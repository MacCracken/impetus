[package]
name = "impetus"
version = "${file:VERSION}"
description = "impetus — physics engine: 2D/3D rigid bodies, collision, constraints, spatial queries, particles, springs"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/impetus"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/impetus"

# stdlib leaves, vendored into lib/ by `cyrius deps` and prepended to every compile.
#   math     — f64_sin / f64_cos and the _polyfill transcendentals (cross-target determinism)
#   ganita   — ganita_f64_hypot / pow (ganita 1.2.15 in the 6.7.18 bundle)
#   tagged / result — the value-form Option and Result
#   freelist — fl_alloc / fl_free: world-owned storage that is returned, not leaked
#   fnptr    — hisab's GJK/EPA support-function callbacks
#   bayan    — the JSON value tree the serde-compatible codecs read (src/json.cyr, ADR 0010)
# hisab's own bundle needs math, alloc, vec, ganita, result, str and fmt (dist/hisab.deps).
# sakshi (logging: tracing → sakshi spans) arrives through hisab's own [deps.sakshi] 2.5.10;
# listing it here too makes `cyrius deps` refuse one copy.
[deps]
stdlib = ["syscalls", "string", "alloc", "str", "fmt", "io", "vec", "math", "ganita",
    "tagged", "result", "freelist", "fnptr", "bayan"]

# hisab 3.4.1, pinned by tag: vectors, quaternions, mat3, ray tests, GJK/EPA, BVH, islands,
# inertia (ADR 0007, hisab-first). No `path =` override, which would bypass the commit pin that
# cyrius.lock records.
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "3.4.1"
modules = ["dist/hisab.cyr"]

# Test / bench / fuzz compiles only. overflow: tests/ulp.cyr's saturating `-|` (ulp distance).
[test]
stdlib = ["assert", "bench", "overflow"]

# `[lib]` is the bundle `cyrius distlib` writes to dist/impetus.cyr: the 2D default, as the Rust
# crate's default feature. [lib.3d] (M4) lists the same shared modules in the same order and adds
# the 3D backend. The list IS the concatenation order and it is load-bearing: no src/ file includes
# another, so each module resolves at file scope against what precedes it (port plan §4 step 3).
# tests/lib_2d.cyr mirrors this list for test compiles (port-parity.md §4.4). Modules are appended
# as their milestone lands. src/constants.cyr and src/constants_private.cyr are generated by
# scripts/oracle; never edit them.
[lib]
modules = [
    "src/error.cyr",
    "src/constants.cyr",
    "src/constants_private.cyr",
    "src/crmath_data.cyr",
    "src/crmath.cyr",
    "src/mathx.cyr",
    "src/fmtf.cyr",
    "src/vec.cyr",
    "src/config.cyr",
    "src/material.cyr",
    "src/units.cyr",
    "src/force.cyr",
    "src/types.cyr",
    "src/arena.cyr",
    "src/contact_tracker.cyr",
    "src/spring.cyr",
    "src/aabb_tree.cyr",
    "src/spatial_hash.cyr",
    "src/b2_types.cyr",
    "src/b2_narrowphase.cyr",
    "src/b2_raycast.cyr",
    "src/b2_state.cyr",
    "src/b2_joints.cyr",
    "src/b2_contacts.cyr",
    "src/b2_solver.cyr",
    "src/particle.cyr",
    "src/world.cyr",
    "src/json.cyr",
]
