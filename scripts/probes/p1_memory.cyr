# Probe 1 (port plan §4 step 9.1): what the step path costs the heap.
#
# The global `alloc` is a bump allocator with no free and no redirection hook; hisab calls it
# directly. A library must never `alloc_reset` (it wipes the consumer's heap too). So every hisab
# call that runs once per step leaks for the life of the process. This measures how much, per call,
# for the calls the port plan wanted on the step path, and checks the two allocators impetus can
# own instead: freelist (world storage) and a growable arena reset per step (scratch).
#
#   cyrius run scripts/probes/p1_memory.cyr

# A sphere for GJK: centre HVec3 at +0, radius f64 bits at +8.
fn sphere_new(x, y, z, r): i64 {
    var s = alloc(16);
    store64(s, hvec3_new(x, y, z));
    store64(s + 8, r);
    return s;
}

# The support contract: the farthest point of the sphere along dir (allocates, as hisab's own do).
fn sphere_support(shape, dir): i64 {
    var r: f64 = load64(shape + 8);
    return hvec3_add(load64(shape), hvec3_scale(hvec3_normalize(dir), r));
}

fn report(name, before, calls) {
    var per = (alloc_used() - before) / calls;
    print(name, strlen(name));
    print(": ", 2);
    fmt_int(per);
    println(" bytes of global heap per call, never returned");
    return 0;
}

fn main() {
    alloc_init();
    var n = 1000;

    var a = hvec3_new(1.0, 2.0, 3.0);
    var b = hvec3_new(0.5, -1.0, 2.0);
    var before = alloc_used();
    var sink = 0;
    for (var k = 0; k < n; k = k + 1) { sink = hvec3_add(a, b); }
    report("hvec3_add", before, n);

    before = alloc_used();
    for (var k = 0; k < n; k = k + 1) { sink = hvec3_cross(a, b); }
    report("hvec3_cross", before, n);

    var q = hquat_from_rotation_z(0.3);
    before = alloc_used();
    for (var k = 0; k < n; k = k + 1) { sink = hquat_rotate_vec3(q, a); }
    report("hquat_rotate_vec3", before, n);

    var m = m3_from_quat(q);
    before = alloc_used();
    for (var k = 0; k < n; k = k + 1) { sink = m3_mul_vec3(m, a); }
    report("m3_mul_vec3", before, n);

    # GJK + EPA on two overlapping unit spheres (depth 0.5), as the 3D narrowphase would per pair.
    var sa = sphere_new(0.0, 0.0, 0.0, 1.0);
    var sb = sphere_new(1.5, 0.0, 0.0, 1.0);
    var nrm[8];
    var dep[8];
    var hit = 0;
    before = alloc_used();
    for (var k = 0; k < 100; k = k + 1) {
        hit = gjk_epa_3d(&sphere_support, sa, &sphere_support, sb, &nrm, &dep);
    }
    report("gjk_epa_3d (two spheres)", before, 100);
    print("  hit ", 6);
    fmt_int(hit);
    var d: f64 = load64(&dep);
    print(" depth bits 0x", 14);
    fmt_hex(d);
    println("");

    # Islands over 100 bodies joined in pairs by 50 contacts, as a step would.
    var contacts = vec_new();
    var up = hvec3_new(0.0, 1.0, 0.0);
    for (var k = 0; k < 50; k = k + 1) {
        vec_push(contacts, contact_new(2 * k, 2 * k + 1, up, 0.01, 0.5, 0.0, 1.0, 1.0));
    }
    before = alloc_used();
    for (var k = 0; k < 100; k = k + 1) { sink = detect_islands(contacts, 50, 100); }
    report("detect_islands (100 bodies, 50 contacts)", before, 100);

    # A BVH over 100 boxes, as a per-step broadphase rebuild would.
    var boxes = alloc(100 * 8);
    for (var k = 0; k < 100; k = k + 1) {
        var lo = hvec3_new(f64_from(k), 0.0, 0.0);
        var hi = hvec3_new(f64_from(k + 1), 1.0, 1.0);
        store64(boxes + k * 8, geo_aabb_new(lo, hi));
    }
    before = alloc_used();
    for (var k = 0; k < 100; k = k + 1) { sink = bvh_build(boxes, 100); }
    report("bvh_build (100 boxes)", before, 100);

    # World storage on freelist: 100,000 alloc/free pairs of a 256-byte body record.
    before = alloc_used();
    for (var k = 0; k < 100000; k = k + 1) {
        var p = fl_alloc(256);
        fl_free(p);
    }
    print("freelist, 100000 alloc/free of 256 B: global heap grew ", 55);
    fmt_int(alloc_used() - before);
    println(" bytes");

    # Step scratch on a growable arena, reset every step: 1,000 steps of 2,000 x 48-byte records.
    var arena = arena_new_growable(65536);
    var cap0 = 0;
    for (var step = 0; step < 1000; step = step + 1) {
        arena_reset(arena);
        for (var k = 0; k < 2000; k = k + 1) { arena_alloc(arena, 48); }
        if (step == 0) { cap0 = arena_capacity_total(arena); }
    }
    print("arena, 1000 steps x 2000 records: capacity after step 1 ", 56);
    fmt_int(cap0);
    print(", after step 1000 ", 18);
    fmt_int(arena_capacity_total(arena));
    println("");
    return 0;
}

var r = main();
sys_exit_group(r);
