# impetus 3D benchmarks — the 3D profile's rows (M4 on). Rust's simulation.rs times the 3D backend only through the
# world, so these are Cyrius-only rows until the 3D world steps (M5); they are recorded in
# docs/benchmarks-rust-v-cyrius.md. Same pattern as tests/impetus.bcyr: bench_new -> bench_batch_start -> tight loop ->
# bench_batch_stop -> bench_report.
#
# M4 part 1: glam's value math (src/math3.cyr) beside hisab's allocating calls for the same operation (ADR 0012's
# trade), the gyroscopic step, body integration, the mass recompute and a world AABB. M4 part 2: the narrowphase.
# M4 part 3: the raycast. M5 part 1: the 3D state, Rust's bodies/* and forces/apply_* loops (Rust's own numbers from the
# 3D build), and get_body_state (since ADR 0008 #4 a copy of the full state; part 1 read the rotation back through the
# correctly rounded atan2). M5 part 2: the
# gyroscopic velocity step, a 20-link chain's joint work for one sub-step, and its whole frame (mask 0, so no
# contacts). M5 part 3: Rust's `world/step_*` scenes on the 3D build. M5 part 4: those scenes through ImPhysicsWorld
# (as Rust's rows run), and Rust's `particles/*` rows on the 3D world. ADR 0008 #4: Rust's `mutation/get_body_state`
# and `set_body_state` on the 3D world.

include "tests/lib_3d.cyr"
include "tests/frame3.cyr"

var N = 1000000;
var g_sink = 0;

# A unit quaternion off every axis.
fn quat(): ImQuat {
    var a: ImQuat = ImQuat_mul_quat(ImQuat_from_rotation_x(0.3), ImQuat_from_rotation_y(0.7));
    return ImQuat_mul_quat(a, ImQuat_from_rotation_z(-0.4));
}

# Value math against hisab's allocating forms (24 B or 72 B of global heap per hisab call, never returned).
fn bench_math3() {
    var q: ImQuat = quat();
    var v: ImVec3 = ImVec3_new(1.0, 2.0, 3.0);
    var b = bench_new("b3/math_quat_mul_vec3");
    bench_batch_start(b);
    for (var i = 0; i < N; i = i + 1) {
        var r: ImVec3 = ImQuat_mul_vec3(q, v);
        g_sink = _im_bits(r.x);
    }
    bench_batch_stop(b, N);
    bench_report(b);

    var hq = hquat_new(q.x, q.y, q.z, q.w);
    var hv = hvec3_new(1.0, 2.0, 3.0);
    var n2 = 100000;
    var bh = bench_new("b3/hisab_hquat_rotate_vec3 (allocates)");
    bench_batch_start(bh);
    for (var i2 = 0; i2 < n2; i2 = i2 + 1) { g_sink = hquat_rotate_vec3(hq, hv); }
    bench_batch_stop(bh, n2);
    bench_report(bh);

    var m: ImMat3 = ImMat3_from_quat(q);
    var bm = bench_new("b3/math_mat3_mul_mat3");
    bench_batch_start(bm);
    for (var i3 = 0; i3 < N; i3 = i3 + 1) {
        var p: ImMat3 = ImMat3_mul_mat3(m, m);
        g_sink = _im_bits(p.x.x);
    }
    bench_batch_stop(bm, N);
    bench_report(bm);

    var j: ImMat3 = ImMat3_from_diagonal(ImVec3_new(1.0, 2.0, 3.0));
    var bi = bench_new("b3/math_mat3_inverse");
    bench_batch_start(bi);
    for (var i4 = 0; i4 < N; i4 = i4 + 1) {
        var inv: ImMat3 = ImMat3_inverse(j);
        g_sink = _im_bits(inv.x.x);
    }
    bench_batch_stop(bi, N);
    bench_report(bi);

    var hm = m3_from_quat(hq);
    var bhm = bench_new("b3/hisab_m3_mul (allocates)");
    bench_batch_start(bhm);
    for (var i5 = 0; i5 < n2; i5 = i5 + 1) { g_sink = m3_mul(hm, hm); }
    bench_batch_stop(bhm, n2);
    bench_report(bhm);
    return 0;
}

# A dynamic body with a box collider, its mass set, spinning off-axis.
fn spinning_box(): ImRigidBody3d {
    var b: ImRigidBody3d = ImRigidBody3d_from_desc(0, ImBodyDesc_default());
    var c: ImCollider3d = ImCollider3d_from_desc(0, 0, ImColliderDesc_new(ImColliderShape_box(1.0, 0.5, 0.25)));
    _im_b3_mass_reset(&b);
    _im_b3_mass_add(&b, &c);
    _im_b3_mass_finish(&b);
    c.free();
    b.rotation = quat();
    b.angular_velocity = ImVec3_new(0.2, 8.0, 0.3);
    b.torque_accumulator = ImVec3_new(0.1, 0.0, -0.2);
    b.update_inertia_world();
    return b;
}

# A tumbling box's gyroscopic step and its integration.
fn bench_body() {
    var b: ImRigidBody3d = spinning_box();
    var w: ImVec3 = ImVec3_new(0.2, 8.0, 0.3);
    var n = 100000;
    var bg = bench_new("b3/gyroscopic_step");
    bench_batch_start(bg);
    for (var i = 0; i < n; i = i + 1) {
        var r: ImVec3 = _im_b3_gyroscopic_step(b.inertia, w, 1.0 / 60.0);
        g_sink = _im_bits(r.x);
    }
    bench_batch_stop(bg, n);
    bench_report(bg);

    var g: ImVec3 = ImVec3_new(0.0, -9.81, 0.0);
    var bv = bench_new("b3/integrate_velocities");
    bench_batch_start(bv);
    for (var i2 = 0; i2 < n; i2 = i2 + 1) { b.integrate_velocities(g, 1.0 / 60.0, 100.0); }
    bench_batch_stop(bv, n);
    bench_report(bv);

    var bp = bench_new("b3/integrate_positions");
    bench_batch_start(bp);
    for (var i3 = 0; i3 < n; i3 = i3 + 1) { b.integrate_positions(1.0 / 60.0); }
    bench_batch_stop(bp, n);
    bench_report(bp);
    return 0;
}

# A box's mass recompute and a rotated box's world AABB.
fn bench_mass_and_aabb() {
    var b: ImRigidBody3d = spinning_box();
    var c: ImCollider3d = ImCollider3d_from_desc(0, 0, ImColliderDesc_new(ImColliderShape_box(1.0, 0.5, 0.25)));
    c.offset = ImVec3_new(0.5, -0.25, 1.0);
    var n = 100000;
    var bm = bench_new("b3/body_mass_box_offset");
    bench_batch_start(bm);
    for (var i = 0; i < n; i = i + 1) {
        _im_b3_mass_reset(&b);
        _im_b3_mass_add(&b, &c);
        _im_b3_mass_finish(&b);
    }
    bench_batch_stop(bm, n);
    bench_report(bm);

    var p: ImVec3 = ImVec3_new(1.0, 2.0, 3.0);
    var q: ImQuat = quat();
    var ba = bench_new("b3/world_aabb_box_rotated");
    bench_batch_start(ba);
    for (var i2 = 0; i2 < n; i2 = i2 + 1) {
        var ab: ImAabb3d = c.world_aabb(p, q);
        g_sink = _im_bits(ab.min.x);
    }
    bench_batch_stop(ba, n);
    bench_report(ba);
    c.free();
    return 0;
}

# The eight corners ±h as a hull.
fn cube_hull(h: f64): ImColliderShape {
    var w = fl_alloc(8 * 24);
    for (var k = 0; k < 8; k = k + 1) {
        var x: f64 = h;
        var y: f64 = h;
        var z: f64 = h;
        if ((k & 4) == 0) { x = -h; }
        if ((k & 2) == 0) { y = -h; }
        if ((k & 1) == 0) { z = -h; }
        store64(w + k * 24, _im_bits(x));
        store64(w + k * 24 + 8, _im_bits(y));
        store64(w + k * 24 + 16, _im_bits(z));
    }
    var s: ImColliderShape = ImColliderShape_convex_hull(w, 8);
    fl_free(w);
    return s;
}

# One pair through `generate_contact_3d`, n times, on a reused GJK scratch.
fn bench_pair(name, sa: *ImColliderShape, pa: ImVec3, ra: ImQuat, sb: *ImColliderShape, pb: ImVec3, rb: ImQuat,
  sc: *ImGjkScratch3d, n) {
    var h: ImHit3d;
    _im_b3_generate_contact_3d(sa, pa, ra, sb, pb, rb, sc, &h);
    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { g_sink = _im_b3_generate_contact_3d(sa, pa, ra, sb, pb, rb, sc, &h); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# M4 part 2: the narrowphase, one row per path: the closed forms, the AABB fast path, the OBB SAT (a face contact
# and an edge pair), and GJK + EPA (a hull against a ball and a box; two balls through GJK, which runs EPA to its cap).
fn bench_narrowphase() {
    var sc: ImGjkScratch3d = ImGjkScratch3d_new();
    var ball: ImColliderShape = ImColliderShape_ball(0.5);
    var cube: ImColliderShape = ImColliderShape_box(0.5, 0.5, 0.5);
    var cap: ImColliderShape = ImColliderShape_capsule(0.5, 0.25);
    var hull: ImColliderShape = cube_hull(0.5);
    var i0: ImQuat = ImQuat_identity();
    var q: ImQuat = quat();
    var r45: ImQuat = ImQuat_from_rotation_z(_IM_PI / 4.0);
    var ry45: ImQuat = ImQuat_from_rotation_y(_IM_PI / 4.0);
    var z: ImVec3 = ImVec3_zero();
    var n = 100000;
    bench_pair("b3/contact_ball_ball", &ball, z, i0, &ball, ImVec3_new(0.6, 0.3, 0.0), i0, &sc, n);
    bench_pair("b3/contact_ball_box_rotated", &ball, ImVec3_new(0.6, 0.5, 0.2), i0, &cube, z, q, &sc, n);
    bench_pair("b3/contact_box_box_aabb", &cube, z, i0, &cube, ImVec3_new(0.8, 0.3, 0.1), i0, &sc, n);
    bench_pair("b3/contact_box_box_obb_face", &cube, z, i0, &cube, ImVec3_new(0.0, 0.9, 0.1), r45, &sc, n);
    var sep: f64 = f64_sqrt(2.0) - 0.1;
    bench_pair("b3/contact_box_box_obb_edge", &cube, z, ry45, &cube, ImVec3_new(sep, 0.0, 0.0), r45, &sc, n);
    bench_pair("b3/contact_capsule_box", &cap, ImVec3_new(0.2, 0.7, 0.0), r45, &cube, z, i0, &sc, n);
    bench_pair("b3/contact_capsule_capsule", &cap, z, i0, &cap, ImVec3_new(0.3, 0.2, 0.1), q, &sc, n);
    bench_pair("b3/contact_hull_ball_gjk", &hull, z, q, &ball, ImVec3_new(0.0, 0.8, 0.2), i0, &sc, n);
    bench_pair("b3/contact_hull_box_gjk", &hull, z, q, &cube, ImVec3_new(0.6, 0.3, 0.1), i0, &sc, n);
    var unit: ImColliderShape = ImColliderShape_ball(1.0);
    var h: ImHit3d;
    var pb: ImVec3 = ImVec3_new(1.2, 0.5, 0.3);
    _im_b3_gjk_epa_shapes(&unit, z, i0, &unit, pb, i0, &sc, &h);
    var b = bench_new("b3/gjk_epa_ball_ball (EPA to its cap)");
    var m = 10000;
    bench_batch_start(b);
    for (var i = 0; i < m; i = i + 1) { g_sink = _im_b3_gjk_epa_shapes(&unit, z, i0, &unit, pb, i0, &sc, &h); }
    bench_batch_stop(b, m);
    bench_report(b);
    ball.free();
    cube.free();
    cap.free();
    hull.free();
    unit.free();
    sc.free();
    return 0;
}

# A static body at pos with one collider of `shape`, inserted as the 3D state will insert them.
fn add_static(ba: *ImArena, ca: *ImArena, pos: ImVec3, rot_z: f64, shape: ImColliderShape) {
    var bd: ImBodyDesc = ImBodyDesc_default();
    bd.body_type = IM_BODY_STATIC;
    bd.position = pos;
    bd.rotation = rot_z;
    var b: ImRigidBody3d = ImRigidBody3d_from_desc(0, bd);
    var bh = ba.insert(&b);
    var bp: *ImRigidBody3d = _im_b3_as_body(ba.get(bh));
    bp.handle = bh;
    var c: ImCollider3d = ImCollider3d_from_desc(0, bh, ImColliderDesc_new(shape));
    var ch = ca.insert(&c);
    var cp: *ImCollider3d = _im_b3_as_coll(ca.get(ch));
    cp.handle = ch;
    return 0;
}

# M4 part 3: one ray against each shape the raycast handles, and Rust's `queries/raycast_100_bodies` scene (100 unit
# balls on a 10 × 10 grid 3 apart, a ray along +x from the origin).
fn bench_raycast() {
    var r: ImRayT3d;
    var z: ImVec3 = ImVec3_zero();
    var x: ImVec3 = ImVec3_new(1.0, 0.0, 0.0);
    var n = 1000000;
    var b1 = bench_new("b3/ray_sphere");
    bench_batch_start(b1);
    for (var i = 0; i < n; i = i + 1) { g_sink = _im_b3_ray_sphere(z, x, ImVec3_new(5.0, 0.2, 0.1), 1.0, &r); }
    bench_batch_stop(b1, n);
    bench_report(b1);
    var lo: ImVec3 = ImVec3_new(4.0, -1.0, -1.0);
    var hi: ImVec3 = ImVec3_new(6.0, 1.0, 1.0);
    var b2 = bench_new("b3/ray_aabb_3d");
    bench_batch_start(b2);
    for (var i2 = 0; i2 < n; i2 = i2 + 1) { g_sink = _im_b3_ray_aabb_3d(z, x, lo, hi, &r); }
    bench_batch_stop(b2, n);
    bench_report(b2);
    var pa: ImVec3 = ImVec3_new(5.0, -1.0, 0.0);
    var pb: ImVec3 = ImVec3_new(5.0, 1.0, 0.0);
    var b3 = bench_new("b3/ray_capsule");
    bench_batch_start(b3);
    for (var i3 = 0; i3 < n; i3 = i3 + 1) { g_sink = _im_b3_ray_capsule(z, x, pa, pb, 0.5, &r); }
    bench_batch_stop(b3, n);
    bench_report(b3);

    var ba: *ImArena = ImArena_new(sizeof(ImRigidBody3d));
    var ca: *ImArena = ImArena_new(sizeof(ImCollider3d));
    for (var k = 0; k < 100; k = k + 1) {
        var px: f64 = f64_from(k % 10) * 3.0;
        var py: f64 = f64_from(k / 10) * 3.0;
        add_static(ba, ca, ImVec3_new(px, py, 0.0), 0.0, ImColliderShape_ball(1.0));
    }
    var hit: ImRayHit;
    var m = 100000;
    var b4 = bench_new("queries/raycast_100_bodies (3D)");
    bench_batch_start(b4);
    for (var i4 = 0; i4 < m; i4 = i4 + 1) { g_sink = _im_b3_raycast(ba, ca, z, x, 100.0, 0, 0, &hit); }
    bench_batch_stop(b4, m);
    bench_report(b4);
    for (var s = 0; s < ca.slot_count(); s = s + 1) { _im_b3_as_coll(ca.get(ca.slot_handle(s))).free(); }
    ca.free();
    ba.free();
    return 0;
}

# bodies/* and forces/apply_*: the Rust benches' loops on an ImPhysicsState3d (PhysicsWorld's 3D calls are the
# backend's). As in Rust, add_body and add_joint grow one world. which 6 is Cyrius-only: get_body_state.
fn bench_state3(name, which) {
    var st: ImPhysicsState3d = ImPhysicsState3d_new();
    var a = st.add_body(ImBodyDesc_default());
    var b2 = st.add_body(ImBodyDesc_default());
    var bd: ImBodyDesc = ImBodyDesc_default();
    bd.position = ImVec3_new(1.0, 2.0, 0.0);
    var cd: ImColliderDesc = ImColliderDesc_new(ImColliderShape_ball(0.5));
    var z2: ImVec2 = ImVec2_new(0.0, 0.0);
    var jd: ImJointDesc = ImJointDesc_new(a, b2, ImJointType_spring(2.0, 100.0, 5.0), z2, z2);
    var fo: ImForce = ImForce_new(10.0, -5.0, 0.0);
    var im: ImImpulse = ImImpulse_new(0.0, 20.0, 0.0);
    var rd: ImBodyDesc = ImBodyDesc_default();
    rd.rotation = 0.7;
    var rh = st.add_body(rd);
    var bs: ImBodyState;
    var bn = bench_new(name);
    var reps = 100000;
    bench_batch_start(bn);
    for (var r = 0; r < reps; r = r + 1) {
        if (which == 0) {
            g_sink = st.add_body(ImBodyDesc_default());
        } elif (which == 1) {
            var h = st.add_body(ImBodyDesc_default());
            st.remove_body(h);
        } elif (which == 2) {
            var h2 = st.add_body(bd);
            var t, c = st.add_collider(h2, cd);
            g_sink = c;
        } elif (which == 3) {
            var tj, j = st.add_joint(jd);
            g_sink = j;
        } elif (which == 4) {
            st.apply_force(a, fo);
        } elif (which == 5) {
            st.apply_impulse(a, im);
        } else {
            var tg, ug = st.get_body_state(rh, &bs);
            g_sink = tg;
        }
    }
    bench_batch_stop(bn, reps);
    bench_report(bn);
    cd.shape.free();
    st.free();
    return 0;
}

# Rust's bodies/* and forces/apply_* rows on the 3D state, and get_body_state.
fn bench_states3() {
    bench_state3("bodies/add_body (3D)", 0);
    bench_state3("bodies/add_remove_body (3D)", 1);
    bench_state3("bodies/add_body_with_collider (3D)", 2);
    bench_state3("bodies/add_joint (3D)", 3);
    bench_state3("forces/apply_force (3D)", 4);
    bench_state3("forces/apply_impulse (3D)", 5);
    bench_state3("b3/get_body_state", 6);
    return 0;
}

# A static anchor and a 20-link chain of 1 m boxes, the joints cycling Fixed, Distance, Rope and Spring, every collider
# mask 0: the state, after `warm` frames.
fn chain20(st: *ImPhysicsState3d, warm) {
    var g: ImVec3 = ImVec3_new(0.0, -9.81, 0.0);
    var prev = st.add_body(ImBodyDesc_default());
    st._body(prev).body_type = IM_BODY_STATIC;
    var z2: ImVec2 = ImVec2_new(0.0, 0.0);
    for (var i = 0; i < 20; i = i + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        var x: f64 = 0.5 + f64_from(i);
        d.position = ImVec3_new(x, 0.0, 0.0);
        var h = st.add_body(d);
        var cd: ImColliderDesc = ImColliderDesc_new(ImColliderShape_box(0.5, 0.1, 0.1));
        cd.collision_layer = 1;
        cd.collision_mask = 0;
        var tc, c = st.add_collider(h, cd);
        cd.shape.free();
        var jt: ImJointType = ImJointType_fixed();
        var k = i % 4;
        if (k == 1) { jt = ImJointType_distance(1.0); }
        if (k == 2) { jt = ImJointType_rope(1.05); }
        if (k == 3) { jt = ImJointType_spring(1.0, 200.0, 4.0); }
        var la: ImVec2 = ImVec2_new(0.5, 0.0);
        if (i == 0) { la = z2; }
        var tj, j = st.add_joint(ImJointDesc_new(prev, h, jt, la, ImVec2_new(-0.5, 0.0)));
        prev = h;
    }
    for (var f = 0; f < warm; f = f + 1) { _t3_frame(st, g); }
    return 0;
}

# The 3D step's parts: the gyroscopic velocity step, a 20-link chain's joint work and its contact-free frame.
fn bench_step3() {
    var g: ImVec3 = ImVec3_new(0.0, -9.81, 0.0);
    var dt: f64 = 1.0 / 60.0;
    # The gyroscopic step: an asymmetric box tumbling about an axis off its principal axes.
    var st: ImPhysicsState3d = ImPhysicsState3d_new();
    var h = st.add_body(ImBodyDesc_default());
    var cd: ImColliderDesc = ImColliderDesc_new(ImColliderShape_box(1.0, 0.5, 0.25));
    var tc, c = st.add_collider(h, cd);
    cd.shape.free();
    var rb: *ImRigidBody3d = st._body(h);
    var w0: ImVec3 = ImVec3_new(3.0, 1.0, 2.0);
    var zero: ImVec3 = ImVec3_zero();
    var n = 100000;
    var b1 = bench_new("b3/integrate_velocities_tumble");
    bench_batch_start(b1);
    for (var i = 0; i < n; i = i + 1) {
        rb.angular_velocity = w0;
        rb.integrate_velocities(zero, dt, 100.0);
    }
    bench_batch_stop(b1, n);
    bench_report(b1);
    st.free();
    # One sub-step's joint work on the 20-link chain: prepare (forces and rows), 4 velocity passes, breaking, 1
    # position pass.
    var sc: ImPhysicsState3d = ImPhysicsState3d_new();
    chain20(&sc, 60);
    var erp: f64 = _im_b3_error_reduction(30.0, 1.0, 0.2, dt);
    var m = 10000;
    var b2 = bench_new("b3/joints_chain20");
    bench_batch_start(b2);
    for (var j = 0; j < m; j = j + 1) {
        sc.prepare_joints(dt);
        for (var v = 0; v < 4; v = v + 1) { sc.solve_joint_velocities(dt); }
        sc.break_joints(dt);
        sc.solve_joint_positions(erp, dt);
    }
    bench_batch_stop(b2, m);
    bench_report(b2);
    sc.free();
    # The chain's whole contact-free frame: integration, joints, positions, sleep, finish_step.
    var sf: ImPhysicsState3d = ImPhysicsState3d_new();
    chain20(&sf, 60);
    var b3 = bench_new("b3/frame_chain20 (no contacts)");
    bench_batch_start(b3);
    for (var f = 0; f < m; f = f + 1) { _t3_frame(&sf, g); }
    bench_batch_stop(b3, m);
    bench_report(b3);
    sf.free();
    return 0;
}

# Rust's world/step_N_bodies scene on the 3D build, through the world (M5 part 4): n dynamic balls of radius 0.5 in
# rows of `per` (1 apart, rows 2 apart, z = 0), falling together; with `floor` 1, substep/step_100_bodies_substep4's
# static floor (a box of half extents 50, 0.5, 0) under balls lifted by 1. Stepped `warm` frames, then timed `reps`.
fn bench_step3_balls(name, n, per, floor, cfg: ImWorldConfig, warm, reps) {
    var w: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var lift: f64 = 0.0;
    if (floor == 1) {
        var fd: ImBodyDesc = ImBodyDesc_default();
        fd.body_type = IM_BODY_STATIC;
        fd.position = ImVec3_new(0.0, -0.5, 0.0);
        var fh = w.add_body(fd);
        var fc: ImColliderDesc = ImColliderDesc_new(ImColliderShape_box(50.0, 0.5, 0.0));
        var tf, cf = w.add_collider(fh, fc);
        lift = 1.0;
    }
    for (var i = 0; i < n; i = i + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        var x: f64 = f64_from(i % per);
        var y: f64 = f64_from(i / per) * 2.0 + lift;
        d.position = ImVec3_new(x, y, 0.0);
        var h = w.add_body(d);
        var t, c = w.add_collider(h, ImColliderDesc_new(ImColliderShape_ball(0.5)));
    }
    for (var k = 0; k < warm; k = k + 1) { w.step(); }
    var bn = bench_new(name);
    bench_batch_start(bn);
    for (var r = 0; r < reps; r = r + 1) { w.step(); }
    bench_batch_stop(bn, reps);
    bench_report(bn);
    w.free();
    return 0;
}

# A fresh 3D world with n particles of radius 0.05 in rows of `per`, 2 apart from y = 5 (Rust's
# particles/step_N_particles), one step timed per sample.
fn bench_fresh_particles3(name, n, per, reps) {
    var bn = bench_new(name);
    for (var r = 0; r < reps; r = r + 1) {
        var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
        for (var i = 0; i < n; i = i + 1) {
            var x: f64 = f64_from(i % per);
            var y: f64 = f64_from(i / per) * 2.0 + 5.0;
            var p: ImParticle = ImParticle_new(ImVec3_new(x, y, 0.0), ImVec3_zero(), 100.0);
            p.with_radius(0.05);
            w.spawn_particle(p);
        }
        bench_start(bn);
        w.step();
        bench_stop(bn);
        w.free();
    }
    bench_report(bn);
    return 0;
}

# The 3D world (M5 parts 3–4): Rust's world/step_*, substep and particles/* rows on its 3D build, through
# ImPhysicsWorld, and a settled stack of five boxes (the OBB SAT's face contacts, kept awake by a nudge every frame).
fn bench_step3_world() {
    var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    var be = bench_new("b3/step_empty");
    bench_batch_start(be);
    for (var r = 0; r < 100000; r = r + 1) { w.step(); }
    bench_batch_stop(be, 100000);
    bench_report(be);
    w.free();
    bench_step3_balls("b3/step_10_bodies", 10, 5, 0, ImWorldConfig_default(), 100, 2000);
    bench_step3_balls("b3/step_100_bodies", 100, 10, 0, ImWorldConfig_default(), 100, 200);
    bench_step3_balls("b3/step_1000_bodies", 1000, 32, 0, ImWorldConfig_default(), 20, 20);
    var c4: ImWorldConfig = ImWorldConfig_default();
    c4.sub_steps = 4;
    bench_step3_balls("b3/step_100_bodies_substep4", 100, 10, 1, c4, 100, 100);
    var sk: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    var gd: ImBodyDesc = ImBodyDesc_default();
    gd.body_type = IM_BODY_STATIC;
    gd.position = ImVec3_new(0.0, -0.5, 0.0);
    var g = sk.add_body(gd);
    var tg, cg = sk.add_collider(g, ImColliderDesc_new(ImColliderShape_box(20.0, 0.5, 20.0)));
    var top = 0;
    for (var i = 0; i < 5; i = i + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        var y: f64 = 0.5 + f64_from(i);
        d.position = ImVec3_new(0.0, y, 0.0);
        top = sk.add_body(d);
        var tb, cb = sk.add_collider(top, ImColliderDesc_new(ImColliderShape_box(0.5, 0.5, 0.5)));
    }
    for (var k = 0; k < 120; k = k + 1) { sk.step(); }
    var nudge: ImForce = ImForce_new(0.0, 0.0, 0.0001);
    var bs = bench_new("b3/step_stack5_resting");
    bench_batch_start(bs);
    for (var q = 0; q < 2000; q = q + 1) {
        sk.apply_force(top, nudge);
        sk.step();
    }
    bench_batch_stop(bs, 2000);
    bench_report(bs);
    sk.free();
    bench_fresh_particles3("b3/particles/step_100_particles", 100, 10, 2000);
    bench_fresh_particles3("b3/particles/step_1000_particles", 1000, 32, 200);
    # A floor and 100 falling particles, stepped on and on as criterion does (they expire at 10 s).
    w = ImPhysicsWorld_new(ImWorldConfig_default());
    var fd: ImBodyDesc = ImBodyDesc_default();
    fd.body_type = IM_BODY_STATIC;
    var fh = w.add_body(fd);
    var tf, cf = w.add_collider(fh, ImColliderDesc_new(ImColliderShape_box(50.0, 0.5, 0.0)));
    for (var j = 0; j < 100; j = j + 1) {
        var px: f64 = f64_from(j % 10);
        var py: f64 = f64_from(j / 10) + 1.0;
        var p: ImParticle = ImParticle_new(ImVec3_new(px, py, 0.0), ImVec3_new(0.0, -2.0, 0.0), 10.0);
        p.with_radius(0.05).with_restitution(0.5);
        w.spawn_particle(p);
    }
    var bf = bench_new("b3/particles/step_100_particles_with_floor");
    bench_batch_start(bf);
    for (var r2 = 0; r2 < 100000; r2 = r2 + 1) { w.step(); }
    bench_batch_stop(bf, 100000);
    bench_report(bf);
    w.free();
    w = ImPhysicsWorld_new(ImWorldConfig_default());
    var bsp = bench_new("b3/particles/spawn_particle");
    bench_batch_start(bsp);
    for (var r3 = 0; r3 < 100000; r3 = r3 + 1) {
        g_sink = w.spawn_particle(ImParticle_new(ImVec3_zero(), ImVec3_new(1.0, 2.0, 0.0), 3.0));
    }
    bench_batch_stop(bsp, 100000);
    bench_report(bsp);
    w.free();
    w = ImPhysicsWorld_new(ImWorldConfig_default());
    var em: ImParticleEmitter = ImParticleEmitter_new(ImVec3_zero(), ImVec3_new(0.0, 10.0, 0.0), 100.0);
    em.with_lifetime(0.5);
    w.add_emitter(em);
    var bm = bench_new("b3/particles/emitter_step");
    bench_batch_start(bm);
    for (var r4 = 0; r4 < 100000; r4 = r4 + 1) { w.step(); }
    bench_batch_stop(bm, 100000);
    bench_report(bm);
    w.free();
    return 0;
}

# Rust's mutation/get_body_state and mutation/set_body_state on the 3D world: a ball's state read, and a state written
# (Rust's angle 0.5 and spin 0.1 about z, as the 2.0 state of that rotation, ADR 0008 #4).
fn bench_mutation3() {
    var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    var h = w.add_body(ImBodyDesc_default());
    var tc, cc = w.add_collider(h, ImColliderDesc_new(ImColliderShape_ball(0.5)));
    var bs: ImBodyState;
    var bg = bench_new("b3/mutation/get_body_state");
    bench_batch_start(bg);
    for (var r = 0; r < 1000000; r = r + 1) {
        var tg, vg = w.get_body_state(h, &bs);
        g_sink = tg;
    }
    bench_batch_stop(bg, 1000000);
    bench_report(bg);
    var st: ImBodyState;
    st.handle = h;
    st.body_type = IM_BODY_DYNAMIC;
    st.position = ImVec3_new(5.0, 10.0, 0.0);
    st.rotation = ImQuat_from_rotation_z(0.5);
    st.linear_velocity = ImVec3_new(1.0, 2.0, 0.0);
    st.angular_velocity = ImVec3_new(0.0, 0.0, 0.1);
    st.is_sleeping = 0;
    var bset = bench_new("b3/mutation/set_body_state");
    bench_batch_start(bset);
    for (var r2 = 0; r2 < 1000000; r2 = r2 + 1) {
        var ts, vs = w.set_body_state(h, st);
        g_sink = ts;
    }
    bench_batch_stop(bset, 1000000);
    bench_report(bset);
    w.free();
    return 0;
}

# Runs the 3D benches.
fn main() {
    alloc_init();
    bench_math3();
    bench_body();
    bench_mass_and_aabb();
    bench_narrowphase();
    bench_raycast();
    bench_states3();
    bench_step3();
    bench_step3_world();
    bench_mutation3();
    return 0;
}

var r = main();
sys_exit_group(r);
