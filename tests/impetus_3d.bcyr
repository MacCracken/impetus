# impetus 3D benchmarks — the 3D profile's rows (M4 on). Rust's simulation.rs times the 3D backend only through the
# world, so these are Cyrius-only rows until the 3D world steps (M5); they are recorded in
# docs/benchmarks-rust-v-cyrius.md. Same pattern as tests/impetus.bcyr: bench_new -> bench_batch_start -> tight loop ->
# bench_batch_stop -> bench_report.
#
# M4 part 1: glam's value math (src/math3.cyr) beside hisab's allocating calls for the same operation (ADR 0012's
# trade), the gyroscopic step, body integration, the mass recompute and a world AABB. M4 part 2: the narrowphase.

include "tests/lib_3d.cyr"

var N = 1000000;
var g_sink = 0;

# A unit quaternion off every axis.
fn quat(): ImQuat {
    var a: ImQuat = ImQuat_mul_quat(ImQuat_from_rotation_x(0.3), ImQuat_from_rotation_y(0.7));
    return ImQuat_mul_quat(a, ImQuat_from_rotation_z(-0.4));
}

# Value math against hisab's allocating forms (24 B or 72 B of global heap per hisab call, never returned).
fn bench_math3() {
    var q: ImQuat = quat();
    var v: ImVec3 = ImVec3_new(1.0, 2.0, 3.0);
    var b = bench_new("b3/math_quat_mul_vec3");
    bench_batch_start(b);
    for (var i = 0; i < N; i = i + 1) {
        var r: ImVec3 = ImQuat_mul_vec3(q, v);
        g_sink = _im_bits(r.x);
    }
    bench_batch_stop(b, N);
    bench_report(b);

    var hq = hquat_new(q.x, q.y, q.z, q.w);
    var hv = hvec3_new(1.0, 2.0, 3.0);
    var n2 = 100000;
    var bh = bench_new("b3/hisab_hquat_rotate_vec3 (allocates)");
    bench_batch_start(bh);
    for (var i2 = 0; i2 < n2; i2 = i2 + 1) { g_sink = hquat_rotate_vec3(hq, hv); }
    bench_batch_stop(bh, n2);
    bench_report(bh);

    var m: ImMat3 = ImMat3_from_quat(q);
    var bm = bench_new("b3/math_mat3_mul_mat3");
    bench_batch_start(bm);
    for (var i3 = 0; i3 < N; i3 = i3 + 1) {
        var p: ImMat3 = ImMat3_mul_mat3(m, m);
        g_sink = _im_bits(p.x.x);
    }
    bench_batch_stop(bm, N);
    bench_report(bm);

    var j: ImMat3 = ImMat3_from_diagonal(ImVec3_new(1.0, 2.0, 3.0));
    var bi = bench_new("b3/math_mat3_inverse");
    bench_batch_start(bi);
    for (var i4 = 0; i4 < N; i4 = i4 + 1) {
        var inv: ImMat3 = ImMat3_inverse(j);
        g_sink = _im_bits(inv.x.x);
    }
    bench_batch_stop(bi, N);
    bench_report(bi);

    var hm = m3_from_quat(hq);
    var bhm = bench_new("b3/hisab_m3_mul (allocates)");
    bench_batch_start(bhm);
    for (var i5 = 0; i5 < n2; i5 = i5 + 1) { g_sink = m3_mul(hm, hm); }
    bench_batch_stop(bhm, n2);
    bench_report(bhm);
    return 0;
}

# A dynamic body with a box collider, its mass set, spinning off-axis.
fn spinning_box(): ImRigidBody3d {
    var b: ImRigidBody3d = ImRigidBody3d_from_desc(0, ImBodyDesc_default());
    var c: ImCollider3d = ImCollider3d_from_desc(0, 0, ImColliderDesc_new(ImColliderShape_box(1.0, 0.5, 0.25)));
    _im_b3_mass_reset(&b);
    _im_b3_mass_add(&b, &c);
    _im_b3_mass_finish(&b);
    c.free();
    b.rotation = quat();
    b.angular_velocity = ImVec3_new(0.2, 8.0, 0.3);
    b.torque_accumulator = ImVec3_new(0.1, 0.0, -0.2);
    b.update_inertia_world();
    return b;
}

fn bench_body() {
    var b: ImRigidBody3d = spinning_box();
    var w: ImVec3 = ImVec3_new(0.2, 8.0, 0.3);
    var n = 100000;
    var bg = bench_new("b3/gyroscopic_step");
    bench_batch_start(bg);
    for (var i = 0; i < n; i = i + 1) {
        var r: ImVec3 = _im_b3_gyroscopic_step(b.inertia, w, 1.0 / 60.0);
        g_sink = _im_bits(r.x);
    }
    bench_batch_stop(bg, n);
    bench_report(bg);

    var g: ImVec3 = ImVec3_new(0.0, -9.81, 0.0);
    var bv = bench_new("b3/integrate_velocities");
    bench_batch_start(bv);
    for (var i2 = 0; i2 < n; i2 = i2 + 1) { b.integrate_velocities(g, 1.0 / 60.0, 100.0); }
    bench_batch_stop(bv, n);
    bench_report(bv);

    var bp = bench_new("b3/integrate_positions");
    bench_batch_start(bp);
    for (var i3 = 0; i3 < n; i3 = i3 + 1) { b.integrate_positions(1.0 / 60.0); }
    bench_batch_stop(bp, n);
    bench_report(bp);
    return 0;
}

fn bench_mass_and_aabb() {
    var b: ImRigidBody3d = spinning_box();
    var c: ImCollider3d = ImCollider3d_from_desc(0, 0, ImColliderDesc_new(ImColliderShape_box(1.0, 0.5, 0.25)));
    c.offset = ImVec3_new(0.5, -0.25, 1.0);
    var n = 100000;
    var bm = bench_new("b3/body_mass_box_offset");
    bench_batch_start(bm);
    for (var i = 0; i < n; i = i + 1) {
        _im_b3_mass_reset(&b);
        _im_b3_mass_add(&b, &c);
        _im_b3_mass_finish(&b);
    }
    bench_batch_stop(bm, n);
    bench_report(bm);

    var p: ImVec3 = ImVec3_new(1.0, 2.0, 3.0);
    var q: ImQuat = quat();
    var ba = bench_new("b3/world_aabb_box_rotated");
    bench_batch_start(ba);
    for (var i2 = 0; i2 < n; i2 = i2 + 1) {
        var ab: ImAabb3d = c.world_aabb(p, q);
        g_sink = _im_bits(ab.min.x);
    }
    bench_batch_stop(ba, n);
    bench_report(ba);
    c.free();
    return 0;
}

# The eight corners ±h as a hull.
fn cube_hull(h: f64): ImColliderShape {
    var w = fl_alloc(8 * 24);
    for (var k = 0; k < 8; k = k + 1) {
        var x: f64 = h;
        var y: f64 = h;
        var z: f64 = h;
        if ((k & 4) == 0) { x = -h; }
        if ((k & 2) == 0) { y = -h; }
        if ((k & 1) == 0) { z = -h; }
        store64(w + k * 24, _im_bits(x));
        store64(w + k * 24 + 8, _im_bits(y));
        store64(w + k * 24 + 16, _im_bits(z));
    }
    var s: ImColliderShape = ImColliderShape_convex_hull(w, 8);
    fl_free(w);
    return s;
}

# One pair through `generate_contact_3d`, n times, on a reused GJK scratch.
fn bench_pair(name, sa: *ImColliderShape, pa: ImVec3, ra: ImQuat, sb: *ImColliderShape, pb: ImVec3, rb: ImQuat,
    sc: *ImGjkScratch3d, n) {
    var h: ImHit3d;
    _im_b3_generate_contact_3d(sa, pa, ra, sb, pb, rb, sc, &h);
    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < n; i = i + 1) { g_sink = _im_b3_generate_contact_3d(sa, pa, ra, sb, pb, rb, sc, &h); }
    bench_batch_stop(b, n);
    bench_report(b);
    return 0;
}

# M4 part 2: the narrowphase, one row per path: the closed forms, the AABB fast path, the OBB SAT (a face contact
# and an edge pair), and GJK + EPA (a hull against a ball and a box; two balls through GJK, which runs EPA to its cap).
fn bench_narrowphase() {
    var sc: ImGjkScratch3d = ImGjkScratch3d_new();
    var ball: ImColliderShape = ImColliderShape_ball(0.5);
    var cube: ImColliderShape = ImColliderShape_box(0.5, 0.5, 0.5);
    var cap: ImColliderShape = ImColliderShape_capsule(0.5, 0.25);
    var hull: ImColliderShape = cube_hull(0.5);
    var i0: ImQuat = ImQuat_identity();
    var q: ImQuat = quat();
    var r45: ImQuat = ImQuat_from_rotation_z(_IM_PI / 4.0);
    var ry45: ImQuat = ImQuat_from_rotation_y(_IM_PI / 4.0);
    var z: ImVec3 = ImVec3_zero();
    var n = 100000;
    bench_pair("b3/contact_ball_ball", &ball, z, i0, &ball, ImVec3_new(0.6, 0.3, 0.0), i0, &sc, n);
    bench_pair("b3/contact_ball_box_rotated", &ball, ImVec3_new(0.6, 0.5, 0.2), i0, &cube, z, q, &sc, n);
    bench_pair("b3/contact_box_box_aabb", &cube, z, i0, &cube, ImVec3_new(0.8, 0.3, 0.1), i0, &sc, n);
    bench_pair("b3/contact_box_box_obb_face", &cube, z, i0, &cube, ImVec3_new(0.0, 0.9, 0.1), r45, &sc, n);
    var sep: f64 = f64_sqrt(2.0) - 0.1;
    bench_pair("b3/contact_box_box_obb_edge", &cube, z, ry45, &cube, ImVec3_new(sep, 0.0, 0.0), r45, &sc, n);
    bench_pair("b3/contact_capsule_box", &cap, ImVec3_new(0.2, 0.7, 0.0), r45, &cube, z, i0, &sc, n);
    bench_pair("b3/contact_capsule_capsule", &cap, z, i0, &cap, ImVec3_new(0.3, 0.2, 0.1), q, &sc, n);
    bench_pair("b3/contact_hull_ball_gjk", &hull, z, q, &ball, ImVec3_new(0.0, 0.8, 0.2), i0, &sc, n);
    bench_pair("b3/contact_hull_box_gjk", &hull, z, q, &cube, ImVec3_new(0.6, 0.3, 0.1), i0, &sc, n);
    var unit: ImColliderShape = ImColliderShape_ball(1.0);
    var h: ImHit3d;
    var pb: ImVec3 = ImVec3_new(1.2, 0.5, 0.3);
    _im_b3_gjk_epa_shapes(&unit, z, i0, &unit, pb, i0, &sc, &h);
    var b = bench_new("b3/gjk_epa_ball_ball (EPA to its cap)");
    var m = 10000;
    bench_batch_start(b);
    for (var i = 0; i < m; i = i + 1) { g_sink = _im_b3_gjk_epa_shapes(&unit, z, i0, &unit, pb, i0, &sc, &h); }
    bench_batch_stop(b, m);
    bench_report(b);
    ball.free();
    cube.free();
    cap.free();
    hull.free();
    unit.free();
    sc.free();
    return 0;
}

fn main() {
    alloc_init();
    bench_math3();
    bench_body();
    bench_mass_and_aabb();
    bench_narrowphase();
    return 0;
}

var r = main();
sys_exit_group(r);
