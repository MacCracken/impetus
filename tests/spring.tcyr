# spring.tcyr — the ported Rust tests of rust-old/src/spring.rs (M1b), plus Cyrius-only tests of the
# transition cache and the three damping regimes' branch point. Bit-level parity is the golden
# corpus's (tests/golden/spring.tsv); these are the Rust reference assertions.

include "tests/lib_2d.cyr"

# |a − b|.
fn dist(a: f64, b: f64): f64 {
    var d: f64 = a - b;
    var r: f64 = f64_abs(d);
    return r;
}

# Runs the ported spring tests.
fn main() {
    alloc_init();
    var dt: f64 = 1.0 / 60.0;

    test_group("spring_moves_toward_target");
    var s: ImSpring = ImSpring_new(0.0, 100.0, 300.0, 15.0);
    for (var i = 0; i < 600; i = i + 1) { s.step(dt); }
    var p: f64 = s.position();
    var d: f64 = dist(p, 100.0);
    assert(d < 0.1, "within 0.1 of 100");

    test_group("spring_critically_damped_no_overshoot");
    s = ImSpring_critically_damped(0.0, 100.0, 300.0);
    var max_pos: f64 = 0.0;
    for (var i = 0; i < 600; i = i + 1) {
        s.step(dt);
        p = s.position();
        if (p > max_pos) { max_pos = p; }
    }
    assert(max_pos < 105.0, "no significant overshoot");

    test_group("spring_under_damped_overshoots");
    s = ImSpring_under_damped(0.0, 100.0, 300.0);
    max_pos = 0.0;
    for (var i = 0; i < 600; i = i + 1) {
        s.step(dt);
        p = s.position();
        if (p > max_pos) { max_pos = p; }
    }
    assert(max_pos > 100.0, "overshoots");

    test_group("spring_settles");
    s = ImSpring_new(0.0, 50.0, 200.0, 20.0);
    assert_eq(s.is_settled(), 0, "not settled at start");
    for (var i = 0; i < 600; i = i + 1) { s.step(dt); }
    assert_eq(s.is_settled(), 1, "settled");

    test_group("spring_snap");
    s = ImSpring_new(0.0, 100.0, 300.0, 15.0);
    s.snap();
    p = s.position();
    var v: f64 = s.velocity();
    assert(p == 100.0, "position 100");
    assert(v == 0.0, "velocity 0");
    assert_eq(s.is_settled(), 1, "settled");

    test_group("spring_set_target");
    s = ImSpring_new(0.0, 100.0, 300.0, 15.0);
    s.set_target(200.0);
    var t: f64 = s.target();
    assert(t == 200.0, "target 200");
    for (var i = 0; i < 600; i = i + 1) { s.step(dt); }
    p = s.position();
    d = dist(p, 200.0);
    assert(d < 0.1, "within 0.1 of 200");

    test_group("spring_fling");
    s = ImSpring_new(50.0, 50.0, 300.0, 15.0);
    s.add_velocity(500.0);
    s.step(dt);
    p = s.position();
    assert(p > 50.0, "moved from the fling");

    test_group("spring_2d_moves");
    var s2: ImSpring2d = ImSpring2d_new(ImVec2_new(0.0, 0.0), ImVec2_new(100.0, 200.0), 300.0, 20.0);
    for (var i = 0; i < 600; i = i + 1) { s2.step(dt); }
    var p2: ImVec2 = s2.position();
    var px: f64 = p2.x;
    var py: f64 = p2.y;
    d = dist(px, 100.0);
    assert(d < 0.1, "x within 0.1 of 100");
    d = dist(py, 200.0);
    assert(d < 0.1, "y within 0.1 of 200");
    assert_eq(s2.is_settled(), 1, "settled");

    test_group("spring_2d_snap");
    s2 = ImSpring2d_new(ImVec2_new(0.0, 0.0), ImVec2_new(50.0, 75.0), 300.0, 20.0);
    s2.snap();
    p2 = s2.position();
    px = p2.x;
    py = p2.y;
    assert(px == 50.0 && py == 75.0, "at (50, 75)");

    test_group("spring_3d_moves");
    var s3: ImSpring3d = ImSpring3d_new(ImVec3_zero(), ImVec3_new(10.0, 20.0, 30.0), 300.0, 20.0);
    for (var i = 0; i < 600; i = i + 1) { s3.step(dt); }
    var p3: ImVec3 = s3.position();
    px = p3.x;
    py = p3.y;
    var pz: f64 = p3.z;
    d = dist(px, 10.0);
    assert(d < 0.1, "x within 0.1 of 10");
    d = dist(py, 20.0);
    assert(d < 0.1, "y within 0.1 of 20");
    d = dist(pz, 30.0);
    assert(d < 0.1, "z within 0.1 of 30");

    test_group("spring_3d_set_target");
    s3 = ImSpring3d_new(ImVec3_zero(), ImVec3_zero(), 300.0, 20.0);
    s3.set_target(ImVec3_new(5.0, 10.0, 15.0));
    for (var i = 0; i < 600; i = i + 1) { s3.step(dt); }
    assert_eq(s3.is_settled(), 1, "settled");

    test_group("spring_stiffness_damping_accessors");
    s = ImSpring_new(0.0, 100.0, 300.0, 15.0);
    var k: f64 = s.stiffness();
    var c: f64 = s.damping();
    assert(k == 300.0 && c == 15.0, "300, 15");
    s.set_stiffness(500.0);
    s.set_damping(25.0);
    k = s.stiffness();
    c = s.damping();
    assert(k == 500.0 && c == 25.0, "500, 25");

    test_group("step_is_stable_for_large_dt_and_stiffness");
    s = ImSpring_critically_damped(0.0, 100.0, 300.0);
    s.step(0.5);
    p = s.position();
    assert(p <= 100.000000001 && p > 99.0, "a 0.5 s hitch stays in (99, 100]");
    s = ImSpring_critically_damped(0.0, 100.0, 2500.0);
    var bounded = 1;
    for (var i = 0; i < 120; i = i + 1) {
        s.step(dt);
        p = s.position();
        var ap: f64 = f64_abs(p);
        if (ap >= 101.0) { bounded = 0; }
    }
    assert_eq(bounded, 1, "stiff spring at 60 fps stays bounded");
    assert_eq(s.is_settled(), 1, "and settles");

    test_group("step_is_exact_regardless_of_step_count");
    var ks = fl_alloc(32);
    var cs = fl_alloc(32);
    var kv: f64 = 300.0;
    store64(ks, kv);
    kv = 400.0;
    store64(ks + 8, kv);
    kv = 100.0;
    store64(ks + 16, kv);
    kv = 0.0;
    store64(ks + 24, kv);
    var cv: f64 = 15.0;
    store64(cs, cv);
    cv = 40.0;
    store64(cs + 8, cv);
    cv = 60.0;
    store64(cs + 16, cv);
    cv = 5.0;
    store64(cs + 24, cv);
    for (var j = 0; j < 4; j = j + 1) {
        k = load64(ks + j * 8);
        c = load64(cs + j * 8);
        var one: ImSpring = ImSpring_new(0.0, 10.0, k, c);
        one.set_velocity(3.0);
        var many: ImSpring = one;
        one.step(0.8);
        for (var i = 0; i < 800; i = i + 1) { many.step(0.001); }
        var op: f64 = one.position();
        var mp: f64 = many.position();
        var ov: f64 = one.velocity();
        var mv: f64 = many.velocity();
        d = dist(op, mp);
        assert(d < 0.000000001, "position: one step = 800 steps");
        d = dist(ov, mv);
        assert(d < 0.000000001, "velocity: one step = 800 steps");
    }
    fl_free(ks);
    fl_free(cs);

    test_group("bad_dt_is_ignored");
    s = ImSpring_new(0.0, 1.0, 100.0, 10.0);
    var zero: f64 = 0.0;
    var nan: f64 = zero / zero;
    s.step(0.0);
    p = s.position();
    assert(p == 0.0, "dt 0");
    s.step(-1.0);
    p = s.position();
    assert(p == 0.0, "dt -1");
    s.step(nan);
    p = s.position();
    assert(p == 0.0, "dt NaN");
    var inf: f64 = 1.0 / zero;
    s.step(inf);
    p = s.position();
    assert(p == 1.0, "dt ∞ snaps");

    test_group("spring_serde");
    s = ImSpring_new(10.0, 90.0, 200.0, 12.0);
    var sb = str_builder_new();
    s.to_json(sb);
    var txt = str_builder_build(sb);
    var expect = str_builder_new();
    str_builder_add_cstr(expect, "{\"position\":10.0,\"velocity\":0.0,\"target\":90.0,");
    str_builder_add_cstr(expect, "\"stiffness\":200.0,\"damping\":12.0,\"settle_threshold\":0.01}");
    assert_eq(str_eq(txt, str_builder_build(expect)), 1, "serde_json's document");
    var back: ImSpring = ImSpring_new(0.0, 0.0, 0.0, 0.0);
    var tag, val = ImSpring_from_json(str_data(txt), str_len(txt), &back);
    assert(is_err_result(tag) == 0, "reads back");
    assert_eq(back.eq(&s), 1, "back == spring");
    assert_eq(back.cache_valid, 0, "the cache is not serialized");

    # Cyrius-only from here.
    test_group("transition_cache");
    s = ImSpring_new(0.0, 1.0, 100.0, 10.0);
    assert_eq(s.cache_valid, 0, "no cache yet");
    s.step(dt);
    assert_eq(s.cache_valid, 1, "cached");
    var m0: f64 = s.m0;
    s.step(dt);
    var m0b: f64 = s.m0;
    assert(m0 == m0b, "same key, same matrix");
    s.set_damping(30.0);
    s.step(dt);
    var cc: f64 = s.cache_c;
    assert(cc == 30.0, "a new damping re-keys the cache");
    var other: ImSpring = ImSpring_new(0.0, 1.0, 100.0, 10.0);
    assert_eq(other.eq(&s), 0, "positions differ");
    other = s;
    other.cache_valid = 0;
    assert_eq(other.eq(&s), 1, "equality ignores the cache");

    test_group("damping_regimes");
    # k = 100: critical damping is c = 20 (|disc| ≤ 1e-9·scale), under below it, over above it.
    s = ImSpring_new(0.0, 1.0, 100.0, 20.0);
    s.step(0.1);
    var crit: f64 = s.m1;
    var e: f64 = _im_exp(-1.0);
    var want: f64 = e * 0.1;
    assert(crit == want, "critical branch: m01 = e^(-α·dt)·dt");
    s = ImSpring_new(0.0, 1.0, 100.0, 19.0);
    s.step(0.1);
    var under: f64 = s.m1;
    s = ImSpring_new(0.0, 1.0, 100.0, 21.0);
    s.step(0.1);
    var over: f64 = s.m1;
    assert(under > crit && crit > over, "m01 falls with damping across the regimes");
    s = ImSpring_new(0.0, 1.0, 0.0, 0.0);
    s.set_velocity(2.0);
    s.step(0.5);
    p = s.position();
    assert(p == 1.0, "k = c = 0: free motion, 0 + 2·0.5");

    # rust-old/README.md's Spring Animation, a doc test (lib.rs takes the README as the crate's docs).
    test_group("doc_readme_spring_animation");
    var ui: ImSpring2d = ImSpring2d_critically_damped(ImVec2_new(0.0, 0.0), ImVec2_new(500.0, 300.0), 400.0);
    ui.step(1.0 / 60.0);
    var uip: ImVec2 = ui.position();
    var uix: f64 = uip.x;
    var uiy: f64 = uip.y;
    assert(uix > 0.0 && uix < 500.0 && uiy > 0.0 && uiy < 300.0, "a frame moves it toward the target");

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
