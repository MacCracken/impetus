# parity_types.cyr — token helpers for the shared types, used by tests/parity_2d.tcyr and tests/parity_3d.tcyr.
#
# Moved out of parity_2d.tcyr when the 3D harness needed them (M4): `Option::None` and enum tokens, materials,
# vectors, body and collider descriptors and states, shapes, joint types and descriptors, events, contact data, ray
# hits and point queries, flattened as scripts/oracle/src/flat.rs writes them (a handle as `i:` of its word, a payload
# enum as its variant then the variant's fields, a Vec as `v:<len>` then its elements). Include it after
# tests/parity_core.cyr and a profile's module list.

# 1 if input token k is `n:` (Option::None).
#must_use
fn _par_in_is_none(k): i64 {
    if (load64(_par_in_k + k * 8) == 110) { return 1; }
    return 0;
}

# 1 if input token k's text, after its `prefix` ("PhysicsUnit."), equals `name`.
#must_use
fn _par_in_enum_is(k, prefix, name): i64 {
    var p = load64(_par_in_v + k * 8);
    var l = load64(_par_in_l + k * 8);
    var pl = strlen(prefix);
    if (l <= pl) { return 0; }
    if (_par_eq(p, pl, prefix) != 1) { return 0; }
    return _par_eq(p + pl, l - pl, name);
}

# Input token k as an enum value: the first v in [0, n) whose name (`name_fn(v)`) matches, or -1.
#must_use
fn _par_in_enum(k, prefix, name_fn, n): i64 {
    for (var v = 0; v < n; v = v + 1) {
        if (_par_in_enum_is(k, prefix, fncall1(name_fn, v)) == 1) { return v; }
    }
    return 0 - 1;
}

# Appends an enum output, `prefix` + `name` ("CombineRule." + "Average"), to the got list.
fn _par_got_enum(prefix, name) {
    var pl = strlen(prefix);
    var nl = strlen(name);
    var t = alloc(pl + nl + 1);
    memcpy(t, prefix, pl);
    memcpy(t + pl, name, nl);
    store8(t + pl + nl, 0);
    _par_got_e(t);
    return 0;
}

fn _par_in_material(k): ImPhysicsMaterial {
    var m: ImPhysicsMaterial = ImPhysicsMaterial_default();
    var fr: f64 = _par_in(k);
    var re: f64 = _par_in(k + 1);
    var de: f64 = _par_in(k + 2);
    var sf: f64 = _par_in(k + 3);
    var ro: f64 = _par_in(k + 4);
    m.friction = fr;
    m.restitution = re;
    m.density = de;
    m.has_static_friction = 1 - _par_in_is_none(k + 3);
    m.static_friction = 0.0;
    if (m.has_static_friction == 1) { m.static_friction = sf; }
    m.rolling_friction = ro;
    m.friction_combine = _par_in_enum(k + 5, "CombineRule.", &combine_rule_name, 4);
    m.restitution_combine = _par_in_enum(k + 6, "CombineRule.", &combine_rule_name, 4);
    return m;
}

fn _par_got_material(m: ImPhysicsMaterial) {
    var fr: f64 = m.friction;
    var re: f64 = m.restitution;
    var de: f64 = m.density;
    var sf: f64 = m.static_friction;
    var ro: f64 = m.rolling_friction;
    _par_got_f(fr);
    _par_got_f(re);
    _par_got_f(de);
    if (m.has_static_friction == 1) { _par_got_f(sf); } else { _par_got_none(); }
    _par_got_f(ro);
    _par_got_enum("CombineRule.", combine_rule_name(m.friction_combine));
    _par_got_enum("CombineRule.", combine_rule_name(m.restitution_combine));
    return 0;
}

# Input tokens k..k+2 as an ImVec3.
fn _par_in_v3(k): ImVec3 {
    var x: f64 = _par_in(k);
    var y: f64 = _par_in(k + 1);
    var z: f64 = _par_in(k + 2);
    return ImVec3_new(x, y, z);
}

# Input tokens k, k+1 as an ImVec2.
fn _par_in_v2(k): ImVec2 {
    var x: f64 = _par_in(k);
    var y: f64 = _par_in(k + 1);
    return ImVec2_new(x, y);
}

# Appends an ImVec3's three floats.
fn _par_got_v3(v: ImVec3) {
    var x: f64 = v.x;
    var y: f64 = v.y;
    var z: f64 = v.z;
    _par_got_f(x);
    _par_got_f(y);
    _par_got_f(z);
    return 0;
}

# Appends an ImVec2's two floats.
fn _par_got_v2(v: ImVec2) {
    var x: f64 = v.x;
    var y: f64 = v.y;
    _par_got_f(x);
    _par_got_f(y);
    return 0;
}

# Appends an `Option<f64>`: the float, or `n:`.
fn _par_got_opt_f(has, x: f64) {
    if (has == 1) { _par_got_f(x); } else { _par_got_none(); }
    return 0;
}

fn _par_in_body_desc(k): ImBodyDesc {
    var d: ImBodyDesc = ImBodyDesc_default();
    d.body_type = _par_in_enum(k, "BodyType.", &body_type_name, 3);
    d.position = _par_in_v3(k + 1);
    var rot: f64 = _par_in(k + 4);
    d.rotation = rot;
    d.linear_velocity = _par_in_v3(k + 5);
    var av: f64 = _par_in(k + 8);
    var ld: f64 = _par_in(k + 9);
    var ad: f64 = _par_in(k + 10);
    d.angular_velocity = av;
    d.linear_damping = ld;
    d.angular_damping = ad;
    d.fixed_rotation = _par_in(k + 11);
    if (_par_in_is_none(k + 12) == 0) {
        var gs: f64 = _par_in(k + 12);
        d.has_gravity_scale = 1;
        d.gravity_scale = gs;
    }
    return d;
}

fn _par_got_body_desc(d: ImBodyDesc) {
    var rot: f64 = d.rotation;
    var av: f64 = d.angular_velocity;
    var ld: f64 = d.linear_damping;
    var ad: f64 = d.angular_damping;
    var gs: f64 = d.gravity_scale;
    _par_got_enum("BodyType.", body_type_name(d.body_type));
    _par_got_v3(d.position);
    _par_got_f(rot);
    _par_got_v3(d.linear_velocity);
    _par_got_f(av);
    _par_got_f(ld);
    _par_got_f(ad);
    _par_got_i(d.fixed_rotation);
    _par_got_opt_f(d.has_gravity_scale, gs);
    return 0;
}

fn _par_in_body_state(k): ImBodyState {
    var s: ImBodyState;
    s.handle = _par_in(k);
    s.body_type = _par_in_enum(k + 1, "BodyType.", &body_type_name, 3);
    s.position = _par_in_v3(k + 2);
    var rot: f64 = _par_in(k + 5);
    s.rotation = rot;
    s.linear_velocity = _par_in_v3(k + 6);
    var av: f64 = _par_in(k + 9);
    s.angular_velocity = av;
    s.is_sleeping = _par_in(k + 10);
    return s;
}

fn _par_got_body_state(s: ImBodyState) {
    var rot: f64 = s.rotation;
    var av: f64 = s.angular_velocity;
    _par_got_i(s.handle);
    _par_got_enum("BodyType.", body_type_name(s.body_type));
    _par_got_v3(s.position);
    _par_got_f(rot);
    _par_got_v3(s.linear_velocity);
    _par_got_f(av);
    _par_got_i(s.is_sleeping);
    return 0;
}

# A freelist copy of the n input words from token k (0 when n is 0).
fn _par_in_words(k, n): i64 {
    if (n <= 0) { return 0; }
    var p = fl_alloc(n * 8);
    for (var j = 0; j < n; j = j + 1) { store64(p + j * 8, _par_in(k + j)); }
    return p;
}

# The shape at token k into *out (its arrays on freelist); returns the token after it.
fn _par_in_shape(k, out: *ImColliderShape): i64 {
    var kind = _par_in_enum(k, "ColliderShape.", &shape_kind_name, 7);
    var s: ImColliderShape = _im_shape(kind);
    var next = k + 1;
    if (kind == IM_SHAPE_BOX) {
        s.half_extents = _par_in_v3(k + 1);
        next = k + 4;
    } elif (kind == IM_SHAPE_BALL) {
        var r: f64 = _par_in(k + 1);
        s.radius = r;
        next = k + 2;
    } elif (kind == IM_SHAPE_CAPSULE) {
        var hh: f64 = _par_in(k + 1);
        var cr: f64 = _par_in(k + 2);
        s.half_height = hh;
        s.radius = cr;
        next = k + 3;
    } elif (kind == IM_SHAPE_CONVEX_HULL) {
        var n = _par_in(k + 1);
        var w = _par_in_words(k + 2, n * 3);
        s = ImColliderShape_convex_hull(w, n);
        if (w != 0) { fl_free(w); }
        next = k + 2 + n * 3;
    } elif (kind == IM_SHAPE_TRI_MESH) {
        var nv = _par_in(k + 1);
        var vw = _par_in_words(k + 2, nv * 3);
        var ki = k + 2 + nv * 3;
        var ni = _par_in(ki);
        var iw = _par_in_words(ki + 1, ni * 3);
        s = ImColliderShape_tri_mesh(vw, nv, iw, ni);
        if (vw != 0) { fl_free(vw); }
        if (iw != 0) { fl_free(iw); }
        next = ki + 1 + ni * 3;
    } elif (kind == IM_SHAPE_HEIGHTFIELD) {
        var nh = _par_in(k + 1);
        var hw = _par_in_words(k + 2, nh);
        s = ImColliderShape_heightfield(hw, nh, _par_in_v3(k + 2 + nh));
        if (hw != 0) { fl_free(hw); }
        next = k + 5 + nh;
    } elif (kind == IM_SHAPE_SEGMENT) {
        s.a = _par_in_v3(k + 1);
        s.b = _par_in_v3(k + 4);
        next = k + 7;
    }
    memcpy(out, &s, sizeof(ImColliderShape));
    return next;
}

# Appends the n words at p as f64 outputs.
fn _par_got_fwords(p, n) {
    for (var j = 0; j < n; j = j + 1) { _par_got_f(load64(p + j * 8)); }
    return 0;
}

fn _par_got_shape(s: ImColliderShape) {
    var k = s.kind;
    _par_got_enum("ColliderShape.", shape_kind_name(k));
    if (k == IM_SHAPE_BOX) {
        _par_got_v3(s.half_extents);
    } elif (k == IM_SHAPE_BALL) {
        var r: f64 = s.radius;
        _par_got_f(r);
    } elif (k == IM_SHAPE_CAPSULE) {
        var hh: f64 = s.half_height;
        var cr: f64 = s.radius;
        _par_got_f(hh);
        _par_got_f(cr);
    } elif (k == IM_SHAPE_CONVEX_HULL) {
        _par_got_seq(s.point_count);
        _par_got_fwords(s.points, s.point_count * 3);
    } elif (k == IM_SHAPE_TRI_MESH) {
        _par_got_seq(s.vertex_count);
        _par_got_fwords(s.vertices, s.vertex_count * 3);
        _par_got_seq(s.index_count);
        for (var j = 0; j < s.index_count * 3; j = j + 1) { _par_got_i(load64(s.indices + j * 8)); }
    } elif (k == IM_SHAPE_HEIGHTFIELD) {
        _par_got_seq(s.height_count);
        _par_got_fwords(s.heights, s.height_count);
        _par_got_v3(s.scale);
    } elif (k == IM_SHAPE_SEGMENT) {
        _par_got_v3(s.a);
        _par_got_v3(s.b);
    }
    return 0;
}

# The collider descriptor at token k0 into *out (the shape's arrays on freelist); returns the token
# after it.
fn _par_in_collider_desc_at(k0, out: *ImColliderDesc): i64 {
    var sh: ImColliderShape = _im_shape(IM_SHAPE_BALL);
    var k = _par_in_shape(k0, &sh);
    var d: ImColliderDesc = ImColliderDesc_new(sh);
    d.offset = _par_in_v3(k);
    d.material = _par_in_material(k + 3);
    d.is_sensor = _par_in(k + 10);
    if (_par_in_is_none(k + 11) == 0) {
        var ms: f64 = _par_in(k + 11);
        d.has_mass = 1;
        d.mass = ms;
    }
    d.collision_layer = _par_in(k + 12);
    d.collision_mask = _par_in(k + 13);
    memcpy(out, &d, sizeof(ImColliderDesc));
    return k + 14;
}

# The collider descriptor at token 0 into *out.
fn _par_in_collider_desc(out: *ImColliderDesc) {
    _par_in_collider_desc_at(0, out);
    return 0;
}

fn _par_got_collider_desc(d: ImColliderDesc) {
    var ms: f64 = d.mass;
    _par_got_shape(d.shape);
    _par_got_v3(d.offset);
    _par_got_material(d.material);
    _par_got_i(d.is_sensor);
    _par_got_opt_f(d.has_mass, ms);
    _par_got_i(d.collision_layer);
    _par_got_i(d.collision_mask);
    return 0;
}

# The joint type at token k into *out; returns the token after it.
fn _par_in_joint_type(k, out: *ImJointType): i64 {
    var kind = _par_in_enum(k, "JointType.", &joint_kind_name, 8);
    var j: ImJointType = _im_joint(kind);
    var next = k + 1;
    if (kind == IM_JOINT_REVOLUTE || kind == IM_JOINT_PRISMATIC) {
        var v: ImVec2 = _par_in_v2(k + 1);
        if (kind == IM_JOINT_REVOLUTE) { j.anchor = v; } else { j.axis = v; }
        if (_par_in_is_none(k + 3) == 1) {
            next = k + 4;
        } else {
            j.has_limits = 1;
            j.limits = _par_in_v2(k + 3);
            next = k + 5;
        }
    } elif (kind == IM_JOINT_SPRING) {
        var rl: f64 = _par_in(k + 1);
        var st: f64 = _par_in(k + 2);
        var dm: f64 = _par_in(k + 3);
        j.rest_length = rl;
        j.stiffness = st;
        j.damping = dm;
        next = k + 4;
    } elif (kind == IM_JOINT_DISTANCE) {
        var ln: f64 = _par_in(k + 1);
        j.length = ln;
        next = k + 2;
    } elif (kind == IM_JOINT_WHEEL) {
        j.axis = _par_in_v2(k + 1);
        var ws: f64 = _par_in(k + 3);
        var wd: f64 = _par_in(k + 4);
        j.stiffness = ws;
        j.damping = wd;
        next = k + 5;
    } elif (kind == IM_JOINT_ROPE) {
        var ml: f64 = _par_in(k + 1);
        j.max_length = ml;
        next = k + 2;
    } elif (kind == IM_JOINT_MOUSE) {
        j.target = _par_in_v3(k + 1);
        var ms: f64 = _par_in(k + 4);
        var md: f64 = _par_in(k + 5);
        var mf: f64 = _par_in(k + 6);
        j.stiffness = ms;
        j.damping = md;
        j.max_force = mf;
        next = k + 7;
    }
    memcpy(out, &j, sizeof(ImJointType));
    return next;
}

fn _par_got_joint_type(j: ImJointType) {
    var k = j.kind;
    var st: f64 = j.stiffness;
    var dm: f64 = j.damping;
    _par_got_enum("JointType.", joint_kind_name(k));
    if (k == IM_JOINT_REVOLUTE || k == IM_JOINT_PRISMATIC) {
        if (k == IM_JOINT_REVOLUTE) { _par_got_v2(j.anchor); } else { _par_got_v2(j.axis); }
        if (j.has_limits == 1) { _par_got_v2(j.limits); } else { _par_got_none(); }
    } elif (k == IM_JOINT_SPRING) {
        var rl: f64 = j.rest_length;
        _par_got_f(rl);
        _par_got_f(st);
        _par_got_f(dm);
    } elif (k == IM_JOINT_DISTANCE) {
        var ln: f64 = j.length;
        _par_got_f(ln);
    } elif (k == IM_JOINT_WHEEL) {
        _par_got_v2(j.axis);
        _par_got_f(st);
        _par_got_f(dm);
    } elif (k == IM_JOINT_ROPE) {
        var ml: f64 = j.max_length;
        _par_got_f(ml);
    } elif (k == IM_JOINT_MOUSE) {
        var mf: f64 = j.max_force;
        _par_got_v3(j.target);
        _par_got_f(st);
        _par_got_f(dm);
        _par_got_f(mf);
    }
    return 0;
}

# The joint descriptor at token k0 into *out; returns the token after it.
fn _par_in_joint_desc_at(k0, out: *ImJointDesc): i64 {
    var jt: ImJointType = ImJointType_fixed();
    var k = _par_in_joint_type(k0 + 2, &jt);
    var d: ImJointDesc = ImJointDesc_new(_par_in(k0), _par_in(k0 + 1), jt, _par_in_v2(k), _par_in_v2(k + 2));
    var next = k + 4;
    if (_par_in_is_none(next) == 1) {
        next = next + 1;
    } else {
        var tv: f64 = _par_in(next);
        var mf: f64 = _par_in(next + 1);
        d.has_motor = 1;
        d.motor = ImJointMotor_new(tv, mf);
        next = next + 2;
    }
    var dm: f64 = _par_in(next);
    d.damping = dm;
    if (_par_in_is_none(next + 1) == 0) {
        var bf: f64 = _par_in(next + 1);
        d.has_break_force = 1;
        d.break_force = bf;
    }
    memcpy(out, &d, sizeof(ImJointDesc));
    return next + 2;
}

fn _par_in_joint_desc(): ImJointDesc {
    var d: ImJointDesc = ImJointDesc_new(0, 0, ImJointType_fixed(), ImVec2_new(0.0, 0.0), ImVec2_new(0.0, 0.0));
    _par_in_joint_desc_at(0, &d);
    return d;
}

fn _par_got_joint_desc(d: ImJointDesc) {
    var dm: f64 = d.damping;
    var bf: f64 = d.break_force;
    _par_got_i(d.body_a);
    _par_got_i(d.body_b);
    _par_got_joint_type(d.joint_type);
    _par_got_v2(d.local_anchor_a);
    _par_got_v2(d.local_anchor_b);
    if (d.has_motor == 1) {
        var tv: f64 = d.motor.target_velocity;
        var mf: f64 = d.motor.max_force;
        _par_got_f(tv);
        _par_got_f(mf);
    } else {
        _par_got_none();
    }
    _par_got_f(dm);
    _par_got_opt_f(d.has_break_force, bf);
    return 0;
}

fn _par_got_event(e: ImCollisionEvent) {
    _par_got_enum("CollisionEvent.", event_kind_name(e.kind));
    _par_got_i(e.collider_a);
    _par_got_i(e.collider_b);
    return 0;
}

fn _par_in_contact_point(k): ImContactPoint {
    var p: ImContactPoint;
    p.local_a = _par_in_v3(k);
    p.local_b = _par_in_v3(k + 3);
    var im: f64 = _par_in(k + 6);
    p.impulse = im;
    return p;
}

fn _par_got_contact_point(p: ImContactPoint) {
    var im: f64 = p.impulse;
    _par_got_v3(p.local_a);
    _par_got_v3(p.local_b);
    _par_got_f(im);
    return 0;
}

# The contact data at token 0 into *out (its points on freelist).
fn _par_in_contact_data(out: *ImContactData) {
    var c: ImContactData;
    c.collider_a = _par_in(0);
    c.collider_b = _par_in(1);
    c.normal = _par_in_v3(2);
    var dp: f64 = _par_in(5);
    c.depth = dp;
    var n = _par_in(6);
    c.point_count = n;
    c.points = 0;
    if (n > 0) { c.points = fl_alloc(n * sizeof(ImContactPoint)); }
    for (var j = 0; j < n; j = j + 1) {
        var p: ImContactPoint = _par_in_contact_point(7 + j * 7);
        memcpy(c.points + j * sizeof(ImContactPoint), &p, sizeof(ImContactPoint));
    }
    memcpy(out, &c, sizeof(ImContactData));
    return 0;
}

fn _par_got_contact_data(c: ImContactData) {
    var dp: f64 = c.depth;
    _par_got_i(c.collider_a);
    _par_got_i(c.collider_b);
    _par_got_v3(c.normal);
    _par_got_f(dp);
    _par_got_seq(c.point_count);
    for (var j = 0; j < c.point_count; j = j + 1) {
        var p: ImContactPoint;
        memcpy(&p, c.points + j * sizeof(ImContactPoint), sizeof(ImContactPoint));
        _par_got_contact_point(p);
    }
    return 0;
}

fn _par_got_ray_hit(h: ImRayHit) {
    var d: f64 = h.distance;
    _par_got_i(h.collider);
    _par_got_v3(h.point);
    _par_got_v3(h.normal);
    _par_got_f(d);
    return 0;
}

fn _par_got_point_query(q: ImPointQuery) {
    var d: f64 = q.distance;
    _par_got_i(q.collider);
    _par_got_f(d);
    _par_got_i(q.is_inside);
    return 0;
}

# ── the backend states' scripts and dumps (shared by b2_state and b3_state) ─────────────

# The op names of a state script, `e:Op.<Name>`.
fn _par_op_name(i): i64 {
    if (i == 0) { return "AddBody"; }
    if (i == 1) { return "AddCollider"; }
    if (i == 2) { return "AddJoint"; }
    if (i == 3) { return "ApplyForce"; }
    if (i == 4) { return "ApplyImpulse"; }
    if (i == 5) { return "ApplyTorque"; }
    if (i == 6) { return "RemoveBody"; }
    if (i == 7) { return "RemoveCollider"; }
    if (i == 8) { return "RemoveJoint"; }
    if (i == 9) { return "GetBodyState"; }
    if (i == 10) { return "SetBodyState"; }
    if (i == 11) { return "SetBodyType"; }
    if (i == 12) { return "BodyCount"; }
    return "Unknown";
}

# A vector and an optional point (`n:` or three floats) at token k into v, *has and p; the token after.
fn _par_in_vec_point(k, v: *ImVec3, has, p: *ImVec3): i64 {
    var x: ImVec3 = _par_in_v3(k);
    memcpy(v, &x, sizeof(ImVec3));
    if (_par_in_is_none(k + 3) == 1) {
        store64(has, 0);
        return k + 4;
    }
    store64(has, 1);
    var q: ImVec3 = _par_in_v3(k + 3);
    memcpy(p, &q, sizeof(ImVec3));
    return k + 6;
}

# An optional u32 word (-1 for none).
fn _par_got_opt_i(x) {
    if (x == 0 - 1) { _par_got_none(); } else { _par_got_i(x); }
    return 0;
}

# An arena's slots, free-list head and staleness, as `ArenaDump`.
fn _par_got_arena(ar: *ImArena) {
    _par_got_seq(ar.slot_count());
    for (var i = 0; i < ar.slot_count(); i = i + 1) {
        var m = ar._meta(i);
        _par_got_i(load64(m));
        _par_got_i(load64(m + 8));
        _par_got_opt_i(load64(m + 16));
    }
    _par_got_opt_i(ar.free_head);
    _par_got_i(ar.free_list_stale);
    return 0;
}

fn _par_got_pairlist(pl: *ImPairList) {
    _par_got_seq(pl.len);
    for (var i = 0; i < pl.len; i = i + 1) {
        _par_got_i(pl.first(i));
        _par_got_i(pl.second(i));
    }
    return 0;
}

# 0 for Ok, else the error token.
fn _par_got_unit(t, v) {
    if (is_ok(t) == 1) { _par_got_i(0); } else { _par_got_err(v); }
    return 0;
}

# ── configs and dumps (the b2 and b3 step rows) ──────────────────────────────────────

# The world config at token k: flat::config's 16 tokens.
fn _par_in_config(k): ImWorldConfig {
    var c: ImWorldConfig = ImWorldConfig_default();
    var ts: f64 = _par_in(k);
    var gx: f64 = _par_in(k + 1);
    var gy: f64 = _par_in(k + 2);
    var gz: f64 = _par_in(k + 3);
    var slop: f64 = _par_in(k + 8);
    var corr: f64 = _par_in(k + 9);
    var mv: f64 = _par_in(k + 10);
    var fq: f64 = _par_in(k + 12);
    var dr: f64 = _par_in(k + 13);
    c.timestep = ts;
    c.gravity = ImVec3_new(gx, gy, gz);
    c.velocity_iterations = _par_in(k + 4);
    c.position_iterations = _par_in(k + 5);
    c.deterministic = _par_in(k + 6);
    c.step = _par_in(k + 7);
    c.position_slop = slop;
    c.position_correction = corr;
    c.max_velocity = mv;
    c.sub_steps = _par_in(k + 11);
    c.constraint_frequency = fq;
    c.constraint_damping_ratio = dr;
    c.broadphase = _par_in_enum(k + 14, "BroadphaseKind.", &broadphase_kind_name, 2);
    c.solver = _par_in_enum(k + 15, "SolverKind.", &solver_kind_name, 2);
    return c;
}

# An arena's dumped slots at token k into ar: the token after them.
fn _par_load_arena(ar: *ImArena, k): i64 {
    var n = _par_in(k);
    if (ar._reserve(n) == 0) { return 0 - 1; }
    ar.count = n;
    ar.len = 0;
    for (var i = 0; i < n; i = i + 1) {
        var m = ar._meta(i);
        var occ = _par_in(k + 1 + i * 3);
        store64(m, occ);
        store64(m + 8, _par_in(k + 2 + i * 3));
        var nx = 0 - 1;
        if (_par_in_is_none(k + 3 + i * 3) == 0) { nx = _par_in(k + 3 + i * 3); }
        store64(m + 16, nx);
        if (occ == 1) { ar.len = ar.len + 1; }
    }
    var j = k + 1 + n * 3;
    ar.free_head = 0 - 1;
    if (_par_in_is_none(j) == 0) { ar.free_head = _par_in(j); }
    ar.free_list_stale = _par_in(j + 1);
    return j + 2;
}

# The record slot of handle h in arena ar.
fn _par_slot(ar: *ImArena, h): i64 {
    return ar.values + _im_handle_index(h) * ar.elem_size;
}

# A dumped pair list at token k pushed onto pl: the token after it.
fn _par_load_pairs(pl: *ImPairList, k): i64 {
    var n = _par_in(k);
    for (var i = 0; i < n; i = i + 1) { pl.push(_par_in(k + 1 + i * 2), _par_in(k + 2 + i * 2)); }
    return k + 1 + n * 2;
}

# The config's tokens (flat::config's 16), as `_par_in_config` reads them.
fn _par_got_config(c: ImWorldConfig) {
    var ts: f64 = c.timestep;
    var gx: f64 = c.gravity.x;
    var gy: f64 = c.gravity.y;
    var gz: f64 = c.gravity.z;
    var slop: f64 = c.position_slop;
    var corr: f64 = c.position_correction;
    var mv: f64 = c.max_velocity;
    var fq: f64 = c.constraint_frequency;
    var dr: f64 = c.constraint_damping_ratio;
    _par_got_f(ts);
    _par_got_f(gx);
    _par_got_f(gy);
    _par_got_f(gz);
    _par_got_i(c.velocity_iterations);
    _par_got_i(c.position_iterations);
    _par_got_i(c.deterministic);
    _par_got_i(c.step);
    _par_got_f(slop);
    _par_got_f(corr);
    _par_got_f(mv);
    _par_got_i(c.sub_steps);
    _par_got_f(fq);
    _par_got_f(dr);
    _par_got_enum("BroadphaseKind.", broadphase_kind_name(c.broadphase));
    _par_got_enum("SolverKind.", solver_kind_name(c.solver));
    return 0;
}

# ── the world's own state (world_step, b3_world) ──

# Input token k as an f64 (for an f64 argument).
fn _par_in_f(k): f64 {
    var x: f64 = _par_in(k);
    return x;
}

# A particle at token k (flat::particle's layout) into *p: the token after it.
fn _par_in_particle(k, p: *ImParticle): i64 {
    var q: ImParticle = ImParticle_new(_par_in_v3(k + 1), _par_in_v3(k + 4), _par_in_f(k + 7));
    q.handle = _par_in(k);
    q.radius = _par_in_f(k + 8);
    q.drag = _par_in_f(k + 9);
    q.restitution = _par_in_f(k + 10);
    q.gravity_scale = _par_in_f(k + 11);
    q.damping = _par_in_f(k + 12);
    var next = k + 14;
    if (_par_in_is_none(k + 13) == 0) {
        q.has_on_death_emit = 1;
        q.on_death_emit = ImSubEmitter_new(_par_in(k + 13), _par_in_f(k + 14), _par_in_f(k + 15), _par_in_f(k + 16),
          _par_in_f(k + 17), _par_in_f(k + 18));
        next = k + 19;
    }
    memcpy(p, &q, sizeof(ImParticle));
    return next;
}

# An emitter at token k (flat::emitter's layout) into *e: the token after it.
fn _par_in_emitter(k, e: *ImParticleEmitter): i64 {
    var m: ImParticleEmitter = ImParticleEmitter_new(_par_in_v3(k + 1), _par_in_v3(k + 4), _par_in_f(k + 10));
    m.handle = _par_in(k);
    m.velocity_spread = _par_in_v3(k + 7);
    m.particle_lifetime = _par_in_f(k + 11);
    m.particle_radius = _par_in_f(k + 12);
    m.particle_restitution = _par_in_f(k + 13);
    m.particle_gravity_scale = _par_in_f(k + 14);
    m.particle_damping = _par_in_f(k + 15);
    m.active = _par_in(k + 16);
    m.accumulator = _par_in_f(k + 17);
    memcpy(e, &m, sizeof(ImParticleEmitter));
    return k + 18;
}

# A force field at token k (flat::force_field's layout) into *f: the token after it.
fn _par_in_force_field(k, f: *ImForceField): i64 {
    var g: ImForceField;
    var next = k + 10;
    if (_par_in_enum_is(k, "ForceField.", "Radial") == 1) {
        g = ImForceField_radial(_par_in_v3(k + 1), _par_in_f(k + 4), _par_in_f(k + 5), _par_in_f(k + 6));
        next = k + 7;
    } else {
        g = ImForceField_directional(_par_in_v3(k + 1), _par_in_v3(k + 4), _par_in_v3(k + 7));
    }
    memcpy(f, &g, sizeof(ImForceField));
    return next;
}

# The world's own state at token k into w (fresh): the token after it.
fn _par_load_world(w: *ImPhysicsWorld, k0): i64 {
    var k = k0;
    w.next_particle_id = _par_in(k);
    w.next_emitter_id = _par_in(k + 1);
    k = k + 2;
    var np = _par_in(k);
    k = k + 1;
    var p: ImParticle;
    for (var i = 0; i < np; i = i + 1) {
        k = _par_in_particle(k, &p);
        w.particles.push(&p);
    }
    var ne = _par_in(k);
    k = k + 1;
    var e: ImParticleEmitter;
    for (var j = 0; j < ne; j = j + 1) {
        k = _par_in_emitter(k, &e);
        w.emitters.push(&e);
    }
    var nf = _par_in(k);
    k = k + 1;
    var f: ImForceField;
    for (var q = 0; q < nf; q = q + 1) {
        k = _par_in_force_field(k, &f);
        w.force_fields.push(&f);
    }
    return k;
}

fn _par_got_sub_emitter(s: *ImSubEmitter) {
    _par_got_i(s.count);
    var sa: f64 = s.speed;
    var sb: f64 = s.lifetime;
    var sc: f64 = s.radius;
    var sd: f64 = s.gravity_scale;
    var se: f64 = s.restitution;
    _par_got_f(sa);
    _par_got_f(sb);
    _par_got_f(sc);
    _par_got_f(sd);
    _par_got_f(se);
    return 0;
}

fn _par_got_particle(p: *ImParticle) {
    _par_got_i(p.handle);
    _par_got_v3(p.position);
    _par_got_v3(p.velocity);
    var pa: f64 = p.lifetime;
    var pb: f64 = p.radius;
    var pc: f64 = p.drag;
    var pd: f64 = p.restitution;
    var pe: f64 = p.gravity_scale;
    var pf: f64 = p.damping;
    _par_got_f(pa);
    _par_got_f(pb);
    _par_got_f(pc);
    _par_got_f(pd);
    _par_got_f(pe);
    _par_got_f(pf);
    if (p.has_on_death_emit == 1) { _par_got_sub_emitter(p.on_death_emit); } else { _par_got_none(); }
    return 0;
}

fn _par_got_emitter(e: *ImParticleEmitter) {
    _par_got_i(e.handle);
    _par_got_v3(e.position);
    _par_got_v3(e.velocity);
    _par_got_v3(e.velocity_spread);
    var ea: f64 = e.rate;
    var eb: f64 = e.particle_lifetime;
    var ec: f64 = e.particle_radius;
    var ed: f64 = e.particle_restitution;
    var ee: f64 = e.particle_gravity_scale;
    var ef: f64 = e.particle_damping;
    var eg: f64 = e.accumulator;
    _par_got_f(ea);
    _par_got_f(eb);
    _par_got_f(ec);
    _par_got_f(ed);
    _par_got_f(ee);
    _par_got_f(ef);
    _par_got_i(e.active);
    _par_got_f(eg);
    return 0;
}

fn _par_got_force_field(f: *ImForceField) {
    _par_got_enum("ForceField.", force_field_kind_name(f.kind));
    if (f.kind == IM_FORCE_FIELD_RADIAL) {
        _par_got_v3(f.center);
        var fa: f64 = f.strength;
        var fb: f64 = f.falloff;
        var fc: f64 = f.radius;
        _par_got_f(fa);
        _par_got_f(fb);
        _par_got_f(fc);
    } else {
        _par_got_v3(f.force);
        _par_got_v3(f.min);
        _par_got_v3(f.max);
    }
    return 0;
}

# The world's config and own state (the counters, then the particles, emitters and fields in storage order): the
# tokens before its backend dump.
fn _par_got_world_own(w: *ImPhysicsWorld) {
    _par_got_config(w.config);
    _par_got_i(w.next_particle_id);
    _par_got_i(w.next_emitter_id);
    _par_got_seq(w.particles.len);
    for (var i = 0; i < w.particles.len; i = i + 1) { _par_got_particle(_im_as_particle(w.particles.at(i))); }
    _par_got_seq(w.emitters.len);
    for (var j = 0; j < w.emitters.len; j = j + 1) { _par_got_emitter(_im_as_emitter(w.emitters.at(j))); }
    _par_got_seq(w.force_fields.len);
    for (var q = 0; q < w.force_fields.len; q = q + 1) {
        _par_got_force_field(_im_as_force_field(w.force_fields.at(q)));
    }
    return 0;
}
