# snapshot_cases.cyr — the snapshot tests both profiles run (M6, ADR 0013), as Rust runs its snapshot tests on both
# backends: rust-old/src/serialize.rs's six tests and the three restore tests of rust-old/tests/regressions.rs (two
# `#[ignore]`d in Rust), and the Cyrius-only tests of the binary and JSON forms: byte and JSON round trips, the header's
# refusals, every truncation, every one-word change, seeded corruption behind a recomputed checksum (fuzz_serialize's
# contract), step-equivalence through JSON, refusals, a NaN without a JSON form, and a flat heap. The including file
# includes its profile's module list first and defines `scene(w, k)` (scenes 0 to 4: a ball dropped with a sideways
# velocity on a floor at slot 1, then four scenes of its choosing, scene 1 in contact) and `body(w, t, x, y, rot,
# shape, material)`. Worlds are compared by their bytes, the canonical form; records by untyped address, so both
# profiles run the same code.

# 1 when the n bytes at a and b are equal (n may be 0).
fn same_bytes(a, b, n): i64 {
    if (n == 0) { return 1; }
    return memeq(a, b, n);
}

# Builds scene k in two worlds over cfg, steps the first `before` frames (a force on body 1 every frame when push is
# 1), restores its snapshot into the second (which held another scene), then steps both `after` frames the same way:
# 1 when the restored world matches bit for bit at the restore and every frame after, events included, and both hand
# out the same next handles.
fn lockstep(k, cfg: ImWorldConfig, before, after, push): i64 {
    var a: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var b: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    scene(&a, k);
    scene(&b, (k + 1) % 5);
    var bh = _im_arena_handle(1, 0);
    var f: ImForce = ImForce_new(3.0, 4.0, 0.0);
    for (var i = 0; i < before; i = i + 1) {
        if (push == 1) { a.apply_force(bh, f); }
        a.step();
    }
    var s: ImWorldSnapshot = ImWorldSnapshot_new();
    var ok = 1;
    var t1, v1 = a.snapshot(&s);
    var t2, v2 = b.restore(&s);
    s.free();
    if (is_ok(t1) == 0 || is_ok(t2) == 0 || same_bytes_world(&a, &b) == 0) { ok = 0; }
    for (var j = 0; j < after && ok == 1; j = j + 1) {
        if (push == 1) {
            a.apply_force(bh, f);
            b.apply_force(bh, f);
        }
        a.step();
        b.step();
        var ea, na = a.collision_events();
        var eb, nb = b.collision_events();
        if (na != nb || same_bytes(ea, eb, na * sizeof(ImCollisionEvent)) == 0) { ok = 0; }
        if ((j % 25) == 24 && same_bytes_world(&a, &b) == 0) { ok = 0; }
    }
    if (ok == 1 && same_bytes_world(&a, &b) == 0) { ok = 0; }
    var na1 = a.add_body(ImBodyDesc_default());
    var nb1 = b.add_body(ImBodyDesc_default());
    var tc1, nc1 = a.add_collider(na1, ImColliderDesc_new(ImColliderShape_ball(0.1)));
    var tc2, nc2 = b.add_collider(nb1, ImColliderDesc_new(ImColliderShape_ball(0.1)));
    if (na1 != nb1 || nc1 != nc2) { ok = 0; }
    a.free();
    b.free();
    return ok;
}

# Restores snapshot s into a world holding scene 1 after 20 frames: 1 when it is refused with code `want` and the
# world is unchanged (its bytes the same).
fn refused(s: *ImWorldSnapshot, want): i64 {
    var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    scene(&w, 1);
    for (var i = 0; i < 20; i = i + 1) { w.step(); }
    var before: ImWordList = ImWordList_new();
    world_bytes(&w, &before);
    var t, v = w.restore(s);
    var after: ImWordList = ImWordList_new();
    world_bytes(&w, &after);
    var r = 0;
    if (is_ok(t) == 0 && v == want && before.len == after.len && memeq(before.data, after.data, before.len * 8) == 1) {
        r = 1;
    }
    before.free();
    after.free();
    w.free();
    return r;
}

# A fresh snapshot of scene k after n frames into *out.
fn take(k, n, out: *ImWorldSnapshot) {
    var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    scene(&w, k);
    for (var i = 0; i < n; i = i + 1) { w.step(); }
    w.snapshot(out);
    w.free();
    return 0;
}

# ── the binary form ─────────────────────────────────────────────────────────────────

# A seeded LCG step (Knuth's MMIX constants).
var _lcg = 88172645463325252;
# The next pseudo-random word.
fn lcg(): i64 {
    _lcg = _lcg * 6364136223846793005 + 1442695040888963407;
    return (_lcg >> 17) & 0x7FFFFFFFFFFF;
}

# Rewrites the header's payload length and checksum of the n bytes at b (after an edit to the payload).
fn reseal(b, n) {
    var words = n / 8 - 5;
    store64(b + 24, words);
    store64(b + 32, _im_snap_checksum(b + 40, words));
    return 0;
}

# 1 when deserializing the n bytes at b into a world holding scene 1 is refused and leaves it unchanged. With
# `steps_ok` 1, an accepted snapshot also counts, provided the world then steps three times and serializes again
# (Rust's fuzz_serialize contract).
fn bytes_refused(b, n, steps_ok): i64 {
    var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    scene(&w, 1);
    var before: ImWordList = ImWordList_new();
    world_bytes(&w, &before);
    var t, v = deserialize_world(&w, b, n);
    var r = 0;
    if (is_ok(t) == 0) {
        var after: ImWordList = ImWordList_new();
        world_bytes(&w, &after);
        if (v == IM_ERR_DESERIALIZE || v == IM_ERR_INVALID_CONFIG || v == IM_ERR_UNSUPPORTED) {
            if (before.len == after.len && memeq(before.data, after.data, before.len * 8) == 1) { r = 1; }
        }
        after.free();
    } elif (steps_ok == 1) {
        for (var s = 0; s < 3; s = s + 1) { w.step(); }
        var again: ImWordList = ImWordList_new();
        var ta, va = serialize_world(&w, &again);
        r = is_ok(ta);
        again.free();
    }
    before.free();
    w.free();
    return r;
}

# The bytes of scene k after n frames into *out.
fn scene_bytes(k, n, out: *ImWordList) {
    var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    scene(&w, k);
    for (var i = 0; i < n; i = i + 1) { w.step(); }
    var t, v = serialize_world(&w, out);
    w.free();
    return is_ok(t);
}

# A ball of radius r (Rust's `ColliderDesc`, material m) on a body of type t at (x, y): its handle.
fn rust_ball(w: *ImPhysicsWorld, t, x: f64, y: f64, r: f64, m: ImPhysicsMaterial): i64 {
    return body(w, t, x, y, 0.0, ImColliderShape_ball(r), m);
}

# ── the JSON form ───────────────────────────────────────────────────────────────────

# The Str of a builder's text.
fn sb_text(sb): i64 { return str_builder_build(sb); }

# The JSON form of world w's snapshot as a Str (0 when to_json refuses).
fn world_json(w: *ImPhysicsWorld): i64 {
    var s: ImWorldSnapshot = ImWorldSnapshot_new();
    w.snapshot(&s);
    var sb = str_builder_new();
    var t, v = s.to_json(sb);
    s.free();
    if (is_ok(t) == 0) { return 0; }
    return sb_text(sb);
}

# The bytes of world w (the canonical form) into *out.
fn world_bytes(w: *ImPhysicsWorld, out: *ImWordList) {
    serialize_world(w, out);
    return 0;
}

# 1 when worlds a and b serialize to the same bytes.
fn same_bytes_world(a: *ImPhysicsWorld, b: *ImPhysicsWorld): i64 {
    var x: ImWordList = ImWordList_new();
    var y: ImWordList = ImWordList_new();
    world_bytes(a, &x);
    world_bytes(b, &y);
    var r = 0;
    if (x.len == y.len && memeq(x.data, y.data, x.len * 8) == 1) { r = 1; }
    x.free();
    y.free();
    return r;
}

# Restores world w from the JSON text j (a Str): the result's tag (1 for Ok) or 0 when from_json refuses.
fn restore_json(w: *ImPhysicsWorld, j): i64 {
    var s: ImWorldSnapshot = ImWorldSnapshot_new();
    var t, v = ImWorldSnapshot_from_json(str_data(j), str_len(j), &s);
    if (is_ok(t) == 0) { return 0 - 1; }
    var tr, vr = w.restore(&s);
    s.free();
    return is_ok(tr);
}

# The Str j with its first occurrence of the C string `old` replaced by `new` (j itself when absent).
fn edit(j, old, new): i64 {
    var d = str_data(j);
    var n = str_len(j);
    var lo = strlen(old);
    for (var i = 0; i + lo <= n; i = i + 1) {
        if (memeq(d + i, old, lo) == 1) {
            var sb = str_builder_new();
            for (var a = 0; a < i; a = a + 1) { str_builder_putc(sb, load8(d + a)); }
            str_builder_add_cstr(sb, new);
            for (var b = i + lo; b < n; b = b + 1) { str_builder_putc(sb, load8(d + b)); }
            return str_builder_build(sb);
        }
    }
    return j;
}

# The f64 words of the n values at v (an array of f64 literals) into a fresh freelist buffer.
fn f64s(v, n): i64 {
    var p = fl_alloc(n * 8);
    for (var i = 0; i < n; i = i + 1) { store64(p + i * 8, load64(v + i * 8)); }
    return p;
}

# The array-owning shapes in w, on static bodies kept apart (so no pair of them is ever tested), beside a ball dropped
# on a floor: a convex hull at x 10, a triangle mesh at 20 and a heightfield at 30.
fn array_scene(w: *ImPhysicsWorld) {
    var dm: ImPhysicsMaterial = ImPhysicsMaterial_default();
    var fd: ImBodyDesc = ImBodyDesc_default();
    fd.body_type = IM_BODY_STATIC;
    var floor = w.add_body(fd);
    var tf, cf = w.add_collider(floor, ImColliderDesc_new(ImColliderShape_box(5.0, 0.5, 5.0)));
    rust_ball(w, IM_BODY_DYNAMIC, 0.0, 2.0, 0.5, dm);
    var hv[96];
    var c0: f64 = 0.0;
    var c1: f64 = 1.0;
    var c2: f64 = -1.0;
    var c3: f64 = 0.5;
    store64(&hv, c2); store64(&hv + 8, c2); store64(&hv + 16, c0);
    store64(&hv + 24, c1); store64(&hv + 32, c2); store64(&hv + 40, c0);
    store64(&hv + 48, c1); store64(&hv + 56, c1); store64(&hv + 64, c3);
    store64(&hv + 72, c2); store64(&hv + 80, c1); store64(&hv + 88, c3);
    var ix[48];
    store64(&ix, 0); store64(&ix + 8, 1); store64(&ix + 16, 2);
    store64(&ix + 24, 0); store64(&ix + 32, 2); store64(&ix + 40, 3);
    var pts = f64s(&hv, 12);
    var hull: ImColliderShape = ImColliderShape_convex_hull(pts, 4);
    var mesh: ImColliderShape = ImColliderShape_tri_mesh(pts, 4, &ix, 2);
    var field: ImColliderShape = ImColliderShape_heightfield(pts, 5, ImVec3_new(0.5, 2.0, 1.0));
    fl_free(pts);
    for (var k = 0; k < 3; k = k + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        d.body_type = IM_BODY_STATIC;
        d.position = ImVec3_new(10.0 + 10.0 * f64_from(k), 5.0, 0.0);
        var h = w.add_body(d);
        var sh: ImColliderShape = hull;
        if (k == 1) { sh = mesh; }
        if (k == 2) { sh = field; }
        var tc, c = w.add_collider(h, ImColliderDesc_new(sh));
    }
    hull.free();
    mesh.free();
    field.free();
    return 0;
}

# 1 when every array of every collider shape in snapshot s is a copy of the matching collider's in world w: the same
# count, the same words, and a different address. A shape sits 16 bytes into a collider record, its four (array, count)
# pairs 48 bytes into the shape; points, vertices and index triples are 24 bytes a unit, heights 8.
fn arrays_apart(w: *ImPhysicsWorld, s: *ImWorldSnapshot): i64 {
    var ca: *ImArena = w.backend._colliders();
    var owned = 0;
    for (var c = 0; c < s.colliders.len; c = c + 1) {
        var sr = s.colliders.at(c) + 16;
        var wr = ca.get(load64(s.colliders.at(c)));
        if (wr == 0) { return 0; }
        wr = wr + 16;
        for (var k = 0; k < 4; k = k + 1) {
            var at = 48 + k * 16;
            var n = load64(sr + at + 8);
            var width = 24;
            if (k == 3) { width = 8; }
            if (n != load64(wr + at + 8)) { return 0; }
            if (n > 0) {
                var pa = load64(sr + at);
                var pb = load64(wr + at);
                if (pa == 0 || pb == 0 || pa == pb || same_bytes(pa, pb, n * width) == 0) { return 0; }
                owned = owned + 1;
            }
        }
    }
    return owned;
}

# Fills freed memory with junk: 4 blocks of every size from 8 to 512 bytes taken from the freelist, written with a
# pattern, and kept until `unscribble`. A pointer into a freed array then reads junk, not the old values.
fn scribble(keep: *ImWordList) {
    for (var sz = 8; sz <= 512; sz = sz + 8) {
        for (var r = 0; r < 4; r = r + 1) {
            var p = fl_alloc(sz);
            for (var o = 0; o < sz; o = o + 8) { store64(p + o, 0x5A5A5A5A5A5A5A5A); }
            keep.push(p);
        }
    }
    return 0;
}

# Frees what `scribble` kept.
fn unscribble(keep: *ImWordList) {
    for (var i = 0; i < keep.len; i = i + 1) { fl_free(keep.at(i)); }
    keep.free();
    return 0;
}

# Runs the shared snapshot tests.
fn snapshot_cases() {
    var cfg: ImWorldConfig = ImWorldConfig_default();

    # ── regressions.rs, struct-level ──
    test_group("restore_rejects_huge_handle_index");
    var w1: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    w1.add_body(ImBodyDesc_default());
    var snap: ImWorldSnapshot = ImWorldSnapshot_new();
    w1.snapshot(&snap);
    var b0: *ImBodySnapshot = _im_as_body_snap(snap.bodies.at(0));
    b0.body.handle = 0xFFFFFFF0;
    var w2: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var th, vh = w2.restore(&snap);
    assert_eq(is_ok(th) == 0 && w2.body_count() == 0, 1, "a huge handle index refused; the world unchanged");
    snap.free();
    w1.free();
    w1 = ImPhysicsWorld_new(cfg);
    var bb = w1.add_body(ImBodyDesc_default());
    var tbc, cbc = w1.add_collider(bb, ImColliderDesc_new(ImColliderShape_ball(0.5)));
    var dup: ImWorldSnapshot = ImWorldSnapshot_new();
    w1.snapshot(&dup);
    # A collider record of either profile: handle, body, then the shape (bytes 0, 8, 16).
    var c0 = dup.colliders.at(0);
    var cc = fl_alloc(dup.colliders.size);
    memcpy(cc, c0, dup.colliders.size);
    _im_snap_clone_shape(c0 + 16, cc + 16);
    dup.colliders.push(cc);
    fl_free(cc);
    var td, vd = w2.restore(&dup);
    assert_eq(is_ok(td), 0, "a duplicated collider refused");
    dup.free();
    var orphan: ImWorldSnapshot = ImWorldSnapshot_new();
    w1.snapshot(&orphan);
    store64(orphan.colliders.at(0) + 8, 99);
    var to, vo = w2.restore(&orphan);
    assert_eq(is_ok(to), 0, "a collider on a missing body refused");
    orphan.free();
    var good: ImWorldSnapshot = ImWorldSnapshot_new();
    w1.snapshot(&good);
    var tg, vg = w2.restore(&good);
    assert_eq(is_ok(tg) == 1 && w2.body_count() == 1, 1, "the valid snapshot restored");
    good.free();
    w1.free();
    w2.free();

    test_group("restore_replaces_force_fields");
    var f1: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    f1.add_force_field(ImForceField_directional(ImVec3_new(1.0, 0.0, 0.0), ImVec3_new(-1.0, -1.0, -1.0),
        ImVec3_new(1.0, 1.0, 1.0)));
    var f2: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    f2.add_force_field(ImForceField_radial(ImVec3_zero(), 1.0, 2.0, 1.0));
    var fs: ImWorldSnapshot = ImWorldSnapshot_new();
    f1.snapshot(&fs);
    var tf, vf = f2.restore(&fs);
    fs.free();
    var fa, fn1 = f1.force_fields();
    var fb, fn2 = f2.force_fields();
    assert_eq(is_ok(tf) == 1 && fn1 == 1 && fn2 == 1 && memeq(fa, fb, sizeof(ImForceField)) == 1, 1,
      "the force fields are the snapshot's");
    f1.free();
    f2.free();

    # ── serialize.rs, through bytes ──
    test_group("roundtrip_empty_world");
    var e1: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var eb: ImWordList = ImWordList_new();
    var te1, ve1 = serialize_world(&e1, &eb);
    var e2: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var te2, ve2 = deserialize_world(&e2, eb.data, eb.len * 8);
    var ets1: f64 = e1.timestep();
    var ets2: f64 = e2.timestep();
    assert_eq(is_ok(te1) == 1 && is_ok(te2) == 1 && e2.body_count() == 0 && ets1 == ets2, 1, "empty, timestep kept");
    e1.free();
    e2.free();

    test_group("roundtrip_with_bodies");
    var r1: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    rust_ball(&r1, IM_BODY_DYNAMIC, 5.0, 10.0, 1.0, ImPhysicsMaterial_rubber());
    body(&r1, IM_BODY_STATIC, 0.0, 0.0, 0.0, ImColliderShape_box(50.0, 0.5, 0.0), ImPhysicsMaterial_wood());
    for (var s10 = 0; s10 < 10; s10 = s10 + 1) { r1.step(); }
    var rb1: ImWordList = ImWordList_new();
    var tr1, vr1 = serialize_world(&r1, &rb1);
    var r2: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var tr2, vr2 = deserialize_world(&r2, rb1.data, rb1.len * 8);
    assert_eq(is_ok(tr1) == 1 && rb1.len > 0 && is_ok(tr2) == 1, 1, "bytes written and read");
    assert_eq(r2.body_count() == 2 && r2.current_step() == r1.current_step(), 1, "two bodies, the same step");
    r1.free();
    r2.free();

    test_group("roundtrip_preserves_positions");
    var p1: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var pb = rust_ball(&p1, IM_BODY_DYNAMIC, 0.0, 10.0, 0.5, ImPhysicsMaterial_default());
    for (var s30 = 0; s30 < 30; s30 = s30 + 1) { p1.step(); }
    var sb4: ImBodyState;
    p1.get_body_state(pb, &sb4);
    var pbytes: ImWordList = ImWordList_new();
    serialize_world(&p1, &pbytes);
    var p2: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    deserialize_world(&p2, pbytes.data, pbytes.len * 8);
    var sa4: ImBodyState;
    var tp, vp = p2.get_body_state(pb, &sa4);
    var py1: f64 = sb4.position.y;
    var py2: f64 = sa4.position.y;
    var vy1: f64 = sb4.linear_velocity.y;
    var vy2: f64 = sa4.linear_velocity.y;
    assert_eq(is_ok(tp) == 1 && py1 == py2 && vy1 == vy2, 1, "position and velocity kept (exactly; Rust: 1e-10)");
    p1.free();
    p2.free();

    test_group("roundtrip_continues_simulation");
    var zg: ImWorldConfig = ImWorldConfig_default();
    zg.gravity = ImVec3_zero();
    var c1: ImPhysicsWorld = ImPhysicsWorld_new(zg);
    var cb = rust_ball(&c1, IM_BODY_DYNAMIC, 0.0, 0.0, 0.5, ImPhysicsMaterial_default());
    var cst: ImBodyState;
    c1.get_body_state(cb, &cst);
    cst.linear_velocity = ImVec3_new(1.0, 0.0, 0.0);
    c1.set_body_state(cb, cst);
    for (var c10 = 0; c10 < 10; c10 = c10 + 1) { c1.step(); }
    c1.get_body_state(cb, &cst);
    var save_x: f64 = cst.position.x;
    var cbytes: ImWordList = ImWordList_new();
    serialize_world(&c1, &cbytes);
    var c2: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    deserialize_world(&c2, cbytes.data, cbytes.len * 8);
    for (var c20 = 0; c20 < 10; c20 = c20 + 1) { c2.step(); }
    c2.get_body_state(cb, &cst);
    var after_x: f64 = cst.position.x;
    assert_eq(after_x > save_x, 1, "it keeps moving");
    c1.free();
    c2.free();

    test_group("step_exact_determinism");
    var da: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    scene(&da, 0);
    for (var d50 = 0; d50 < 50; d50 = d50 + 1) { da.step(); }
    var dbytes: ImWordList = ImWordList_new();
    serialize_world(&da, &dbytes);
    var dr: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    deserialize_world(&dr, dbytes.data, dbytes.len * 8);
    for (var d100 = 0; d100 < 100; d100 = d100 + 1) { dr.step(); }
    var dbw: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    scene(&dbw, 0);
    for (var d150 = 0; d150 < 150; d150 = d150 + 1) { dbw.step(); }
    var bsa: ImBodyState;
    var bsb: ImBodyState;
    dr.get_body_state(_im_arena_handle(1, 0), &bsa);
    dbw.get_body_state(_im_arena_handle(1, 0), &bsb);
    assert_eq(memeq(&bsa, &bsb, sizeof(ImBodyState)) == 1 && same_bytes_world(&dr, &dbw) == 1, 1,
      "restored at 50 and stepped 100 = 150 straight, bit for bit (Rust: within 1e-10)");
    da.free();
    dr.free();
    dbw.free();

    # ── regressions.rs, through bytes ──
    test_group("restore_preserves_handle_allocation");
    var h1: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var hh[32];
    for (var hi = 0; hi < 4; hi = hi + 1) {
        var hd: ImBodyDesc = ImBodyDesc_default();
        var hx: f64 = f64_from(hi) * 3.0;
        hd.position = ImVec3_new(hx, 0.0, 0.0);
        store64(&hh + hi * 8, h1.add_body(hd));
    }
    h1.remove_body(load64(&hh));
    h1.remove_body(load64(&hh + 16));
    var hbytes: ImWordList = ImWordList_new();
    serialize_world(&h1, &hbytes);
    var h2: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    deserialize_world(&h2, hbytes.data, hbytes.len * 8);
    var ha1 = h1.add_body(ImBodyDesc_default());
    var ha2 = h2.add_body(ImBodyDesc_default());
    var hb1 = h1.add_body(ImBodyDesc_default());
    var hb2 = h2.add_body(ImBodyDesc_default());
    assert_eq(ha1 == ha2 && hb1 == hb2, 1, "the next handles are the original's (#[ignore]d in Rust)");
    h1.free();
    h2.free();

    test_group("restore_replaces_force_fields_bytes");
    var g1: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    g1.add_force_field(ImForceField_directional(ImVec3_new(1.0, 0.0, 0.0), ImVec3_new(-1.0, -1.0, -1.0),
        ImVec3_new(1.0, 1.0, 1.0)));
    var gbytes: ImWordList = ImWordList_new();
    serialize_world(&g1, &gbytes);
    var g2: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    g2.add_force_field(ImForceField_radial(ImVec3_zero(), 1.0, 2.0, 1.0));
    var tgf, vgf = deserialize_world(&g2, gbytes.data, gbytes.len * 8);
    var ga, gn1 = g1.force_fields();
    var gb, gn2 = g2.force_fields();
    assert_eq(is_ok(tgf) == 1 && gn1 == 1 && gn2 == 1 && memeq(ga, gb, sizeof(ImForceField)) == 1, 1,
      "the fields are the bytes' (#[ignore]d in Rust)");
    g1.free();
    g2.free();

    # ── Cyrius-only: the binary form ──
    test_group("byte_round_trips");
    var bt = 1;
    for (var bk = 0; bk < 5; bk = bk + 1) {
        var xb1: ImWordList = ImWordList_new();
        scene_bytes(bk, 37, &xb1);
        var bs1: ImWorldSnapshot = ImWorldSnapshot_new();
        var tb1, vb1 = ImWorldSnapshot_from_bytes(xb1.data, xb1.len * 8, &bs1);
        var xb2: ImWordList = ImWordList_new();
        var tb2, vb2 = bs1.to_bytes(&xb2);
        var bw: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
        var tb3, vb3 = deserialize_world(&bw, xb1.data, xb1.len * 8);
        var xb3: ImWordList = ImWordList_new();
        serialize_world(&bw, &xb3);
        if (is_ok(tb1) == 0 || is_ok(tb2) == 0 || is_ok(tb3) == 0) { bt = 0; }
        if (xb1.len != xb2.len || memeq(xb1.data, xb2.data, xb1.len * 8) == 0) { bt = 0; }
        if (xb1.len != xb3.len || memeq(xb1.data, xb3.data, xb1.len * 8) == 0) { bt = 0; }
        xb1.free();
        xb2.free();
        xb3.free();
        bs1.free();
        bw.free();
    }
    assert_eq(bt, 1, "bytes → snapshot → bytes, and bytes → world → bytes, unchanged in every scene");

    test_group("header_refusals");
    var xb: ImWordList = ImWordList_new();
    scene_bytes(1, 20, &xb);
    var xn = xb.len * 8;
    assert_eq(bytes_refused(xb.data, 0, 0) + bytes_refused(xb.data, 39, 0) + bytes_refused(xb.data, xn - 3, 0), 3,
      "empty, shorter than the header, not whole words");
    var keep = load64(xb.data);
    store64(xb.data, keep ^ 1);
    var r_magic = bytes_refused(xb.data, xn, 0);
    store64(xb.data, keep);
    store64(xb.data + 8, 2);
    var r_ver = bytes_refused(xb.data, xn, 0);
    store64(xb.data + 8, 1);
    store64(xb.data + 16, _IM_SNAP_PROFILE + 1);
    var r_prof = bytes_refused(xb.data, xn, 0);
    store64(xb.data + 16, _IM_SNAP_PROFILE);
    store64(xb.data + 24, load64(xb.data + 24) - 1);
    var r_len = bytes_refused(xb.data, xn, 0);
    store64(xb.data + 24, load64(xb.data + 24) + 1);
    store64(xb.data + 32, load64(xb.data + 32) + 1);
    var r_sum = bytes_refused(xb.data, xn, 0);
    store64(xb.data + 32, load64(xb.data + 32) - 1);
    assert_eq(r_magic + r_ver + r_prof + r_len + r_sum, 5, "a wrong magic, version, profile, length or checksum");
    assert_eq(bytes_refused(xb.data, xn, 0), 0, "(the untouched bytes restore)");

    test_group("every_truncation_refused");
    var tr_all = 1;
    for (var cut = 0; cut < xn; cut = cut + 8) {
        if (bytes_refused(xb.data, cut, 0) == 0) { tr_all = 0; }
    }
    assert_eq(tr_all, 1, "every whole-word prefix refused by the header");
    var tp_all = 1;
    var copy = fl_alloc(xn);
    for (var pc = 5; pc < xb.len; pc = pc + 1) {
        memcpy(copy, xb.data, pc * 8);
        reseal(copy, pc * 8);
        if (bytes_refused(copy, pc * 8, 0) == 0) { tp_all = 0; }
    }
    assert_eq(tp_all, 1, "every truncated payload refused, even behind a resealed header");

    test_group("every_word_change_refused");
    var flip_all = 1;
    for (var fw = 0; fw < xb.len; fw = fw + 1) {
        memcpy(copy, xb.data, xn);
        store64(copy + fw * 8, load64(copy + fw * 8) ^ (1 << (fw % 64)));
        if (bytes_refused(copy, xn, 0) == 0) { flip_all = 0; }
    }
    assert_eq(flip_all, 1, "a one-bit change in any word refused (the checksum, or the header)");

    test_group("corruption_behind_a_resealed_checksum");
    var fzs: ImWorldSnapshot = ImWorldSnapshot_new();
    # Rust's fuzz_serialize contract: damaged bytes never crash; an accepted one steps and serializes again.
    var fz = 1;
    var accepted = 0;
    for (var fi = 0; fi < 1500; fi = fi + 1) {
        memcpy(copy, xb.data, xn);
        var nmut = 1 + (lcg() % 3);
        for (var mu = 0; mu < nmut; mu = mu + 1) {
            var at = 5 + (lcg() % (xb.len - 5));
            var kind = lcg() % 4;
            if (kind == 0) { store64(copy + at * 8, lcg()); }
            if (kind == 1) { store64(copy + at * 8, load64(copy + at * 8) + 1); }
            if (kind == 2) { store64(copy + at * 8, 0 - 1); }
            if (kind == 3) { store64(copy + at * 8, load64(copy + at * 8) ^ (1 << (lcg() % 64))); }
        }
        reseal(copy, xn);
        var t9, v9 = ImWorldSnapshot_from_bytes(copy, xn, &fzs);
        if (is_ok(t9) == 1) {
            var w9: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
            var tr9, vr9 = w9.restore(&fzs);
            if (is_ok(tr9) == 1) { accepted = accepted + 1; }
            w9.free();
            fzs.free();
        }
        if (bytes_refused(copy, xn, 1) == 0) { fz = 0; }
    }
    assert_eq(fz, 1, "1,500 corruptions: each refused with the world unchanged, or restored and stepping");
    assert_eq(accepted > 0 && accepted < 1500, 1, "(some corruptions are values a world can hold)");
    fl_free(copy);

    xb.free();

    # ── serialize.rs: the JSON form ──
    test_group("snapshot_serde_json");
    var jw0: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var js0: ImWorldSnapshot = ImWorldSnapshot_new();
    jw0.snapshot(&js0);
    var jsb0 = str_builder_new();
    var tj0, vj0 = js0.to_json(jsb0);
    var jt0 = sb_text(jsb0);
    var jback: ImWorldSnapshot = ImWorldSnapshot_new();
    var tj1, vj1 = ImWorldSnapshot_from_json(str_data(jt0), str_len(jt0), &jback);
    assert_eq(is_ok(tj0) == 1 && is_ok(tj1) == 1 && jback.next_particle_id == 0, 1, "an empty world's snapshot back");
    js0.free();
    jback.free();
    jw0.free();

    # ── Cyrius-only: the JSON form ──
    test_group("json_round_trips");
    var jr = 1;
    for (var jk = 0; jk < 5; jk = jk + 1) {
        var jwa: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
        scene(&jwa, jk);
        for (var jf = 0; jf < 37; jf = jf + 1) { jwa.step(); }
        var ja = world_json(&jwa);
        var jwb: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
        if (ja == 0 || restore_json(&jwb, ja) != 1) { jr = 0; }
        if (same_bytes_world(&jwa, &jwb) == 0) { jr = 0; }
        var jb = world_json(&jwb);
        if (jb == 0 || str_len(ja) != str_len(jb) || memeq(str_data(ja), str_data(jb), str_len(ja)) == 0) { jr = 0; }
        jwa.free();
        jwb.free();
    }
    assert_eq(jr, 1, "world → JSON → world: the same state, and the same text again, in every scene");

    test_group("json_step_equivalence");
    var jsa: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    scene(&jsa, 2);
    for (var j25 = 0; j25 < 25; j25 = j25 + 1) { jsa.step(); }
    var jtext = world_json(&jsa);
    var jsb2: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    scene(&jsb2, 3);
    var jok = restore_json(&jsb2, jtext);
    var jsame = 1;
    for (var j90 = 0; j90 < 90; j90 = j90 + 1) {
        jsa.step();
        jsb2.step();
        var jea, jna = jsa.collision_events();
        var jeb, jnb = jsb2.collision_events();
        if (jna != jnb || same_bytes(jea, jeb, jna * sizeof(ImCollisionEvent)) == 0) { jsame = 0; }
    }
    assert_eq(jok == 1 && jsame == 1 && same_bytes_world(&jsa, &jsb2) == 1, 1,
      "restored from JSON at frame 25, 90 frames in step, bit for bit");
    jsa.free();
    jsb2.free();

    test_group("json_document");
    var jd: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    scene(&jd, 0);
    var jdt = world_json(&jd);
    var lsb = str_builder_new();
    str_builder_add_cstr(lsb, "{\"format\":\"impetus-snapshot\",\"version\":1,\"profile\":\"");
    str_builder_add_cstr(lsb, _im_snap_profile_name());
    str_builder_add_cstr(lsb, "\",\"config\":{");
    var lead = str_builder_build(lsb);
    assert_eq(str_len(jdt) > str_len(lead) && memeq(str_data(jdt), str_data(lead), str_len(lead)) == 1, 1,
      "format, version and profile lead, then the config");

    test_group("json_refusals");
    var jx: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var jr_text = restore_json(&jx, edit(jdt, "{", "["));
    var jr_fmt = restore_json(&jx, edit(jdt, "impetus-snapshot", "impetus-snapshoT"));
    var jr_ver = restore_json(&jx, edit(jdt, "\"version\":1", "\"version\":2"));
    var jr_prof = restore_json(&jx, edit(jdt, "\"profile\":\"", "\"profile\":\"x"));
    var jr_key = restore_json(&jx, edit(jdt, "\"tracker\"", "\"tracked\""));
    var jr_type = restore_json(&jx, edit(jdt, "\"is_sleeping\":false", "\"is_sleeping\":0"));
    var jall = jr_text + jr_fmt + jr_ver + jr_prof + jr_key + jr_type;
    assert_eq(jall, 0 - 6, "not an object; a wrong format, version, profile, key or type: refused by the reader");
    var jr_handle = restore_json(&jx, edit(jdt, "{\"body\":{\"handle\":1,", "{\"body\":{\"handle\":9,"));
    assert_eq(jr_handle == 0 && jx.body_count() == 0, 1, "a well-formed document of an invalid world: refused");
    jx.free();
    jd.free();
    var jn: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var nan_rate: f64 = 0.0;
    nan_rate = nan_rate / nan_rate;
    jn.add_emitter(ImParticleEmitter_new(ImVec3_zero(), ImVec3_zero(), nan_rate));
    var jns: ImWorldSnapshot = ImWorldSnapshot_new();
    jn.snapshot(&jns);
    var jnsb = str_builder_new();
    var tjn, vjn = jns.to_json(jnsb);
    var jnb: ImWordList = ImWordList_new();
    var tjb, vjb = jns.to_bytes(&jnb);
    assert_eq(is_ok(tjn) == 0 && vjn == IM_ERR_SERIALIZE && is_ok(tjb) == 1, 1,
      "a NaN has no JSON form (IM_ERR_SERIALIZE); the bytes hold it");
    jnb.free();
    jns.free();
    jn.free();

    test_group("array_shapes_owned");
    # A convex hull, a triangle mesh and a heightfield own arrays. A snapshot holds copies of its own and a restored
    # world copies again, so either outlives the other, even with the freed memory written over. (A ball, box, capsule
    # or segment owns none: its record copy is the whole copy, and capture and load skip the clone.)
    var aw: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    array_scene(&aw);
    for (var af = 0; af < 5; af = af + 1) { aw.step(); }
    var abytes: ImWordList = ImWordList_new();
    world_bytes(&aw, &abytes);
    var asn: ImWorldSnapshot = ImWorldSnapshot_new();
    var tas, vas = aw.snapshot(&asn);
    assert_eq(is_ok(tas) == 1 && arrays_apart(&aw, &asn) == 4, 1, "the snapshot's four arrays are copies");
    aw.free();
    var junk1: ImWordList = ImWordList_new();
    scribble(&junk1);
    var ar: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var tar, varr = ar.restore(&asn);
    assert_eq(is_ok(tar) == 1 && arrays_apart(&ar, &asn) == 4, 1, "the restored world's are copies again");
    var ab2: ImWordList = ImWordList_new();
    world_bytes(&ar, &ab2);
    assert_eq(ab2.len == abytes.len && same_bytes(ab2.data, abytes.data, abytes.len * 8) == 1, 1,
      "the snapshot outlives its world");
    asn.free();
    var junk2: ImWordList = ImWordList_new();
    scribble(&junk2);
    var ab3: ImWordList = ImWordList_new();
    world_bytes(&ar, &ab3);
    assert_eq(ab3.len == abytes.len && same_bytes(ab3.data, abytes.data, abytes.len * 8) == 1, 1,
      "the restored world outlives its snapshot");
    unscribble(&junk1);
    unscribble(&junk2);
    abytes.free();
    ab2.free();
    ab3.free();
    ar.free();

    test_group("flat_heap_snapshots");
    # Snapshot and restore, round and round: after warm-up the heap stays put.
    var hw: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    scene(&hw, 3);
    var hr: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    for (var warm = 0; warm < 30; warm = warm + 1) {
        hw.step();
        var hs1: ImWorldSnapshot = ImWorldSnapshot_new();
        hw.snapshot(&hs1);
        hr.restore(&hs1);
        hs1.free();
    }
    var arena0 = _fl_arena;
    var pos0 = _fl_arena_pos;
    for (var rnd = 0; rnd < 60; rnd = rnd + 1) {
        var hs2: ImWorldSnapshot = ImWorldSnapshot_new();
        hw.snapshot(&hs2);
        hr.restore(&hs2);
        hs2.free();
    }
    assert_eq(_fl_arena == arena0 && _fl_arena_pos == pos0, 1, "no growth");
    hw.free();
    hr.free();

    return 0;
}
