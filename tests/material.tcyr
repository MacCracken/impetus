# material.tcyr — the ported Rust tests of rust-old/src/material.rs (M1a, serde in M1b).
#
# The serde tests round-trip through the serde-compatible JSON codecs (src/json.cyr, ADR 0010).

include "tests/ulp.cyr"
include "tests/lib_2d.cyr"

# 1 when two materials have equal fields (Rust's derived PartialEq).
fn same(a: ImPhysicsMaterial, b: ImPhysicsMaterial): i64 {
    var af: f64 = a.friction;
    var bf: f64 = b.friction;
    var ar: f64 = a.restitution;
    var br: f64 = b.restitution;
    var ad: f64 = a.density;
    var bd: f64 = b.density;
    var ao: f64 = a.rolling_friction;
    var bo: f64 = b.rolling_friction;
    if (af != bf || ar != br || ad != bd || ao != bo) { return 0; }
    if (a.has_static_friction != b.has_static_friction) { return 0; }
    if (a.friction_combine != b.friction_combine || a.restitution_combine != b.restitution_combine) { return 0; }
    return 1;
}

# 1 when |got − want| < 1e-10.
fn close(got: f64, want: f64): i64 {
    var d: f64 = f64_abs(got - want);
    if (d < 0.0000000001) { return 1; }
    return 0;
}

# Writes m as JSON and reads it back into *out: 1 when the read succeeds.
fn json_roundtrip(m: ImPhysicsMaterial, out: *ImPhysicsMaterial): i64 {
    var sb = str_builder_new();
    m.to_json(sb);
    var s = str_builder_build(sb);
    var t, v = ImPhysicsMaterial_from_json(str_data(s), str_len(s), out);
    if (is_err_result(t) == 1) { return 0; }
    return 1;
}

# Runs the ported material tests.
fn main() {
    alloc_init();
    test_group("default_material");
    var m: ImPhysicsMaterial = ImPhysicsMaterial_default();
    var mf: f64 = m.friction;
    var mr: f64 = m.restitution;
    var md: f64 = m.density;
    assert(mf == 0.5 && mr == 0.0 && md == 1.0, "0.5 / 0 / 1");

    test_group("presets");
    var ice: ImPhysicsMaterial = ImPhysicsMaterial_ice();
    var rubber: ImPhysicsMaterial = ImPhysicsMaterial_rubber();
    var bouncy: ImPhysicsMaterial = ImPhysicsMaterial_bouncy();
    var steel: ImPhysicsMaterial = ImPhysicsMaterial_steel();
    var wood: ImPhysicsMaterial = ImPhysicsMaterial_wood();
    var icef: f64 = ice.friction;
    var rubf: f64 = rubber.friction;
    var bor: f64 = bouncy.restitution;
    var str: f64 = steel.restitution;
    var std: f64 = steel.density;
    var wod: f64 = wood.density;
    assert(icef < rubf, "ice slips more than rubber");
    assert(bor > str, "bouncy bounces more than steel");
    assert(std > wod, "steel is denser than wood");

    test_group("preset_values");
    var icer: f64 = ice.restitution;
    var iced: f64 = ice.density;
    var rubr: f64 = rubber.restitution;
    assert(icef == 0.05 && icer == 0.1 && iced == 0.9, "ice 0.05 / 0.1 / 0.9");
    assert(rubf == 1.0 && rubr == 0.8, "rubber 1 / 0.8");

    test_group("material_serde");
    var rb: ImPhysicsMaterial = ImPhysicsMaterial_default();
    assert(json_roundtrip(rubber, &rb) == 1, "reads back");
    assert(same(rubber, rb) == 1, "rubber survives the round trip");

    test_group("material_equality");
    assert(same(ImPhysicsMaterial_steel(), ImPhysicsMaterial_steel()) == 1, "steel == steel");
    assert(same(ice, rubber) == 0, "ice != rubber");

    test_group("default_combine_rules");
    assert_eq(m.friction_combine, IM_COMBINE_AVERAGE, "friction: Average");
    assert_eq(m.restitution_combine, IM_COMBINE_MIN, "restitution: Min");
    var mo: f64 = m.rolling_friction;
    assert(mo == 0.0, "no rolling friction");

    test_group("combine_rule_average");
    assert(close(combine_rule_combine(IM_COMBINE_AVERAGE, 0.4, 0.6), 0.5) == 1, "average");
    test_group("combine_rule_min");
    assert(close(combine_rule_combine(IM_COMBINE_MIN, 0.3, 0.7), 0.3) == 1, "min");
    test_group("combine_rule_max");
    assert(close(combine_rule_combine(IM_COMBINE_MAX, 0.3, 0.7), 0.7) == 1, "max");
    test_group("combine_rule_multiply");
    assert(close(combine_rule_combine(IM_COMBINE_MULTIPLY, 0.5, 0.4), 0.2) == 1, "multiply");

    test_group("combine_rule_ordering");
    assert(IM_COMBINE_MAX > IM_COMBINE_MULTIPLY, "Max > Multiply");
    assert(IM_COMBINE_MULTIPLY > IM_COMBINE_AVERAGE, "Multiply > Average");
    assert(IM_COMBINE_AVERAGE > IM_COMBINE_MIN, "Average > Min");

    test_group("rolling_friction_serde");
    var rf: ImPhysicsMaterial = ImPhysicsMaterial_default();
    rf.rolling_friction = 0.01;
    var rfb: ImPhysicsMaterial = ImPhysicsMaterial_default();
    assert(json_roundtrip(rf, &rfb) == 1, "reads back");
    assert(same(rf, rfb) == 1, "equal after the round trip");
    var rfv: f64 = rfb.rolling_friction;
    assert(rfv == 0.01, "rolling friction 0.01");

    test_group("combine_rule_serde");
    var cr: ImPhysicsMaterial = ImPhysicsMaterial_default();
    cr.friction_combine = IM_COMBINE_MAX;
    cr.restitution_combine = IM_COMBINE_MULTIPLY;
    var crb: ImPhysicsMaterial = ImPhysicsMaterial_default();
    assert(json_roundtrip(cr, &crb) == 1, "reads back");
    assert_eq(crb.friction_combine, IM_COMBINE_MAX, "Max");
    assert_eq(crb.restitution_combine, IM_COMBINE_MULTIPLY, "Multiply");

    test_group("serde_defaults_for_new_fields");
    var old = "{\"friction\":0.5,\"restitution\":0.0,\"density\":1.0}";
    var od: ImPhysicsMaterial = ImPhysicsMaterial_ice();
    var ot, ov = ImPhysicsMaterial_from_json(old, strlen(old), &od);
    assert(is_err_result(ot) == 0, "an old document reads");
    var orr: f64 = od.rolling_friction;
    assert(orr == 0.0, "rolling friction defaults to 0");
    assert_eq(od.friction_combine, IM_COMBINE_AVERAGE, "friction combine defaults to Average");
    assert_eq(od.restitution_combine, IM_COMBINE_MIN, "restitution combine defaults to Min");

    # backend_2d/tests.rs's two static-friction serde tests.
    test_group("static_friction_serde_roundtrip");
    var sf: ImPhysicsMaterial = ImPhysicsMaterial_default();
    sf.friction = 0.5;
    sf.has_static_friction = 1;
    sf.static_friction = 0.8;
    var sfb: ImPhysicsMaterial = ImPhysicsMaterial_default();
    assert(json_roundtrip(sf, &sfb) == 1, "reads back");
    var sfv: f64 = sfb.static_friction;
    assert(sfb.has_static_friction == 1 && sfv == 0.8, "Some(0.8)");

    test_group("static_friction_serde_default_none");
    # The target starts with an override, so the reader has to clear it.
    var sn: ImPhysicsMaterial = ImPhysicsMaterial_ice();
    sn.has_static_friction = 1;
    sn.static_friction = 0.3;
    var snt, snv = ImPhysicsMaterial_from_json(old, strlen(old), &sn);
    assert(is_err_result(snt) == 0 && sn.has_static_friction == 0, "an old document reads as None");

    # Cyrius-only: the static friction override and its fallback.
    test_group("effective_static_friction");
    var fallback: f64 = m.effective_static_friction();
    assert(fallback == 0.75, "friction x 1.5 without an override");
    m.has_static_friction = 1;
    m.static_friction = 0.9;
    var over: f64 = m.effective_static_friction();
    assert(over == 0.9, "the override when set");
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
