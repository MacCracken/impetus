# world.tcyr — the world and its particles on the 2D profile (M3d): tests/world_cases.cyr, the tests Rust runs on
# both backends.

include "tests/lib_2d.cyr"
include "tests/world_cases.cyr"

# Runs the world tests.
fn main() {
    alloc_init();
    world_cases();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
