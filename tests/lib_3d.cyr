# lib_3d.cyr — the 3D profile's module list, in cyrius.cyml [lib.3d] order, for test compiles.
#
# `cyrius test` never prepends [lib.3d] (it is read only by `cyrius distlib`), and `[test] modules`
# can't differ by profile (port-parity.md §4.4), so every 3D test file includes this one. Keep it
# in step with [lib.3d]; scripts/surface_parity.py checks both mirrors.

include "src/error.cyr"
include "src/constants.cyr"
include "src/constants_private.cyr"
include "src/crmath_data.cyr"
