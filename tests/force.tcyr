# force.tcyr — the ported Rust tests of rust-old/src/force.rs (M1a, serde in M1b).

include "tests/ulp.cyr"
include "tests/lib_2d.cyr"

# 1 when |got − want| < 1e-10.
fn close(got: f64, want: f64): i64 {
    var d: f64 = f64_abs(got - want);
    if (d < 0.0000000001) { return 1; }
    return 0;
}

# 1 when v equals (x, y, z).
fn vec_is(v: ImVec3, x: f64, y: f64, z: f64): i64 {
    var vx: f64 = v.x;
    var vy: f64 = v.y;
    var vz: f64 = v.z;
    if (vx == x && vy == y && vz == z) { return 1; }
    return 0;
}

# Runs the ported force tests.
fn main() {
    alloc_init();
    test_group("force_magnitude");
    var f: ImForce = ImForce_new(3.0, 4.0, 0.0);
    assert(close(f.magnitude(), 5.0) == 1, "|(3, 4, 0)| = 5");

    test_group("force_zero");
    var z: ImForce = ImForce_new(0.0, 0.0, 0.0);
    var zm: f64 = z.magnitude();
    assert(zm == 0.0, "zero magnitude");
    assert_eq(z.has_point, 0, "no point");

    test_group("gravity_force");
    var g: ImForce = ImForce_gravity(10.0, 9.81);
    var gy: f64 = g.vector.y;
    var gx: f64 = g.vector.x;
    var gz: f64 = g.vector.z;
    assert(close(gy, -98.1) == 1, "weight -98.1");
    assert(gx == 0.0 && gz == 0.0, "vertical only");

    test_group("force_at_point");
    var a: ImForce = ImForce_at_point(1.0, 0.0, 0.0, 0.5, 0.5, 0.0);
    assert_eq(a.has_point, 1, "has a point");
    assert(vec_is(a.point, 0.5, 0.5, 0.0) == 1, "point (0.5, 0.5, 0)");
    assert(vec_is(a.vector, 1.0, 0.0, 0.0) == 1, "vector (1, 0, 0)");

    test_group("force_serde");
    var fs: ImForce = ImForce_at_point(3.0, 4.0, 0.0, 1.0, 2.0, 0.0);
    var sbf = str_builder_new();
    fs.to_json(sbf);
    var jf = str_builder_build(sbf);
    var fb: ImForce = ImForce_new(0.0, 0.0, 0.0);
    var ft, fv = ImForce_from_json(str_data(jf), str_len(jf), &fb);
    assert(is_err_result(ft) == 0, "reads back");
    assert(vec_is(fb.vector, 3.0, 4.0, 0.0) == 1 && fb.has_point == 1, "vector and point present");
    assert(vec_is(fb.point, 1.0, 2.0, 0.0) == 1, "point (1, 2, 0)");

    test_group("impulse_new");
    var i: ImImpulse = ImImpulse_new(5.0, 10.0, 0.0);
    assert(vec_is(i.vector, 5.0, 10.0, 0.0) == 1, "vector (5, 10, 0)");
    assert_eq(i.has_point, 0, "no point");

    test_group("impulse_at_point");
    var ip: ImImpulse = ImImpulse_at_point(1.0, 2.0, 0.0, 0.5, 0.5, 0.0);
    assert(vec_is(ip.point, 0.5, 0.5, 0.0) == 1, "point (0.5, 0.5, 0)");

    test_group("impulse_magnitude");
    var im: ImImpulse = ImImpulse_new(3.0, 4.0, 0.0);
    assert(close(im.magnitude(), 5.0) == 1, "|(3, 4, 0)| = 5");

    test_group("impulse_serde");
    var is: ImImpulse = ImImpulse_at_point(1.0, 2.0, 0.0, 3.0, 4.0, 0.0);
    var sbi = str_builder_new();
    is.to_json(sbi);
    var ji = str_builder_build(sbi);
    var ib: ImImpulse = ImImpulse_new(0.0, 0.0, 0.0);
    var it, iv = ImImpulse_from_json(str_data(ji), str_len(ji), &ib);
    assert(is_err_result(it) == 0, "reads back");
    assert(vec_is(ib.vector, 1.0, 2.0, 0.0) == 1 && vec_is(ib.point, 3.0, 4.0, 0.0) == 1, "equal after the round trip");

    test_group("torque_new");
    var t: ImTorque = ImTorque_new(5.0);
    var tv: f64 = t.value;
    assert(tv == 5.0, "5 N·m");

    test_group("torque_serde");
    var ts: ImTorque = ImTorque_new(-3.5);
    var sbt = str_builder_new();
    ts.to_json(sbt);
    var jt = str_builder_build(sbt);
    var tb: ImTorque = ImTorque_new(0.0);
    var tt, tv2 = ImTorque_from_json(str_data(jt), str_len(jt), &tb);
    assert(is_err_result(tt) == 0, "reads back");
    var tbv: f64 = tb.value;
    assert(tbv == -3.5, "-3.5 N·m");
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
