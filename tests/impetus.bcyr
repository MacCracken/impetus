# springs/spring_1d_step: one cached step at 60 fps (the transition is computed once).
fn bench_spring_1d_step() {
    var b = bench_new("springs/spring_1d_step");
    var s: ImSpring = ImSpring_new(0.0, 100.0, 300.0, 15.0);
    var dt: f64 = 1.0 / 60.0;
    bench_batch_start(b);
    for (var i = 0; i < N; i = i + 1) { s.step(dt); }
    bench_batch_stop(b, N);
    var p: f64 = s.position();
    g_sink = p;
    bench_report(b);
    return 0;
}

# springs/spring_2d_step: both axes, cached.
fn bench_spring_2d_step() {
    var b = bench_new("springs/spring_2d_step");
    var s: ImSpring2d = ImSpring2d_new(ImVec2_new(0.0, 0.0), ImVec2_new(100.0, 200.0), 300.0, 15.0);
    var dt: f64 = 1.0 / 60.0;
    bench_batch_start(b);
    for (var i = 0; i < N; i = i + 1) { s.step(dt); }
    bench_batch_stop(b, N);
    var p: f64 = s.x.position;
    g_sink = p;
    bench_report(b);
    return 0;
}

# springs/spring_settle_frames: a fresh critically damped spring stepped at 60 fps until settled
# (the first step computes the transition).
fn bench_spring_settle_frames() {
    var b = bench_new("springs/spring_settle_frames");
    var dt: f64 = 1.0 / 60.0;
    var reps = N / 100;
    bench_batch_start(b);
    for (var i = 0; i < reps; i = i + 1) {
        var s: ImSpring = ImSpring_critically_damped(0.0, 100.0, 300.0);
        while (s.is_settled() == 0) { s.step(dt); }
        g_sink = s.cache_valid;
    }
    bench_batch_stop(b, reps);
    bench_report(b);
    return 0;
}

# The serde and Display bodies build a fresh document per iteration, as Rust's `to_string` and
# `format!` allocate a fresh String; 10,000 iterations bound the heap they grow.
var NS = 10000;

# materials/quantity_display: format 9.81 N (Rust's Display).
fn bench_quantity_display() {
    var b = bench_new("materials/quantity_display");
    var q: ImQuantity = ImQuantity_newtons(9.81);
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var sb = str_builder_new();
        q.fmt(sb);
        g_sink = str_builder_build(sb);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# serde/serialize_body_desc: a dynamic body at (5, 10, 0), rotated 1.57.
fn bench_serialize_body_desc() {
    var b = bench_new("serde/serialize_body_desc");
    var d: ImBodyDesc = ImBodyDesc_default();
    d.position = ImVec3_new(5.0, 10.0, 0.0);
    d.rotation = 1.57;
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var sb = str_builder_new();
        d.to_json(sb);
        g_sink = str_builder_build(sb);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# serde/deserialize_body_desc: the default descriptor's document.
fn bench_deserialize_body_desc() {
    var b = bench_new("serde/deserialize_body_desc");
    var d: ImBodyDesc = ImBodyDesc_default();
    var sb = str_builder_new();
    d.to_json(sb);
    var doc = str_builder_build(sb);
    var out: ImBodyDesc = ImBodyDesc_default();
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var t, v = ImBodyDesc_from_json(str_data(doc), str_len(doc), &out);
        g_sink = t;
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# serde/serialize_config: the default world config.
fn bench_serialize_config() {
    var b = bench_new("serde/serialize_config");
    var c: ImWorldConfig = ImWorldConfig_default();
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var sb = str_builder_new();
        c.to_json(sb);
        g_sink = str_builder_build(sb);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# serde/roundtrip_collider_desc: a rubber ball of mass 5, written then read.
fn bench_roundtrip_collider_desc() {
    var b = bench_new("serde/roundtrip_collider_desc");
    var d: ImColliderDesc = ImColliderDesc_new(ImColliderShape_ball(1.0));
    d.material = ImPhysicsMaterial_rubber();
    d.has_mass = 1;
    d.mass = 5.0;
    var out: ImColliderDesc = ImColliderDesc_new(ImColliderShape_ball(0.0));
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var sb = str_builder_new();
        d.to_json(sb);
        var doc = str_builder_build(sb);
        var t, v = ImColliderDesc_from_json(str_data(doc), str_len(doc), &out);
        g_sink = t;
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# math/exp_cr: the correctly rounded exp on an ordinary argument (its fast path); no Rust row
# (glibc's exp is about 5 ns).
fn bench_exp_cr() {
    var b = bench_new("math/exp_cr");
    var x: f64 = -0.3;
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var r: f64 = _im_exp(x);
        g_sink = _im_bits(r);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# math/sin_cos_cr: the correctly rounded pair on a rotation angle (its fast path); no Rust row.
fn bench_sin_cos_cr() {
    var b = bench_new("math/sin_cos_cr");
    var x: f64 = 2.5;
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var s, c = _im_sin_cos(x);
        var sv: f64 = s;
        g_sink = _im_bits(sv);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# broadphase/aabb_tree_1000_row: rebuild the tree over 1,000 unit boxes 1.5 apart (Rust's
# aabb_tree_1000_row bench layout) and query its pairs, reusing the storage, as a world step does.
# No Rust row: Rust times the whole step (M3).
fn bench_aabb_tree_row() {
    var b = bench_new("broadphase/aabb_tree_1000_row");
    var t: ImAabbTree = ImAabbTree_new();
    var out: ImPairList = ImPairList_new();
    var reps = 100;
    bench_batch_start(b);
    for (var r = 0; r < reps; r = r + 1) {
        t.clear();
        for (var i = 0; i < 1000; i = i + 1) {
            var x: f64 = f64_from(i) * 1.5;
            t.insert(i, ImTreeAabb_from_2d(ImVec2_new(x - 0.5, -0.5), ImVec2_new(x + 0.5, 0.5)));
        }
        t.query_pairs(&out);
        g_sink = out.len;
    }
    bench_batch_stop(b, reps);
    bench_report(b);
    t.free();
    out.free();
    return 0;
}

# broadphase/spatial_hash_1000_row: the same row through the spatial hash at its automatic cell size.
fn bench_spatial_hash_row() {
    var b = bench_new("broadphase/spatial_hash_1000_row");
    var dims = fl_alloc(8000);
    var one: f64 = 1.0;
    for (var i = 0; i < 1000; i = i + 1) { store64(dims + i * 8, one); }
    var g: ImSpatialHashGrid = ImSpatialHashGrid_new(1.0);
    var out: ImPairList = ImPairList_new();
    var reps = 100;
    bench_batch_start(b);
    for (var r = 0; r < reps; r = r + 1) {
        var cell: f64 = ImSpatialHashGrid_auto_cell_size(dims, 1000);
        g.reset(cell);
        for (var i = 0; i < 1000; i = i + 1) {
            var x: f64 = f64_from(i) * 1.5;
            g.insert_2d(i, ImVec2_new(x - 0.5, -0.5), ImVec2_new(x + 0.5, 0.5));
        }
        g.query_pairs(&out);
        g_sink = out.len;
    }
    bench_batch_stop(b, reps);
    bench_report(b);
    g.free();
    out.free();
    fl_free(dims);
    return 0;
}

# Runs every bench.
fn main(): i64 {
    alloc_init();
    bench_force_magnitude();
    bench_gravity_force();
    bench_preset_steel();
    bench_preset_rubber();
    bench_degrees_to_radians();
    bench_quantity_new();
    bench_quantity_display();
    bench_serialize_body_desc();
    bench_deserialize_body_desc();
    bench_serialize_config();
    bench_roundtrip_collider_desc();
    bench_spring_1d_step();
    bench_spring_2d_step();
    bench_spring_settle_frames();
    bench_exp_cr();
    bench_sin_cos_cr();
    bench_aabb_tree_row();
    bench_spatial_hash_row();
    return 0;
}

var r = main();
sys_exit_group(r);
