# serde/roundtrip_collider_desc: a rubber ball of mass 5, written then read.
fn bench_roundtrip_collider_desc() {
    var b = bench_new("serde/roundtrip_collider_desc");
    var d: ImColliderDesc = ImColliderDesc_new(ImColliderShape_ball(1.0));
    d.material = ImPhysicsMaterial_rubber();
    d.has_mass = 1;
    d.mass = 5.0;
    var out: ImColliderDesc = ImColliderDesc_new(ImColliderShape_ball(0.0));
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var sb = str_builder_new();
        d.to_json(sb);
        var doc = str_builder_build(sb);
        var t, v = ImColliderDesc_from_json(str_data(doc), str_len(doc), &out);
        g_sink = t;
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    return 0;
}

# math/exp_cr: the correctly rounded exp on an ordinary argument (its fast path); no Rust row
# (glibc's exp is about 5 ns).
# math/hypot_cr: the correctly rounded hypot (ADR 0011 as amended), and ganita's, which it replaced,
# on (0.6, 0.8 + a small step) so no call repeats the last.
fn bench_hypot_cr() {
    var b = bench_new("math/hypot_cr");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var y: f64 = 0.8 + f64_from(i & 1023) * 0.000001;
        var r: f64 = _im_hypot(0.6, y);
        g_sink = _im_bits(r);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    var g = bench_new("math/hypot_ganita");
    bench_batch_start(g);
    for (var j = 0; j < NS; j = j + 1) {
        var y2: f64 = 0.8 + f64_from(j & 1023) * 0.000001;
        var r2: f64 = ganita_f64_hypot(0.6, y2);
        g_sink = _im_bits(r2);
    }
    bench_batch_stop(g, NS);
    bench_report(g);
    return 0;
}

# The correctly rounded pow (ADR 0011, amended for pow) against ganita's, on the radial force field's
# form: a base d² + ε² near 4, the exponent falloff/2 = 0.75.
fn bench_pow_cr() {
    var b = bench_new("math/pow_cr");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var x: f64 = 4.0001 + f64_from(i & 1023) * 0.000001;
        var r: f64 = _im_powf(x, 0.75);
        g_sink = _im_bits(r);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    var g = bench_new("math/pow_ganita");
    bench_batch_start(g);
    for (var j = 0; j < NS; j = j + 1) {
        var x2: f64 = 4.0001 + f64_from(j & 1023) * 0.000001;
        var r2: f64 = ganita_f64_pow(x2, 0.75);
        g_sink = _im_bits(r2);
    }
    bench_batch_stop(g, NS);
    bench_report(g);
    return 0;
}

# math/atan2_cr: the correctly rounded atan2 (ADR 0011, amended) on a spread of angles, against ganita's on the native
# atan (x87 on x86_64) that the port used to shadow.
fn bench_atan2_cr() {
    var b = bench_new("math/atan2_cr");
    bench_batch_start(b);
    for (var i = 0; i < NS; i = i + 1) {
        var y: f64 = 0.3 + f64_from(i & 1023) * 0.0017;
        var r: f64 = _im_atan2(y, -0.8);
        g_sink = _im_bits(r);
    }
    bench_batch_stop(b, NS);
    bench_report(b);
    var g = bench_new("math/atan2_ganita");
    bench_batch_start(g);
    for (var j = 0; j < NS; j = j + 1) {
        var y2: f64 = 0.3 + f64_from(j & 1023) * 0.0017;
        var r2: f64 = ganita_f64_atan2(y2, -0.8);
        g_sink = _im_bits(r2);
    }
    bench_batch_stop(g, NS);
    bench_report(g);
    return 0;
}

