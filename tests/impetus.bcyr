# broadphase/aabb_tree_1000_row (rebuild only): rebuild the tree over 1,000 unit boxes 1.5 apart (Rust's
# aabb_tree_1000_row bench layout) and query its pairs, reusing the storage, as a world step does. Cyrius-only: Rust
# times the whole step, whose twin (M7 part 2) is bc_aabb_tree_row.
fn bench_aabb_tree_row() {
    var b = bench_new("broadphase/aabb_tree_1000_row (rebuild only)");
    var t: ImAabbTree = ImAabbTree_new();
    var out: ImPairList = ImPairList_new();
    var reps = 100;
    bench_batch_start(b);
    for (var r = 0; r < reps; r = r + 1) {
        t.clear();
        for (var i = 0; i < 1000; i = i + 1) {
            var x: f64 = f64_from(i) * 1.5;
            t.insert(i, ImTreeAabb_from_2d(ImVec2_new(x - 0.5, -0.5), ImVec2_new(x + 0.5, 0.5)));
        }
        t.query_pairs(&out);
        g_sink = out.len;
    }
    bench_batch_stop(b, reps);
    bench_report(b);
    t.free();
    out.free();
    return 0;
}

# broadphase/spatial_hash_1000_row: the same row through the spatial hash at its automatic cell size.
fn bench_spatial_hash_row() {
    var b = bench_new("broadphase/spatial_hash_1000_row");
    var dims = fl_alloc(8000);
    var one: f64 = 1.0;
    for (var i = 0; i < 1000; i = i + 1) { store64(dims + i * 8, one); }
    var g: ImSpatialHashGrid = ImSpatialHashGrid_new(1.0);
    var out: ImPairList = ImPairList_new();
    var reps = 100;
    bench_batch_start(b);
    for (var r = 0; r < reps; r = r + 1) {
        var cell: f64 = ImSpatialHashGrid_auto_cell_size(dims, 1000);
        g.reset(cell);
        for (var i = 0; i < 1000; i = i + 1) {
            var x: f64 = f64_from(i) * 1.5;
            g.insert_2d(i, ImVec2_new(x - 0.5, -0.5), ImVec2_new(x + 0.5, 0.5));
        }
        g.query_pairs(&out);
        g_sink = out.len;
    }
    bench_batch_stop(b, reps);
    bench_report(b);
    g.free();
    out.free();
    fl_free(dims);
    return 0;
}

# b2/add_collider_mass_ball: a ball collider from its descriptor, its mass added to a body (the
# mass half of Rust's bodies/add_body_with_collider, which also times the world's arenas: M3).
fn bench_b2_add_collider_mass() {
    var b = bench_new("b2/add_collider_mass_ball");
    var bd: ImBodyDesc = ImBodyDesc_default();
    var d: ImColliderDesc = ImColliderDesc_new(ImColliderShape_ball(0.5));
    var reps = 100000;
    bench_batch_start(b);
    for (var r = 0; r < reps; r = r + 1) {
        var rb: ImRigidBody2d = ImRigidBody2d_from_desc(r, bd);
        var c: ImCollider2d = ImCollider2d_from_desc(r, r, d);
        _im_b2_add_collider_mass(&rb, &c);
        var m: f64 = rb.inv_mass;
        g_sink = m;
    }
    bench_batch_stop(b, reps);
    bench_report(b);
    return 0;
}

# b2/hull16_mass_properties: the mass, inertia and centroid of a 16-vertex convex hull.
fn bench_b2_hull_mass() {
    var b = bench_new("b2/hull16_mass_properties");
    var w = fl_alloc(16 * 24);
    for (var j = 0; j < 16; j = j + 1) {
        var t: f64 = -1.0 + f64_from(j) / 8.0;
        var den: f64 = 1.0 + t * t;
        var x: f64 = 2.0 * (1.0 - t * t) / den;
        var y: f64 = 1.5 * (2.0 * t) / den;
        var z: f64 = 0.0;
        store64(w + j * 24, x);
        store64(w + j * 24 + 8, y);
        store64(w + j * 24 + 16, z);
    }
    var s: ImColliderShape = ImColliderShape_convex_hull(w, 16);
    fl_free(w);
    var c: ImCollider2d = ImCollider2d_from_desc(0, 0, ImColliderDesc_new(s));
    var o[32];
    var reps = 100000;
    bench_batch_start(b);
    for (var r = 0; r < reps; r = r + 1) {
        c.mass_properties(&o);
        g_sink = load64(&o + 8);
    }
    bench_batch_stop(b, reps);
    bench_report(b);
    c.free();
    s.free();
    return 0;
}

# b2/world_aabb_box_rotated: a box collider's world AABB at a rotation (one correctly rounded sin_cos).
fn bench_b2_world_aabb() {
    var b = bench_new("b2/world_aabb_box_rotated");
    var c: ImCollider2d = ImCollider2d_from_desc(0, 0, ImColliderDesc_new(ImColliderShape_box(2.0, 1.0, 0.0)));
    var reps = 100000;
    bench_batch_start(b);
    for (var r = 0; r < reps; r = r + 1) {
        var rot: f64 = f64_from(r) * 0.001;
        var a: ImAabb2d = c.world_aabb(ImVec2_new(1.0, 2.0), rot);
        var mx: f64 = a.max.x;
        g_sink = mx;
    }
    bench_batch_stop(b, reps);
    bench_report(b);
    return 0;
}

# b2/contacts_<pair>: one generate_contacts_multi call on a touching pair (Cyrius only: Rust times
# the narrowphase inside its step benches, M3). The pose index varies the rotation slightly so no
# call is a repeat of the last.
fn bench_b2_contacts(name, a: *ImColliderShape, b: *ImColliderShape, bx: f64, by: f64, rb: f64) {
    var bn = bench_new(name);
    var out[80];
    var reps = 100000;
    bench_batch_start(bn);
    for (var r = 0; r < reps; r = r + 1) {
        var jitter: f64 = f64_from(r & 1023) * 0.000001;
        var rot: f64 = rb + jitter;
        g_sink = _im_b2_generate_contacts_multi(a, 0.0, 0.0, 0.0, b, bx, by, rot, &out);
    }
    bench_batch_stop(bn, reps);
    bench_report(bn);
    return 0;
}

# The narrowphase rows: ball-box, rotated box-box (clipping), a capsule lying on a box (two end
# caps), and two 8-vertex hulls.
fn bench_b2_narrowphase() {
    var ball: ImColliderShape = ImColliderShape_ball(0.5);
    var bx: ImColliderShape = ImColliderShape_box(1.0, 0.5, 0.0);
    var cap: ImColliderShape = ImColliderShape_capsule(1.0, 0.25);
    bench_b2_contacts("b2/contacts_ball_box", &bx, &ball, 0.3, 0.9, 0.0);
    bench_b2_contacts("b2/contacts_box_box_rotated", &bx, &bx, 0.5, 0.9, 0.3);
    bench_b2_contacts("b2/contacts_capsule_box_lying", &bx, &cap, 0.0, 0.74, 1.5707963267948966);
    var w = fl_alloc(8 * 24);
    for (var j = 0; j < 8; j = j + 1) {
        var t: f64 = -3.0 + 6.0 * f64_from(j + 1) / 8.0;
        var d: f64 = 1.0 + t * t;
        var x: f64 = 1.2 * (1.0 - t * t) / d;
        var y: f64 = 0.8 * (2.0 * t) / d;
        var z: f64 = 0.0;
        store64(w + j * 24, x);
        store64(w + j * 24 + 8, y);
        store64(w + j * 24 + 16, z);
    }
    var hull: ImColliderShape = ImColliderShape_convex_hull(w, 8);
    fl_free(w);
    bench_b2_contacts("b2/contacts_hull8_hull8", &hull, &hull, 0.8, 1.0, 0.4);
    hull.free();
    return 0;
}

# b2/<query>: one per-collider ray or overlap query on a collider of a static body at (1, 0.5)
# rotated by 0.4 (Cyrius only; Rust has no query bench). The ray's direction is normalised once,
# as `raycast_filtered` does before its loop; the origin steps so no call repeats the last.
fn bench_b2_ray(name, s: ImColliderShape, sphere) {
    var bd: ImBodyDesc = ImBodyDesc_default();
    bd.body_type = IM_BODY_STATIC;
    bd.position = ImVec3_new(1.0, 0.5, 0.0);
    bd.rotation = 0.4;
    var rb: ImRigidBody2d = ImRigidBody2d_from_desc(0, bd);
    var c: ImCollider2d = ImCollider2d_from_desc(0, 0, ImColliderDesc_new(s));
    var probe: ImColliderShape = ImColliderShape_ball(0.4);
    var bn = bench_new(name);
    var hit[24];
    var reps = 100000;
    bench_batch_start(bn);
    for (var r = 0; r < reps; r = r + 1) {
        var oy: f64 = 0.4 + f64_from(r & 1023) * 0.0001;
        if (sphere == 1) {
            var pbox: ImAabb2d = ImAabb2d_new(1.4, oy - 0.4, 2.2, oy + 0.4);
            g_sink = _im_b2_overlap_collider(&rb, &c, &probe, 1.8, oy, &pbox);
        } else {
            g_sink = _im_b2_raycast_collider(&rb, &c, -4.0, oy, 1.0, 0.0, &hit);
        }
    }
    bench_batch_stop(bn, reps);
    bench_report(bn);
    c.free();
    return 0;
}

# The query rows: rays on a ball, a rotated box, a capsule and an 8-vertex hull; a sphere overlap on
# the box.
fn bench_b2_queries() {
    bench_b2_ray("b2/raycast_ball", ImColliderShape_ball(0.75), 0);
    bench_b2_ray("b2/raycast_box_rotated", ImColliderShape_box(1.0, 0.5, 0.0), 0);
    bench_b2_ray("b2/raycast_capsule", ImColliderShape_capsule(0.75, 0.3), 0);
    var w = fl_alloc(8 * 24);
    for (var j = 0; j < 8; j = j + 1) {
        var t: f64 = -3.0 + 6.0 * f64_from(j + 1) / 8.0;
        var d: f64 = 1.0 + t * t;
        var x: f64 = 1.2 * (1.0 - t * t) / d;
        var y: f64 = 0.8 * (2.0 * t) / d;
        var z: f64 = 0.0;
        store64(w + j * 24, x);
        store64(w + j * 24 + 8, y);
        store64(w + j * 24 + 16, z);
    }
    var hull: ImColliderShape = ImColliderShape_convex_hull(w, 8);
    fl_free(w);
    bench_b2_ray("b2/raycast_hull8", hull, 0);
    hull.free();
    bench_b2_ray("b2/overlap_sphere_box", ImColliderShape_box(1.0, 0.5, 0.0), 1);
    return 0;
}

# bodies/* and forces/apply_*: the Rust benches' loops on an ImPhysicsState2d (PhysicsWorld's 2D
# calls are the backend's, M3a). As in Rust, add_body and add_joint grow one world.
fn bench_state(name, which) {
    var st: ImPhysicsState2d = ImPhysicsState2d_new();
    var a = st.add_body(ImBodyDesc_default());
    var b2 = st.add_body(ImBodyDesc_default());
    var bd: ImBodyDesc = ImBodyDesc_default();
    bd.position = ImVec3_new(1.0, 2.0, 0.0);
    var cd: ImColliderDesc = ImColliderDesc_new(ImColliderShape_ball(0.5));
    var z2: ImVec2 = ImVec2_new(0.0, 0.0);
    var jd: ImJointDesc = ImJointDesc_new(a, b2, ImJointType_spring(2.0, 100.0, 5.0), z2, z2);
    var fo: ImForce = ImForce_new(10.0, -5.0, 0.0);
    var im: ImImpulse = ImImpulse_new(0.0, 20.0, 0.0);
    var bn = bench_new(name);
    var reps = 100000;
    bench_batch_start(bn);
    for (var r = 0; r < reps; r = r + 1) {
        if (which == 0) {
            g_sink = st.add_body(ImBodyDesc_default());
        } elif (which == 1) {
            var h = st.add_body(ImBodyDesc_default());
            st.remove_body(h);
        } elif (which == 2) {
            var h2 = st.add_body(bd);
            var t, c = st.add_collider(h2, cd);
            g_sink = c;
        } elif (which == 3) {
            var tj, j = st.add_joint(jd);
            g_sink = j;
        } elif (which == 4) {
            st.apply_force(a, fo);
        } else {
            st.apply_impulse(a, im);
        }
    }
    bench_batch_stop(bn, reps);
    bench_report(bn);
    st.free();
    return 0;
}

# Rust's bodies/* and forces/apply_* rows on the 2D state.
fn bench_states() {
    bench_state("bodies/add_body", 0);
    bench_state("bodies/add_remove_body", 1);
    bench_state("bodies/add_body_with_collider", 2);
    bench_state("bodies/add_joint", 3);
    bench_state("forces/apply_force", 4);
    bench_state("forces/apply_impulse", 5);
    return 0;
}

# b2/joints_chain20_*: a revolute chain of 20 boxes hanging from a static anchor (collision mask 0, so
# nothing touches): preparing and solving its joints for one sub-step (4 iterations), and a whole frame
# of the stages a step runs without contacts (Cyrius only; Rust times its step whole, M3c).
fn bench_joints() {
    var st: ImPhysicsState2d = ImPhysicsState2d_new();
    var ad: ImBodyDesc = ImBodyDesc_default();
    ad.body_type = IM_BODY_STATIC;
    var prev = st.add_body(ad);
    var pdx: f64 = 0.0;
    for (var i = 0; i < 20; i = i + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        var x: f64 = 0.5 + f64_from(i);
        d.position = ImVec3_new(x, 0.0, 0.0);
        var h = st.add_body(d);
        var cd: ImColliderDesc = ImColliderDesc_new(ImColliderShape_box(0.5, 0.1, 0.0));
        cd.collision_layer = 1;
        cd.collision_mask = 0;
        var t, c = st.add_collider(h, cd);
        var rev: ImJointType = ImJointType_revolute(ImVec2_new(0.0, 0.0), 0, 0.0, 0.0);
        var tj, j = st.add_joint(ImJointDesc_new(prev, h, rev, ImVec2_new(pdx, 0.0), ImVec2_new(-0.5, 0.0)));
        prev = h;
        pdx = 0.5;
    }
    var dt: f64 = 1.0 / 60.0;
    var bn = bench_new("b2/joints_chain20_prepare_solve");
    var reps = 2000;
    bench_batch_start(bn);
    for (var r = 0; r < reps; r = r + 1) {
        st.prepare_joints(dt);
        for (var it = 0; it < 4; it = it + 1) { st.solve_joints_once(); }
    }
    bench_batch_stop(bn, reps);
    bench_report(bn);
    var bf = bench_new("b2/joints_chain20_frame");
    bench_batch_start(bf);
    for (var r2 = 0; r2 < reps; r2 = r2 + 1) { g_sink = b2_frame(&st, 1); }
    bench_batch_stop(bf, reps);
    bench_report(bf);
    st.free();
    return 0;
}

# One frame with the default world config, as PhysicsWorld::step's 2D loop: `sub` sub-steps, then
# finish_step. The event count.
fn b2_frame(st: *ImPhysicsState2d, sub): i64 {
    var cfg: ImWorldConfig = ImWorldConfig_default();
    var ts: f64 = cfg.timestep;
    var sf: f64 = f64_from(sub);
    var dt: f64 = ts / sf;
    for (var s = 0; s < sub; s = s + 1) {
        st.step(cfg.gravity, dt, cfg.velocity_iterations, cfg.position_iterations, cfg.position_slop,
          cfg.position_correction, cfg.max_velocity, cfg.constraint_frequency, cfg.constraint_damping_ratio,
          cfg.broadphase, cfg.solver);
    }
    return st.finish_step();
}

# Rust's world/step_N_bodies scene: n dynamic balls of radius 0.5 in rows of `per` (1 apart, rows 2
# apart), falling together; stepped `warm` frames first, then timed `reps` frames.
fn bench_step_balls(name, n, per, warm, reps) {
    var st: ImPhysicsState2d = ImPhysicsState2d_new();
    for (var i = 0; i < n; i = i + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        var x: f64 = f64_from(i % per);
        var y: f64 = f64_from(i / per) * 2.0;
        d.position = ImVec3_new(x, y, 0.0);
        var h = st.add_body(d);
        var t, c = st.add_collider(h, ImColliderDesc_new(ImColliderShape_ball(0.5)));
    }
    for (var w = 0; w < warm; w = w + 1) { b2_frame(&st, 1); }
    var bn = bench_new(name);
    bench_batch_start(bn);
    for (var r = 0; r < reps; r = r + 1) { g_sink = b2_frame(&st, 1); }
    bench_batch_stop(bn, reps);
    bench_report(bn);
    st.free();
    return 0;
}

# Rust's world/step_N_bodies scene through the world (M3d): n balls in rows of `per`, falling together.
fn bench_world_balls(name, n, per, warm, reps) {
    var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    for (var i = 0; i < n; i = i + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        var x: f64 = f64_from(i % per);
        var y: f64 = f64_from(i / per) * 2.0;
        d.position = ImVec3_new(x, y, 0.0);
        var h = w.add_body(d);
        var t, c = w.add_collider(h, ImColliderDesc_new(ImColliderShape_ball(0.5)));
    }
    for (var k = 0; k < warm; k = k + 1) { w.step(); }
    var bn = bench_new(name);
    bench_batch_start(bn);
    for (var r = 0; r < reps; r = r + 1) { w.step(); }
    bench_batch_stop(bn, reps);
    bench_report(bn);
    w.free();
    return 0;
}

# A fresh world with n particles of radius 0.05 in rows of `per`, 2 apart from y = 5 (Rust's
# particles/step_N_particles), one step timed per sample.
fn bench_fresh_particles(name, n, per, reps) {
    var bn = bench_new(name);
    for (var r = 0; r < reps; r = r + 1) {
        var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
        for (var i = 0; i < n; i = i + 1) {
            var x: f64 = f64_from(i % per);
            var y: f64 = f64_from(i / per) * 2.0 + 5.0;
            var p: ImParticle = ImParticle_new(ImVec3_new(x, y, 0.0), ImVec3_zero(), 100.0);
            p.with_radius(0.05);
            w.spawn_particle(p);
        }
        bench_start(bn);
        w.step();
        bench_stop(bn);
        w.free();
    }
    bench_report(bn);
    return 0;
}

# The world (M3d) against Rust's world/* and particles/* rows.
fn bench_world() {
    var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    var be = bench_new("world/step_empty");
    bench_batch_start(be);
    for (var r = 0; r < 100000; r = r + 1) { w.step(); }
    bench_batch_stop(be, 100000);
    bench_report(be);
    w.free();
    bench_world_balls("world/step_10_bodies", 10, 5, 100, 2000);
    bench_world_balls("world/step_100_bodies", 100, 10, 100, 200);
    bench_world_balls("world/step_1000_bodies", 1000, 32, 20, 20);
    bench_fresh_particles("particles/step_100_particles", 100, 10, 2000);
    bench_fresh_particles("particles/step_1000_particles", 1000, 32, 200);
    # A floor and 100 falling particles, stepped on and on as criterion does (they expire at 10 s).
    w = ImPhysicsWorld_new(ImWorldConfig_default());
    var fd: ImBodyDesc = ImBodyDesc_default();
    fd.body_type = IM_BODY_STATIC;
    var fh = w.add_body(fd);
    var tf, cf = w.add_collider(fh, ImColliderDesc_new(ImColliderShape_box(50.0, 0.5, 0.0)));
    for (var i = 0; i < 100; i = i + 1) {
        var x: f64 = f64_from(i % 10);
        var y: f64 = f64_from(i / 10) + 1.0;
        var p: ImParticle = ImParticle_new(ImVec3_new(x, y, 0.0), ImVec3_new(0.0, -2.0, 0.0), 10.0);
        p.with_radius(0.05).with_restitution(0.5);
        w.spawn_particle(p);
    }
    var bf = bench_new("particles/step_100_particles_with_floor");
    bench_batch_start(bf);
    for (var r2 = 0; r2 < 100000; r2 = r2 + 1) { w.step(); }
    bench_batch_stop(bf, 100000);
    bench_report(bf);
    w.free();
    w = ImPhysicsWorld_new(ImWorldConfig_default());
    var bs = bench_new("particles/spawn_particle");
    bench_batch_start(bs);
    for (var r3 = 0; r3 < 100000; r3 = r3 + 1) {
        g_sink = w.spawn_particle(ImParticle_new(ImVec3_zero(), ImVec3_new(1.0, 2.0, 0.0), 3.0));
    }
    bench_batch_stop(bs, 100000);
    bench_report(bs);
    w.free();
    w = ImPhysicsWorld_new(ImWorldConfig_default());
    var em: ImParticleEmitter = ImParticleEmitter_new(ImVec3_zero(), ImVec3_new(0.0, 10.0, 0.0), 100.0);
    em.with_lifetime(0.5);
    w.add_emitter(em);
    var bm = bench_new("particles/emitter_step");
    bench_batch_start(bm);
    for (var r4 = 0; r4 < 100000; r4 = r4 + 1) { w.step(); }
    bench_batch_stop(bm, 100000);
    bench_report(bm);
    w.free();
    return 0;
}

# The 2D step with contacts (M3c): Rust's world/step_* scenes through the backend, and a settled stack
# of five boxes (two-point manifolds through the block solver, warm started).
fn bench_step() {
    var st: ImPhysicsState2d = ImPhysicsState2d_new();
    var be = bench_new("b2/step_empty");
    bench_batch_start(be);
    for (var r = 0; r < 100000; r = r + 1) { g_sink = b2_frame(&st, 1); }
    bench_batch_stop(be, 100000);
    bench_report(be);
    st.free();
    bench_step_balls("b2/step_10_bodies", 10, 5, 100, 2000);
    bench_step_balls("b2/step_100_bodies", 100, 10, 100, 200);
    bench_step_balls("b2/step_1000_bodies", 1000, 32, 20, 20);
    st = ImPhysicsState2d_new();
    var gd: ImBodyDesc = ImBodyDesc_default();
    gd.body_type = IM_BODY_STATIC;
    gd.position = ImVec3_new(0.0, -0.5, 0.0);
    var g = st.add_body(gd);
    var tg, cg = st.add_collider(g, ImColliderDesc_new(ImColliderShape_box(20.0, 0.5, 0.0)));
    for (var i = 0; i < 5; i = i + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        var y: f64 = 0.5 + f64_from(i);
        d.position = ImVec3_new(0.0, y, 0.0);
        var h = st.add_body(d);
        var t, c = st.add_collider(h, ImColliderDesc_new(ImColliderShape_box(0.5, 0.5, 0.0)));
    }
    # Settle, then wake the stack every frame so it never sleeps.
    for (var w = 0; w < 120; w = w + 1) { b2_frame(&st, 1); }
    var bs = bench_new("b2/step_stack5_resting");
    bench_batch_start(bs);
    for (var r2 = 0; r2 < 2000; r2 = r2 + 1) {
        for (var k = 1; k <= 5; k = k + 1) {
            var rb: *ImRigidBody2d = st._body(k);
            _im_b2_wake(rb);
        }
        g_sink = b2_frame(&st, 1);
    }
    bench_batch_stop(bs, 2000);
    bench_report(bs);
    st.free();
    return 0;
}

# Rust's snapshot/* scenes (an empty world; 100 balls in rows of 10) at the struct (M6 part 1, ADR 0013): a capture
# and its free, and a restore into a fresh world and its free. Rust's rows go through bytes, which part 2 adds.
fn bench_snapshot() {
    var e: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    var s: ImWorldSnapshot = ImWorldSnapshot_new();
    var b1 = bench_new("snapshot/capture_empty (struct)");
    bench_batch_start(b1);
    for (var r = 0; r < 100000; r = r + 1) {
        var t1, v1 = e.snapshot(&s);
        s.free();
    }
    bench_batch_stop(b1, 100000);
    bench_report(b1);
    e.free();
    var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    for (var i = 0; i < 100; i = i + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        var x: f64 = f64_from(i % 10);
        var y: f64 = f64_from(i / 10);
        d.position = ImVec3_new(x, y, 0.0);
        var h = w.add_body(d);
        var tc, c = w.add_collider(h, ImColliderDesc_new(ImColliderShape_ball(0.5)));
    }
    var b2 = bench_new("snapshot/capture_100_bodies (struct)");
    bench_batch_start(b2);
    for (var r2 = 0; r2 < 10000; r2 = r2 + 1) {
        var t2, v2 = w.snapshot(&s);
        s.free();
    }
    bench_batch_stop(b2, 10000);
    bench_report(b2);
    var keep: ImWorldSnapshot = ImWorldSnapshot_new();
    var t3, v3 = w.snapshot(&keep);
    var b3 = bench_new("snapshot/restore_100_bodies (struct)");
    bench_batch_start(b3);
    for (var r3 = 0; r3 < 10000; r3 = r3 + 1) {
        var fresh: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
        var t4, v4 = fresh.restore(&keep);
        g_sink = t4;
        fresh.free();
    }
    bench_batch_stop(b3, 10000);
    bench_report(b3);
    keep.free();
    w.free();
    return 0;
}

# Rust's snapshot/* rows through the binary form (M6 part 2, ADR 0013): serialize an empty world, serialize 100 balls,
# and the round trip of those bytes into a fresh world. The byte buffer is reused, where Rust allocates a Vec a call.
fn bench_snapshot_bytes() {
    var e: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    var bytes: ImWordList = ImWordList_new();
    var b1 = bench_new("snapshot/serialize_empty");
    bench_batch_start(b1);
    for (var r = 0; r < 100000; r = r + 1) {
        var t1, v1 = serialize_world(&e, &bytes);
        g_sink = t1;
    }
    bench_batch_stop(b1, 100000);
    bench_report(b1);
    e.free();
    var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    for (var i = 0; i < 100; i = i + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        var x: f64 = f64_from(i % 10);
        var y: f64 = f64_from(i / 10);
        d.position = ImVec3_new(x, y, 0.0);
        var h = w.add_body(d);
        var tc, c = w.add_collider(h, ImColliderDesc_new(ImColliderShape_ball(0.5)));
    }
    var b2 = bench_new("snapshot/serialize_100_bodies");
    bench_batch_start(b2);
    for (var r2 = 0; r2 < 10000; r2 = r2 + 1) {
        var t2, v2 = serialize_world(&w, &bytes);
        g_sink = t2;
    }
    bench_batch_stop(b2, 10000);
    bench_report(b2);
    var t3, v3 = serialize_world(&w, &bytes);
    var b3 = bench_new("snapshot/roundtrip_100_bodies");
    bench_batch_start(b3);
    for (var r3 = 0; r3 < 10000; r3 = r3 + 1) {
        var fresh: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
        var t4, v4 = deserialize_world(&fresh, bytes.data, bytes.len * 8);
        g_sink = t4;
        fresh.free();
    }
    bench_batch_stop(b3, 10000);
    bench_report(b3);
    bytes.free();
    w.free();
    return 0;
}

# The snapshot's JSON form (M6 part 3, ADR 0013) on Rust's 100-ball scene: a snapshot written as JSON, and that text
# read and restored into a fresh world. Cyrius only: Rust has no JSON snapshot bench.
fn bench_snapshot_json() {
    var w: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    for (var i = 0; i < 100; i = i + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        var x: f64 = f64_from(i % 10);
        var y: f64 = f64_from(i / 10);
        d.position = ImVec3_new(x, y, 0.0);
        var h = w.add_body(d);
        var tc, c = w.add_collider(h, ImColliderDesc_new(ImColliderShape_ball(0.5)));
    }
    var s: ImWorldSnapshot = ImWorldSnapshot_new();
    var t0, v0 = w.snapshot(&s);
    var b1 = bench_new("snapshot/to_json_100_bodies");
    bench_batch_start(b1);
    for (var r = 0; r < 2000; r = r + 1) {
        var sb = str_builder_new();
        var t1, v1 = s.to_json(sb);
        g_sink = t1;
    }
    bench_batch_stop(b1, 2000);
    bench_report(b1);
    var sbk = str_builder_new();
    var t2, v2 = s.to_json(sbk);
    var text = str_builder_build(sbk);
    var b2 = bench_new("snapshot/json_roundtrip_100_bodies");
    bench_batch_start(b2);
    for (var r2 = 0; r2 < 2000; r2 = r2 + 1) {
        var back: ImWorldSnapshot = ImWorldSnapshot_new();
        var t3, v3 = ImWorldSnapshot_from_json(str_data(text), str_len(text), &back);
        var fresh: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
        var t4, v4 = fresh.restore(&back);
        g_sink = t4;
        fresh.free();
        back.free();
    }
    bench_batch_stop(b2, 2000);
    bench_report(b2);
    s.free();
    w.free();
    return 0;
}

# Rust's rows that had no 2D twin before M7 part 2, on its scenes: the queries, the body mutations, the sub-stepped
# floor, a revolute chain, and (tests/bench_cases.cyr, shared with 3D) the overlap, set_body_type, the box stack and
# the AABB-tree row.
fn bench_rust_rest() {
    var qw: ImPhysicsWorld = bc_still_world();
    bc_ball_grid(&qw);
    var hit: ImRayHit;
    var o: ImVec3 = ImVec3_zero();
    var dx: ImVec3 = ImVec3_new(1.0, 0.0, 0.0);
    var br = bench_new("queries/raycast_100_bodies");
    bench_batch_start(br);
    for (var r = 0; r < 100000; r = r + 1) { g_sink = qw.raycast(o, dx, 100.0, &hit); }
    bench_batch_stop(br, 100000);
    bench_report(br);
    qw.free();
    bc_overlap_sphere("queries/overlap_sphere_100_bodies");

    # mutation/*: a dynamic ball of radius 0.5; Rust's state written back each time.
    var mw: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    var mh = mw.add_body(ImBodyDesc_default());
    var tm, cm = mw.add_collider(mh, ImColliderDesc_new(ImColliderShape_ball(0.5)));
    var bs: ImBodyState;
    var bg = bench_new("mutation/get_body_state");
    bench_batch_start(bg);
    for (var r2 = 0; r2 < N; r2 = r2 + 1) {
        var tg, vg = mw.get_body_state(mh, &bs);
        g_sink = is_ok(tg);
    }
    bench_batch_stop(bg, N);
    bench_report(bg);
    var ns: ImBodyState = bs;
    ns.handle = mh;
    ns.body_type = IM_BODY_DYNAMIC;
    ns.position = ImVec3_new(5.0, 10.0, 0.0);
    ns.rotation = 0.5;
    ns.linear_velocity = ImVec3_new(1.0, 2.0, 0.0);
    ns.angular_velocity = 0.1;
    ns.is_sleeping = 0;
    var bset = bench_new("mutation/set_body_state");
    bench_batch_start(bset);
    for (var r3 = 0; r3 < N; r3 = r3 + 1) {
        var ts, vs = mw.set_body_state(mh, ns);
        g_sink = is_ok(ts);
    }
    bench_batch_stop(bset, N);
    bench_report(bset);
    mw.free();
    bc_set_body_type("mutation/set_body_type");

    # substep/step_100_bodies_substep4: 100 balls over a static floor (half extents 50, 0.5), four sub-steps a frame.
    var c4: ImWorldConfig = ImWorldConfig_default();
    c4.sub_steps = 4;
    var sw: ImPhysicsWorld = ImPhysicsWorld_new(c4);
    var fd: ImBodyDesc = ImBodyDesc_default();
    fd.body_type = IM_BODY_STATIC;
    fd.position = ImVec3_new(0.0, -0.5, 0.0);
    var fl = sw.add_body(fd);
    var tf, cf = sw.add_collider(fl, ImColliderDesc_new(ImColliderShape_box(50.0, 0.5, 0.0)));
    for (var i = 0; i < 100; i = i + 1) {
        var d: ImBodyDesc = ImBodyDesc_default();
        var x: f64 = f64_from(i % 10);
        var y: f64 = f64_from(i / 10) * 2.0 + 1.0;
        d.position = ImVec3_new(x, y, 0.0);
        var h = sw.add_body(d);
        var tb, cb = sw.add_collider(h, ImColliderDesc_new(ImColliderShape_ball(0.5)));
    }
    var bsub = bench_new("substep/step_100_bodies_substep4");
    bench_batch_start(bsub);
    for (var r4 = 0; r4 < 200; r4 = r4 + 1) { sw.step(); }
    bench_batch_stop(bsub, 200);
    bench_report(bsub);
    sw.free();
    bc_box_stack_10("stacking/box_stack_10");

    # joints/revolute_chain_20: 20 thin links (half extents 0.5, 0.05) hanging from a static anchor at (0, 20) by
    # revolute joints, swinging.
    var jw: ImPhysicsWorld = ImPhysicsWorld_new(ImWorldConfig_default());
    var ad: ImBodyDesc = ImBodyDesc_default();
    ad.body_type = IM_BODY_STATIC;
    ad.position = ImVec3_new(0.0, 20.0, 0.0);
    var prev = jw.add_body(ad);
    for (var k = 0; k < 20; k = k + 1) {
        var ld: ImBodyDesc = ImBodyDesc_default();
        var lx: f64 = 0.5 + f64_from(k);
        ld.position = ImVec3_new(lx, 20.0, 0.0);
        var link = jw.add_body(ld);
        var tl, cl = jw.add_collider(link, ImColliderDesc_new(ImColliderShape_box(0.5, 0.05, 0.05)));
        var la: ImVec2 = ImVec2_new(0.5, 0.0);
        if (k == 0) { la = ImVec2_new(0.0, 0.0); }
        var rev: ImJointType = ImJointType_revolute(ImVec2_new(0.0, 0.0), 0, 0.0, 0.0);
        var tj, jh = jw.add_joint(ImJointDesc_new(prev, link, rev, la, ImVec2_new(-0.5, 0.0)));
        prev = link;
    }
    var bj = bench_new("joints/revolute_chain_20");
    bench_batch_start(bj);
    for (var r5 = 0; r5 < 2000; r5 = r5 + 1) { jw.step(); }
    bench_batch_stop(bj, 2000);
    bench_report(bj);
    jw.free();
    bc_aabb_tree_row("broadphase/aabb_tree_1000_row");
    return 0;
}

# Runs every bench.
fn main(): i64 {
    alloc_init();
    bench_force_magnitude();
    bench_gravity_force();
    bench_preset_steel();
    bench_preset_rubber();
    bench_degrees_to_radians();
    bench_quantity_new();
    bench_quantity_display();
    bench_serialize_body_desc();
    bench_deserialize_body_desc();
    bench_serialize_config();
    bench_roundtrip_collider_desc();
    bench_spring_1d_step();
    bench_spring_2d_step();
    bench_spring_settle_frames();
    bench_exp_cr();
    bench_sin_cos_cr();
    bench_hypot_cr();
    bench_pow_cr();
    bench_atan2_cr();
    bench_aabb_tree_row();
    bench_spatial_hash_row();
    bench_b2_add_collider_mass();
    bench_b2_hull_mass();
    bench_b2_world_aabb();
    bench_b2_narrowphase();
    bench_b2_queries();
    bench_states();
    bench_joints();
    bench_step();
    bench_world();
    bench_snapshot();
    bench_snapshot_bytes();
    bench_snapshot_json();
    bench_rust_rest();
    return 0;
}

var r = main();
sys_exit_group(r);
