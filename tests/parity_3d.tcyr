# parity_3d.tcyr — replays the 3D backend's golden modules (tests/golden/b3_*.tsv) against the port.
#
# The 3D twin of tests/parity_2d.tcyr, which replays the shared modules and the 2D backend's (`b2_*`). The replay
# machinery is tests/parity_core.cyr; this file holds the 3D dispatchers. Rows are ok, FAILED, measured, accepted or
# pending exactly as there, and the exit code is the number of modules with a failure. The 3D math and backend are
# impetus-owned (ADR 0012), so their rows are classes A–C, gated at 0 ulp against the corrected oracle.

include "tests/ulp.cyr"
include "tests/lib_3d.cyr"
include "tests/step3.cyr"

alloc_init();

include "tests/parity_core.cyr"
include "tests/parity_types.cyr"

# ── hooks ───────────────────────────────────────────────────────────────────────────

# The Rust variant name of an error code (src/error.cyr).
#must_use
fn _par_error_name(code): i64 {
    return im_error_name(code);
}

# ── cross-target digest ─────────────────────────────────────────────────────────────
# A 64-bit FNV-1a-style fold (word at a time) of every output word b3_math returns, in row order, as parity_2d.tcyr
# does for the math module: equal digests on x86_64 ELF, x86_64 PE and aarch64 mean bit-identical results on every
# row.
var _par_dg3: i64 = 0xcbf29ce484222325;

fn _par_dg3_fold() {
    for (var k = 0; k < _par_got_n; k = k + 1) {
        _par_dg3 = (_par_dg3 ^ load64(_par_got_v + k * 8)) * 0x100000001b3;
    }
    return 0;
}

# ── token helpers (the shared types' are tests/parity_types.cyr) ─────────────────────

# Input tokens k..k+3 as a quaternion (x, y, z, w).
#must_use
fn _par_in_q4(k): ImQuat {
    var x: f64 = _par_in(k);
    var y: f64 = _par_in(k + 1);
    var z: f64 = _par_in(k + 2);
    var w: f64 = _par_in(k + 3);
    return ImQuat_new(x, y, z, w);
}

# Input tokens k..k+8 as a matrix, by columns.
#must_use
fn _par_in_m9(k): ImMat3 {
    return ImMat3_from_cols(_par_in_v3(k), _par_in_v3(k + 3), _par_in_v3(k + 6));
}

fn _par_got_q4(q: ImQuat) {
    _par_got_f(q.x);
    _par_got_f(q.y);
    _par_got_f(q.z);
    _par_got_f(q.w);
    return 0;
}

fn _par_got_m9(m: ImMat3) {
    _par_got_v3(m.x);
    _par_got_v3(m.y);
    _par_got_v3(m.z);
    return 0;
}

# ── b3_math: glam's 3D math (src/math3.cyr) ─────────────────────────────────────────

# Vector rows: one vector, two vectors, or a vector and a scalar in.
fn _par_b3_vec(fp, fl): i64 {
    var a: ImVec3 = _par_in_v3(0);
    if (_par_eq(fp, fl, "DVec3::neg") == 1) { _par_got_v3(ImVec3_neg(a)); return 1; }
    if (_par_eq(fp, fl, "DVec3::abs") == 1) { _par_got_v3(ImVec3_abs(a)); return 1; }
    if (_par_eq(fp, fl, "DVec3::is_finite") == 1) { _par_got_i(ImVec3_is_finite(a)); return 1; }
    if (_par_eq(fp, fl, "DVec3::length_squared") == 1) {
        var r: f64 = ImVec3_length_squared(a);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "DVec3::length") == 1) {
        var r: f64 = ImVec3_length(a);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "DVec3::length_recip") == 1) {
        var r: f64 = ImVec3_length_recip(a);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "DVec3::normalize") == 1) { _par_got_v3(ImVec3_normalize(a)); return 1; }
    if (_par_eq(fp, fl, "DVec3::try_normalize") == 1) {
        var out: ImVec3 = ImVec3_zero();
        if (ImVec3_try_normalize(a, &out) == 1) { _par_got_v3(out); } else { _par_got_none(); }
        return 1;
    }
    if (_par_eq(fp, fl, "DVec3::normalize_or_zero") == 1) { _par_got_v3(ImVec3_normalize_or_zero(a)); return 1; }
    if (_par_eq(fp, fl, "DVec3::any_orthogonal_vector") == 1) {
        _par_got_v3(ImVec3_any_orthogonal_vector(a));
        return 1;
    }
    if (_par_eq(fp, fl, "DVec3::any_orthonormal_pair") == 1) {
        var p: ImVec3 = ImVec3_zero();
        var q: ImVec3 = ImVec3_zero();
        ImVec3_any_orthonormal_pair(a, &p, &q);
        _par_got_v3(p);
        _par_got_v3(q);
        return 1;
    }
    if (_par_in_n == 4) {
        var s: f64 = _par_in(3);
        if (_par_eq(fp, fl, "DVec3::mul_f64") == 1) { _par_got_v3(ImVec3_scale(a, s)); return 1; }
        if (_par_eq(fp, fl, "DVec3::div_f64") == 1) { _par_got_v3(ImVec3_div_scalar(a, s)); return 1; }
        return 0;
    }
    var b: ImVec3 = _par_in_v3(3);
    if (_par_in_n == 9) {
        if (_par_eq(fp, fl, "DVec3::clamp") == 1) { _par_got_v3(ImVec3_clamp(a, b, _par_in_v3(6))); return 1; }
        return 0;
    }
    if (_par_eq(fp, fl, "DVec3::add") == 1) { _par_got_v3(a + b); return 1; }
    if (_par_eq(fp, fl, "DVec3::sub") == 1) { _par_got_v3(a - b); return 1; }
    if (_par_eq(fp, fl, "DVec3::mul") == 1) { _par_got_v3(ImVec3_mul_elem(a, b)); return 1; }
    if (_par_eq(fp, fl, "DVec3::min") == 1) { _par_got_v3(ImVec3_min(a, b)); return 1; }
    if (_par_eq(fp, fl, "DVec3::max") == 1) { _par_got_v3(ImVec3_max(a, b)); return 1; }
    if (_par_eq(fp, fl, "DVec3::dot") == 1) {
        var r: f64 = ImVec3_dot(a, b);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "DVec3::cross") == 1) { _par_got_v3(ImVec3_cross(a, b)); return 1; }
    if (_par_eq(fp, fl, "DVec3::normalize_or") == 1) { _par_got_v3(ImVec3_normalize_or(a, b)); return 1; }
    return 0;
}

# Quaternion rows: an angle, one quaternion, two, or a quaternion and a vector in.
fn _par_b3_quat(fp, fl): i64 {
    if (_par_in_n == 1) {
        var ang: f64 = _par_in(0);
        if (_par_eq(fp, fl, "DQuat::from_rotation_x") == 1) { _par_got_q4(ImQuat_from_rotation_x(ang)); return 1; }
        if (_par_eq(fp, fl, "DQuat::from_rotation_y") == 1) { _par_got_q4(ImQuat_from_rotation_y(ang)); return 1; }
        if (_par_eq(fp, fl, "DQuat::from_rotation_z") == 1) { _par_got_q4(ImQuat_from_rotation_z(ang)); return 1; }
        return 0;
    }
    var q: ImQuat = _par_in_q4(0);
    if (_par_eq(fp, fl, "DQuat::conjugate") == 1) { _par_got_q4(ImQuat_conjugate(q)); return 1; }
    if (_par_eq(fp, fl, "DQuat::inverse") == 1) { _par_got_q4(ImQuat_inverse(q)); return 1; }
    if (_par_eq(fp, fl, "DQuat::is_finite") == 1) { _par_got_i(ImQuat_is_finite(q)); return 1; }
    if (_par_eq(fp, fl, "DQuat::length_squared") == 1) {
        var r: f64 = ImQuat_length_squared(q);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "DQuat::normalize") == 1) { _par_got_q4(ImQuat_normalize(q)); return 1; }
    if (_par_eq(fp, fl, "DQuat::mul_quat") == 1) { _par_got_q4(ImQuat_mul_quat(q, _par_in_q4(4))); return 1; }
    if (_par_eq(fp, fl, "DQuat::mul_vec3") == 1) { _par_got_v3(ImQuat_mul_vec3(q, _par_in_v3(4))); return 1; }
    return 0;
}

# Matrix rows: a quaternion, a diagonal, one matrix, two, or a matrix and a vector or scalar in.
fn _par_b3_mat(fp, fl): i64 {
    if (_par_eq(fp, fl, "DMat3::from_quat") == 1) { _par_got_m9(ImMat3_from_quat(_par_in_q4(0))); return 1; }
    if (_par_eq(fp, fl, "DMat3::from_diagonal") == 1) { _par_got_m9(ImMat3_from_diagonal(_par_in_v3(0))); return 1; }
    var a: ImMat3 = _par_in_m9(0);
    if (_par_eq(fp, fl, "DMat3::transpose") == 1) { _par_got_m9(ImMat3_transpose(a)); return 1; }
    if (_par_eq(fp, fl, "DMat3::neg") == 1) { _par_got_m9(ImMat3_neg(a)); return 1; }
    if (_par_eq(fp, fl, "DMat3::determinant") == 1) {
        var r: f64 = ImMat3_determinant(a);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "DMat3::inverse") == 1) { _par_got_m9(ImMat3_inverse(a)); return 1; }
    if (_par_eq(fp, fl, "DMat3::mul_vec3") == 1) { _par_got_v3(ImMat3_mul_vec3(a, _par_in_v3(9))); return 1; }
    if (_par_eq(fp, fl, "DMat3::mul_scalar") == 1) {
        var s: f64 = _par_in(9);
        _par_got_m9(ImMat3_mul_scalar(a, s));
        return 1;
    }
    var b: ImMat3 = _par_in_m9(9);
    if (_par_eq(fp, fl, "DMat3::add_mat3") == 1) { _par_got_m9(a + b); return 1; }
    if (_par_eq(fp, fl, "DMat3::sub_mat3") == 1) { _par_got_m9(a - b); return 1; }
    if (_par_eq(fp, fl, "DMat3::mul_mat3") == 1) { _par_got_m9(ImMat3_mul_mat3(a, b)); return 1; }
    return 0;
}

fn _par_b3_math(fp, fl): i64 {
    if (fl > 7 && _par_eq(fp, 7, "DVec3::") == 1) { return _par_b3_vec(fp, fl); }
    if (fl > 7 && _par_eq(fp, 7, "DQuat::") == 1) { return _par_b3_quat(fp, fl); }
    if (fl > 7 && _par_eq(fp, 7, "DMat3::") == 1) { return _par_b3_mat(fp, fl); }
    return 0;
}

# ── b3_body: the 3D backend's bodies (src/b3_types.cyr) ─────────────────────────────
# `b3::body`: a body from its descriptor, each collider (shape, offset, density, explicit mass) added in order. Rust
# recomputes the mass from all of the body's colliders on every add, so the last recompute is the one that stands;
# with no collider none runs and the body keeps from_desc's zeros. Outputs every stored field but the handle and type.

fn _par_b3_body(fp, fl): i64 {
    if (_par_eq(fp, fl, "b3::body") != 1) { return 0; }
    var bd: ImBodyDesc = _par_in_body_desc(0);
    var b: ImRigidBody3d = ImRigidBody3d_from_desc(0, bd);
    var n = _par_in(13);
    var k = 14;
    if (n > 0) { _im_b3_mass_reset(&b); }
    for (var j = 0; j < n; j = j + 1) {
        var sh: ImColliderShape = _im_shape(IM_SHAPE_BALL);
        k = _par_in_shape(k, &sh);
        var d: ImColliderDesc = ImColliderDesc_new(sh);
        d.offset = _par_in_v3(k);
        var den: f64 = _par_in(k + 3);
        var mat: ImPhysicsMaterial = ImPhysicsMaterial_default();
        mat.density = den;
        d.material = mat;
        if (_par_in_is_none(k + 4) == 0) {
            var ms: f64 = _par_in(k + 4);
            d.has_mass = 1;
            d.mass = ms;
        }
        var c: ImCollider3d = ImCollider3d_from_desc(j, 0, d);
        _im_b3_mass_add(&b, &c);
        c.free();
        sh.free();
        k = k + 5;
    }
    if (n > 0) { _im_b3_mass_finish(&b); }
    var ld: f64 = b.linear_damping;
    var ad: f64 = b.angular_damping;
    var gs: f64 = b.gravity_scale;
    var m: f64 = b.mass;
    var im: f64 = b.inv_mass;
    var st: f64 = b.sleep_timer;
    _par_got_v3(b.position);
    _par_got_q4(b.rotation);
    _par_got_v3(b.linear_velocity);
    _par_got_v3(b.angular_velocity);
    _par_got_f(ld);
    _par_got_f(ad);
    _par_got_i(b.fixed_rotation);
    _par_got_f(gs);
    _par_got_v3(b.force_accumulator);
    _par_got_v3(b.torque_accumulator);
    _par_got_f(m);
    _par_got_f(im);
    _par_got_m9(b.inertia);
    _par_got_m9(b.inv_inertia);
    _par_got_m9(b.inv_inertia_world);
    _par_got_v3(b.pseudo_velocity);
    _par_got_v3(b.pseudo_angular_velocity);
    _par_got_i(b.is_sleeping);
    _par_got_f(st);
    return 1;
}

# ── b3_narrow: the 3D narrowphase (src/b3_narrowphase.cyr) ───────────────────────────
# `b3::contact`: shape A, its position and rotation (x, y, z, w), then shape B and its pose; `n:` or the normal, the
# depth and the point. One GJK scratch serves every row, as a world's would serve every pair.

var _par_gjk = 0;

#must_use
fn _par_as_gjk(p): *ImGjkScratch3d { return p; }

fn _par_b3_narrow(fp, fl): i64 {
    if (_par_eq(fp, fl, "b3::contact") != 1) { return 0; }
    if (_par_gjk == 0) {
        _par_gjk = fl_alloc(sizeof(ImGjkScratch3d));
        var fresh: ImGjkScratch3d = ImGjkScratch3d_new();
        memcpy(_par_gjk, &fresh, sizeof(ImGjkScratch3d));
    }
    var sa: ImColliderShape = _im_shape(IM_SHAPE_BALL);
    var sb: ImColliderShape = _im_shape(IM_SHAPE_BALL);
    var k = _par_in_shape(0, &sa);
    var pa: ImVec3 = _par_in_v3(k);
    var ra: ImQuat = _par_in_q4(k + 3);
    k = _par_in_shape(k + 7, &sb);
    var pb: ImVec3 = _par_in_v3(k);
    var rb: ImQuat = _par_in_q4(k + 3);
    var h: ImHit3d;
    if (_im_b3_generate_contact_3d(&sa, pa, ra, &sb, pb, rb, _par_as_gjk(_par_gjk), &h) == 1) {
        var d: f64 = h.depth;
        _par_got_v3(h.normal);
        _par_got_f(d);
        _par_got_v3(h.point);
    } else {
        _par_got_none();
    }
    sa.free();
    sb.free();
    return 1;
}

# ── b3_ray: the 3D raycast (src/b3_raycast.cyr) ─────────────────────────────────────
# `b3::raycast`: static bodies, one collider each, inserted into a body arena and a collider arena as Rust's
# add_body and add_collider do (each record's handle set after its insert); then the ray, with its mask or `n:` for
# the unfiltered `raycast`. Output: `n:`, or the collider handle, the point, the normal and the distance.

fn _par_b3_ray(fp, fl): i64 {
    if (_par_eq(fp, fl, "b3::raycast") != 1) { return 0; }
    var bodies: *ImArena = ImArena_new(sizeof(ImRigidBody3d));
    var colls: *ImArena = ImArena_new(sizeof(ImCollider3d));
    var n = _par_in(0);
    var k = 1;
    for (var i = 0; i < n; i = i + 1) {
        var pos: ImVec3 = _par_in_v3(k);
        var rot: f64 = _par_in(k + 3);
        var sh: ImColliderShape = _im_shape(IM_SHAPE_BALL);
        k = _par_in_shape(k + 4, &sh);
        var bd: ImBodyDesc = ImBodyDesc_default();
        bd.body_type = IM_BODY_STATIC;
        bd.position = pos;
        bd.rotation = rot;
        var b: ImRigidBody3d = ImRigidBody3d_from_desc(0, bd);
        var bh = bodies.insert(&b);
        var bp: *ImRigidBody3d = _im_b3_as_body(bodies.get(bh));
        bp.handle = bh;
        var cd: ImColliderDesc = ImColliderDesc_new(sh);
        cd.offset = _par_in_v3(k);
        cd.collision_layer = _par_in(k + 3);
        var c: ImCollider3d = ImCollider3d_from_desc(0, bh, cd);
        var ch = colls.insert(&c);
        var cp: *ImCollider3d = _im_b3_as_coll(colls.get(ch));
        cp.handle = ch;
        sh.free();
        k = k + 4;
    }
    var o: ImVec3 = _par_in_v3(k);
    var d: ImVec3 = _par_in_v3(k + 3);
    var max: f64 = _par_in(k + 6);
    var has_mask = 1 - _par_in_is_none(k + 7);
    var mask = 0;
    if (has_mask == 1) { mask = _par_in(k + 7); }
    var hit: ImRayHit;
    if (_im_b3_raycast(bodies, colls, o, d, max, has_mask, mask, &hit) == 1) {
        var dist: f64 = hit.distance;
        _par_got_i(hit.collider);
        _par_got_v3(hit.point);
        _par_got_v3(hit.normal);
        _par_got_f(dist);
    } else {
        _par_got_none();
    }
    for (var s = 0; s < colls.slot_count(); s = s + 1) {
        var h = colls.slot_handle(s);
        if (h != 0 - 1) { _im_b3_as_coll(colls.get(h)).free(); }
    }
    bodies.free();
    colls.free();
    return 1;
}

# ── b3_state: the 3D backend's state (src/b3_state.cyr) ─────────────────────────────
# A row is a script of ops on a fresh ImPhysicsState3d; its outputs are each op's result, then the backend dump in
# `oracle_dump()`'s order. `b3::state_script_orphan` rows add a collider or a joint for a missing body, which the port
# refuses (ADR 0008 #1): mapped, and counted.

var _par_mapped3 = 0;
var _par_map_orphan3 = 0;

fn _par_got_body3d(rb: *ImRigidBody3d) {
    _par_got_i(rb.handle);
    _par_got_enum("BodyType.", body_type_name(rb.body_type));
    _par_got_v3(rb.position);
    _par_got_q4(rb.rotation);
    _par_got_v3(rb.linear_velocity);
    _par_got_v3(rb.angular_velocity);
    var ld: f64 = rb.linear_damping;
    var ad: f64 = rb.angular_damping;
    var gs: f64 = rb.gravity_scale;
    _par_got_f(ld);
    _par_got_f(ad);
    _par_got_i(rb.fixed_rotation);
    _par_got_f(gs);
    _par_got_v3(rb.force_accumulator);
    _par_got_v3(rb.torque_accumulator);
    var m: f64 = rb.mass;
    var im: f64 = rb.inv_mass;
    _par_got_f(m);
    _par_got_f(im);
    _par_got_m9(rb.inertia);
    _par_got_m9(rb.inv_inertia);
    _par_got_m9(rb.inv_inertia_world);
    _par_got_v3(rb.pseudo_velocity);
    _par_got_v3(rb.pseudo_angular_velocity);
    var stm: f64 = rb.sleep_timer;
    _par_got_i(rb.is_sleeping);
    _par_got_f(stm);
    return 0;
}

fn _par_got_collider3d(c: *ImCollider3d) {
    _par_got_i(c.handle);
    _par_got_i(c.body);
    _par_got_shape(c.shape);
    _par_got_v3(c.offset);
    _par_got_material(c.material);
    _par_got_i(c.is_sensor);
    var ms: f64 = c.mass;
    _par_got_opt_f(c.has_mass, ms);
    _par_got_i(c.collision_layer);
    _par_got_i(c.collision_mask);
    return 0;
}

fn _par_got_joint3d(h, j: *ImJoint3d) {
    _par_got_i(h);
    _par_got_i(j.body_a);
    _par_got_i(j.body_b);
    _par_got_joint_type(j.joint_type);
    _par_got_v3(j.local_anchor_a);
    _par_got_v3(j.local_anchor_b);
    _par_got_q4(j.reference_rotation);
    if (j.has_motor == 1) {
        var tv: f64 = j.motor.target_velocity;
        var mf: f64 = j.motor.max_force;
        _par_got_f(tv);
        _par_got_f(mf);
    } else {
        _par_got_none();
    }
    var dm: f64 = j.damping;
    var bf: f64 = j.break_force;
    _par_got_f(dm);
    _par_got_opt_f(j.has_break_force, bf);
    return 0;
}

# The state's dump: arenas and values in slot order, body_colliders by handle, the tracker.
fn _par_got_state3d(st: *ImPhysicsState3d) {
    var ba: *ImArena = st._bodies();
    _par_got_arena(ba);
    _par_got_seq(ba.len());
    for (var i = 0; i < ba.slot_count(); i = i + 1) {
        var h = ba.slot_handle(i);
        if (h != 0 - 1) { _par_got_body3d(_im_b3_as_body(ba.get(h))); }
    }
    var ca: *ImArena = st._colliders();
    _par_got_arena(ca);
    _par_got_seq(ca.len());
    for (var c = 0; c < ca.slot_count(); c = c + 1) {
        var ch = ca.slot_handle(c);
        if (ch != 0 - 1) { _par_got_collider3d(_im_b3_as_coll(ca.get(ch))); }
    }
    var ja: *ImArena = st._joints();
    _par_got_arena(ja);
    _par_got_seq(ja.len());
    for (var j = 0; j < ja.slot_count(); j = j + 1) {
        var jh = ja.slot_handle(j);
        if (jh != 0 - 1) { _par_got_joint3d(jh, _im_b3_as_joint(ja.get(jh))); }
    }
    # body_colliders: the live bodies in unsigned handle order (an insertion sort).
    var n = ba.len();
    var hs = fl_alloc(n * 8 + 8);
    var cnt = 0;
    for (var s = 0; s < ba.slot_count(); s = s + 1) {
        var bh = ba.slot_handle(s);
        if (bh != 0 - 1) {
            var at = cnt;
            while (at > 0 && _im_ult(bh, load64(hs + (at - 1) * 8)) == 1) {
                store64(hs + at * 8, load64(hs + (at - 1) * 8));
                at = at - 1;
            }
            store64(hs + at * 8, bh);
            cnt = cnt + 1;
        }
    }
    _par_got_seq(cnt);
    for (var q = 0; q < cnt; q = q + 1) {
        var b = load64(hs + q * 8);
        _par_got_i(b);
        var list: *ImWordList = st._list(_im_handle_index(b));
        _par_got_seq(list.len);
        for (var r = 0; r < list.len; r = r + 1) { _par_got_i(list.at(r)); }
    }
    fl_free(hs);
    _par_got_pairlist(st.contact_tracker.prev);
    _par_got_pairlist(st.contact_tracker.current);
    _par_got_pairlist(st.contact_tracker.seen);
    _par_got_i(st.contact_tracker.recorded);
    return 0;
}

fn _par_b3_state(fp, fl): i64 {
    var plain = _par_eq(fp, fl, "b3::state_script");
    var orphan = _par_eq(fp, fl, "b3::state_script_orphan");
    if (plain == 0 && orphan == 0) { return 0; }
    var st: ImPhysicsState3d = ImPhysicsState3d_new();
    var n = _par_in(0);
    var k = 1;
    var refused = 0;
    for (var i = 0; i < n; i = i + 1) {
        var op = _par_in_enum(k, "Op.", &_par_op_name, 13);
        k = k + 1;
        if (op == 0) {
            var bd: ImBodyDesc = _par_in_body_desc(k);
            k = k + 13;
            _par_got_i(st.add_body(bd));
        } elif (op == 1) {
            var body = _par_in(k);
            var cd: ImColliderDesc = ImColliderDesc_new(_im_shape(IM_SHAPE_BALL));
            k = _par_in_collider_desc_at(k + 1, &cd);
            var t1, v1 = st.add_collider(body, cd);
            cd.shape.free();
            if (is_ok(t1) == 1) { _par_got_i(v1); } else { _par_got_err(v1); refused = 1; }
        } elif (op == 2) {
            var jd: ImJointDesc = _par_in_joint_desc();
            k = _par_in_joint_desc_at(k, &jd);
            var t2, v2 = st.add_joint(jd);
            if (is_ok(t2) == 1) { _par_got_i(v2); } else { _par_got_err(v2); refused = 1; }
        } elif (op == 3 || op == 4) {
            var fb = _par_in(k);
            var vec: ImVec3 = ImVec3_zero();
            var pt: ImVec3 = ImVec3_zero();
            var has = 0;
            k = _par_in_vec_point(k + 1, &vec, &has, &pt);
            if (op == 3) {
                var fo: ImForce;
                fo.vector = vec;
                fo.has_point = has;
                fo.point = pt;
                st.apply_force(fb, fo);
            } else {
                var im: ImImpulse;
                im.vector = vec;
                im.has_point = has;
                im.point = pt;
                st.apply_impulse(fb, im);
            }
        } elif (op == 5) {
            var tb = _par_in(k);
            var tv: f64 = _par_in(k + 1);
            var tq: ImTorque;
            tq.value = tv;
            st.apply_torque(tb, tq);
            k = k + 2;
        } elif (op == 6) {
            st.remove_body(_par_in(k));
            _par_got_i(0);
            k = k + 1;
        } elif (op == 7) {
            var t7, v7 = st.remove_collider(_par_in(k));
            _par_got_unit(t7, v7);
            k = k + 1;
        } elif (op == 8) {
            var t8, v8 = st.remove_joint(_par_in(k));
            _par_got_unit(t8, v8);
            k = k + 1;
        } elif (op == 9) {
            var bs: ImBodyState = _par_in_body_state(0);
            var t9, v9 = st.get_body_state(_par_in(k), &bs);
            if (is_ok(t9) == 1) { _par_got_body_state(bs); } else { _par_got_err(v9); }
            k = k + 1;
        } elif (op == 10) {
            var sh = _par_in(k);
            var ss: ImBodyState = _par_in_body_state(k + 1);
            var t10, v10 = st.set_body_state(sh, ss);
            _par_got_unit(t10, v10);
            k = k + 12;
        } elif (op == 11) {
            var th = _par_in(k);
            var ty = _par_in_enum(k + 1, "BodyType.", &body_type_name, 3);
            var t11, v11 = st.set_body_type(th, ty);
            _par_got_unit(t11, v11);
            k = k + 2;
        } elif (op == 12) {
            _par_got_i(st.body_count());
        } else {
            st.free();
            return 0;
        }
    }
    _par_got_state3d(&st);
    st.free();
    if (orphan == 1 && refused == 1) {
        _par_mapped3 = 8;
        _par_map_orphan3 = _par_map_orphan3 + 1;
    }
    return 1;
}

# ── dispatch and hooks ──────────────────────────────────────────────────────────────

# ── M5b: single steps ───────────────────────────────────────────────────────────────
# A `b3::step` row is the config, then a 3D backend dump; the port loads the dump into an ImPhysicsState3d (every
# arena slot, generation and free list as dumped), steps it as PhysicsWorld::step does (a sub-step per sub_steps, then
# `finish_step`), and writes the dump and the frame's events. Until the contact pipeline arrives (part 3) the sub-step
# is tests/step3.cyr's contact-free composition: every b3_step collider has mask 0, and step3's guard fails the row if
# the broadphase could have paired two colliders.

# A 3D backend dump at token k into st (fresh): the token after it.
fn _par_load_state3d(st: *ImPhysicsState3d, k0): i64 {
    var ba: *ImArena = st._bodies();
    var k = _par_load_arena(ba, k0);
    var nb = _par_in(k);
    k = k + 1;
    for (var i = 0; i < nb; i = i + 1) {
        var rb: *ImRigidBody3d = _im_b3_as_body(_par_slot(ba, _par_in(k)));
        rb.handle = _par_in(k);
        rb.body_type = _par_in_enum(k + 1, "BodyType.", &body_type_name, 3);
        rb.position = _par_in_v3(k + 2);
        rb.rotation = _par_in_q4(k + 5);
        rb.linear_velocity = _par_in_v3(k + 9);
        rb.angular_velocity = _par_in_v3(k + 12);
        var ld: f64 = _par_in(k + 15);
        var ad: f64 = _par_in(k + 16);
        var gs: f64 = _par_in(k + 18);
        rb.linear_damping = ld;
        rb.angular_damping = ad;
        rb.fixed_rotation = _par_in(k + 17);
        rb.gravity_scale = gs;
        rb.force_accumulator = _par_in_v3(k + 19);
        rb.torque_accumulator = _par_in_v3(k + 22);
        var m: f64 = _par_in(k + 25);
        var im: f64 = _par_in(k + 26);
        rb.mass = m;
        rb.inv_mass = im;
        rb.inertia = _par_in_m9(k + 27);
        rb.inv_inertia = _par_in_m9(k + 36);
        rb.inv_inertia_world = _par_in_m9(k + 45);
        rb.pseudo_velocity = _par_in_v3(k + 54);
        rb.pseudo_angular_velocity = _par_in_v3(k + 57);
        rb.is_sleeping = _par_in(k + 60);
        var stm: f64 = _par_in(k + 61);
        rb.sleep_timer = stm;
        k = k + 62;
    }
    var ca: *ImArena = st._colliders();
    k = _par_load_arena(ca, k);
    var nc = _par_in(k);
    k = k + 1;
    for (var c = 0; c < nc; c = c + 1) {
        var cp: *ImCollider3d = _im_b3_as_coll(_par_slot(ca, _par_in(k)));
        cp.handle = _par_in(k);
        cp.body = _par_in(k + 1);
        var sh: ImColliderShape = _im_shape(IM_SHAPE_BALL);
        k = _par_in_shape(k + 2, &sh);
        cp.shape = sh;
        cp.offset = _par_in_v3(k);
        cp.material = _par_in_material(k + 3);
        cp.is_sensor = _par_in(k + 10);
        cp.has_mass = 0;
        cp.mass = 0.0;
        if (_par_in_is_none(k + 11) == 0) {
            var cm: f64 = _par_in(k + 11);
            cp.has_mass = 1;
            cp.mass = cm;
        }
        cp.collision_layer = _par_in(k + 12);
        cp.collision_mask = _par_in(k + 13);
        k = k + 14;
    }
    var ja: *ImArena = st._joints();
    k = _par_load_arena(ja, k);
    var nj = _par_in(k);
    k = k + 1;
    for (var j = 0; j < nj; j = j + 1) {
        var jp: *ImJoint3d = _im_b3_as_joint(_par_slot(ja, _par_in(k)));
        jp.body_a = _par_in(k + 1);
        jp.body_b = _par_in(k + 2);
        var jt: ImJointType = ImJointType_fixed();
        k = _par_in_joint_type(k + 3, &jt);
        jp.joint_type = jt;
        jp.local_anchor_a = _par_in_v3(k);
        jp.local_anchor_b = _par_in_v3(k + 3);
        jp.reference_rotation = _par_in_q4(k + 6);
        k = k + 10;
        jp.has_motor = 0;
        if (_par_in_is_none(k) == 1) {
            k = k + 1;
        } else {
            jp.has_motor = 1;
            jp.motor = ImJointMotor_new(_par_in(k), _par_in(k + 1));
            k = k + 2;
        }
        var dm: f64 = _par_in(k);
        jp.damping = dm;
        jp.has_break_force = 0;
        jp.break_force = 0.0;
        if (_par_in_is_none(k + 1) == 0) {
            var bf: f64 = _par_in(k + 1);
            jp.has_break_force = 1;
            jp.break_force = bf;
        }
        k = k + 2;
    }
    var ne = _par_in(k);
    k = k + 1;
    for (var e = 0; e < ne; e = e + 1) {
        var list: *ImWordList = st._list(_im_handle_index(_par_in(k)));
        list.len = 0;
        var n = _par_in(k + 1);
        for (var q = 0; q < n; q = q + 1) { list.push(_par_in(k + 2 + q)); }
        k = k + 2 + n;
    }
    k = _par_load_pairs(st.contact_tracker.prev, k);
    k = _par_load_pairs(st.contact_tracker.current, k);
    k = _par_load_pairs(st.contact_tracker.seen, k);
    st.contact_tracker.recorded = _par_in(k);
    return k + 1;
}

fn _par_b3_step(fp, fl): i64 {
    if (_par_eq(fp, fl, "b3::step") != 1) { return 0; }
    var cfg: ImWorldConfig = _par_in_config(0);
    var st: ImPhysicsState3d = ImPhysicsState3d_new();
    _par_load_state3d(&st, 16);
    var sub = cfg.sub_steps;
    if (sub < 1) { sub = 1; }
    var ts: f64 = cfg.timestep;
    var subf: f64 = f64_from(sub);
    var dt: f64 = ts / subf;
    _t3_touch = 0;
    for (var s = 0; s < sub; s = s + 1) {
        _t3_substep(&st, cfg.gravity, dt, cfg.velocity_iterations, cfg.position_iterations, cfg.position_slop,
          cfg.position_correction, cfg.max_velocity, cfg.constraint_frequency, cfg.constraint_damping_ratio);
    }
    var ne = st.finish_step();
    if (_t3_touch == 0) {
        _par_got_state3d(&st);
        _par_got_seq(ne);
        for (var e = 0; e < ne; e = e + 1) { _par_got_event(st.contact_tracker.event(e)); }
    } else {
        # A pair the contact-free sub-step can't handle: no outputs, so the row fails visibly.
        println("  b3::step: the broadphase could pair two colliders; the contact-free sub-step doesn't apply");
    }
    st.free();
    return 1;
}

fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    _par_mapped3 = 0;
    if (_par_eq(mp, ml, "b3_state") == 1) { return _par_b3_state(fp, fl); }
    if (_par_eq(mp, ml, "b3_step") == 1) { return _par_b3_step(fp, fl); }
    if (_par_eq(mp, ml, "b3_body") == 1) { return _par_b3_body(fp, fl); }
    if (_par_eq(mp, ml, "b3_math") == 1) { return _par_b3_math(fp, fl); }
    if (_par_eq(mp, ml, "b3_narrow") == 1) { return _par_b3_narrow(fp, fl); }
    if (_par_eq(mp, ml, "b3_ray") == 1) { return _par_b3_ray(fp, fl); }
    return 0;
}

# The cross-target digest folds every b3_math output, after the port's own outputs are in.
fn _par_shadows(mp, ml, fp, fl, cls) {
    if (_par_eq(mp, ml, "b3_math") == 1 && _par_got_n > 0) { _par_dg3_fold(); }
    return 0;
}

# The class-C bound for a function, in ulps; -1 when none is set. The rotations are built on crmath's correctly
# rounded sin_cos (ADR 0011), so the bound is 0 against the corrected oracle (ADR 0012).
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "b3::body") == 1) { return 0; }
    if (_par_eq(fp, fl, "b3::raycast") == 1) { return 0; }
    if (_par_eq(fp, fl, "b3::state_script") == 1) { return 0; }
    if (_par_eq(fp, fl, "b3::state_script_orphan") == 1) { return 0; }
    if (_par_eq(fp, fl, "b3::step") == 1) { return 0; }
    if (_par_eq(fp, fl, "DQuat::from_rotation_x") == 1) { return 0; }
    if (_par_eq(fp, fl, "DQuat::from_rotation_y") == 1) { return 0; }
    if (_par_eq(fp, fl, "DQuat::from_rotation_z") == 1) { return 0; }
    return 0 - 1;
}

# The ADR accepting a divergent row, or 0. The 3D math is impetus-owned and exact (ADR 0012); the one mapping is ADR
# 0008 #1, a state script whose collider or joint for a missing body the port refuses.
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    if (_par_mapped3 == 8) { return 8; }
    return 0;
}

# ADR 0008's orphan mapping is counted, not printed row by row (summarised by _par_module_done).
#must_use
fn _par_accepted_quiet(adr): i64 {
    if (adr == 8) { return 1; }
    return 0;
}

fn _par_module_done(mp, ml) {
    if (_par_eq(mp, ml, "b3_state") == 1) {
        print("  ADR 0008 #1 orphans: ", 23);
        fmt_int(_par_map_orphan3);
        println(" scripts add a collider or joint for a missing body, which the port refuses, accepted (ADR 8)");
        return 0;
    }
    if (_par_eq(mp, ml, "b3_math") != 1) { return 0; }
    print("  digest b3_math: 0x", 20);
    fmt_hex(_par_dg3);
    println("");
    return 0;
}

# Every module but the 3D backend's (`b3_*`) is replayed by tests/parity_2d.tcyr.
#must_use
fn _par_skip(mp, ml): i64 {
    if (ml >= 3 && load8(mp) == 98 && load8(mp + 1) == 51 && load8(mp + 2) == 95) { return 0; }
    return 1;
}

var exit_code = _par_main();
sys_exit_group(exit_code);
