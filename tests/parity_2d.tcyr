# parity_2d.tcyr — replays the golden corpus (tests/golden/*.tsv) against the port: the shared
# modules and the 2D backend's (`b2_*`). tests/parity_3d.tcyr replays the `b3_*` modules from M4.
#
# Port plan §4 step 7, copied from kimiya's tests/parity.tcyr (itself tanmatra's). Format and
# comparison rules: scripts/oracle/README.md. The module list is tests/golden/modules.txt, which
# the generator writes. The replay machinery is tests/parity_core.cyr; this file holds the
# dispatchers.
#
# Every row of every module is one of:
# - ok: every output matched within its class;
# - FAILED: an output differs; the first 10 per module are printed with the row's note and
#   both bit patterns;
# - measured: class C, with no bound set yet for its function. The ulp distance is recorded
#   but not gated. Bounds are set per function before its comparison (M0 step 8,
#   docs/development/port-parity.md);
# - accepted: a divergence an ADR accepts, listed by row in _par_accepted;
# - pending: its function isn't ported yet (no dispatcher entry).
#
# Per function it prints the row counts and the ulp histogram, which is the step 8 baseline.
# Shadow lines (`fn ~ candidate`) compare the same rows against another Cyrius candidate and
# are never gated. The exit code is the number of modules with a failure.

include "tests/ulp.cyr"
include "tests/lib_2d.cyr"

alloc_init();

include "tests/parity_core.cyr"
include "tests/parity_types.cyr"

# ── hooks ───────────────────────────────────────────────────────────────────────────

# The Rust variant name of an error code (src/error.cyr).
#must_use
fn _par_error_name(code): i64 {
    return im_error_name(code);
}

# ── cross-target digests (M0 step 8) ────────────────────────────────────────────────
# A 64-bit FNV-1a fold of every output word the port returns for a math function, in row order.
# Run on x86_64 ELF, x86_64 PE and aarch64: equal digests mean bit-identical results on every
# row, which is what ADR 0008 #7 promises for impetus-owned arithmetic. Histograms alone can't
# show that. Slots 0–6 are the dispatched class-C functions, 7 the class-A/B rows together, 8–9
# the native shadows (which differ on aarch64 by design).
var _PAR_DG_N = 10;
var _par_dg[80];

fn _par_dg_init() {
    for (var k = 0; k < _PAR_DG_N; k = k + 1) { store64(&_par_dg + k * 8, 0xcbf29ce484222325); }
    return 0;
}

# The digest slot of a math function, or -1.
#must_use
fn _par_dg_slot(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::sin_cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 1; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 2; }
    if (_par_eq(fp, fl, "f64::atan2") == 1) { return 3; }
    if (_par_eq(fp, fl, "f64::hypot") == 1) { return 4; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 5; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 6; }
    return 7;
}

# Folds the got list into digest `slot`.
fn _par_dg_fold(slot) {
    var at = &_par_dg + slot * 8;
    var h = load64(at);
    for (var k = 0; k < _par_got_n; k = k + 1) {
        h = (h ^ load64(_par_got_v + k * 8)) * 0x100000001b3;
    }
    store64(at, h);
    return 0;
}

# Prints digest `slot` under `name`.
fn _par_dg_print(slot, name) {
    print("  digest ", 9);
    _par_print_pad(name, strlen(name), 34);
    print(" 0x", 3);
    fmt_hex(load64(&_par_dg + slot * 8));
    println("");
    return 0;
}

# A shadow: the port's atan2 before ADR 0011's atan2 amendment, ganita_f64_atan2 (1.2.15) with `_f64_atan_polyfill`
# in place of the `f64_atan` builtin, the same bits on every target (port-parity.md §2). The whole C99 Annex F
# table, signs of zero included, as ganita. Words in, word out.
#must_use
fn _par_atan2_poly(y, x): i64 {
    var ay = y & 0x7FFFFFFFFFFFFFFF;
    var ax = x & 0x7FFFFFFFFFFFFFFF;
    if (ay > 0x7FF0000000000000) { return y; }
    if (ax > 0x7FF0000000000000) { return x; }
    var ysign = y & 0x8000000000000000;
    var xneg = (x >> 63) & 1;
    if (ay == 0) {
        if (xneg == 1) { return F64_PI | ysign; }
        return y;
    }
    if (ax == 0) { return F64_PI_2 | ysign; }
    if ((ay == 0x7FF0000000000000) && (ax == 0x7FF0000000000000)) {
        if (xneg == 1) { return _F64_3PI_4 | ysign; }
        return F64_PI_4 | ysign;
    }
    var q = _f64_atan_polyfill(f64_div(y, x));
    if (xneg == 0) { return q; }
    if (ysign != 0) { return f64_sub(q, F64_PI); }
    return f64_add(q, F64_PI);
}

# ── the 2D body state (flat::body_state's 11 tokens) ────────────────────────────────────

fn _par_in_body_state(k): ImBodyState {
    var s: ImBodyState;
    s.handle = _par_in(k);
    s.body_type = _par_in_enum(k + 1, "BodyType.", &body_type_name, 3);
    s.position = _par_in_v3(k + 2);
    var rot: f64 = _par_in(k + 5);
    s.rotation = rot;
    s.linear_velocity = _par_in_v3(k + 6);
    var av: f64 = _par_in(k + 9);
    s.angular_velocity = av;
    s.is_sleeping = _par_in(k + 10);
    return s;
}

fn _par_got_body_state(s: ImBodyState) {
    var rot: f64 = s.rotation;
    var av: f64 = s.angular_velocity;
    _par_got_i(s.handle);
    _par_got_enum("BodyType.", body_type_name(s.body_type));
    _par_got_v3(s.position);
    _par_got_f(rot);
    _par_got_v3(s.linear_velocity);
    _par_got_f(av);
    _par_got_i(s.is_sleeping);
    return 0;
}

# ── dispatch ────────────────────────────────────────────────────────────────────────
# Each module's dispatcher fills the got list for one row. It returns 1 when it handled the
# function, 0 when the function is pending (not ported), or -1 when the inputs are unusable (a
# defect, counted as a failure). Add a function the moment it's ported.

# `const` rows (input `s:<path>`). The config limits are src/constants.cyr's IM_ consts; the
# snapshot index cap is generated with the snapshot module (M6) and pending until then. Any
# other name is a defect.
fn _par_constants(fp, fl): i64 {
    if (_par_eq(fp, fl, "const") != 1 || _par_in_n != 1) { return 0 - 1; }
    var np = load64(_par_in_v);
    var nl = load64(_par_in_l);
    if (_par_eq(np, nl, "config::WorldConfig::MAX_SUB_STEPS") == 1) {
        _par_got_i(IM_MAX_SUB_STEPS);
        return 1;
    }
    if (_par_eq(np, nl, "config::WorldConfig::MAX_ITERATIONS") == 1) {
        _par_got_i(IM_MAX_ITERATIONS);
        return 1;
    }
    if (_par_eq(np, nl, "world::PhysicsWorld::MAX_SNAPSHOT_INDEX") == 1) { return 0; }
    return 0 - 1;
}

# `f64::*` rows: the Rust std reference values (port plan §7.1), through the counterparts the port
# uses: the builtins where they match Rust, and src/mathx.cyr's `_im_` helpers where they don't.
# exp, sin and cos are correctly rounded (src/crmath.cyr, ADR 0011); atan2 is ganita's on the atan
# polyfill, which gives the same bits on every target (port-parity.md §2): the `f64_atan` inside
# ganita's atan2 is x87 on x86_64 and the polyfill on aarch64.
fn _par_math(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::abs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::signum") == 1) { var r: f64 = _im_signum(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::floor") == 1) { var r: f64 = f64_floor(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ceil") == 1) { var r: f64 = f64_ceil(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::sin_cos") == 1) {
        var sv, cv = _im_sin_cos(x);
        var s: f64 = sv;
        var c: f64 = cv;
        _par_got_f(s);
        _par_got_f(c);
        return 1;
    }
    if (_par_eq(fp, fl, "f64::sin") == 1) { var r: f64 = _im_sin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { var r: f64 = _im_cos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { var r: f64 = _im_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::is_nan") == 1) { _par_got_i(_im_is_nan(x)); return 1; }
    if (_par_eq(fp, fl, "f64::is_finite") == 1) { _par_got_i(_im_is_finite(x)); return 1; }
    if (_par_eq(fp, fl, "f64::to_radians") == 1) { var r: f64 = _im_to_radians(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi2") == 1) { var r: f64 = _im_powi2(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi3") == 1) { var r: f64 = _im_powi3(x); _par_got_f(r); return 1; }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    # Rust's y.atan2(x) is the golden f64::atan2(y, x): inputs in C order (x here is atan2's y).
    if (_par_eq(fp, fl, "f64::atan2") == 1) {
        var ra: f64 = _im_atan2(x, y);
        _par_got_f(ra);
        return 1;
    }
    if (_par_eq(fp, fl, "f64::hypot") == 1) { var r: f64 = _im_hypot(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { var r: f64 = _im_powf(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::max") == 1) { var r: f64 = _im_max(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::min") == 1) { var r: f64 = _im_min(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::clamp") == 1) {
        var hi: f64 = _par_in(2);
        var r: f64 = _im_clamp(x, y, hi);
        _par_got_f(r);
        return 1;
    }
    return 0;
}

# ── M1a: config, material, units, force ─────────────────────────────────────────────
# Inputs and outputs are the structs flattened field by field (scripts/oracle/src/flat.rs).

# ADR 0008 #6: a `validate` row the port refuses as XPBD while the oracle accepts it. Set by the
# config dispatcher, cleared for every row by _par_dispatch.
var _par_mapped = 0;
var _par_map_xpbd = 0;

# The config tokens' reader and writer (`_par_in_config`, `_par_got_config`) are tests/parity_types.cyr's.

fn _par_config(fp, fl): i64 {
    if (_par_eq(fp, fl, "WorldConfig::default") == 1) {
        _par_got_config(ImWorldConfig_default());
        return 1;
    }
    if (_par_eq(fp, fl, "WorldConfig::validate") == 1) {
        if (_par_in_n != 16) { return 0 - 1; }
        var c: ImWorldConfig = _par_in_config(0);
        var t, v = c.validate();
        if (is_err_result(t) == 1) {
            if (v == IM_ERR_UNSUPPORTED && c.solver == IM_SOLVER_XPBD) {
                _par_mapped = 8;
                _par_map_xpbd = _par_map_xpbd + 1;
            }
            _par_got_err(v);
        }
        return 1;
    }
    return 0;
}

fn _par_material(fp, fl): i64 {
    if (_par_eq(fp, fl, "CombineRule::combine") == 1) {
        var rule = _par_in_enum(0, "CombineRule.", &combine_rule_name, 4);
        var a: f64 = _par_in(1);
        var b: f64 = _par_in(2);
        var r: f64 = combine_rule_combine(rule, a, b);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "PhysicsMaterial::default") == 1) { _par_got_material(ImPhysicsMaterial_default()); return 1; }
    if (_par_eq(fp, fl, "PhysicsMaterial::ice") == 1) { _par_got_material(ImPhysicsMaterial_ice()); return 1; }
    if (_par_eq(fp, fl, "PhysicsMaterial::rubber") == 1) { _par_got_material(ImPhysicsMaterial_rubber()); return 1; }
    if (_par_eq(fp, fl, "PhysicsMaterial::wood") == 1) { _par_got_material(ImPhysicsMaterial_wood()); return 1; }
    if (_par_eq(fp, fl, "PhysicsMaterial::steel") == 1) { _par_got_material(ImPhysicsMaterial_steel()); return 1; }
    if (_par_eq(fp, fl, "PhysicsMaterial::bouncy") == 1) { _par_got_material(ImPhysicsMaterial_bouncy()); return 1; }
    if (_par_eq(fp, fl, "PhysicsMaterial::effective_static_friction") == 1) {
        var m: ImPhysicsMaterial = _par_in_material(0);
        var r: f64 = m.effective_static_friction();
        _par_got_f(r);
        return 1;
    }
    return 0;
}

fn _par_got_quantity(q: ImQuantity) {
    var v: f64 = q.value;
    _par_got_f(v);
    _par_got_enum("PhysicsUnit.", physics_unit_name(q.unit));
    return 0;
}

fn _par_units(fp, fl): i64 {
    var v: f64 = _par_in(0);
    if (_par_eq(fp, fl, "Quantity::new") == 1) {
        var u = _par_in_enum(1, "PhysicsUnit.", &physics_unit_name, 14);
        _par_got_quantity(ImQuantity_new(v, u));
        return 1;
    }
    if (_par_eq(fp, fl, "Quantity::meters") == 1) { _par_got_quantity(ImQuantity_meters(v)); return 1; }
    if (_par_eq(fp, fl, "Quantity::kilograms") == 1) { _par_got_quantity(ImQuantity_kilograms(v)); return 1; }
    if (_par_eq(fp, fl, "Quantity::seconds") == 1) { _par_got_quantity(ImQuantity_seconds(v)); return 1; }
    if (_par_eq(fp, fl, "Quantity::newtons") == 1) { _par_got_quantity(ImQuantity_newtons(v)); return 1; }
    if (_par_eq(fp, fl, "Quantity::joules") == 1) { _par_got_quantity(ImQuantity_joules(v)); return 1; }
    if (_par_eq(fp, fl, "Quantity::radians") == 1) { _par_got_quantity(ImQuantity_radians(v)); return 1; }
    if (_par_eq(fp, fl, "Quantity::degrees") == 1) { _par_got_quantity(ImQuantity_degrees(v)); return 1; }
    if (_par_eq(fp, fl, "Quantity::meters_per_second") == 1) {
        _par_got_quantity(ImQuantity_meters_per_second(v));
        return 1;
    }
    if (_par_eq(fp, fl, "Quantity::pascals") == 1) { _par_got_quantity(ImQuantity_pascals(v)); return 1; }
    if (_par_eq(fp, fl, "Quantity::to_radians") == 1) {
        var u2 = _par_in_enum(1, "PhysicsUnit.", &physics_unit_name, 14);
        var q: ImQuantity = ImQuantity_new(v, u2);
        var r: f64 = q.to_radians();
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "Quantity::fmt") == 1) {
        var u3 = _par_in_enum(1, "PhysicsUnit.", &physics_unit_name, 14);
        var qf: ImQuantity = ImQuantity_new(v, u3);
        var sb = str_builder_new();
        qf.fmt(sb);
        var txt = str_builder_build(sb);
        _par_got_text(str_data(txt), str_len(txt));
        return 1;
    }
    return 0;
}

# Appends a force or impulse: the vector, then `n:` or the point.
fn _par_got_vector_point(v: ImVec3, has, p: ImVec3) {
    var vx: f64 = v.x;
    var vy: f64 = v.y;
    var vz: f64 = v.z;
    _par_got_f(vx);
    _par_got_f(vy);
    _par_got_f(vz);
    if (has == 1) {
        var px: f64 = p.x;
        var py: f64 = p.y;
        var pz: f64 = p.z;
        _par_got_f(px);
        _par_got_f(py);
        _par_got_f(pz);
    } else {
        _par_got_none();
    }
    return 0;
}

fn _par_force(fp, fl): i64 {
    var x: f64 = _par_in(0);
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "Torque::new") == 1) {
        var t: ImTorque = ImTorque_new(x);
        var tv: f64 = t.value;
        _par_got_f(tv);
        return 1;
    }
    if (_par_eq(fp, fl, "Force::gravity") == 1) {
        var g: ImForce = ImForce_gravity(x, y);
        _par_got_vector_point(g.vector, g.has_point, g.point);
        return 1;
    }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "Force::new") == 1) {
        var f: ImForce = ImForce_new(x, y, z);
        _par_got_vector_point(f.vector, f.has_point, f.point);
        return 1;
    }
    if (_par_eq(fp, fl, "Impulse::new") == 1) {
        var i: ImImpulse = ImImpulse_new(x, y, z);
        _par_got_vector_point(i.vector, i.has_point, i.point);
        return 1;
    }
    if (_par_eq(fp, fl, "Force::magnitude") == 1 || _par_eq(fp, fl, "Impulse::magnitude") == 1) {
        # The point doesn't enter the magnitude; build the force from the vector alone.
        var fm: ImForce = ImForce_new(x, y, z);
        var r: f64 = fm.magnitude();
        _par_got_f(r);
        return 1;
    }
    var px: f64 = _par_in(3);
    var py: f64 = _par_in(4);
    var pz: f64 = _par_in(5);
    if (_par_eq(fp, fl, "Force::at_point") == 1) {
        var fa: ImForce = ImForce_at_point(x, y, z, px, py, pz);
        _par_got_vector_point(fa.vector, fa.has_point, fa.point);
        return 1;
    }
    if (_par_eq(fp, fl, "Impulse::at_point") == 1) {
        var ia: ImImpulse = ImImpulse_at_point(x, y, z, px, py, pz);
        _par_got_vector_point(ia.vector, ia.has_point, ia.point);
        return 1;
    }
    return 0;
}

# ── M1b: descriptor types, springs ──────────────────────────────────────────────────
# The descriptor token helpers are in tests/parity_types.cyr, shared with the 3D harness.

# The spring at token k: its six serialized fields.
fn _par_in_spring(k): ImSpring {
    var p: f64 = _par_in(k);
    var v: f64 = _par_in(k + 1);
    var t: f64 = _par_in(k + 2);
    var st: f64 = _par_in(k + 3);
    var dm: f64 = _par_in(k + 4);
    var th: f64 = _par_in(k + 5);
    var s: ImSpring = ImSpring_new(p, t, st, dm);
    s.set_velocity(v);
    s.set_settle_threshold(th);
    return s;
}

fn _par_got_spring(s: ImSpring) {
    var p: f64 = s.position;
    var v: f64 = s.velocity;
    var t: f64 = s.target;
    var st: f64 = s.stiffness;
    var dm: f64 = s.damping;
    var th: f64 = s.settle_threshold;
    _par_got_f(p);
    _par_got_f(v);
    _par_got_f(t);
    _par_got_f(st);
    _par_got_f(dm);
    _par_got_f(th);
    return 0;
}

fn _par_types(fp, fl): i64 {
    if (_par_eq(fp, fl, "BodyDesc::default") == 1) {
        _par_got_body_desc(ImBodyDesc_default());
        return 1;
    }
    return 0;
}

fn _par_spring(fp, fl): i64 {
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    var c: f64 = _par_in(2);
    if (_par_eq(fp, fl, "Spring::critically_damped") == 1) {
        _par_got_spring(ImSpring_critically_damped(a, b, c));
        return 1;
    }
    if (_par_eq(fp, fl, "Spring::over_damped") == 1) {
        _par_got_spring(ImSpring_over_damped(a, b, c));
        return 1;
    }
    if (_par_eq(fp, fl, "Spring::under_damped") == 1) {
        _par_got_spring(ImSpring_under_damped(a, b, c));
        return 1;
    }
    var d: f64 = _par_in(3);
    if (_par_eq(fp, fl, "Spring::new") == 1) {
        _par_got_spring(ImSpring_new(a, b, c, d));
        return 1;
    }
    if (_par_eq(fp, fl, "Spring::is_settled") == 1) {
        # (position, velocity, target, threshold)
        var s: ImSpring = ImSpring_new(a, c, 1.0, 1.0);
        s.set_velocity(b);
        s.set_settle_threshold(d);
        _par_got_i(s.is_settled());
        return 1;
    }
    if (_par_eq(fp, fl, "Spring::step") == 1) {
        # (position, velocity, target, stiffness, damping, dt, n)
        var dm: f64 = _par_in(4);
        var dt: f64 = _par_in(5);
        var n = _par_in(6);
        var st: ImSpring = ImSpring_new(a, c, d, dm);
        st.set_velocity(b);
        for (var i = 0; i < n; i = i + 1) { st.step(dt); }
        var p: f64 = st.position();
        var v: f64 = st.velocity();
        _par_got_f(p);
        _par_got_f(v);
        return 1;
    }
    return 0;
}

# ── M2a: the broadphase ─────────────────────────────────────────────────────────────
# A row's boxes are inserted in order with their input index as the key; the output is the sorted
# pair set (`v:P`, then each pair's two indices).

# Appends the pair list as `v:P` and its pairs.
fn _par_got_pairs(pl: *ImPairList) {
    _par_got_seq(pl.len);
    for (var j = 0; j < pl.len; j = j + 1) {
        _par_got_i(pl.first(j));
        _par_got_i(pl.second(j));
    }
    return 0;
}

fn _par_broadphase(fp, fl): i64 {
    var out: ImPairList = ImPairList_new();
    if (_par_eq(fp, fl, "aabb_tree_pairs_2d") == 1 || _par_eq(fp, fl, "aabb_tree_pairs_3d") == 1) {
        var d3 = _par_eq(fp, fl, "aabb_tree_pairs_3d");
        var per = 4;
        if (d3 == 1) { per = 6; }
        var n = _par_in(0);
        var tree: ImAabbTree = ImAabbTree_new();
        for (var i = 0; i < n; i = i + 1) {
            var k = 1 + i * per;
            if (d3 == 1) {
                tree.insert(i, ImTreeAabb_from_3d(_par_in_v3(k), _par_in_v3(k + 3)));
            } else {
                tree.insert(i, ImTreeAabb_from_2d(_par_in_v2(k), _par_in_v2(k + 2)));
            }
        }
        if (tree.query_pairs(&out) == 0) { return 0 - 1; }
        _par_got_pairs(&out);
        tree.free();
        out.free();
        return 1;
    }
    if (_par_eq(fp, fl, "spatial_hash_pairs_2d") == 1 || _par_eq(fp, fl, "spatial_hash_pairs_3d") == 1) {
        var h3 = _par_eq(fp, fl, "spatial_hash_pairs_3d");
        var per2 = 4;
        if (h3 == 1) { per2 = 6; }
        var cell: f64 = _par_in(0);
        var n2 = _par_in(1);
        var grid: ImSpatialHashGrid = ImSpatialHashGrid_new(cell);
        for (var i2 = 0; i2 < n2; i2 = i2 + 1) {
            var k2 = 2 + i2 * per2;
            if (h3 == 1) {
                grid.insert_3d(i2, _par_in_v3(k2), _par_in_v3(k2 + 3));
            } else {
                grid.insert_2d(i2, _par_in_v2(k2), _par_in_v2(k2 + 2));
            }
        }
        if (grid.query_pairs(&out) == 0) { return 0 - 1; }
        _par_got_pairs(&out);
        grid.free();
        out.free();
        return 1;
    }
    if (_par_eq(fp, fl, "spatial_hash_auto_cell_size") == 1) {
        var n3 = _par_in(0);
        var dims = _par_in_words(1, n3);
        var r: f64 = ImSpatialHashGrid_auto_cell_size(dims, n3);
        if (dims != 0) { fl_free(dims); }
        _par_got_f(r);
        return 1;
    }
    return 0;
}

# ── M2b: the 2D backend's types ─────────────────────────────────────────────────────
# `b2::body_mass`: a body from its type and fixed_rotation, each collider (shape, offset, density,
# explicit mass) added in order as state.rs's add_collider does; the output is the body's mass,
# inertia and inverses.

fn _par_b2_mass(fp, fl): i64 {
    if (_par_eq(fp, fl, "b2::body_mass") != 1) { return 0; }
    var bd: ImBodyDesc = ImBodyDesc_default();
    bd.body_type = _par_in_enum(0, "BodyType.", &body_type_name, 3);
    bd.fixed_rotation = _par_in(1);
    var b: ImRigidBody2d = ImRigidBody2d_from_desc(0, bd);
    var n = _par_in(2);
    var k = 3;
    for (var j = 0; j < n; j = j + 1) {
        var sh: ImColliderShape = _im_shape(IM_SHAPE_BALL);
        k = _par_in_shape(k, &sh);
        var d: ImColliderDesc = ImColliderDesc_new(sh);
        var ox: f64 = _par_in(k);
        var oy: f64 = _par_in(k + 1);
        var den: f64 = _par_in(k + 2);
        d.offset = ImVec3_new(ox, oy, 0.0);
        var mat: ImPhysicsMaterial = ImPhysicsMaterial_default();
        mat.density = den;
        d.material = mat;
        if (_par_in_is_none(k + 3) == 0) {
            var ms: f64 = _par_in(k + 3);
            d.has_mass = 1;
            d.mass = ms;
        }
        var c: ImCollider2d = ImCollider2d_from_desc(j, 0, d);
        _im_b2_add_collider_mass(&b, &c);
        c.free();
        sh.free();
        k = k + 4;
    }
    var m: f64 = b.mass;
    var i: f64 = b.inertia;
    var im: f64 = b.inv_mass;
    var ii: f64 = b.inv_inertia;
    _par_got_f(m);
    _par_got_f(i);
    _par_got_f(im);
    _par_got_f(ii);
    return 1;
}

# ── M2c: the 2D narrowphase ─────────────────────────────────────────────────────────
# Inputs: shape A, A's x, y and rotation, shape B and its pose. `b2::contacts` outputs `v:N` and
# each contact's normal x, y, depth and point x, y; `b2::shapes_touch` outputs 0 or 1.

fn _par_b2_narrow(fp, fl): i64 {
    var is_c = _par_eq(fp, fl, "b2::contacts");
    var is_t = _par_eq(fp, fl, "b2::shapes_touch");
    if (is_c == 0 && is_t == 0) { return 0; }
    var sa: ImColliderShape = _im_shape(IM_SHAPE_BALL);
    var sb: ImColliderShape = _im_shape(IM_SHAPE_BALL);
    var k = _par_in_shape(0, &sa);
    var ax: f64 = _par_in(k);
    var ay: f64 = _par_in(k + 1);
    var ra: f64 = _par_in(k + 2);
    k = _par_in_shape(k + 3, &sb);
    var bx: f64 = _par_in(k);
    var by: f64 = _par_in(k + 1);
    var rb: f64 = _par_in(k + 2);
    var out[80];
    var n = 0;
    if (is_t == 1) {
        _par_got_i(_im_b2_shapes_touch(&sa, ax, ay, ra, &sb, bx, by, rb));
    } else {
        n = _im_b2_generate_contacts_multi(&sa, ax, ay, ra, &sb, bx, by, rb, &out);
        _par_got_seq(n);
        for (var j = 0; j < n; j = j + 1) {
            for (var w = 0; w < 5; w = w + 1) { _par_got_f(load64(&out + j * 40 + w * 8)); }
        }
    }
    sa.free();
    sb.free();
    return 1;
}

# ── M2d: the 2D raycast and overlap queries ─────────────────────────────────────────
# Inputs: `v:<bodies>`, then per body its x, y, rotation, collider shape, offset x, y and layer; then
# the query. The world is an ImPhysicsState2d (static bodies, one collider each, handles in order) and
# the queries are its methods: `raycast_filtered`, `overlap_sphere`, `overlap_aabb`.

fn _par_b2_ray(fp, fl): i64 {
    var is_r = _par_eq(fp, fl, "b2::raycast");
    var is_s = _par_eq(fp, fl, "b2::overlap_sphere");
    var is_a = _par_eq(fp, fl, "b2::overlap_aabb");
    if (is_r == 0 && is_s == 0 && is_a == 0) { return 0; }
    var st: ImPhysicsState2d = ImPhysicsState2d_new();
    var n = _par_in(0);
    var k = 1;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = _par_in(k);
        var y: f64 = _par_in(k + 1);
        var rot: f64 = _par_in(k + 2);
        var sh: ImColliderShape = _im_shape(IM_SHAPE_BALL);
        k = _par_in_shape(k + 3, &sh);
        var ox: f64 = _par_in(k);
        var oy: f64 = _par_in(k + 1);
        var bd: ImBodyDesc = ImBodyDesc_default();
        bd.body_type = IM_BODY_STATIC;
        bd.position = ImVec3_new(x, y, 0.0);
        bd.rotation = rot;
        var bh = st.add_body(bd);
        var cd: ImColliderDesc = ImColliderDesc_new(sh);
        cd.offset = ImVec3_new(ox, oy, 0.0);
        cd.collision_layer = _par_in(k + 2);
        var t, h = st.add_collider(bh, cd);
        sh.free();
        k = k + 3;
    }
    if (is_r == 1) {
        var o: ImVec3 = ImVec3_new(_par_in_f(k), _par_in_f(k + 1), 0.0);
        var d: ImVec3 = ImVec3_new(_par_in_f(k + 2), _par_in_f(k + 3), 0.0);
        var max: f64 = _par_in(k + 4);
        var hit: ImRayHit;
        if (st.raycast_filtered(o, d, max, _par_in(k + 5), &hit) == 1) {
            var px: f64 = hit.point.x;
            var py: f64 = hit.point.y;
            var nx: f64 = hit.normal.x;
            var ny: f64 = hit.normal.y;
            var dist: f64 = hit.distance;
            _par_got_i(hit.collider);
            _par_got_f(px);
            _par_got_f(py);
            _par_got_f(nx);
            _par_got_f(ny);
            _par_got_f(dist);
        } else {
            _par_got_none();
        }
    } else {
        var found: ImWordList = ImWordList_new();
        if (is_s == 1) {
            var r: f64 = _par_in(k + 2);
            st.overlap_sphere(ImVec3_new(_par_in_f(k), _par_in_f(k + 1), 0.0), r, &found);
        } else {
            var lo: ImVec3 = ImVec3_new(_par_in_f(k), _par_in_f(k + 1), 0.0);
            var hi: ImVec3 = ImVec3_new(_par_in_f(k + 2), _par_in_f(k + 3), 0.0);
            st.overlap_aabb(lo, hi, &found);
        }
        _par_got_seq(found.len);
        for (var w = 0; w < found.len; w = w + 1) { _par_got_i(found.at(w)); }
        found.free();
    }
    st.free();
    return 1;
}

# ── M3a: the 2D backend's state ─────────────────────────────────────────────────────
# A row is a script of ops on a fresh ImPhysicsState2d; its outputs are each op's result, then the
# backend dump in `oracle_dump()`'s order. `b2::state_script_orphan` rows add a collider or a joint for a
# missing body, which the port refuses (ADR 0008 #1): mapped, and counted.

var _par_map_orphan = 0;

fn _par_got_body2d(rb: *ImRigidBody2d) {
    var f[24];
    _par_got_i(rb.handle);
    _par_got_enum("BodyType.", body_type_name(rb.body_type));
    _par_got_v2(rb.position);
    var rot: f64 = rb.rotation;
    _par_got_f(rot);
    _par_got_v2(rb.linear_velocity);
    var av: f64 = rb.angular_velocity;
    var ld: f64 = rb.linear_damping;
    var ad: f64 = rb.angular_damping;
    var gs: f64 = rb.gravity_scale;
    _par_got_f(av);
    _par_got_f(ld);
    _par_got_f(ad);
    _par_got_i(rb.fixed_rotation);
    _par_got_f(gs);
    _par_got_v2(rb.force_accumulator);
    var ta: f64 = rb.torque_accumulator;
    var m: f64 = rb.mass;
    var im: f64 = rb.inv_mass;
    var ii: f64 = rb.inertia;
    var iii: f64 = rb.inv_inertia;
    _par_got_f(ta);
    _par_got_f(m);
    _par_got_f(im);
    _par_got_f(ii);
    _par_got_f(iii);
    _par_got_v2(rb.pseudo_velocity);
    var pw: f64 = rb.pseudo_angular_velocity;
    _par_got_f(pw);
    _par_got_v2(rb.prev_position);
    var pr: f64 = rb.prev_rotation;
    var stm: f64 = rb.sleep_timer;
    _par_got_f(pr);
    _par_got_i(rb.is_sleeping);
    _par_got_f(stm);
    _par_got_i(rb.island_id);
    return 0;
}

fn _par_got_collider2d(c: *ImCollider2d) {
    _par_got_i(c.handle);
    _par_got_i(c.body);
    _par_got_shape(c.shape);
    var ox: f64 = c.offset.x;
    var oy: f64 = c.offset.y;
    _par_got_f(ox);
    _par_got_f(oy);
    _par_got_f(0.0);
    _par_got_material(c.material);
    _par_got_i(c.is_sensor);
    var ms: f64 = c.mass;
    _par_got_opt_f(c.has_mass, ms);
    _par_got_i(c.collision_layer);
    _par_got_i(c.collision_mask);
    return 0;
}

fn _par_got_joint2d(h, j: *ImJoint2d) {
    _par_got_i(h);
    _par_got_i(j.body_a);
    _par_got_i(j.body_b);
    _par_got_joint_type(j.joint_type);
    _par_got_v2(j.local_anchor_a);
    _par_got_v2(j.local_anchor_b);
    if (j.has_motor == 1) {
        var tv: f64 = j.motor.target_velocity;
        var mf: f64 = j.motor.max_force;
        _par_got_f(tv);
        _par_got_f(mf);
    } else {
        _par_got_none();
    }
    var dm: f64 = j.damping;
    var bf: f64 = j.break_force;
    var ra: f64 = j.reference_angle;
    _par_got_f(dm);
    _par_got_opt_f(j.has_break_force, bf);
    _par_got_f(ra);
    return 0;
}

# The state's dump: arenas and values in slot order, body_colliders by handle, manifolds, tracker.
fn _par_got_state(st: *ImPhysicsState2d) {
    var ba: *ImArena = st._bodies();
    _par_got_arena(ba);
    _par_got_seq(ba.len());
    for (var i = 0; i < ba.slot_count(); i = i + 1) {
        var h = ba.slot_handle(i);
        if (h != 0 - 1) { _par_got_body2d(ba.get(h)); }
    }
    var ca: *ImArena = st._colliders();
    _par_got_arena(ca);
    _par_got_seq(ca.len());
    for (var c = 0; c < ca.slot_count(); c = c + 1) {
        var ch = ca.slot_handle(c);
        if (ch != 0 - 1) { _par_got_collider2d(ca.get(ch)); }
    }
    var ja: *ImArena = st._joints();
    _par_got_arena(ja);
    _par_got_seq(ja.len());
    for (var j = 0; j < ja.slot_count(); j = j + 1) {
        var jh = ja.slot_handle(j);
        if (jh != 0 - 1) { _par_got_joint2d(jh, ja.get(jh)); }
    }
    # body_colliders: the live bodies in unsigned handle order (an insertion sort).
    var n = ba.len();
    var hs = fl_alloc(n * 8 + 8);
    var cnt = 0;
    for (var s = 0; s < ba.slot_count(); s = s + 1) {
        var bh = ba.slot_handle(s);
        if (bh != 0 - 1) {
            var at = cnt;
            while (at > 0 && _im_ult(bh, load64(hs + (at - 1) * 8)) == 1) {
                store64(hs + at * 8, load64(hs + (at - 1) * 8));
                at = at - 1;
            }
            store64(hs + at * 8, bh);
            cnt = cnt + 1;
        }
    }
    _par_got_seq(cnt);
    for (var q = 0; q < cnt; q = q + 1) {
        var b = load64(hs + q * 8);
        _par_got_i(b);
        var list: *ImWordList = st._list(_im_handle_index(b));
        _par_got_seq(list.len);
        for (var r = 0; r < list.len; r = r + 1) { _par_got_i(list.at(r)); }
    }
    fl_free(hs);
    _par_got_seq(st.manifolds.count());
    for (var mi = 0; mi < st.manifolds.count(); mi = mi + 1) {
        var m: *ImContactManifold = _im_b2_as_manifold(st.manifolds.at(mi));
        _par_got_i(m.collider_a);
        _par_got_i(m.collider_b);
        _par_got_i(m.body_a);
        _par_got_i(m.body_b);
        _par_got_v2(m.normal);
        _par_got_seq(m.point_count);
        for (var pi = 0; pi < m.point_count; pi = pi + 1) {
            var p = m.points + pi * sizeof(ImManifoldPoint);
            for (var w = 0; w < 7; w = w + 1) { _par_got_f(load64(p + w * 8)); }
        }
        var ri: f64 = m.rolling_impulse;
        _par_got_f(ri);
    }
    _par_got_pairlist(st.contact_tracker.prev);
    _par_got_pairlist(st.contact_tracker.current);
    _par_got_pairlist(st.contact_tracker.seen);
    _par_got_i(st.contact_tracker.recorded);
    return 0;
}

fn _par_b2_state(fp, fl): i64 {
    var plain = _par_eq(fp, fl, "b2::state_script");
    var orphan = _par_eq(fp, fl, "b2::state_script_orphan");
    if (plain == 0 && orphan == 0) { return 0; }
    var st: ImPhysicsState2d = ImPhysicsState2d_new();
    var n = _par_in(0);
    var k = 1;
    var refused = 0;
    for (var i = 0; i < n; i = i + 1) {
        var op = _par_in_enum(k, "Op.", &_par_op_name, 13);
        k = k + 1;
        if (op == 0) {
            var bd: ImBodyDesc = _par_in_body_desc(k);
            k = k + 13;
            _par_got_i(st.add_body(bd));
        } elif (op == 1) {
            var body = _par_in(k);
            var cd: ImColliderDesc = ImColliderDesc_new(_im_shape(IM_SHAPE_BALL));
            k = _par_in_collider_desc_at(k + 1, &cd);
            var t1, v1 = st.add_collider(body, cd);
            cd.shape.free();
            if (is_ok(t1) == 1) { _par_got_i(v1); } else { _par_got_err(v1); refused = 1; }
        } elif (op == 2) {
            var jd: ImJointDesc = _par_in_joint_desc();
            k = _par_in_joint_desc_at(k, &jd);
            var t2, v2 = st.add_joint(jd);
            if (is_ok(t2) == 1) { _par_got_i(v2); } else { _par_got_err(v2); refused = 1; }
        } elif (op == 3 || op == 4) {
            var fb = _par_in(k);
            var vec: ImVec3 = ImVec3_new(0.0, 0.0, 0.0);
            var pt: ImVec3 = ImVec3_new(0.0, 0.0, 0.0);
            var has = 0;
            k = _par_in_vec_point(k + 1, &vec, &has, &pt);
            if (op == 3) {
                var fo: ImForce;
                fo.vector = vec;
                fo.has_point = has;
                fo.point = pt;
                st.apply_force(fb, fo);
            } else {
                var im: ImImpulse;
                im.vector = vec;
                im.has_point = has;
                im.point = pt;
                st.apply_impulse(fb, im);
            }
        } elif (op == 5) {
            var tb = _par_in(k);
            var tv: f64 = _par_in(k + 1);
            var tq: ImTorque;
            tq.value = tv;
            st.apply_torque(tb, tq);
            k = k + 2;
        } elif (op == 6) {
            st.remove_body(_par_in(k));
            _par_got_i(0);
            k = k + 1;
        } elif (op == 7) {
            var t7, v7 = st.remove_collider(_par_in(k));
            _par_got_unit(t7, v7);
            k = k + 1;
        } elif (op == 8) {
            var t8, v8 = st.remove_joint(_par_in(k));
            _par_got_unit(t8, v8);
            k = k + 1;
        } elif (op == 9) {
            var bs: ImBodyState = _par_in_body_state(0);
            var t9, v9 = st.get_body_state(_par_in(k), &bs);
            if (is_ok(t9) == 1) { _par_got_body_state(bs); } else { _par_got_err(v9); }
            k = k + 1;
        } elif (op == 10) {
            var sh = _par_in(k);
            var ss: ImBodyState = _par_in_body_state(k + 1);
            var t10, v10 = st.set_body_state(sh, ss);
            _par_got_unit(t10, v10);
            k = k + 12;
        } elif (op == 11) {
            var th = _par_in(k);
            var ty = _par_in_enum(k + 1, "BodyType.", &body_type_name, 3);
            var t11, v11 = st.set_body_type(th, ty);
            _par_got_unit(t11, v11);
            k = k + 2;
        } elif (op == 12) {
            _par_got_i(st.body_count());
        } else {
            st.free();
            return 0;
        }
    }
    _par_got_state(&st);
    st.free();
    if (orphan == 1 && refused == 1) {
        _par_mapped = 8;
        _par_map_orphan = _par_map_orphan + 1;
    }
    return 1;
}

# ── M3b–c: single steps ─────────────────────────────────────────────────────────────
# A `b2::step` row is the config, then a backend dump; the port loads the dump into an ImPhysicsState2d
# (every arena slot, generation and free list as dumped), steps it as PhysicsWorld::step does (the
# library's `step` per sub-step, then `finish_step`), and writes the dump and the frame's events. The arena,
# slot and pair-list loaders are tests/parity_types.cyr's.

# A backend dump at token k into st (fresh): the token after it.
fn _par_load_state(st: *ImPhysicsState2d, k0): i64 {
    var ba: *ImArena = st._bodies();
    var k = _par_load_arena(ba, k0);
    var nb = _par_in(k);
    k = k + 1;
    for (var i = 0; i < nb; i = i + 1) {
        var rb: *ImRigidBody2d = _im_b2_as_body(_par_slot(ba, _par_in(k)));
        rb.handle = _par_in(k);
        rb.body_type = _par_in_enum(k + 1, "BodyType.", &body_type_name, 3);
        rb.position = _par_in_v2(k + 2);
        rb.rotation = _par_in_f(k + 4);
        rb.linear_velocity = _par_in_v2(k + 5);
        rb.angular_velocity = _par_in_f(k + 7);
        rb.linear_damping = _par_in_f(k + 8);
        rb.angular_damping = _par_in_f(k + 9);
        rb.fixed_rotation = _par_in(k + 10);
        rb.gravity_scale = _par_in_f(k + 11);
        rb.force_accumulator = _par_in_v2(k + 12);
        rb.torque_accumulator = _par_in_f(k + 14);
        rb.mass = _par_in_f(k + 15);
        rb.inv_mass = _par_in_f(k + 16);
        rb.inertia = _par_in_f(k + 17);
        rb.inv_inertia = _par_in_f(k + 18);
        rb.pseudo_velocity = _par_in_v2(k + 19);
        rb.pseudo_angular_velocity = _par_in_f(k + 21);
        rb.prev_position = _par_in_v2(k + 22);
        rb.prev_rotation = _par_in_f(k + 24);
        rb.is_sleeping = _par_in(k + 25);
        rb.sleep_timer = _par_in_f(k + 26);
        rb.island_id = _par_in(k + 27);
        k = k + 28;
    }
    var ca: *ImArena = st._colliders();
    k = _par_load_arena(ca, k);
    var nc = _par_in(k);
    k = k + 1;
    for (var c = 0; c < nc; c = c + 1) {
        var cp: *ImCollider2d = _im_b2_as_coll(_par_slot(ca, _par_in(k)));
        cp.handle = _par_in(k);
        cp.body = _par_in(k + 1);
        var sh: ImColliderShape = _im_shape(IM_SHAPE_BALL);
        k = _par_in_shape(k + 2, &sh);
        cp.shape = sh;
        cp.offset = _par_in_v2(k);
        cp.material = _par_in_material(k + 3);
        cp.is_sensor = _par_in(k + 10);
        cp.has_mass = 0;
        cp.mass = 0.0;
        if (_par_in_is_none(k + 11) == 0) {
            cp.has_mass = 1;
            cp.mass = _par_in_f(k + 11);
        }
        cp.collision_layer = _par_in(k + 12);
        cp.collision_mask = _par_in(k + 13);
        k = k + 14;
    }
    var ja: *ImArena = st._joints();
    k = _par_load_arena(ja, k);
    var nj = _par_in(k);
    k = k + 1;
    for (var j = 0; j < nj; j = j + 1) {
        var jp: *ImJoint2d = _im_b2_as_joint(_par_slot(ja, _par_in(k)));
        jp.body_a = _par_in(k + 1);
        jp.body_b = _par_in(k + 2);
        var jt: ImJointType = ImJointType_fixed();
        k = _par_in_joint_type(k + 3, &jt);
        jp.joint_type = jt;
        jp.local_anchor_a = _par_in_v2(k);
        jp.local_anchor_b = _par_in_v2(k + 2);
        k = k + 4;
        jp.has_motor = 0;
        if (_par_in_is_none(k) == 1) {
            k = k + 1;
        } else {
            jp.has_motor = 1;
            jp.motor = ImJointMotor_new(_par_in_f(k), _par_in_f(k + 1));
            k = k + 2;
        }
        jp.damping = _par_in_f(k);
        jp.has_break_force = 0;
        jp.break_force = 0.0;
        if (_par_in_is_none(k + 1) == 0) {
            jp.has_break_force = 1;
            jp.break_force = _par_in_f(k + 1);
        }
        jp.reference_angle = _par_in_f(k + 2);
        k = k + 3;
    }
    var ne = _par_in(k);
    k = k + 1;
    for (var e = 0; e < ne; e = e + 1) {
        var list: *ImWordList = st._list(_im_handle_index(_par_in(k)));
        list.len = 0;
        var m = _par_in(k + 1);
        for (var q = 0; q < m; q = q + 1) { list.push(_par_in(k + 2 + q)); }
        k = k + 2 + m;
    }
    var nm = _par_in(k);
    k = k + 1;
    if (nm > 0) {
        st.manifolds.data = fl_alloc(nm * sizeof(ImContactManifold));
        st.manifolds.cap = nm;
    }
    for (var mi = 0; mi < nm; mi = mi + 1) {
        var mf: *ImContactManifold = _im_b2_as_manifold(st.manifolds.data + mi * sizeof(ImContactManifold));
        mf.collider_a = _par_in(k);
        mf.collider_b = _par_in(k + 1);
        mf.body_a = _par_in(k + 2);
        mf.body_b = _par_in(k + 3);
        mf.normal = _par_in_v2(k + 4);
        var np = _par_in(k + 6);
        mf.point_count = np;
        mf.points = 0;
        if (np > 0) { mf.points = fl_alloc(np * sizeof(ImManifoldPoint)); }
        for (var pi = 0; pi < np * 7; pi = pi + 1) { store64(mf.points + pi * 8, _par_in(k + 7 + pi)); }
        k = k + 7 + np * 7;
        mf.rolling_impulse = _par_in_f(k);
        k = k + 1;
        st.manifolds.len = mi + 1;
    }
    k = _par_load_pairs(st.contact_tracker.prev, k);
    k = _par_load_pairs(st.contact_tracker.current, k);
    k = _par_load_pairs(st.contact_tracker.seen, k);
    st.contact_tracker.recorded = _par_in(k);
    return k + 1;
}

fn _par_b2_step(fp, fl): i64 {
    if (_par_eq(fp, fl, "b2::step") != 1) { return 0; }
    var cfg: ImWorldConfig = _par_in_config(0);
    var st: ImPhysicsState2d = ImPhysicsState2d_new();
    _par_load_state(&st, 16);
    var sub = cfg.sub_steps;
    if (sub < 1) { sub = 1; }
    var ts: f64 = cfg.timestep;
    var subf: f64 = f64_from(sub);
    var dt: f64 = ts / subf;
    for (var s = 0; s < sub; s = s + 1) {
        st.step(cfg.gravity, dt, cfg.velocity_iterations, cfg.position_iterations, cfg.position_slop,
          cfg.position_correction, cfg.max_velocity, cfg.constraint_frequency, cfg.constraint_damping_ratio,
          cfg.broadphase, cfg.solver);
    }
    var ne = st.finish_step();
    _par_got_state(&st);
    _par_got_seq(ne);
    for (var e = 0; e < ne; e = e + 1) { _par_got_event(st.contact_tracker.event(e)); }
    st.free();
    return 1;
}

# ── M3d: world steps ────────────────────────────────────────────────────────────────
# A `world::step` row is the config, the world's own state (the particle and emitter counters, the
# particles, emitters and force fields) and the backend dump; the port loads all three into an
# ImPhysicsWorld, steps it, and writes them again with the frame's events.

# The world's own tokens (the particles, emitters and fields) are read and written by tests/parity_types.cyr.

fn _par_got_world(w: *ImPhysicsWorld) {
    _par_got_world_own(w);
    _par_got_state(w.backend);
    return 0;
}

fn _par_world_step(fp, fl): i64 {
    if (_par_eq(fp, fl, "world::step") != 1) { return 0; }
    var cfg: ImWorldConfig = _par_in_config(0);
    var w: ImPhysicsWorld = ImPhysicsWorld_new(cfg);
    var k = _par_load_world(&w, 16);
    _par_load_state(w.backend, k);
    w.step();
    _par_got_world(&w);
    var ev, n = w.collision_events();
    _par_got_seq(n);
    for (var e = 0; e < n; e = e + 1) { _par_got_event(ev + e * sizeof(ImCollisionEvent)); }
    w.free();
    return 1;
}

# `f64::fmt_display` and `serde_json::f64` rows: src/fmtf.cyr's two layouts (ADR 0010).
fn _par_fmtf(fp, fl): i64 {
    var x: f64 = _par_in(0);
    var sb = str_builder_new();
    if (_par_eq(fp, fl, "f64::fmt_display") == 1) {
        im_fmt_f64_display(sb, x);
    } elif (_par_eq(fp, fl, "serde_json::f64") == 1) {
        im_fmt_f64_json(sb, x);
    } else {
        return 0;
    }
    var txt = str_builder_build(sb);
    _par_got_text(str_data(txt), str_len(txt));
    return 1;
}

# ── json (ADR 0010) ─────────────────────────────────────────────────────────────────
# `serde_json::to_string::<T>` rows: the flattened value in, the port's document out (compared byte
# for byte). `serde_json::from_str::<T>` rows: a document in, the port's decoded fields (or
# E:Deserialize) out.

# A force or impulse's vector and point from the flattened tokens at k: the vector, then `n:` or the
# point. Writes *has.
fn _par_in_vector_point(k, v: *ImVec3, has, p: *ImVec3) {
    var x: f64 = _par_in(k);
    var y: f64 = _par_in(k + 1);
    var z: f64 = _par_in(k + 2);
    v.x = x;
    v.y = y;
    v.z = z;
    store64(has, 0);
    if (_par_in_is_none(k + 3) == 0) {
        var px: f64 = _par_in(k + 3);
        var py: f64 = _par_in(k + 4);
        var pz: f64 = _par_in(k + 5);
        p.x = px;
        p.y = py;
        p.z = pz;
        store64(has, 1);
    }
    return 0;
}

# Appends the builder's text as the row's `s:` output.
fn _par_got_builder(sb) {
    var txt = str_builder_build(sb);
    _par_got_text(str_data(txt), str_len(txt));
    return 0;
}

fn _par_json_write(fp, fl): i64 {
    var sb = str_builder_new();
    if (_par_eq(fp, fl, "serde_json::to_string::<WorldConfig>") == 1) {
        var c: ImWorldConfig = _par_in_config(0);
        c.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<PhysicsMaterial>") == 1) {
        var m: ImPhysicsMaterial = _par_in_material(0);
        m.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<Quantity>") == 1) {
        var v: f64 = _par_in(0);
        var q: ImQuantity = ImQuantity_new(v, _par_in_enum(1, "PhysicsUnit.", &physics_unit_name, 14));
        q.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<Force>") == 1) {
        var f: ImForce = ImForce_new(0.0, 0.0, 0.0);
        var has[8];
        var vv: ImVec3 = ImVec3_zero();
        var pp: ImVec3 = ImVec3_zero();
        _par_in_vector_point(0, &vv, &has, &pp);
        f.vector = vv;
        f.has_point = load64(&has);
        f.point = pp;
        f.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<Impulse>") == 1) {
        var i: ImImpulse = ImImpulse_new(0.0, 0.0, 0.0);
        var hi[8];
        var vi: ImVec3 = ImVec3_zero();
        var pi: ImVec3 = ImVec3_zero();
        _par_in_vector_point(0, &vi, &hi, &pi);
        i.vector = vi;
        i.has_point = load64(&hi);
        i.point = pi;
        i.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<Torque>") == 1) {
        var tv: f64 = _par_in(0);
        var t: ImTorque = ImTorque_new(tv);
        t.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<BodyDesc>") == 1) {
        var bd: ImBodyDesc = _par_in_body_desc(0);
        bd.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<BodyState>") == 1) {
        var bs: ImBodyState = _par_in_body_state(0);
        bs.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<ColliderShape>") == 1) {
        var sh: ImColliderShape = _im_shape(IM_SHAPE_BALL);
        _par_in_shape(0, &sh);
        sh.to_json(sb);
        sh.free();
    } elif (_par_eq(fp, fl, "serde_json::to_string::<ColliderDesc>") == 1) {
        var cd: ImColliderDesc = ImColliderDesc_new(_im_shape(IM_SHAPE_BALL));
        _par_in_collider_desc(&cd);
        cd.to_json(sb);
        cd.shape.free();
    } elif (_par_eq(fp, fl, "serde_json::to_string::<JointType>") == 1) {
        var jt: ImJointType = ImJointType_fixed();
        _par_in_joint_type(0, &jt);
        jt.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<JointDesc>") == 1) {
        var jd: ImJointDesc = _par_in_joint_desc();
        jd.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<CollisionEvent>") == 1) {
        var kind = _par_in_enum(0, "CollisionEvent.", &event_kind_name, 3);
        var ev: ImCollisionEvent = ImCollisionEvent_new(kind, _par_in(1), _par_in(2));
        ev.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<ContactPoint>") == 1) {
        var cp: ImContactPoint = _par_in_contact_point(0);
        cp.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<ContactData>") == 1) {
        var cdt: ImContactData;
        _par_in_contact_data(&cdt);
        cdt.to_json(sb);
        cdt.free();
    } elif (_par_eq(fp, fl, "serde_json::to_string::<RayHit>") == 1) {
        var rh: ImRayHit;
        rh.collider = _par_in(0);
        rh.point = _par_in_v3(1);
        rh.normal = _par_in_v3(4);
        var rd: f64 = _par_in(7);
        rh.distance = rd;
        rh.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<PointQuery>") == 1) {
        var pq: ImPointQuery;
        pq.collider = _par_in(0);
        var pd: f64 = _par_in(1);
        pq.distance = pd;
        pq.is_inside = _par_in(2);
        pq.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<Spring>") == 1) {
        var sp: ImSpring = _par_in_spring(0);
        sp.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<Spring2d>") == 1) {
        var s2: ImSpring2d;
        s2.x = _par_in_spring(0);
        s2.y = _par_in_spring(6);
        s2.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<ForceField>") == 1) {
        var ff: ImForceField;
        _par_in_force_field(0, &ff);
        ff.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<SubEmitter>") == 1) {
        var se: ImSubEmitter = ImSubEmitter_new(_par_in(0), _par_in_f(1), _par_in_f(2), _par_in_f(3), _par_in_f(4),
          _par_in_f(5));
        se.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<Particle>") == 1) {
        var pt: ImParticle;
        _par_in_particle(0, &pt);
        pt.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<ParticleEmitter>") == 1) {
        var em: ImParticleEmitter;
        _par_in_emitter(0, &em);
        em.to_json(sb);
    } elif (_par_eq(fp, fl, "serde_json::to_string::<Spring3d>") == 1) {
        var s3: ImSpring3d;
        s3.x = _par_in_spring(0);
        s3.y = _par_in_spring(6);
        s3.z = _par_in_spring(12);
        s3.to_json(sb);
    } else {
        return 0;
    }
    _par_got_builder(sb);
    return 1;
}

# 1 when the n bytes at p contain the C string `needle`.
#must_use
fn _par_has(p, n, needle): i64 {
    var m = strlen(needle);
    for (var i = 0; i + m <= n; i = i + 1) {
        if (memeq(p + i, needle, m) == 1) { return 1; }
    }
    return 0;
}

# 1 for a document that meets a bayan policy stricter than serde_json (port plan §8), so its row is
# pending until the gap closes: S3, an integer above i64::MAX (a u64 handle or `step` at 2^63 and
# up, or an integer beyond u64 that serde_json reads as an f64); S4, a duplicate key that serde
# ignores (an unknown field, or one inside an ignored value). Matched by the generator's edge
# documents' markers.
#must_use
fn _par_bayan_gap(doc): i64 {
    var n = strlen(doc);
    if (_par_has(doc, n, "18446744073709551615") == 1) { return 1; }
    if (_par_has(doc, n, "9223372036854775808") == 1) { return 1; }
    if (_par_has(doc, n, "100000000000000000000") == 1) { return 1; }
    if (_par_has(doc, n, "\"x\":1,\"x\":2") == 1) { return 1; }
    if (_par_has(doc, n, "\"a\":1,\"a\":2") == 1) { return 1; }
    return 0;
}

fn _par_json_read(fp, fl): i64 {
    var doc = _par_in_cstr(0);
    if (doc == 0) { return 0 - 1; }
    if (_par_bayan_gap(doc) == 1) { return 0; }
    var n = strlen(doc);
    if (_par_eq(fp, fl, "serde_json::from_str::<WorldConfig>") == 1) {
        var c: ImWorldConfig = ImWorldConfig_default();
        var t, v = ImWorldConfig_from_json(doc, n, &c);
        if (is_err_result(t) == 1) { _par_got_err(v); } else { _par_got_config(c); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<PhysicsMaterial>") == 1) {
        var m: ImPhysicsMaterial = ImPhysicsMaterial_default();
        var tm, vm = ImPhysicsMaterial_from_json(doc, n, &m);
        if (is_err_result(tm) == 1) { _par_got_err(vm); } else { _par_got_material(m); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<Quantity>") == 1) {
        var q: ImQuantity = ImQuantity_meters(0.0);
        var tq, vq = ImQuantity_from_json(doc, n, &q);
        if (is_err_result(tq) == 1) { _par_got_err(vq); } else { _par_got_quantity(q); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<Force>") == 1) {
        var f: ImForce = ImForce_new(0.0, 0.0, 0.0);
        var tf, vf = ImForce_from_json(doc, n, &f);
        if (is_err_result(tf) == 1) {
            _par_got_err(vf);
        } else {
            _par_got_vector_point(f.vector, f.has_point, f.point);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<Impulse>") == 1) {
        var i: ImImpulse = ImImpulse_new(0.0, 0.0, 0.0);
        var ti, vi = ImImpulse_from_json(doc, n, &i);
        if (is_err_result(ti) == 1) {
            _par_got_err(vi);
        } else {
            _par_got_vector_point(i.vector, i.has_point, i.point);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<Torque>") == 1) {
        var tq2: ImTorque = ImTorque_new(0.0);
        var tt, vt = ImTorque_from_json(doc, n, &tq2);
        if (is_err_result(tt) == 1) {
            _par_got_err(vt);
        } else {
            var val: f64 = tq2.value;
            _par_got_f(val);
        }
        return 1;
    }
    return _par_json_read_m1b(fp, fl, doc, n);
}

# The particle types' documents (M3d).
fn _par_json_read_m3(fp, fl, doc, n): i64 {
    if (_par_eq(fp, fl, "serde_json::from_str::<ForceField>") == 1) {
        var ff: ImForceField;
        var t1, v1 = ImForceField_from_json(doc, n, &ff);
        if (is_err_result(t1) == 1) { _par_got_err(v1); } else { _par_got_force_field(&ff); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<SubEmitter>") == 1) {
        var se: ImSubEmitter;
        var t2, v2 = ImSubEmitter_from_json(doc, n, &se);
        if (is_err_result(t2) == 1) { _par_got_err(v2); } else { _par_got_sub_emitter(&se); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<Particle>") == 1) {
        var pt: ImParticle;
        var t3, v3 = ImParticle_from_json(doc, n, &pt);
        if (is_err_result(t3) == 1) { _par_got_err(v3); } else { _par_got_particle(&pt); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<ParticleEmitter>") == 1) {
        var em: ImParticleEmitter;
        var t4, v4 = ImParticleEmitter_from_json(doc, n, &em);
        if (is_err_result(t4) == 1) { _par_got_err(v4); } else { _par_got_emitter(&em); }
        return 1;
    }
    return 0;
}

fn _par_json_read_m1b(fp, fl, doc, n): i64 {
    if (_par_eq(fp, fl, "serde_json::from_str::<BodyDesc>") == 1) {
        var bd: ImBodyDesc = ImBodyDesc_default();
        var t1, v1 = ImBodyDesc_from_json(doc, n, &bd);
        if (is_err_result(t1) == 1) { _par_got_err(v1); } else { _par_got_body_desc(bd); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<BodyState>") == 1) {
        var bs: ImBodyState;
        var t2, v2 = ImBodyState_from_json(doc, n, &bs);
        if (is_err_result(t2) == 1) { _par_got_err(v2); } else { _par_got_body_state(bs); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<ColliderShape>") == 1) {
        var sh: ImColliderShape = _im_shape(IM_SHAPE_BALL);
        var t3, v3 = ImColliderShape_from_json(doc, n, &sh);
        if (is_err_result(t3) == 1) {
            _par_got_err(v3);
        } else {
            _par_got_shape(sh);
            sh.free();
        }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<ColliderDesc>") == 1) {
        var cd: ImColliderDesc = ImColliderDesc_new(_im_shape(IM_SHAPE_BALL));
        var t4, v4 = ImColliderDesc_from_json(doc, n, &cd);
        if (is_err_result(t4) == 1) {
            _par_got_err(v4);
        } else {
            _par_got_collider_desc(cd);
            cd.shape.free();
        }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<JointType>") == 1) {
        var jt: ImJointType = ImJointType_fixed();
        var t5, v5 = ImJointType_from_json(doc, n, &jt);
        if (is_err_result(t5) == 1) { _par_got_err(v5); } else { _par_got_joint_type(jt); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<JointDesc>") == 1) {
        var jd: ImJointDesc = ImJointDesc_new(0, 0, ImJointType_fixed(), ImVec2_new(0.0, 0.0), ImVec2_new(0.0, 0.0));
        var t6, v6 = ImJointDesc_from_json(doc, n, &jd);
        if (is_err_result(t6) == 1) { _par_got_err(v6); } else { _par_got_joint_desc(jd); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<CollisionEvent>") == 1) {
        var ev: ImCollisionEvent = ImCollisionEvent_new(0, 0, 0);
        var t7, v7 = ImCollisionEvent_from_json(doc, n, &ev);
        if (is_err_result(t7) == 1) { _par_got_err(v7); } else { _par_got_event(ev); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<ContactPoint>") == 1) {
        var cp: ImContactPoint;
        var t8, v8 = ImContactPoint_from_json(doc, n, &cp);
        if (is_err_result(t8) == 1) { _par_got_err(v8); } else { _par_got_contact_point(cp); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<ContactData>") == 1) {
        var cdt: ImContactData;
        var t9, v9 = ImContactData_from_json(doc, n, &cdt);
        if (is_err_result(t9) == 1) {
            _par_got_err(v9);
        } else {
            _par_got_contact_data(cdt);
            cdt.free();
        }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<RayHit>") == 1) {
        var rh: ImRayHit;
        var ta, va = ImRayHit_from_json(doc, n, &rh);
        if (is_err_result(ta) == 1) { _par_got_err(va); } else { _par_got_ray_hit(rh); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<PointQuery>") == 1) {
        var pq: ImPointQuery;
        var tb, vb = ImPointQuery_from_json(doc, n, &pq);
        if (is_err_result(tb) == 1) { _par_got_err(vb); } else { _par_got_point_query(pq); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<Spring>") == 1) {
        var sp: ImSpring = ImSpring_new(0.0, 0.0, 0.0, 0.0);
        var tc, vc = ImSpring_from_json(doc, n, &sp);
        if (is_err_result(tc) == 1) { _par_got_err(vc); } else { _par_got_spring(sp); }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<Spring2d>") == 1) {
        var s2: ImSpring2d;
        var td, vd = ImSpring2d_from_json(doc, n, &s2);
        if (is_err_result(td) == 1) {
            _par_got_err(vd);
        } else {
            _par_got_spring(s2.x);
            _par_got_spring(s2.y);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "serde_json::from_str::<Spring3d>") == 1) {
        var s3: ImSpring3d;
        var te, ve = ImSpring3d_from_json(doc, n, &s3);
        if (is_err_result(te) == 1) {
            _par_got_err(ve);
        } else {
            _par_got_spring(s3.x);
            _par_got_spring(s3.y);
            _par_got_spring(s3.z);
        }
        return 1;
    }
    return _par_json_read_m3(fp, fl, doc, n);
}

fn _par_json(fp, fl): i64 {
    var h = _par_json_write(fp, fl);
    if (h != 0) { return h; }
    return _par_json_read(fp, fl);
}

fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    _par_mapped = 0;
    if (_par_eq(mp, ml, "b2_mass") == 1) { return _par_b2_mass(fp, fl); }
    if (_par_eq(mp, ml, "b2_narrow") == 1) { return _par_b2_narrow(fp, fl); }
    if (_par_eq(mp, ml, "b2_ray") == 1) { return _par_b2_ray(fp, fl); }
    if (_par_eq(mp, ml, "b2_state") == 1) { return _par_b2_state(fp, fl); }
    if (_par_eq(mp, ml, "b2_step") == 1 || _par_eq(mp, ml, "b2_contact") == 1) { return _par_b2_step(fp, fl); }
    if (_par_eq(mp, ml, "world_step") == 1) { return _par_world_step(fp, fl); }
    if (_par_eq(mp, ml, "broadphase") == 1) { return _par_broadphase(fp, fl); }
    if (_par_eq(mp, ml, "config") == 1) { return _par_config(fp, fl); }
    if (_par_eq(mp, ml, "fmtf") == 1) { return _par_fmtf(fp, fl); }
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "force") == 1) { return _par_force(fp, fl); }
    if (_par_eq(mp, ml, "json") == 1) { return _par_json(fp, fl); }
    if (_par_eq(mp, ml, "material") == 1) { return _par_material(fp, fl); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    if (_par_eq(mp, ml, "spring") == 1) { return _par_spring(fp, fl); }
    if (_par_eq(mp, ml, "types") == 1) { return _par_types(fp, fl); }
    if (_par_eq(mp, ml, "units") == 1) { return _par_units(fp, fl); }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through another Cyrius candidate.
# - the native exp and ganita's atan2 (on the native atan): x87 on x86_64, so their bits differ
#   between targets; the polyfill forms are dispatched instead (port-parity.md §2);
# - the exp, sin and cos polyfills (the builtin sin / cos on every target) and ganita's hypot, the
#   port's primitives before the correctly rounded ones (ADR 0011);
# - the stdlib min / max, to show where their NaN semantics differ from Rust's.
fn _par_shadows(mp, ml, fp, fl, cls) {
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    # The port's own outputs first (a pending row has none), before a shadow replaces them.
    if (_par_got_n > 0) { _par_dg_fold(_par_dg_slot(fp, fl)); }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_exp(x);
        _par_got_f(r);
        _par_shadow_record("f64::exp ~ f64_exp (native)", cls);
        _par_dg_fold(8);
        _par_got_n = 0;
        _par_got_f(_f64_exp_polyfill(x));
        _par_shadow_record("f64::exp ~ _f64_exp_polyfill", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::sin") == 1) {
        _par_got_n = 0;
        var r: f64 = _f64_sin_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::sin ~ _f64_sin_polyfill", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::cos") == 1) {
        _par_got_n = 0;
        var r: f64 = _f64_cos_polyfill(x);
        _par_got_f(r);
        _par_shadow_record("f64::cos ~ _f64_cos_polyfill", cls);
        return 0;
    }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::atan2") == 1) {
        _par_got_n = 0;
        _par_got_f(_par_atan2_poly(_par_in(0), _par_in(1)));
        _par_shadow_record("f64::atan2 ~ atan polyfill", cls);
        _par_got_n = 0;
        var r: f64 = ganita_f64_atan2(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::atan2 ~ ganita_f64_atan2", cls);
        _par_dg_fold(9);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::hypot") == 1) {
        _par_got_n = 0;
        var r: f64 = ganita_f64_hypot(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::hypot ~ ganita_f64_hypot", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::max") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_max(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::max ~ f64_max", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_min(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::min ~ f64_min", cls);
        return 0;
    }
    return 0;
}

# The class-C bound for a function, in ulps; -1 when none is set yet (the rows are measured).
# Bounds are derived in M0 step 8 (docs/development/port-parity.md) per target against glibc,
# BEFORE the function's first gated comparison, and never raised to make a row pass.
#
# The math primitives get 2 ulp: glibc and each Cyrius counterpart (the polyfills, ganita) document
# about 1 ulp, so two implementations can differ by up to 2. Measured 2026-11-09 on x86_64 ELF,
# x86_64 PE and aarch64: max 1 ulp, except hypot's 3 rows at 2 (port-parity.md §2). impetus's own
# class-C functions get K_F = 2·S·c + 2 at their milestones (port-parity.md, the rule).
#
# On correctly rounded primitives (ADR 0011) the bound is 0: the port and the corrected oracle
# evaluate the same operations on the same correctly rounded results, so any difference is a defect.
# That covers exp, sin, cos, sin_cos, hypot, pow, the spring step, the narrowphase and the step; atan2
# keeps 2.
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::sin_cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "Spring::step") == 1) { return 0; }
    if (_par_eq(fp, fl, "b2::contacts") == 1) { return 0; }
    if (_par_eq(fp, fl, "b2::raycast") == 1) { return 0; }
    if (_par_eq(fp, fl, "b2::step") == 1) { return 0; }
    if (_par_eq(fp, fl, "world::step") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::atan2") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::hypot") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    return 0 - 1;
}

# The ADR accepting a divergent row (function and raw input field), or 0. Each entry names its ADR;
# an accepted row is reported on every run and doesn't fail its module. The ADR 0007 hisab paths
# arrive with M4, the ADR 0008 mappings with their modules.
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    # ADR 0008 #6: a `validate` row the port refuses as XPBD (mapped by the config dispatcher).
    if (_par_mapped == 8) { return 8; }
    # (ADR 0009's pow(-1, DBL_MAX) row needs no entry since crmath's pow replaced ganita's: it is ok.)
    return 0;
}

# 1 for an ADR whose accepted rows are counted but not printed row by row: ADR 0008's XPBD mapping
# (summarised by _par_module_done).
#must_use
fn _par_accepted_quiet(adr): i64 {
    if (adr == 8) { return 1; }
    return 0;
}

# After the config module: the ADR 0008 #6 mapping summary. After the math module: the cross-target
# digests.
fn _par_module_done(mp, ml) {
    if (_par_eq(mp, ml, "config") == 1) {
        print("  ADR 0008 #6 XPBD: ", 20);
        fmt_int(_par_map_xpbd);
        print(" validate rows the oracle accepts and the port refuses", 54);
        println(" (Err(Unsupported)), accepted (ADR 8)");
        return 0;
    }
    if (_par_eq(mp, ml, "b2_state") == 1) {
        print("  ADR 0008 #1 orphans: ", 23);
        fmt_int(_par_map_orphan);
        println(" scripts add a collider or joint for a missing body, which the port refuses, accepted (ADR 8)");
        return 0;
    }
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    _par_dg_print(0, "f64::sin_cos");
    _par_dg_print(1, "f64::sin");
    _par_dg_print(2, "f64::cos");
    _par_dg_print(3, "f64::atan2");
    _par_dg_print(4, "f64::hypot");
    _par_dg_print(5, "f64::exp");
    _par_dg_print(6, "f64::powf");
    _par_dg_print(7, "class A/B rows");
    _par_dg_print(8, "exp ~ f64_exp (native)");
    _par_dg_print(9, "atan2 ~ ganita_f64_atan2");
    return 0;
}

# The 3D backend's modules (`b3_*`) are replayed by tests/parity_3d.tcyr (M4).
#must_use
fn _par_skip(mp, ml): i64 {
    if (ml >= 3 && load8(mp) == 98 && load8(mp + 1) == 51 && load8(mp + 2) == 95) { return 1; }
    return 0;
}

_par_dg_init();
var exit_code = _par_main();
sys_exit_group(exit_code);
