# Fattening margin — how much to expand AABBs to reduce reinsertions.
# Rust: `AABB_MARGIN: f64 = 0.1`
var _IM_AABB_MARGIN: f64 = 0.1;

# ── rust-old/src/spatial_hash.rs ──

# Entries spanning more cells than this (huge, non-finite or NaN bounds)
# are kept in an "oversized" list and paired with every other entry instead
# of being rasterised, so one bad AABB can't stall the broadphase.
# Rust: `MAX_CELLS_PER_ENTRY: f64 = 4096.0`
var _IM_MAX_CELLS_PER_ENTRY: f64 = 4096.0;

