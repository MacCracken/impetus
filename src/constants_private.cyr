# General-purpose geometry epsilon for zero-length checks (normals, axes, etc.).
# Rust: `EPSILON: f64 = 1e-10`
var _IM_B2_EPSILON: f64 = 0.0000000001;

# Squared epsilon for distance-squared checks (avoids sqrt for near-zero vectors).
# Rust: `EPSILON_SQ: f64 = 1e-20`
var _IM_B2_EPSILON_SQ: f64 = 0.00000000000000000001;

# Bodies with both linear and angular speed below this are candidates for sleep.
# Rust: `SLEEP_VELOCITY_THRESHOLD: f64 = 0.01`
var _IM_B2_SLEEP_VELOCITY_THRESHOLD: f64 = 0.01;

# How many seconds of low motion before a body is put to sleep.
# Rust: `SLEEP_TIME_THRESHOLD: f64 = 0.5`
var _IM_B2_SLEEP_TIME_THRESHOLD: f64 = 0.5;

# Minimum mass/inertia to avoid division by zero for dynamic bodies.
# Rust: `MIN_MASS: f64 = 1e-6`
var _IM_B2_MIN_MASS: f64 = 0.000001;

# Minimum inertia to avoid division by zero.
# Rust: `MIN_INERTIA: f64 = 1e-10`
var _IM_B2_MIN_INERTIA: f64 = 0.0000000001;

# Distance threshold for matching manifold points across frames (body-local coords).
# Rust: `MANIFOLD_MATCH_THRESHOLD: f64 = 0.02`
var _IM_B2_MANIFOLD_MATCH_THRESHOLD: f64 = 0.02;

# Maximum number of contact points per manifold in 2D.
# Increased from 2 to 4 for one-shot manifold generation (edge clipping).
# Rust: `MAX_MANIFOLD_POINTS: usize = 4`
const _IM_B2_MAX_MANIFOLD_POINTS = 4;

# Warm starting scale factor — slightly less than 1.0 for stability.
# Rust: `WARM_START_FACTOR: f64 = 0.95`
var _IM_B2_WARM_START_FACTOR: f64 = 0.95;

# FALLBACK is not carried: the (1, [0, 0], 1) tuple local to `shape_props`, written in place in src/b2_types.cyr.

