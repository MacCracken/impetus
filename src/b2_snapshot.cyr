# b2_snapshot.cyr — the 2D profile's snapshot (ADR 0013): `ImWorldSnapshot` over the 2D backend's own records, and its
# backend half: capture from a state, the checks, and the load into a fresh one. src/world_snapshot.cyr, after this
# file, holds `snapshot`, `restore` and the world's half; src/snapshot.cyr, before it, the arena and tracker pieces.
#
# The records are the backend's (ImRigidBody2d, ImCollider2d, ImJoint2d, ImContactManifold), field for field, so a
# snapshot holds what the oracle's dump holds. A snapshot owns its copies: each collider's shape arrays, each
# manifold's points, each body's collider list; `free` releases them.

# A body and its collider handles, in attachment order. Rust's `BodySnapshot` (a `BodyDesc` and the kinematic state);
# here the whole body record.
struct ImBodySnapshot {
    body: ImRigidBody2d;
    colliders: ImWordList;
}

# A joint record and its handle. Rust's `JointSnapshot` (a `JointDesc`); here the whole record, its reference angle
# included.
struct ImJointSnapshot {
    handle;
    joint: ImJoint2d;
}

# A 2D world's whole state (ADR 0013). `bodies` are ImBodySnapshot records, `colliders` ImCollider2d (Rust's
# `ColliderSnapshot`) and `joints` ImJointSnapshot, each in its arena's slot order; `particles`, `emitters` and
# `force_fields` the world's records; the three arenas' slots and free lists; the contact manifolds (ImContactManifold
# records in key order, each owning its points); the contact tracker. Mirrors Rust's `WorldSnapshot`, which holds the
# first eight fields' worth (less the arenas, force fields, manifolds and tracker).
struct ImWorldSnapshot {
    config: ImWorldConfig;
    next_particle_id;
    next_emitter_id;
    bodies: ImRecordList;
    colliders: ImRecordList;
    joints: ImRecordList;
    particles: ImRecordList;
    emitters: ImRecordList;
    force_fields: ImRecordList;
    body_arena: ImArenaSnapshot;
    collider_arena: ImArenaSnapshot;
    joint_arena: ImArenaSnapshot;
    manifolds: ImRecordList;
    tracker: ImTrackerSnapshot;
}

# The binary form's profile word for this profile (ADR 0013).
const _IM_SNAP_PROFILE = 2;

# The JSON form's profile name for this profile (ADR 0013).
#must_use
fn _im_snap_profile_name(): i64 { return "2d"; }

#must_use
fn _im_as_body_snap(p): *ImBodySnapshot { return p; }
#must_use
fn _im_as_joint_snap(p): *ImJointSnapshot { return p; }

#must_use
fn _im_b2_as_point(p): *ImManifoldPoint { return p; }

# The collider list of the ImBodySnapshot record at r (Cyrius takes no field addresses: the word after the body).
#must_use
fn _im_b2_snap_list(r): *ImWordList { return r + sizeof(ImRigidBody2d); }

# An empty snapshot (the default config).
#must_use
fn ImWorldSnapshot_new(): ImWorldSnapshot {
    var s: ImWorldSnapshot;
    s.config = ImWorldConfig_default();
    s.next_particle_id = 0;
    s.next_emitter_id = 0;
    s.bodies = ImRecordList_new(sizeof(ImBodySnapshot));
    s.colliders = ImRecordList_new(sizeof(ImCollider2d));
    s.joints = ImRecordList_new(sizeof(ImJointSnapshot));
    s.particles = ImRecordList_new(sizeof(ImParticle));
    s.emitters = ImRecordList_new(sizeof(ImParticleEmitter));
    s.force_fields = ImRecordList_new(sizeof(ImForceField));
    s.body_arena = ImArenaSnapshot_new();
    s.collider_arena = ImArenaSnapshot_new();
    s.joint_arena = ImArenaSnapshot_new();
    s.manifolds = ImRecordList_new(sizeof(ImContactManifold));
    s.tracker = ImTrackerSnapshot_new();
    return s;
}

impl ImWorldSnapshot {
    # Captures the state's arenas, records, collider lists, manifolds and tracker: 1, or 0 when there is no memory
    # (what was captured stays owned by the snapshot, for `free`).
    fn _capture_backend(self, st: *ImPhysicsState2d): i64 {
        var ba: *ImArena = st._bodies();
        var ca: *ImArena = st._colliders();
        var ja: *ImArena = st._joints();
        if (self.body_arena.capture(ba) == 0) { return 0; }
        if (self.collider_arena.capture(ca) == 0) { return 0; }
        if (self.joint_arena.capture(ja) == 0) { return 0; }
        if (self.bodies.reserve(ba.len()) == 0) { return 0; }
        var empty: ImWordList = ImWordList_new();
        for (var s = 0; s < ba.slot_count(); s = s + 1) {
            var bh = ba.slot_handle(s);
            if (bh != 0 - 1) {
                var r = self.bodies.at(self.bodies.len);
                memcpy(r, ba.get(bh), sizeof(ImRigidBody2d));
                var dl: *ImWordList = _im_b2_snap_list(r);
                memcpy(dl, &empty, sizeof(ImWordList));
                self.bodies.len = self.bodies.len + 1;
                var sl: *ImWordList = st._list(_im_handle_index(bh));
                if (sl == 0) { return 0; }
                if (dl.reserve(sl.len) == 0) { return 0; }
                for (var q = 0; q < sl.len; q = q + 1) { dl.push(sl.at(q)); }
            }
        }
        if (self.colliders.reserve(ca.len()) == 0) { return 0; }
        var sh: ImColliderShape;
        for (var c = 0; c < ca.slot_count(); c = c + 1) {
            var ch = ca.slot_handle(c);
            if (ch != 0 - 1) {
                var src: *ImCollider2d = _im_b2_as_coll(ca.get(ch));
                var plain = _im_snap_shape_plain(src.shape);
                if (plain == 0) {
                    if (_im_snap_clone_shape(src.shape, &sh) == 0) { return 0; }
                }
                var cr: *ImCollider2d = _im_b2_as_coll(self.colliders.at(self.colliders.len));
                memcpy(cr, src, sizeof(ImCollider2d));
                if (plain == 0) { cr.shape = sh; }
                self.colliders.len = self.colliders.len + 1;
            }
        }
        if (self.joints.reserve(ja.len()) == 0) { return 0; }
        for (var j = 0; j < ja.slot_count(); j = j + 1) {
            var jh = ja.slot_handle(j);
            if (jh != 0 - 1) {
                var jr = self.joints.at(self.joints.len);
                store64(jr, jh);
                memcpy(jr + 8, ja.get(jh), sizeof(ImJoint2d));
                self.joints.len = self.joints.len + 1;
            }
        }
        var nm = st.manifolds.count();
        if (self.manifolds.reserve(nm) == 0) { return 0; }
        for (var m = 0; m < nm; m = m + 1) {
            var mf: *ImContactManifold = _im_b2_as_manifold(st.manifolds.at(m));
            var pts = 0;
            var pbytes = mf.point_count * sizeof(ImManifoldPoint);
            if (pbytes > 0) {
                pts = fl_alloc(pbytes);
                if (pts == 0) { return 0; }
                memcpy(pts, mf.points, pbytes);
            }
            var mr: *ImContactManifold = _im_b2_as_manifold(self.manifolds.at(self.manifolds.len));
            memcpy(mr, mf, sizeof(ImContactManifold));
            mr.points = pts;
            self.manifolds.len = self.manifolds.len + 1;
        }
        return self.tracker.capture(st.contact_tracker);
    }

    # 1 when the backend half is consistent: the arenas well formed; one body, collider and joint record per occupied
    # slot of its arena, each at its slot's handle; enums and flags in range; each collider on a live body and on that
    # body's list exactly once; each joint's bodies live (a Mouse joint's second body needn't be); each manifold on two
    # live colliders, its bodies theirs, the smaller handle first, in strictly ascending key order with at most two
    # points; the tracker's lists sorted. 0 otherwise, or when there is no memory for the check.
    #must_use
    fn _validate_backend(self): i64 {
        if (self.bodies.size != sizeof(ImBodySnapshot) || self.colliders.size != sizeof(ImCollider2d)) { return 0; }
        if (self.joints.size != sizeof(ImJointSnapshot)) { return 0; }
        if (self.manifolds.size != sizeof(ImContactManifold)) { return 0; }
        if (self.body_arena.validate() == 0 || self.collider_arena.validate() == 0) { return 0; }
        if (self.joint_arena.validate() == 0 || self.tracker.validate() == 0) { return 0; }
        if (self.bodies.len != self.body_arena.occupied()) { return 0; }
        if (self.colliders.len != self.collider_arena.occupied()) { return 0; }
        if (self.joints.len != self.joint_arena.occupied()) { return 0; }
        # seen: one word per collider slot, the index + 1 of its record (0: none yet), then a listed flag per record.
        var nslots = self.collider_arena.slots.len;
        var seen = fl_alloc(nslots * 8 + self.colliders.len * 8 + 8);
        if (seen == 0) { return 0; }
        var ok = self._validate_records(seen, nslots);
        fl_free(seen);
        return ok;
    }

    # The record checks of `_validate_backend`, with seen: nslots + colliders.len zeroed words.
    #must_use
    fn _validate_records(self, seen, nslots): i64 {
        for (var z = 0; z < nslots + self.colliders.len; z = z + 1) { store64(seen + z * 8, 0); }
        var listed = seen + nslots * 8;
        # Bodies: live handles in ascending slot order, so one per occupied slot.
        for (var i = 0; i < self.bodies.len; i = i + 1) {
            var b: *ImBodySnapshot = _im_as_body_snap(self.bodies.at(i));
            var bh = b.body.handle;
            if (self.body_arena.live(bh) == 0) { return 0; }
            if (i > 0) {
                var pb: *ImBodySnapshot = _im_as_body_snap(self.bodies.at(i - 1));
                if (_im_handle_index(pb.body.handle) >= _im_handle_index(bh)) { return 0; }
            }
            if (b.body.body_type < IM_BODY_STATIC || b.body.body_type > IM_BODY_KINEMATIC) { return 0; }
            if (_im_snap_flag(b.body.fixed_rotation) == 0 || _im_snap_flag(b.body.is_sleeping) == 0) { return 0; }
        }
        # Colliders: distinct live handles in slot order, on live bodies, well formed.
        for (var c = 0; c < self.colliders.len; c = c + 1) {
            var cp: *ImCollider2d = _im_b2_as_coll(self.colliders.at(c));
            if (self.collider_arena.live(cp.handle) == 0 || self.body_arena.live(cp.body) == 0) { return 0; }
            var ci = _im_handle_index(cp.handle);
            if (load64(seen + ci * 8) != 0) { return 0; }
            store64(seen + ci * 8, c + 1);
            if (_im_snap_flag(cp.is_sensor) == 0 || _im_snap_flag(cp.has_mass) == 0) { return 0; }
            if (_im_snap_shape_ok(cp.shape) == 0 || _im_snap_material_ok(cp.material) == 0) { return 0; }
        }
        # Lists: each entry a live collider of that body, each collider listed once.
        var total = 0;
        for (var k = 0; k < self.bodies.len; k = k + 1) {
            var r = self.bodies.at(k);
            var kb: *ImBodySnapshot = _im_as_body_snap(r);
            var l: *ImWordList = _im_b2_snap_list(r);
            if (l.len < 0 || (l.len > 0 && l.data == 0)) { return 0; }
            for (var q = 0; q < l.len; q = q + 1) {
                var lh = l.at(q);
                if (self.collider_arena.live(lh) == 0) { return 0; }
                var rec = load64(seen + _im_handle_index(lh) * 8) - 1;
                var lc: *ImCollider2d = _im_b2_as_coll(self.colliders.at(rec));
                if (lc.body != kb.body.handle || load64(listed + rec * 8) != 0) { return 0; }
                store64(listed + rec * 8, 1);
                total = total + 1;
            }
        }
        if (total != self.colliders.len) { return 0; }
        # Joints: distinct live handles in slot order, their bodies live.
        for (var j = 0; j < self.joints.len; j = j + 1) {
            var js: *ImJointSnapshot = _im_as_joint_snap(self.joints.at(j));
            if (self.joint_arena.live(js.handle) == 0) { return 0; }
            if (j > 0) {
                var pj: *ImJointSnapshot = _im_as_joint_snap(self.joints.at(j - 1));
                if (_im_handle_index(pj.handle) >= _im_handle_index(js.handle)) { return 0; }
            }
            if (_im_snap_joint_type_ok(js.joint.joint_type) == 0) { return 0; }
            if (self.body_arena.live(js.joint.body_a) == 0) { return 0; }
            if (js.joint.joint_type.kind != IM_JOINT_MOUSE && self.body_arena.live(js.joint.body_b) == 0) { return 0; }
            if (_im_snap_flag(js.joint.has_motor) == 0 || _im_snap_flag(js.joint.has_break_force) == 0) { return 0; }
        }
        # Manifolds: on live colliders and their bodies, keyed in strictly ascending order.
        for (var m = 0; m < self.manifolds.len; m = m + 1) {
            var mf: *ImContactManifold = _im_b2_as_manifold(self.manifolds.at(m));
            if (self.collider_arena.live(mf.collider_a) == 0 || self.collider_arena.live(mf.collider_b) == 0) {
                return 0;
            }
            if (_im_ult(mf.collider_b, mf.collider_a) == 1) { return 0; }
            if (m > 0) {
                var pm: *ImContactManifold = _im_b2_as_manifold(self.manifolds.at(m - 1));
                if (_im_pair_cmp(pm.collider_a, pm.collider_b, mf.collider_a, mf.collider_b) >= 0) { return 0; }
            }
            var ra = load64(seen + _im_handle_index(mf.collider_a) * 8) - 1;
            var rb = load64(seen + _im_handle_index(mf.collider_b) * 8) - 1;
            var ma: *ImCollider2d = _im_b2_as_coll(self.colliders.at(ra));
            var mb: *ImCollider2d = _im_b2_as_coll(self.colliders.at(rb));
            if (mf.body_a != ma.body || mf.body_b != mb.body) { return 0; }
            if (mf.point_count < 0 || mf.point_count > 2 || (mf.point_count > 0 && mf.points == 0)) { return 0; }
        }
        return 1;
    }

    # Loads the backend half into the fresh state st: 1, or 0 when there is no memory (st then holds what was loaded,
    # for its `free`). Assumes `_validate_backend`.
    fn _load_backend(self, st: *ImPhysicsState2d): i64 {
        var ba: *ImArena = st._bodies();
        var ca: *ImArena = st._colliders();
        var ja: *ImArena = st._joints();
        if (self.body_arena.load(ba) == 0) { return 0; }
        for (var i = 0; i < self.bodies.len; i = i + 1) {
            var r = self.bodies.at(i);
            var b: *ImBodySnapshot = _im_as_body_snap(r);
            var bi = _im_handle_index(b.body.handle);
            memcpy(ba.values + bi * ba.elem_size, r, sizeof(ImRigidBody2d));
            var src: *ImWordList = _im_b2_snap_list(r);
            var dst: *ImWordList = st._list(bi);
            if (dst == 0 || dst.reserve(src.len) == 0) { return 0; }
            for (var q = 0; q < src.len; q = q + 1) { dst.push(src.at(q)); }
        }
        # A collider slot holds no shape arrays until its copy is in, so a failure leaves nothing to double-free.
        if (self.collider_arena.load(ca) == 0) { return 0; }
        var sh: ImColliderShape;
        for (var c = 0; c < self.colliders.len; c = c + 1) {
            var cp: *ImCollider2d = _im_b2_as_coll(self.colliders.at(c));
            var ci = _im_handle_index(cp.handle);
            var slot: *ImCollider2d = _im_b2_as_coll(ca.values + ci * ca.elem_size);
            memcpy(slot, cp, sizeof(ImCollider2d));
            if (_im_snap_shape_plain(cp.shape) == 0) {
                var blank: ImColliderShape = _im_shape(cp.shape.kind);
                slot.shape = blank;
            }
        }
        for (var c2 = 0; c2 < self.colliders.len; c2 = c2 + 1) {
            var cq: *ImCollider2d = _im_b2_as_coll(self.colliders.at(c2));
            if (_im_snap_shape_plain(cq.shape) == 0) {
                if (_im_snap_clone_shape(cq.shape, &sh) == 0) { return 0; }
                var s2: *ImCollider2d = _im_b2_as_coll(ca.values + _im_handle_index(cq.handle) * ca.elem_size);
                s2.shape = sh;
            }
        }
        if (self.joint_arena.load(ja) == 0) { return 0; }
        for (var j = 0; j < self.joints.len; j = j + 1) {
            var jr = self.joints.at(j);
            var ji = _im_handle_index(load64(jr));
            memcpy(ja.values + ji * ja.elem_size, jr + 8, sizeof(ImJoint2d));
        }
        var nm = self.manifolds.len;
        if (nm > 0) {
            st.manifolds.data = fl_alloc(nm * sizeof(ImContactManifold));
            if (st.manifolds.data == 0) { return 0; }
            st.manifolds.cap = nm;
        }
        for (var m = 0; m < nm; m = m + 1) {
            var mf: *ImContactManifold = _im_b2_as_manifold(self.manifolds.at(m));
            var pts = 0;
            var pbytes = mf.point_count * sizeof(ImManifoldPoint);
            if (pbytes > 0) {
                pts = fl_alloc(pbytes);
                if (pts == 0) { return 0; }
                memcpy(pts, mf.points, pbytes);
            }
            var dm: *ImContactManifold = _im_b2_as_manifold(st.manifolds.at(m));
            memcpy(dm, mf, sizeof(ImContactManifold));
            dm.points = pts;
            st.manifolds.len = m + 1;
        }
        return self.tracker.load(st.contact_tracker);
    }

    # ── the binary form (ADR 0013, version 1): the backend half ──
    # The body arena, then each body (28 words, its record's fields in order, then its collider list); the collider
    # arena, then each collider (handle, body, shape, offset, material, sensor flag, optional mass, layer, mask); the
    # joint arena, then each joint (handle, bodies, joint type, anchors, optional motor, damping, optional break force,
    # reference angle); the manifolds (keys, bodies, normal, point count, seven words a point, rolling impulse); the
    # tracker.

    # Writes the backend half: 1, or 0 for a shape or joint type of unknown kind.
    fn _encode_backend(self, wr: *ImSnapWriter): i64 {
        _im_snap_put_arena(wr, self.body_arena);
        wr.w(self.bodies.len);
        for (var i = 0; i < self.bodies.len; i = i + 1) {
            var r = self.bodies.at(i);
            var b: *ImRigidBody2d = _im_b2_as_body(r);
            var rot: f64 = b.rotation;
            var av: f64 = b.angular_velocity;
            var ld: f64 = b.linear_damping;
            var ad: f64 = b.angular_damping;
            var gs: f64 = b.gravity_scale;
            var tq: f64 = b.torque_accumulator;
            var ms: f64 = b.mass;
            var im: f64 = b.inv_mass;
            var it: f64 = b.inertia;
            var ii: f64 = b.inv_inertia;
            var pa: f64 = b.pseudo_angular_velocity;
            var pr: f64 = b.prev_rotation;
            var st: f64 = b.sleep_timer;
            wr.w(b.handle);
            wr.w(b.body_type);
            wr.v2(b.position);
            wr.f(rot);
            wr.v2(b.linear_velocity);
            wr.f(av);
            wr.f(ld);
            wr.f(ad);
            wr.w(b.fixed_rotation);
            wr.f(gs);
            wr.v2(b.force_accumulator);
            wr.f(tq);
            wr.f(ms);
            wr.f(im);
            wr.f(it);
            wr.f(ii);
            wr.v2(b.pseudo_velocity);
            wr.f(pa);
            wr.v2(b.prev_position);
            wr.f(pr);
            wr.w(b.is_sleeping);
            wr.f(st);
            wr.w(b.island_id);
            var l: *ImWordList = _im_b2_snap_list(r);
            wr.w(l.len);
            wr.words(l.data, l.len);
        }
        _im_snap_put_arena(wr, self.collider_arena);
        wr.w(self.colliders.len);
        for (var c = 0; c < self.colliders.len; c = c + 1) {
            var cp: *ImCollider2d = _im_b2_as_coll(self.colliders.at(c));
            var cm: f64 = cp.mass;
            wr.w(cp.handle);
            wr.w(cp.body);
            if (_im_snap_put_shape(wr, cp.shape) == 0) { return 0; }
            wr.v2(cp.offset);
            _im_snap_put_material(wr, cp.material);
            wr.w(cp.is_sensor);
            wr.opt_f(cp.has_mass, cm);
            wr.w(cp.collision_layer);
            wr.w(cp.collision_mask);
        }
        _im_snap_put_arena(wr, self.joint_arena);
        wr.w(self.joints.len);
        for (var j = 0; j < self.joints.len; j = j + 1) {
            var js: *ImJointSnapshot = _im_as_joint_snap(self.joints.at(j));
            var tv: f64 = js.joint.motor.target_velocity;
            var mf: f64 = js.joint.motor.max_force;
            var dp: f64 = js.joint.damping;
            var bf: f64 = js.joint.break_force;
            var ra: f64 = js.joint.reference_angle;
            wr.w(js.handle);
            wr.w(js.joint.body_a);
            wr.w(js.joint.body_b);
            if (_im_snap_put_joint_type(wr, js.joint.joint_type) == 0) { return 0; }
            wr.v2(js.joint.local_anchor_a);
            wr.v2(js.joint.local_anchor_b);
            wr.w(js.joint.has_motor);
            if (js.joint.has_motor == 1) {
                wr.f(tv);
                wr.f(mf);
            } else {
                wr.w(0);
                wr.w(0);
            }
            wr.f(dp);
            wr.opt_f(js.joint.has_break_force, bf);
            wr.f(ra);
        }
        wr.w(self.manifolds.len);
        for (var m = 0; m < self.manifolds.len; m = m + 1) {
            var mn: *ImContactManifold = _im_b2_as_manifold(self.manifolds.at(m));
            var ri: f64 = mn.rolling_impulse;
            wr.w(mn.collider_a);
            wr.w(mn.collider_b);
            wr.w(mn.body_a);
            wr.w(mn.body_b);
            wr.v2(mn.normal);
            wr.w(mn.point_count);
            wr.words(mn.points, mn.point_count * 7);
            wr.f(ri);
        }
        _im_snap_put_tracker(wr, self.tracker);
        return 1;
    }

    # Reads the backend half into this empty snapshot: 1, or 0 on a bad read, an unknown kind or no memory (what was
    # read stays owned by the snapshot, for `free`).
    fn _decode_backend(self, rd: *ImSnapReader): i64 {
        if (_im_snap_get_arena(rd, self.body_arena) == 0) { return 0; }
        var nb = rd.count(29);
        if (self.bodies.reserve(nb) == 0) { return 0; }
        var empty: ImWordList = ImWordList_new();
        for (var i = 0; i < nb; i = i + 1) {
            var r = self.bodies.at(i);
            var b: *ImRigidBody2d = _im_b2_as_body(r);
            var dl: *ImWordList = _im_b2_snap_list(r);
            memcpy(dl, &empty, sizeof(ImWordList));
            self.bodies.len = i + 1;
            b.handle = rd.w();
            b.body_type = rd.w();
            var pos: ImVec2 = rd.v2();
            b.position = pos;
            b.rotation = rd.f();
            var lv: ImVec2 = rd.v2();
            b.linear_velocity = lv;
            b.angular_velocity = rd.f();
            b.linear_damping = rd.f();
            b.angular_damping = rd.f();
            b.fixed_rotation = rd.flag();
            b.gravity_scale = rd.f();
            var fa: ImVec2 = rd.v2();
            b.force_accumulator = fa;
            b.torque_accumulator = rd.f();
            b.mass = rd.f();
            b.inv_mass = rd.f();
            b.inertia = rd.f();
            b.inv_inertia = rd.f();
            var pv: ImVec2 = rd.v2();
            b.pseudo_velocity = pv;
            b.pseudo_angular_velocity = rd.f();
            var pp: ImVec2 = rd.v2();
            b.prev_position = pp;
            b.prev_rotation = rd.f();
            b.is_sleeping = rd.flag();
            b.sleep_timer = rd.f();
            b.island_id = rd.w();
            var nl = rd.count(1);
            if (dl.reserve(nl) == 0) { return 0; }
            for (var q = 0; q < nl; q = q + 1) { dl.push(rd.w()); }
            if (rd.bad == 1) { return 0; }
        }
        if (_im_snap_get_arena(rd, self.collider_arena) == 0) { return 0; }
        # A collider is at least 19 words (a ball or an empty hull).
        var nc = rd.count(19);
        if (self.colliders.reserve(nc) == 0) { return 0; }
        var sh: ImColliderShape;
        for (var c = 0; c < nc; c = c + 1) {
            var cp: *ImCollider2d = _im_b2_as_coll(self.colliders.at(c));
            cp.handle = rd.w();
            cp.body = rd.w();
            if (_im_snap_get_shape(rd, &sh) == 0) { return 0; }
            cp.shape = sh;
            self.colliders.len = c + 1;
            var off: ImVec2 = rd.v2();
            cp.offset = off;
            _im_snap_get_material(rd, cp.material);
            cp.is_sensor = rd.flag();
            cp.has_mass = rd.flag();
            cp.mass = rd.f();
            cp.collision_layer = rd.w();
            cp.collision_mask = rd.w();
            if (rd.bad == 1) { return 0; }
        }
        if (_im_snap_get_arena(rd, self.joint_arena) == 0) { return 0; }
        # A Fixed joint is the shortest: 15 words.
        var nj = rd.count(15);
        if (self.joints.reserve(nj) == 0) { return 0; }
        var jt: ImJointType;
        for (var j = 0; j < nj; j = j + 1) {
            var js: *ImJointSnapshot = _im_as_joint_snap(self.joints.at(j));
            js.handle = rd.w();
            js.joint.body_a = rd.w();
            js.joint.body_b = rd.w();
            if (_im_snap_get_joint_type(rd, &jt) == 0) { return 0; }
            js.joint.joint_type = jt;
            var la: ImVec2 = rd.v2();
            var lb: ImVec2 = rd.v2();
            js.joint.local_anchor_a = la;
            js.joint.local_anchor_b = lb;
            js.joint.has_motor = rd.flag();
            var tv: f64 = rd.f();
            var mf: f64 = rd.f();
            var mo: ImJointMotor = ImJointMotor_new(tv, mf);
            js.joint.motor = mo;
            js.joint.damping = rd.f();
            js.joint.has_break_force = rd.flag();
            js.joint.break_force = rd.f();
            js.joint.reference_angle = rd.f();
            self.joints.len = j + 1;
            if (rd.bad == 1) { return 0; }
        }
        var nm = rd.count(8);
        if (self.manifolds.reserve(nm) == 0) { return 0; }
        for (var m = 0; m < nm; m = m + 1) {
            var mn: *ImContactManifold = _im_b2_as_manifold(self.manifolds.at(m));
            mn.points = 0;
            mn.point_count = 0;
            self.manifolds.len = m + 1;
            mn.collider_a = rd.w();
            mn.collider_b = rd.w();
            mn.body_a = rd.w();
            mn.body_b = rd.w();
            var nv: ImVec2 = rd.v2();
            mn.normal = nv;
            var np = rd.count(7);
            mn.points = rd.words(np * 7);
            mn.point_count = np;
            mn.rolling_impulse = rd.f();
            if (rd.bad == 1) { return 0; }
        }
        return _im_snap_get_tracker(rd, self.tracker);
    }

    # ── the JSON form (ADR 0013): the backend's records ──
    # A body is {"body":{its record's fields},"colliders":[handles]}; a collider its record's fields (shape and material
    # through their serde codecs); a joint {"handle","joint":{its record's fields}} (joint type and motor likewise); a
    # manifold its fields, its points as objects.

    # Appends the bodies array.
    fn _json_bodies(self, sb) {
        str_builder_putc(sb, 91);
        for (var i = 0; i < self.bodies.len; i = i + 1) {
            if (i > 0) { str_builder_putc(sb, 44); }
            var r = self.bodies.at(i);
            var b: *ImRigidBody2d = _im_b2_as_body(r);
            var rot: f64 = b.rotation;
            var av: f64 = b.angular_velocity;
            var ld: f64 = b.linear_damping;
            var ad: f64 = b.angular_damping;
            var gs: f64 = b.gravity_scale;
            var tq: f64 = b.torque_accumulator;
            var ms: f64 = b.mass;
            var im: f64 = b.inv_mass;
            var it: f64 = b.inertia;
            var ii: f64 = b.inv_inertia;
            var pa: f64 = b.pseudo_angular_velocity;
            var pr: f64 = b.prev_rotation;
            var st: f64 = b.sleep_timer;
            str_builder_add_cstr(sb, "{\"body\":{");
            _im_jw_key(sb, "handle", 1);
            _im_jw_u64(sb, b.handle);
            _im_jw_key(sb, "body_type", 0);
            _im_jw_name(sb, body_type_name(b.body_type));
            _im_jw_key(sb, "position", 0);
            _im_jw_vec2(sb, b.position);
            _im_jw_key(sb, "rotation", 0);
            im_fmt_f64_json(sb, rot);
            _im_jw_key(sb, "linear_velocity", 0);
            _im_jw_vec2(sb, b.linear_velocity);
            _im_jw_key(sb, "angular_velocity", 0);
            im_fmt_f64_json(sb, av);
            _im_jw_key(sb, "linear_damping", 0);
            im_fmt_f64_json(sb, ld);
            _im_jw_key(sb, "angular_damping", 0);
            im_fmt_f64_json(sb, ad);
            _im_jw_key(sb, "fixed_rotation", 0);
            _im_jw_bool(sb, b.fixed_rotation);
            _im_jw_key(sb, "gravity_scale", 0);
            im_fmt_f64_json(sb, gs);
            _im_jw_key(sb, "force_accumulator", 0);
            _im_jw_vec2(sb, b.force_accumulator);
            _im_jw_key(sb, "torque_accumulator", 0);
            im_fmt_f64_json(sb, tq);
            _im_jw_key(sb, "mass", 0);
            im_fmt_f64_json(sb, ms);
            _im_jw_key(sb, "inv_mass", 0);
            im_fmt_f64_json(sb, im);
            _im_jw_key(sb, "inertia", 0);
            im_fmt_f64_json(sb, it);
            _im_jw_key(sb, "inv_inertia", 0);
            im_fmt_f64_json(sb, ii);
            _im_jw_key(sb, "pseudo_velocity", 0);
            _im_jw_vec2(sb, b.pseudo_velocity);
            _im_jw_key(sb, "pseudo_angular_velocity", 0);
            im_fmt_f64_json(sb, pa);
            _im_jw_key(sb, "prev_position", 0);
            _im_jw_vec2(sb, b.prev_position);
            _im_jw_key(sb, "prev_rotation", 0);
            im_fmt_f64_json(sb, pr);
            _im_jw_key(sb, "is_sleeping", 0);
            _im_jw_bool(sb, b.is_sleeping);
            _im_jw_key(sb, "sleep_timer", 0);
            im_fmt_f64_json(sb, st);
            _im_jw_key(sb, "island_id", 0);
            str_builder_add_int(sb, b.island_id);
            str_builder_add_cstr(sb, "},\"colliders\":[");
            var l: *ImWordList = _im_b2_snap_list(r);
            for (var q = 0; q < l.len; q = q + 1) {
                if (q > 0) { str_builder_putc(sb, 44); }
                _im_jw_u64(sb, l.at(q));
            }
            str_builder_add_cstr(sb, "]}");
        }
        str_builder_putc(sb, 93);
        return 0;
    }

    # Reads the bodies array into this empty snapshot: 1, or 0.
    fn _read_bodies(self, v): i64 {
        var n = _im_sr_len(v);
        if (n < 0 || self.bodies.reserve(n) == 0) { return 0; }
        var empty: ImWordList = ImWordList_new();
        var bad[8];
        store64(&bad, 0);
        var w[8];
        for (var i = 0; i < n; i = i + 1) {
            var r = self.bodies.at(i);
            var dl: *ImWordList = _im_b2_snap_list(r);
            memcpy(dl, &empty, sizeof(ImWordList));
            self.bodies.len = i + 1;
            var o = bayan_json_v_arr_get(v, i);
            var f = _im_jr_form(o, 2);
            if (f == 0) { return 0; }
            var bo = _im_jr_at(o, f, 0, "body");
            var g = _im_jr_form(bo, 23);
            if (g == 0) { return 0; }
            var b: *ImRigidBody2d = _im_b2_as_body(r);
            b.handle = _im_sr_u64(bo, g, 0, "handle", &bad);
            if (_im_jr_body_type(_im_jr_at(bo, g, 1, "body_type"), &w) == 0) { return 0; }
            b.body_type = load64(&w);
            b.position = _im_sr_v2(bo, g, 2, "position", &bad);
            b.rotation = _im_sr_f(bo, g, 3, "rotation", &bad);
            b.linear_velocity = _im_sr_v2(bo, g, 4, "linear_velocity", &bad);
            b.angular_velocity = _im_sr_f(bo, g, 5, "angular_velocity", &bad);
            b.linear_damping = _im_sr_f(bo, g, 6, "linear_damping", &bad);
            b.angular_damping = _im_sr_f(bo, g, 7, "angular_damping", &bad);
            b.fixed_rotation = _im_sr_bool(bo, g, 8, "fixed_rotation", &bad);
            b.gravity_scale = _im_sr_f(bo, g, 9, "gravity_scale", &bad);
            b.force_accumulator = _im_sr_v2(bo, g, 10, "force_accumulator", &bad);
            b.torque_accumulator = _im_sr_f(bo, g, 11, "torque_accumulator", &bad);
            b.mass = _im_sr_f(bo, g, 12, "mass", &bad);
            b.inv_mass = _im_sr_f(bo, g, 13, "inv_mass", &bad);
            b.inertia = _im_sr_f(bo, g, 14, "inertia", &bad);
            b.inv_inertia = _im_sr_f(bo, g, 15, "inv_inertia", &bad);
            b.pseudo_velocity = _im_sr_v2(bo, g, 16, "pseudo_velocity", &bad);
            b.pseudo_angular_velocity = _im_sr_f(bo, g, 17, "pseudo_angular_velocity", &bad);
            b.prev_position = _im_sr_v2(bo, g, 18, "prev_position", &bad);
            b.prev_rotation = _im_sr_f(bo, g, 19, "prev_rotation", &bad);
            b.is_sleeping = _im_sr_bool(bo, g, 20, "is_sleeping", &bad);
            b.sleep_timer = _im_sr_f(bo, g, 21, "sleep_timer", &bad);
            b.island_id = _im_sr_int(bo, g, 22, "island_id", 0, 0x7FFFFFFFFFFFFFFF, &bad);
            var lv = _im_jr_at(o, f, 1, "colliders");
            var nl = _im_sr_len(lv);
            if (nl < 0 || dl.reserve(nl) == 0 || load64(&bad) == 1) { return 0; }
            for (var q = 0; q < nl; q = q + 1) {
                if (_im_jr_u64(bayan_json_v_arr_get(lv, q), &w) == 0) { return 0; }
                dl.push(load64(&w));
            }
        }
        return 1;
    }

    # Appends the colliders array.
    fn _json_colliders(self, sb) {
        str_builder_putc(sb, 91);
        for (var c = 0; c < self.colliders.len; c = c + 1) {
            if (c > 0) { str_builder_putc(sb, 44); }
            var cp: *ImCollider2d = _im_b2_as_coll(self.colliders.at(c));
            var cm: f64 = cp.mass;
            str_builder_putc(sb, 123);
            _im_jw_key(sb, "handle", 1);
            _im_jw_u64(sb, cp.handle);
            _im_jw_key(sb, "body", 0);
            _im_jw_u64(sb, cp.body);
            _im_jw_key(sb, "shape", 0);
            cp.shape.to_json(sb);
            _im_jw_key(sb, "offset", 0);
            _im_jw_vec2(sb, cp.offset);
            _im_jw_key(sb, "material", 0);
            cp.material.to_json(sb);
            _im_jw_key(sb, "is_sensor", 0);
            _im_jw_bool(sb, cp.is_sensor);
            _im_jw_key(sb, "mass", 0);
            _im_jw_opt_f64(sb, cp.has_mass, cm);
            _im_jw_key(sb, "collision_layer", 0);
            str_builder_add_int(sb, cp.collision_layer);
            _im_jw_key(sb, "collision_mask", 0);
            str_builder_add_int(sb, cp.collision_mask);
            str_builder_putc(sb, 125);
        }
        str_builder_putc(sb, 93);
        return 0;
    }

    # Reads the colliders array into this empty snapshot: 1, or 0.
    fn _read_colliders(self, v): i64 {
        var n = _im_sr_len(v);
        if (n < 0 || self.colliders.reserve(n) == 0) { return 0; }
        var bad[8];
        store64(&bad, 0);
        var has[8];
        var sh: ImColliderShape;
        for (var c = 0; c < n; c = c + 1) {
            var o = bayan_json_v_arr_get(v, c);
            var f = _im_jr_form(o, 9);
            if (f == 0) { return 0; }
            var cp: *ImCollider2d = _im_b2_as_coll(self.colliders.at(c));
            if (_im_jr_shape(_im_jr_at(o, f, 2, "shape"), &sh) == 0) { return 0; }
            cp.shape = sh;
            self.colliders.len = c + 1;
            cp.handle = _im_sr_u64(o, f, 0, "handle", &bad);
            cp.body = _im_sr_u64(o, f, 1, "body", &bad);
            cp.offset = _im_sr_v2(o, f, 3, "offset", &bad);
            if (_im_jr_material(_im_jr_at(o, f, 4, "material"), cp.material) == 0) { return 0; }
            cp.is_sensor = _im_sr_bool(o, f, 5, "is_sensor", &bad);
            cp.mass = _im_sr_opt_f(o, f, 6, "mass", &has, &bad);
            cp.has_mass = load64(&has);
            cp.collision_layer = _im_sr_int(o, f, 7, "collision_layer", 0, 4294967295, &bad);
            cp.collision_mask = _im_sr_int(o, f, 8, "collision_mask", 0, 4294967295, &bad);
            if (load64(&bad) == 1) { return 0; }
        }
        return 1;
    }

    # Appends the joints array.
    fn _json_joints(self, sb) {
        str_builder_putc(sb, 91);
        for (var j = 0; j < self.joints.len; j = j + 1) {
            if (j > 0) { str_builder_putc(sb, 44); }
            var js: *ImJointSnapshot = _im_as_joint_snap(self.joints.at(j));
            var dp: f64 = js.joint.damping;
            var bf: f64 = js.joint.break_force;
            var ra: f64 = js.joint.reference_angle;
            str_builder_putc(sb, 123);
            _im_jw_key(sb, "handle", 1);
            _im_jw_u64(sb, js.handle);
            _im_jw_key(sb, "joint", 0);
            str_builder_putc(sb, 123);
            _im_jw_key(sb, "body_a", 1);
            _im_jw_u64(sb, js.joint.body_a);
            _im_jw_key(sb, "body_b", 0);
            _im_jw_u64(sb, js.joint.body_b);
            _im_jw_key(sb, "joint_type", 0);
            js.joint.joint_type.to_json(sb);
            _im_jw_key(sb, "local_anchor_a", 0);
            _im_jw_vec2(sb, js.joint.local_anchor_a);
            _im_jw_key(sb, "local_anchor_b", 0);
            _im_jw_vec2(sb, js.joint.local_anchor_b);
            _im_jw_key(sb, "motor", 0);
            if (js.joint.has_motor == 1) { js.joint.motor.to_json(sb); } else { str_builder_add_cstr(sb, "null"); }
            _im_jw_key(sb, "damping", 0);
            im_fmt_f64_json(sb, dp);
            _im_jw_key(sb, "break_force", 0);
            _im_jw_opt_f64(sb, js.joint.has_break_force, bf);
            _im_jw_key(sb, "reference_angle", 0);
            im_fmt_f64_json(sb, ra);
            str_builder_add_cstr(sb, "}}");
        }
        str_builder_putc(sb, 93);
        return 0;
    }

    # Reads the joints array into this empty snapshot: 1, or 0.
    fn _read_joints(self, v): i64 {
        var n = _im_sr_len(v);
        if (n < 0 || self.joints.reserve(n) == 0) { return 0; }
        var bad[8];
        store64(&bad, 0);
        var has[8];
        var jt: ImJointType;
        var mo: ImJointMotor = ImJointMotor_new(0.0, 0.0);
        for (var j = 0; j < n; j = j + 1) {
            var o = bayan_json_v_arr_get(v, j);
            var f = _im_jr_form(o, 2);
            if (f == 0) { return 0; }
            var jo = _im_jr_at(o, f, 1, "joint");
            var g = _im_jr_form(jo, 9);
            if (g == 0) { return 0; }
            var js: *ImJointSnapshot = _im_as_joint_snap(self.joints.at(j));
            self.joints.len = j + 1;
            js.handle = _im_sr_u64(o, f, 0, "handle", &bad);
            js.joint.body_a = _im_sr_u64(jo, g, 0, "body_a", &bad);
            js.joint.body_b = _im_sr_u64(jo, g, 1, "body_b", &bad);
            if (_im_jr_joint_type(_im_jr_at(jo, g, 2, "joint_type"), &jt) == 0) { return 0; }
            js.joint.joint_type = jt;
            js.joint.local_anchor_a = _im_sr_v2(jo, g, 3, "local_anchor_a", &bad);
            js.joint.local_anchor_b = _im_sr_v2(jo, g, 4, "local_anchor_b", &bad);
            var mv = _im_jr_at(jo, g, 5, "motor");
            js.joint.has_motor = 0;
            var none: ImJointMotor = ImJointMotor_new(0.0, 0.0);
            js.joint.motor = none;
            if (mv != 0 && _im_jr_is_null(mv) == 0) {
                if (_im_jr_motor(mv, &mo) == 0) { return 0; }
                js.joint.has_motor = 1;
                js.joint.motor = mo;
            }
            js.joint.damping = _im_sr_f(jo, g, 6, "damping", &bad);
            js.joint.break_force = _im_sr_opt_f(jo, g, 7, "break_force", &has, &bad);
            js.joint.has_break_force = load64(&has);
            js.joint.reference_angle = _im_sr_f(jo, g, 8, "reference_angle", &bad);
            if (load64(&bad) == 1) { return 0; }
        }
        return 1;
    }

    # Appends the profile's keys after the arenas: `,"manifolds":[…]`.
    fn _json_backend_extra(self, sb) {
        _im_jw_key(sb, "manifolds", 0);
        str_builder_putc(sb, 91);
        for (var m = 0; m < self.manifolds.len; m = m + 1) {
            if (m > 0) { str_builder_putc(sb, 44); }
            var mn: *ImContactManifold = _im_b2_as_manifold(self.manifolds.at(m));
            var ri: f64 = mn.rolling_impulse;
            str_builder_putc(sb, 123);
            _im_jw_key(sb, "collider_a", 1);
            _im_jw_u64(sb, mn.collider_a);
            _im_jw_key(sb, "collider_b", 0);
            _im_jw_u64(sb, mn.collider_b);
            _im_jw_key(sb, "body_a", 0);
            _im_jw_u64(sb, mn.body_a);
            _im_jw_key(sb, "body_b", 0);
            _im_jw_u64(sb, mn.body_b);
            _im_jw_key(sb, "normal", 0);
            _im_jw_vec2(sb, mn.normal);
            _im_jw_key(sb, "points", 0);
            str_builder_putc(sb, 91);
            for (var q = 0; q < mn.point_count; q = q + 1) {
                if (q > 0) { str_builder_putc(sb, 44); }
                var pt: *ImManifoldPoint = _im_b2_as_point(mn.points + q * sizeof(ImManifoldPoint));
                var ni: f64 = pt.normal_impulse;
                var ti: f64 = pt.tangent_impulse;
                var de: f64 = pt.depth;
                str_builder_putc(sb, 123);
                _im_jw_key(sb, "local_a", 1);
                _im_jw_vec2(sb, pt.local_a);
                _im_jw_key(sb, "local_b", 0);
                _im_jw_vec2(sb, pt.local_b);
                _im_jw_key(sb, "normal_impulse", 0);
                im_fmt_f64_json(sb, ni);
                _im_jw_key(sb, "tangent_impulse", 0);
                im_fmt_f64_json(sb, ti);
                _im_jw_key(sb, "depth", 0);
                im_fmt_f64_json(sb, de);
                str_builder_putc(sb, 125);
            }
            str_builder_putc(sb, 93);
            _im_jw_key(sb, "rolling_impulse", 0);
            im_fmt_f64_json(sb, ri);
            str_builder_putc(sb, 125);
        }
        str_builder_putc(sb, 93);
        return 0;
    }

    # Reads the profile's keys after the arenas (the manifolds) from the document node o: 1, or 0.
    fn _read_backend_extra(self, o): i64 {
        var v = bayan_json_v_obj_get_by_cstr(o, "manifolds");
        var n = _im_sr_len(v);
        if (n < 0 || self.manifolds.reserve(n) == 0) { return 0; }
        var bad[8];
        store64(&bad, 0);
        for (var m = 0; m < n; m = m + 1) {
            var mo = bayan_json_v_arr_get(v, m);
            var f = _im_jr_form(mo, 7);
            if (f == 0) { return 0; }
            var mn: *ImContactManifold = _im_b2_as_manifold(self.manifolds.at(m));
            mn.points = 0;
            mn.point_count = 0;
            self.manifolds.len = m + 1;
            mn.collider_a = _im_sr_u64(mo, f, 0, "collider_a", &bad);
            mn.collider_b = _im_sr_u64(mo, f, 1, "collider_b", &bad);
            mn.body_a = _im_sr_u64(mo, f, 2, "body_a", &bad);
            mn.body_b = _im_sr_u64(mo, f, 3, "body_b", &bad);
            mn.normal = _im_sr_v2(mo, f, 4, "normal", &bad);
            var pv = _im_jr_at(mo, f, 5, "points");
            var np = _im_sr_len(pv);
            if (np < 0) { return 0; }
            if (np > 0) {
                mn.points = fl_alloc(np * sizeof(ImManifoldPoint));
                if (mn.points == 0) { return 0; }
                mn.point_count = np;
            }
            for (var q = 0; q < np; q = q + 1) {
                var po = bayan_json_v_arr_get(pv, q);
                var g = _im_jr_form(po, 5);
                if (g == 0) { return 0; }
                var pt: *ImManifoldPoint = _im_b2_as_point(mn.points + q * sizeof(ImManifoldPoint));
                pt.local_a = _im_sr_v2(po, g, 0, "local_a", &bad);
                pt.local_b = _im_sr_v2(po, g, 1, "local_b", &bad);
                pt.normal_impulse = _im_sr_f(po, g, 2, "normal_impulse", &bad);
                pt.tangent_impulse = _im_sr_f(po, g, 3, "tangent_impulse", &bad);
                pt.depth = _im_sr_f(po, g, 4, "depth", &bad);
            }
            mn.rolling_impulse = _im_sr_f(mo, f, 6, "rolling_impulse", &bad);
            if (load64(&bad) == 1) { return 0; }
        }
        return 1;
    }

    # Releases the backend half: the collider lists, shapes, manifold points, arenas and tracker.
    fn _free_backend(self) {
        for (var i = 0; i < self.bodies.len; i = i + 1) {
            var bl: *ImWordList = _im_b2_snap_list(self.bodies.at(i));
            bl.free();
        }
        self.bodies.free();
        for (var c = 0; c < self.colliders.len; c = c + 1) {
            var cp: *ImCollider2d = _im_b2_as_coll(self.colliders.at(c));
            cp.shape.free();
        }
        self.colliders.free();
        self.joints.free();
        for (var m = 0; m < self.manifolds.len; m = m + 1) {
            var mf: *ImContactManifold = _im_b2_as_manifold(self.manifolds.at(m));
            if (mf.points != 0) { fl_free(mf.points); }
        }
        self.manifolds.free();
        self.body_arena.free();
        self.collider_arena.free();
        self.joint_arena.free();
        self.tracker.free();
        return 0;
    }
}
