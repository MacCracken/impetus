# world_snapshot.cyr — `snapshot` and `restore` (ADR 0013), and the world's half of a snapshot: the config, the id
# counters, the particles, emitters and force fields. Shared by both profiles, after the profile's snapshot file
# (src/b2_snapshot.cyr), whose `ImWorldSnapshot` and backend half it completes.
#
# `restore` is the one fallible restore of ADR 0008 #2 (Rust's `try_restore`; 1.4.0's `restore` that ignored errors is
# gone). It checks the whole snapshot first, builds a fresh world from it, and only then replaces the world, so on any
# error the world is unchanged.

impl ImWorldSnapshot {
    # Captures world w: 1, or 0 when there is no memory (what was captured stays owned by the snapshot).
    fn _capture(self, w: *ImPhysicsWorld): i64 {
        self.config = w.config;
        self.next_particle_id = w.next_particle_id;
        self.next_emitter_id = w.next_emitter_id;
        if (_im_snap_copy_records(self.particles, w.particles) == 0) { return 0; }
        if (_im_snap_copy_records(self.emitters, w.emitters) == 0) { return 0; }
        if (_im_snap_copy_records(self.force_fields, w.force_fields) == 0) { return 0; }
        return self._capture_backend(w.backend);
    }

    # Ok(0) when the snapshot can be restored: the config passes `validate` (else its error, IM_ERR_INVALID_CONFIG or,
    # for XPBD, IM_ERR_UNSUPPORTED), and the world's records and the backend half are well formed (else
    # Err(IM_ERR_DESERIALIZE)). Mirrors `validate_snapshot`, whose checks it extends (ADR 0013).
    fn validate(self): Result {
        var cfg: ImWorldConfig = self.config;
        var t, v = cfg.validate();
        if (is_ok(t) == 0) { return Err(v); }
        if (self.particles.size != sizeof(ImParticle) || self.emitters.size != sizeof(ImParticleEmitter)) {
            return Err(IM_ERR_DESERIALIZE);
        }
        if (self.force_fields.size != sizeof(ImForceField)) { return Err(IM_ERR_DESERIALIZE); }
        for (var i = 0; i < self.particles.len; i = i + 1) {
            var p: *ImParticle = _im_as_particle(self.particles.at(i));
            if (_im_snap_flag(p.has_on_death_emit) == 0) { return Err(IM_ERR_DESERIALIZE); }
            var n = p.on_death_emit.count;
            if (p.has_on_death_emit == 1 && (n < 0 || n > 0xFFFFFFFF)) { return Err(IM_ERR_DESERIALIZE); }
        }
        for (var e = 0; e < self.emitters.len; e = e + 1) {
            var em: *ImParticleEmitter = _im_as_emitter(self.emitters.at(e));
            if (_im_snap_flag(em.active) == 0) { return Err(IM_ERR_DESERIALIZE); }
        }
        for (var f = 0; f < self.force_fields.len; f = f + 1) {
            var ff: *ImForceField = _im_as_force_field(self.force_fields.at(f));
            if (ff.kind != IM_FORCE_FIELD_RADIAL && ff.kind != IM_FORCE_FIELD_DIRECTIONAL) {
                return Err(IM_ERR_DESERIALIZE);
            }
        }
        if (self._validate_backend() == 0) { return Err(IM_ERR_DESERIALIZE); }
        return Ok(0);
    }

    # Loads the snapshot into the fresh world w (built over its config): 1, or 0 when there is no memory. Assumes
    # `validate`.
    fn _load(self, w: *ImPhysicsWorld): i64 {
        w.next_particle_id = self.next_particle_id;
        w.next_emitter_id = self.next_emitter_id;
        if (_im_snap_copy_records(w.particles, self.particles) == 0) { return 0; }
        if (_im_snap_copy_records(w.emitters, self.emitters) == 0) { return 0; }
        if (_im_snap_copy_records(w.force_fields, self.force_fields) == 0) { return 0; }
        return self._load_backend(w.backend);
    }

    # Releases everything the snapshot owns.
    fn free(self) {
        self.particles.free();
        self.emitters.free();
        self.force_fields.free();
        self._free_backend();
        return 0;
    }
}

impl ImPhysicsWorld {
    # The world's whole state into out, overwriting it (free a snapshot it held first): Ok(0), or Err(IM_ERR_SERIALIZE)
    # when there is no memory. The snapshot owns copies; the world is untouched. Mirrors `snapshot` (ADR 0013).
    fn snapshot(self, out: *ImWorldSnapshot): Result {
        var s: ImWorldSnapshot = ImWorldSnapshot_new();
        if (s._capture(self) == 0) {
            s.free();
            return Err(IM_ERR_SERIALIZE);
        }
        memcpy(out, &s, sizeof(ImWorldSnapshot));
        return Ok(0);
    }

    # Replaces the world with the snapshot's: its config, bodies, colliders, joints, contacts, particles, emitters and
    # force fields, its arenas' slots (so the next handles are the original's) and the last step's events. Ok(0), or the
    # error `validate` gives, or Err(IM_ERR_DESERIALIZE) when there is no memory; on any error the world is unchanged.
    # The snapshot is only read. Mirrors `try_restore` (ADR 0008 #2).
    fn restore(self, snap: *ImWorldSnapshot): Result {
        var t, v = snap.validate();
        if (is_ok(t) == 0) { return Err(v); }
        var nw: ImPhysicsWorld = ImPhysicsWorld_new(snap.config);
        if (snap._load(&nw) == 0) {
            nw.free();
            return Err(IM_ERR_DESERIALIZE);
        }
        self.free();
        memcpy(self, &nw, sizeof(ImPhysicsWorld));
        return Ok(0);
    }
}

# ── the binary form (ADR 0013, version 1) ───────────────────────────────────────────
# The payload is the world half (the config, the two counters, then the particles, emitters and force fields, each a
# count and its records), then the profile's backend half. src/snapshot.cyr has the header and the word codec.

impl ImWorldSnapshot {
    # Writes the world half: 1, or 0 for a force field of unknown kind.
    fn _encode_world(self, wr: *ImSnapWriter): i64 {
        _im_snap_put_config(wr, self.config);
        wr.w(self.next_particle_id);
        wr.w(self.next_emitter_id);
        wr.w(self.particles.len);
        for (var i = 0; i < self.particles.len; i = i + 1) {
            _im_snap_put_particle(wr, _im_as_particle(self.particles.at(i)));
        }
        wr.w(self.emitters.len);
        for (var e = 0; e < self.emitters.len; e = e + 1) {
            _im_snap_put_emitter(wr, _im_as_emitter(self.emitters.at(e)));
        }
        wr.w(self.force_fields.len);
        for (var f = 0; f < self.force_fields.len; f = f + 1) {
            if (_im_snap_put_field(wr, _im_as_force_field(self.force_fields.at(f))) == 0) { return 0; }
        }
        return 1;
    }

    # Reads the world half into this empty snapshot: 1, or 0 on a bad read or no memory.
    fn _decode_world(self, rd: *ImSnapReader): i64 {
        _im_snap_get_config(rd, self.config);
        self.next_particle_id = rd.w();
        self.next_emitter_id = rd.w();
        var np = rd.count(20);
        if (self.particles.reserve(np) == 0) { return 0; }
        for (var i = 0; i < np; i = i + 1) {
            _im_snap_get_particle(rd, _im_as_particle(self.particles.at(i)));
            self.particles.len = i + 1;
        }
        var ne = rd.count(18);
        if (self.emitters.reserve(ne) == 0) { return 0; }
        for (var e = 0; e < ne; e = e + 1) {
            _im_snap_get_emitter(rd, _im_as_emitter(self.emitters.at(e)));
            self.emitters.len = e + 1;
        }
        var nf = rd.count(7);
        if (self.force_fields.reserve(nf) == 0) { return 0; }
        for (var f = 0; f < nf; f = f + 1) {
            if (_im_snap_get_field(rd, _im_as_force_field(self.force_fields.at(f))) == 0) { return 0; }
            self.force_fields.len = f + 1;
        }
        if (rd.bad == 1) { return 0; }
        return 1;
    }

    # The snapshot's binary form into out, replacing what it held: Ok(0), or Err(IM_ERR_SERIALIZE) when there is no
    # memory or a shape, joint type or force field has an unknown kind. The bytes are out.data, out.len × 8 of them: the
    # header (magic, version, profile, payload length, checksum), then the payload. The snapshot is not checked here;
    # `restore` checks it. ADR 0013.
    fn to_bytes(self, out: *ImWordList): Result {
        out.len = 0;
        var wr: ImSnapWriter = _im_snap_writer(out);
        for (var h = 0; h < _IM_SNAP_HEADER; h = h + 1) { wr.w(0); }
        if (self._encode_world(&wr) == 0 || self._encode_backend(&wr) == 0) { return Err(IM_ERR_SERIALIZE); }
        if (wr.bad == 1) { return Err(IM_ERR_SERIALIZE); }
        var n = out.len - _IM_SNAP_HEADER;
        var payload = out.data + _IM_SNAP_HEADER * 8;
        store64(out.data, _IM_SNAP_MAGIC);
        store64(out.data + 8, _IM_SNAP_VERSION);
        store64(out.data + 16, _IM_SNAP_PROFILE);
        store64(out.data + 24, n);
        store64(out.data + 32, _im_snap_checksum(payload, n));
        return Ok(0);
    }
}

# Reads the binary form at buf (len bytes) into *out (overwritten; free it after): Ok(0), or Err(IM_ERR_DESERIALIZE) for
# a length not a whole number of words or shorter than the header, a wrong magic, version or profile, a payload length
# that disagrees, a checksum that doesn't match, a malformed or truncated payload, or no memory. A snapshot read here is
# checked in full by `restore`. ADR 0013.
fn ImWorldSnapshot_from_bytes(buf, len, out: *ImWorldSnapshot): Result {
    if (len < _IM_SNAP_HEADER * 8 || (len % 8) != 0) { return Err(IM_ERR_DESERIALIZE); }
    var words = len / 8;
    var n = load64(buf + 24);
    if (load64(buf) != _IM_SNAP_MAGIC || load64(buf + 8) != _IM_SNAP_VERSION) { return Err(IM_ERR_DESERIALIZE); }
    if (load64(buf + 16) != _IM_SNAP_PROFILE || n != words - _IM_SNAP_HEADER) { return Err(IM_ERR_DESERIALIZE); }
    var payload = buf + _IM_SNAP_HEADER * 8;
    if (_im_snap_checksum(payload, n) != load64(buf + 32)) { return Err(IM_ERR_DESERIALIZE); }
    var s: ImWorldSnapshot = ImWorldSnapshot_new();
    var rd: ImSnapReader = _im_snap_reader(payload, n);
    var ok = s._decode_world(&rd);
    if (ok == 1) { ok = s._decode_backend(&rd); }
    if (ok == 0 || rd.bad == 1 || rd.at != n) {
        s.free();
        return Err(IM_ERR_DESERIALIZE);
    }
    memcpy(out, &s, sizeof(ImWorldSnapshot));
    return Ok(0);
}

# The world's binary form into out (ADR 0013): `snapshot`, then `to_bytes`. Ok(0), or Err(IM_ERR_SERIALIZE). Mirrors
# `serialize_world`; its bytes are Cyrius's own, not Rust's bitcode.
fn serialize_world(w: *ImPhysicsWorld, out: *ImWordList): Result {
    var s: ImWorldSnapshot = ImWorldSnapshot_new();
    var t, v = w.snapshot(&s);
    if (is_ok(t) == 0) { return Err(v); }
    var tb, vb = s.to_bytes(out);
    s.free();
    if (is_ok(tb) == 0) { return Err(vb); }
    return Ok(0);
}

# Restores world w from the binary form at buf (len bytes): `ImWorldSnapshot_from_bytes`, then `restore`. Ok(0), or
# their error; on any error the world is unchanged. Mirrors `deserialize_world`.
fn deserialize_world(w: *ImPhysicsWorld, buf, len): Result {
    var s: ImWorldSnapshot = ImWorldSnapshot_new();
    var t, v = ImWorldSnapshot_from_bytes(buf, len, &s);
    if (is_ok(t) == 0) { return Err(v); }
    var tr, vr = w.restore(&s);
    s.free();
    if (is_ok(tr) == 0) { return Err(vr); }
    return Ok(0);
}

# ── the JSON form (ADR 0013) ────────────────────────────────────────────────────────
# One object: "format" ("impetus-snapshot"), "version" (1) and "profile" ("2d" or "3d") first, then the struct's fields
# in order (config, next_particle_id, next_emitter_id, bodies, colliders, joints, particles, emitters, force_fields,
# body_arena, collider_arena, joint_arena, the profile's own keys, tracker). No checksum: the form is meant to be read
# and edited, and `restore` checks it as it checks any snapshot.

impl ImWorldSnapshot {
    # Appends the snapshot as JSON to the str builder sb: Ok(0), or Err(IM_ERR_SERIALIZE) when a value is not finite
    # (JSON has no form for it, and serde_json would write null; the binary form holds it). sb then holds a document
    # that must not be read back. ADR 0013.
    fn to_json(self, sb): Result {
        _im_json_nonfinite = 0;
        str_builder_add_cstr(sb, "{\"format\":\"impetus-snapshot\",\"version\":1,\"profile\":");
        _im_jw_name(sb, _im_snap_profile_name());
        _im_jw_key(sb, "config", 0);
        self.config.to_json(sb);
        _im_jw_key(sb, "next_particle_id", 0);
        _im_jw_u64(sb, self.next_particle_id);
        _im_jw_key(sb, "next_emitter_id", 0);
        _im_jw_u64(sb, self.next_emitter_id);
        _im_jw_key(sb, "bodies", 0);
        self._json_bodies(sb);
        _im_jw_key(sb, "colliders", 0);
        self._json_colliders(sb);
        _im_jw_key(sb, "joints", 0);
        self._json_joints(sb);
        _im_jw_key(sb, "particles", 0);
        str_builder_putc(sb, 91);
        for (var i = 0; i < self.particles.len; i = i + 1) {
            if (i > 0) { str_builder_putc(sb, 44); }
            var p: *ImParticle = _im_as_particle(self.particles.at(i));
            p.to_json(sb);
        }
        str_builder_putc(sb, 93);
        _im_jw_key(sb, "emitters", 0);
        str_builder_putc(sb, 91);
        for (var e = 0; e < self.emitters.len; e = e + 1) {
            if (e > 0) { str_builder_putc(sb, 44); }
            var em: *ImParticleEmitter = _im_as_emitter(self.emitters.at(e));
            em.to_json(sb);
        }
        str_builder_putc(sb, 93);
        _im_jw_key(sb, "force_fields", 0);
        str_builder_putc(sb, 91);
        for (var f = 0; f < self.force_fields.len; f = f + 1) {
            if (f > 0) { str_builder_putc(sb, 44); }
            var ff: *ImForceField = _im_as_force_field(self.force_fields.at(f));
            ff.to_json(sb);
        }
        str_builder_putc(sb, 93);
        _im_jw_key(sb, "body_arena", 0);
        _im_sj_arena(sb, self.body_arena);
        _im_jw_key(sb, "collider_arena", 0);
        _im_sj_arena(sb, self.collider_arena);
        _im_jw_key(sb, "joint_arena", 0);
        _im_sj_arena(sb, self.joint_arena);
        self._json_backend_extra(sb);
        _im_jw_key(sb, "tracker", 0);
        _im_sj_tracker(sb, self.tracker);
        str_builder_putc(sb, 125);
        if (_im_json_nonfinite > 0) { return Err(IM_ERR_SERIALIZE); }
        return Ok(0);
    }

    # Reads the document node o into this empty snapshot: 1, or 0.
    fn _read_json(self, o): i64 {
        var bad[8];
        store64(&bad, 0);
        var w[8];
        var fv = bayan_json_v_obj_get_by_cstr(o, "format");
        var pv = bayan_json_v_obj_get_by_cstr(o, "profile");
        if (fv == 0 || bayan_json_v_tag(fv) != JTAG_STR || pv == 0 || bayan_json_v_tag(pv) != JTAG_STR) { return 0; }
        if (str_eq_cstr(bayan_json_v_str(fv), "impetus-snapshot") != 1) { return 0; }
        if (str_eq_cstr(bayan_json_v_str(pv), _im_snap_profile_name()) != 1) { return 0; }
        if (_im_jr_int(bayan_json_v_obj_get_by_cstr(o, "version"), 1, 1, &w) == 0) { return 0; }
        if (_im_jr_config(bayan_json_v_obj_get_by_cstr(o, "config"), self.config) == 0) { return 0; }
        self.next_particle_id = _im_sr_u64(o, 1, 0, "next_particle_id", &bad);
        self.next_emitter_id = _im_sr_u64(o, 1, 0, "next_emitter_id", &bad);
        if (load64(&bad) == 1) { return 0; }
        if (self._read_bodies(bayan_json_v_obj_get_by_cstr(o, "bodies")) == 0) { return 0; }
        if (self._read_colliders(bayan_json_v_obj_get_by_cstr(o, "colliders")) == 0) { return 0; }
        if (self._read_joints(bayan_json_v_obj_get_by_cstr(o, "joints")) == 0) { return 0; }
        var plv = bayan_json_v_obj_get_by_cstr(o, "particles");
        var np = _im_sr_len(plv);
        if (np < 0 || self.particles.reserve(np) == 0) { return 0; }
        for (var i = 0; i < np; i = i + 1) {
            if (_im_jr_particle(bayan_json_v_arr_get(plv, i), _im_as_particle(self.particles.at(i))) == 0) { return 0; }
            self.particles.len = i + 1;
        }
        var elv = bayan_json_v_obj_get_by_cstr(o, "emitters");
        var ne = _im_sr_len(elv);
        if (ne < 0 || self.emitters.reserve(ne) == 0) { return 0; }
        for (var e = 0; e < ne; e = e + 1) {
            if (_im_jr_emitter(bayan_json_v_arr_get(elv, e), _im_as_emitter(self.emitters.at(e))) == 0) { return 0; }
            self.emitters.len = e + 1;
        }
        var flv = bayan_json_v_obj_get_by_cstr(o, "force_fields");
        var nf = _im_sr_len(flv);
        if (nf < 0 || self.force_fields.reserve(nf) == 0) { return 0; }
        for (var f = 0; f < nf; f = f + 1) {
            var fp: *ImForceField = _im_as_force_field(self.force_fields.at(f));
            if (_im_jr_force_field(bayan_json_v_arr_get(flv, f), fp) == 0) { return 0; }
            self.force_fields.len = f + 1;
        }
        if (_im_sr_arena(bayan_json_v_obj_get_by_cstr(o, "body_arena"), self.body_arena) == 0) { return 0; }
        if (_im_sr_arena(bayan_json_v_obj_get_by_cstr(o, "collider_arena"), self.collider_arena) == 0) { return 0; }
        if (_im_sr_arena(bayan_json_v_obj_get_by_cstr(o, "joint_arena"), self.joint_arena) == 0) { return 0; }
        if (self._read_backend_extra(o) == 0) { return 0; }
        return _im_sr_tracker(bayan_json_v_obj_get_by_cstr(o, "tracker"), self.tracker);
    }
}

# Reads a snapshot's JSON form at buf (len bytes) into *out (overwritten; free it after): Ok(0), or
# Err(IM_ERR_DESERIALIZE) when the text is not one JSON object, its format, version or profile is not this one's, or a
# field is missing or malformed. A snapshot read here is checked in full by `restore`. ADR 0013.
fn ImWorldSnapshot_from_json(buf, len, out: *ImWorldSnapshot): Result {
    var o = _im_jr_parse(buf, len);
    if (o == 0 || bayan_json_v_tag(o) != JTAG_OBJ) { return Err(IM_ERR_DESERIALIZE); }
    var s: ImWorldSnapshot = ImWorldSnapshot_new();
    if (s._read_json(o) == 0) {
        s.free();
        return Err(IM_ERR_DESERIALIZE);
    }
    memcpy(out, &s, sizeof(ImWorldSnapshot));
    return Ok(0);
}
