# snapshot.cyr — the snapshot pieces both profiles share (ADR 0013): an arena's slots and free list, the contact
# tracker's pair lists and last events, and record-list copies. Each piece captures its part of a live world, checks
# itself, and loads into a fresh one. A profile's `ImWorldSnapshot`, with its backend records, comes next
# (src/b2_snapshot.cyr; the 3D one arrives with M6 part 4), and src/world_snapshot.cyr after it: `snapshot`,
# `restore` and the checks that span the pieces.

# ── record and pair lists ───────────────────────────────────────────────────────────

# Copies src's records into dst (emptied first; both of one record size): 1, or 0 when there is no memory.
fn _im_snap_copy_records(dst: *ImRecordList, src: *ImRecordList): i64 {
    dst.len = 0;
    if (src.len == 0) { return 1; }
    if (dst.reserve(src.len) == 0) { return 0; }
    memcpy(dst.data, src.data, src.len * src.size);
    dst.len = src.len;
    return 1;
}

# Copies src's pairs into dst (emptied first): 1, or 0 when there is no memory.
fn _im_snap_copy_pairs(dst: *ImPairList, src: *ImPairList): i64 {
    dst.len = 0;
    if (src.len == 0) { return 1; }
    if (dst.reserve(src.len) == 0) { return 0; }
    memcpy(dst.data, src.data, src.len * 16);
    dst.len = src.len;
    return 1;
}

# 1 when the pairs are in strictly ascending (unsigned) order, as the tracker and the manifold store keep them.
#must_use
fn _im_snap_pairs_ascending(p: *ImPairList): i64 {
    for (var i = 1; i < p.len; i = i + 1) {
        if (_im_pair_cmp(p.first(i - 1), p.second(i - 1), p.first(i), p.second(i)) >= 0) { return 0; }
    }
    return 1;
}

# 1 when x is 0 or 1.
#must_use
fn _im_snap_flag(x): i64 {
    if (x == 0 || x == 1) { return 1; }
    return 0;
}

# ── shapes, materials, joint types ──────────────────────────────────────────────────

# A copy of shape s with arrays of its own into *out: 1, or 0 when there is no memory (then nothing stays allocated).
fn _im_snap_clone_shape(s: *ImColliderShape, out: *ImColliderShape): i64 {
    var c: ImColliderShape = s.clone();
    var lost = 0;
    if (s.point_count > 0 && c.points == 0) { lost = 1; }
    if (s.vertex_count > 0 && c.vertices == 0) { lost = 1; }
    if (s.index_count > 0 && c.indices == 0) { lost = 1; }
    if (s.height_count > 0 && c.heights == 0) { lost = 1; }
    if (lost == 1) {
        c.free();
        return 0;
    }
    memcpy(out, &c, sizeof(ImColliderShape));
    return 1;
}

# 1 when shape s is well formed: a known kind, no negative array count, an array behind every nonzero count, and a
# mesh's indices inside its vertices. Its sizes are not checked, as Rust checks none.
#must_use
fn _im_snap_shape_ok(s: *ImColliderShape): i64 {
    if (s.kind < IM_SHAPE_BOX || s.kind > IM_SHAPE_SEGMENT) { return 0; }
    if (s.point_count < 0 || s.vertex_count < 0 || s.index_count < 0 || s.height_count < 0) { return 0; }
    if ((s.point_count > 0 && s.points == 0) || (s.vertex_count > 0 && s.vertices == 0)) { return 0; }
    if ((s.index_count > 0 && s.indices == 0) || (s.height_count > 0 && s.heights == 0)) { return 0; }
    for (var i = 0; i < s.index_count * 3; i = i + 1) {
        var v = load64(s.indices + i * 8);
        if (v < 0 || v >= s.vertex_count) { return 0; }
    }
    return 1;
}

# 1 when the material's flag and combine rules are in range.
#must_use
fn _im_snap_material_ok(m: *ImPhysicsMaterial): i64 {
    if (_im_snap_flag(m.has_static_friction) == 0) { return 0; }
    if (m.friction_combine < IM_COMBINE_MIN || m.friction_combine > IM_COMBINE_MAX) { return 0; }
    if (m.restitution_combine < IM_COMBINE_MIN || m.restitution_combine > IM_COMBINE_MAX) { return 0; }
    return 1;
}

# 1 when the joint type's kind and limits flag are in range.
#must_use
fn _im_snap_joint_type_ok(j: *ImJointType): i64 {
    if (j.kind < IM_JOINT_FIXED || j.kind > IM_JOINT_MOUSE) { return 0; }
    return _im_snap_flag(j.has_limits);
}

# ── arenas ──────────────────────────────────────────────────────────────────────────

# One arena slot: occupied (0 or 1), its generation (below 2^32) and the next free slot (-1 for none). The arena's
# own three metadata words, in that order.
struct ImSlotSnapshot { occupied; generation; next_free; }

# An arena's slots (ImSlotSnapshot records, slot order), its free-list head (-1 for none) and whether the free list
# awaits a rebuild (after `insert_at`). With these an arena hands out the same handles as the original.
struct ImArenaSnapshot { slots: ImRecordList; free_head; free_list_stale; }

# An empty arena snapshot.
#must_use
fn ImArenaSnapshot_new(): ImArenaSnapshot {
    var s: ImArenaSnapshot;
    s.slots = ImRecordList_new(sizeof(ImSlotSnapshot));
    s.free_head = 0 - 1;
    s.free_list_stale = 0;
    return s;
}

#must_use
fn _im_as_slot(p): *ImSlotSnapshot { return p; }

impl ImArenaSnapshot {
    # Captures arena a's slots and free list: 1, or 0 when there is no memory.
    fn capture(self, a: *ImArena): i64 {
        self.slots.len = 0;
        if (a.count > 0) {
            if (self.slots.reserve(a.count) == 0) { return 0; }
            memcpy(self.slots.data, a.meta, a.count * sizeof(ImSlotSnapshot));
        }
        self.slots.len = a.count;
        self.free_head = a.free_head;
        self.free_list_stale = a.free_list_stale;
        return 1;
    }

    # The slot record at index i.
    #must_use
    fn slot(self, i): *ImSlotSnapshot { return _im_as_slot(self.slots.at(i)); }

    # 1 when h names an occupied slot at that slot's generation.
    #must_use
    fn live(self, h): i64 {
        var i = _im_handle_index(h);
        if (i >= self.slots.len) { return 0; }
        var s: *ImSlotSnapshot = self.slot(i);
        if (s.occupied != 1 || _im_arena_handle(i, s.generation) != h) { return 0; }
        return 1;
    }

    # The number of occupied slots.
    #must_use
    fn occupied(self): i64 {
        var n = 0;
        for (var i = 0; i < self.slots.len; i = i + 1) {
            var s: *ImSlotSnapshot = self.slot(i);
            if (s.occupied == 1) { n = n + 1; }
        }
        return n;
    }

    # 1 when the slots could be an arena's: at most IM_MAX_SNAPSHOT_INDEX + 1 of them, each occupied 0 or 1 with a
    # generation below 2^32 and a next free slot in range or -1, the head in range or -1, and (unless the list awaits a
    # rebuild) a free list that visits free slots only, each at most once. Mirrors `validate_snapshot`'s index cap.
    #must_use
    fn validate(self): i64 {
        var n = self.slots.len;
        if (self.slots.size != sizeof(ImSlotSnapshot) || n < 0 || n > IM_MAX_SNAPSHOT_INDEX + 1) { return 0; }
        for (var i = 0; i < n; i = i + 1) {
            var s: *ImSlotSnapshot = self.slot(i);
            if (_im_snap_flag(s.occupied) == 0) { return 0; }
            if (s.generation < 0 || s.generation > 0xFFFFFFFF) { return 0; }
            if (s.next_free < 0 - 1 || s.next_free >= n) { return 0; }
        }
        if (self.free_head < 0 - 1 || self.free_head >= n) { return 0; }
        if (_im_snap_flag(self.free_list_stale) == 0) { return 0; }
        if (self.free_list_stale == 0) {
            var at = self.free_head;
            var steps = 0;
            while (at >= 0) {
                var f: *ImSlotSnapshot = self.slot(at);
                if (f.occupied != 0 || steps >= n) { return 0; }
                steps = steps + 1;
                at = f.next_free;
            }
        }
        return 1;
    }

    # Writes the slots and free list into the fresh arena a, whose records the caller fills: 1, or 0 when there is no
    # memory.
    fn load(self, a: *ImArena): i64 {
        var n = self.slots.len;
        if (a._reserve(n) == 0) { return 0; }
        if (n > 0) { memcpy(a.meta, self.slots.data, n * sizeof(ImSlotSnapshot)); }
        a.count = n;
        a.len = self.occupied();
        a.free_head = self.free_head;
        a.free_list_stale = self.free_list_stale;
        return 1;
    }

    # Releases the slot list.
    fn free(self) {
        self.slots.free();
        return 0;
    }
}

# ── the contact tracker ─────────────────────────────────────────────────────────────

# The contact tracker's state between frames: the pairs touching at the end of the last frame (`prev`), the frame's
# so far (`current`), those seen in any sub-step (`seen`), whether a sub-step recorded (`recorded`), and the last
# frame's events (ImCollisionEvent records), which `collision_events` returns.
struct ImTrackerSnapshot {
    prev: ImPairList;
    current: ImPairList;
    seen: ImPairList;
    recorded;
    events: ImRecordList;
}

# An empty tracker snapshot.
#must_use
fn ImTrackerSnapshot_new(): ImTrackerSnapshot {
    var s: ImTrackerSnapshot;
    s.prev = ImPairList_new();
    s.current = ImPairList_new();
    s.seen = ImPairList_new();
    s.recorded = 0;
    s.events = ImRecordList_new(sizeof(ImCollisionEvent));
    return s;
}

#must_use
fn _im_as_event(p): *ImCollisionEvent { return p; }

impl ImTrackerSnapshot {
    # Captures tracker t: 1, or 0 when there is no memory.
    fn capture(self, t: *ImContactTracker): i64 {
        if (_im_snap_copy_pairs(self.prev, t.prev) == 0) { return 0; }
        if (_im_snap_copy_pairs(self.current, t.current) == 0) { return 0; }
        if (_im_snap_copy_pairs(self.seen, t.seen) == 0) { return 0; }
        self.recorded = t.recorded;
        self.events.len = 0;
        if (t.event_count > 0) {
            if (self.events.reserve(t.event_count) == 0) { return 0; }
            memcpy(self.events.data, t.events, t.event_count * sizeof(ImCollisionEvent));
        }
        self.events.len = t.event_count;
        return 1;
    }

    # 1 when the pair lists are strictly ascending, the flag is 0 or 1 and every event's kind is one of the three.
    #must_use
    fn validate(self): i64 {
        if (self.events.size != sizeof(ImCollisionEvent)) { return 0; }
        if (_im_snap_pairs_ascending(self.prev) == 0 || _im_snap_pairs_ascending(self.current) == 0) { return 0; }
        if (_im_snap_pairs_ascending(self.seen) == 0 || _im_snap_flag(self.recorded) == 0) { return 0; }
        for (var i = 0; i < self.events.len; i = i + 1) {
            var e: *ImCollisionEvent = _im_as_event(self.events.at(i));
            if (e.kind < IM_EVENT_STARTED || e.kind > IM_EVENT_ONGOING) { return 0; }
        }
        return 1;
    }

    # Writes the state into the fresh tracker t: 1, or 0 when there is no memory.
    fn load(self, t: *ImContactTracker): i64 {
        if (_im_snap_copy_pairs(t.prev, self.prev) == 0) { return 0; }
        if (_im_snap_copy_pairs(t.current, self.current) == 0) { return 0; }
        if (_im_snap_copy_pairs(t.seen, self.seen) == 0) { return 0; }
        t.recorded = self.recorded;
        var n = self.events.len;
        if (n > 0) {
            var e = fl_alloc(n * sizeof(ImCollisionEvent));
            if (e == 0) { return 0; }
            memcpy(e, self.events.data, n * sizeof(ImCollisionEvent));
            t.events = e;
            t.event_cap = n;
        }
        t.event_count = n;
        return 1;
    }

    # Releases the lists.
    fn free(self) {
        self.prev.free();
        self.current.free();
        self.seen.free();
        self.events.free();
        return 0;
    }
}

# ── the binary form (ADR 0013, version 1) ───────────────────────────────────────────
# Little-endian 64-bit words: integers and handles as words, f64 as their bits, flags as 0 or 1, an absent optional as
# a 0 flag and zero value words, a list as its count then its items, a payload enum (shape, joint type, force field)
# as its kind then that variant's own fields. Five header words lead: the magic "IMPSNAP\0", the version, the
# profile (2 or 3), the payload's length in words and its checksum. The same bytes on every target (ADR 0008 #7).

const _IM_SNAP_MAGIC = 0x0050414E53504D49;
const _IM_SNAP_VERSION = 1;
const _IM_SNAP_HEADER = 5;

# The 64-bit FNV-1a of the n words at p, a word at a time: h ← (h ⊕ w) × 0x100000001b3 from
# 0xcbf29ce484222325, wrapping. Each step maps h one to one, so changing any one word changes the result.
#must_use
fn _im_snap_checksum(p, n): i64 {
    var h = 0xcbf29ce484222325;
    for (var i = 0; i < n; i = i + 1) { h = (h ^ load64(p + i * 8)) * 0x100000001b3; }
    return h;
}

#must_use
fn _im_as_wlist(p): *ImWordList { return p; }

# A word sink over an ImWordList (`out`, its address); `bad` turns 1 when a write runs out of memory, and later writes
# are dropped.
struct ImSnapWriter { out; bad; }

# A writer appending to *out.
#must_use
fn _im_snap_writer(out: *ImWordList): ImSnapWriter {
    var wr: ImSnapWriter;
    wr.out = out;
    wr.bad = 0;
    return wr;
}

impl ImSnapWriter {
    # Appends the word x.
    fn w(self, x) {
        if (self.bad == 0) {
            var l: *ImWordList = _im_as_wlist(self.out);
            if (l.push(x) == 0) { self.bad = 1; }
        }
        return 0;
    }

    # Appends x's bits.
    fn f(self, x: f64) {
        var t[8];
        store64(&t, x);
        self.w(load64(&t));
        return 0;
    }

    # Appends v's two components.
    fn v2(self, v: ImVec2) {
        var x: f64 = v.x;
        var y: f64 = v.y;
        self.f(x);
        self.f(y);
        return 0;
    }

    # Appends v's three components.
    fn v3(self, v: ImVec3) {
        var x: f64 = v.x;
        var y: f64 = v.y;
        var z: f64 = v.z;
        self.f(x);
        self.f(y);
        self.f(z);
        return 0;
    }

    # Appends an optional f64: the flag, then x, or 0 when has is 0.
    fn opt_f(self, has, x: f64) {
        self.w(has);
        if (has == 1) { self.f(x); } else { self.w(0); }
        return 0;
    }

    # Appends the n words at p.
    fn words(self, p, n) {
        for (var i = 0; i < n; i = i + 1) { self.w(load64(p + i * 8)); }
        return 0;
    }
}

# A word source over the n words at `data`; `at` is the next word, and `bad` turns 1 when a read runs past the end or
# finds a malformed word. Reads past the end give 0.
struct ImSnapReader { data; n; at; bad; }

# A reader over the n words at p.
#must_use
fn _im_snap_reader(p, n): ImSnapReader {
    var rd: ImSnapReader;
    rd.data = p;
    rd.n = n;
    rd.at = 0;
    rd.bad = 0;
    return rd;
}

impl ImSnapReader {
    # The next word.
    fn w(self): i64 {
        if (self.at >= self.n) {
            self.bad = 1;
            return 0;
        }
        var x = load64(self.data + self.at * 8);
        self.at = self.at + 1;
        return x;
    }

    # The next word as an f64.
    fn f(self): f64 {
        var zero: f64 = 0.0;
        if (self.at >= self.n) {
            self.bad = 1;
            return zero;
        }
        var x: f64 = load64(self.data + self.at * 8);
        self.at = self.at + 1;
        return x;
    }

    # The next two words as an ImVec2.
    fn v2(self): ImVec2 {
        var x: f64 = self.f();
        var y: f64 = self.f();
        return ImVec2_new(x, y);
    }

    # The next three words as an ImVec3.
    fn v3(self): ImVec3 {
        var x: f64 = self.f();
        var y: f64 = self.f();
        var z: f64 = self.f();
        return ImVec3_new(x, y, z);
    }

    # The next word, which must be 0 or 1.
    fn flag(self): i64 {
        var x = self.w();
        if (x != 0 && x != 1) { self.bad = 1; }
        return x;
    }

    # The next word as a count of items of at least `per` words each, which must fit in the words left: else 0, and
    # the read is bad. It bounds every allocation by the input's length.
    fn count(self, per): i64 {
        var c = self.w();
        if (c < 0 || c > (self.n - self.at) / per) {
            self.bad = 1;
            return 0;
        }
        return c;
    }

    # A freelist copy of the next n words (n checked by `count`), or 0 for none or no memory (then the read is bad).
    fn words(self, n): i64 {
        if (n == 0) { return 0; }
        var p = fl_alloc(n * 8);
        if (p == 0) {
            self.bad = 1;
            return 0;
        }
        for (var i = 0; i < n; i = i + 1) { store64(p + i * 8, self.w()); }
        return p;
    }
}

# ── shared records in the binary form ───────────────────────────────────────────────

# Writes shape s: its kind and that kind's fields. 1, or 0 for an unknown kind.
fn _im_snap_put_shape(wr: *ImSnapWriter, s: *ImColliderShape): i64 {
    var k = s.kind;
    wr.w(k);
    if (k == IM_SHAPE_BOX) {
        wr.v3(s.half_extents);
    } elif (k == IM_SHAPE_BALL) {
        var r: f64 = s.radius;
        wr.f(r);
    } elif (k == IM_SHAPE_CAPSULE) {
        var hh: f64 = s.half_height;
        var cr: f64 = s.radius;
        wr.f(hh);
        wr.f(cr);
    } elif (k == IM_SHAPE_CONVEX_HULL) {
        wr.w(s.point_count);
        wr.words(s.points, s.point_count * 3);
    } elif (k == IM_SHAPE_TRI_MESH) {
        wr.w(s.vertex_count);
        wr.words(s.vertices, s.vertex_count * 3);
        wr.w(s.index_count);
        wr.words(s.indices, s.index_count * 3);
    } elif (k == IM_SHAPE_HEIGHTFIELD) {
        wr.w(s.height_count);
        wr.words(s.heights, s.height_count);
        wr.v3(s.scale);
    } elif (k == IM_SHAPE_SEGMENT) {
        wr.v3(s.a);
        wr.v3(s.b);
    } else {
        return 0;
    }
    return 1;
}

# Reads a shape into *out: 1, or 0 for an unknown kind, a short read or no memory (then nothing stays allocated).
fn _im_snap_get_shape(rd: *ImSnapReader, out: *ImColliderShape): i64 {
    var k = rd.w();
    var s: ImColliderShape = _im_shape(k);
    if (k == IM_SHAPE_BOX) {
        var he: ImVec3 = rd.v3();
        s.half_extents = he;
    } elif (k == IM_SHAPE_BALL) {
        s.radius = rd.f();
    } elif (k == IM_SHAPE_CAPSULE) {
        s.half_height = rd.f();
        s.radius = rd.f();
    } elif (k == IM_SHAPE_CONVEX_HULL) {
        s.point_count = rd.count(3);
        s.points = rd.words(s.point_count * 3);
    } elif (k == IM_SHAPE_TRI_MESH) {
        s.vertex_count = rd.count(3);
        s.vertices = rd.words(s.vertex_count * 3);
        s.index_count = rd.count(3);
        s.indices = rd.words(s.index_count * 3);
    } elif (k == IM_SHAPE_HEIGHTFIELD) {
        s.height_count = rd.count(1);
        s.heights = rd.words(s.height_count);
        var sc: ImVec3 = rd.v3();
        s.scale = sc;
    } elif (k == IM_SHAPE_SEGMENT) {
        var a: ImVec3 = rd.v3();
        var b: ImVec3 = rd.v3();
        s.a = a;
        s.b = b;
    } else {
        rd.bad = 1;
    }
    if (rd.bad == 1) {
        s.free();
        return 0;
    }
    memcpy(out, &s, sizeof(ImColliderShape));
    return 1;
}

# Writes material m (8 words).
fn _im_snap_put_material(wr: *ImSnapWriter, m: *ImPhysicsMaterial) {
    var fr: f64 = m.friction;
    var re: f64 = m.restitution;
    var de: f64 = m.density;
    var sf: f64 = m.static_friction;
    var ro: f64 = m.rolling_friction;
    wr.f(fr);
    wr.f(re);
    wr.f(de);
    wr.opt_f(m.has_static_friction, sf);
    wr.f(ro);
    wr.w(m.friction_combine);
    wr.w(m.restitution_combine);
    return 0;
}

# Reads a material into *m.
fn _im_snap_get_material(rd: *ImSnapReader, m: *ImPhysicsMaterial) {
    m.friction = rd.f();
    m.restitution = rd.f();
    m.density = rd.f();
    m.has_static_friction = rd.flag();
    m.static_friction = rd.f();
    m.rolling_friction = rd.f();
    m.friction_combine = rd.w();
    m.restitution_combine = rd.w();
    return 0;
}

# Writes joint type j: its kind and that kind's fields. 1, or 0 for an unknown kind.
fn _im_snap_put_joint_type(wr: *ImSnapWriter, j: *ImJointType): i64 {
    var k = j.kind;
    wr.w(k);
    var lo: f64 = j.limits.x;
    var hi: f64 = j.limits.y;
    if (k == IM_JOINT_REVOLUTE || k == IM_JOINT_PRISMATIC) {
        if (k == IM_JOINT_REVOLUTE) { wr.v2(j.anchor); } else { wr.v2(j.axis); }
        wr.w(j.has_limits);
        if (j.has_limits == 1) {
            wr.f(lo);
            wr.f(hi);
        } else {
            wr.w(0);
            wr.w(0);
        }
    } elif (k == IM_JOINT_SPRING) {
        var rl: f64 = j.rest_length;
        var st: f64 = j.stiffness;
        var dp: f64 = j.damping;
        wr.f(rl);
        wr.f(st);
        wr.f(dp);
    } elif (k == IM_JOINT_DISTANCE) {
        var ln: f64 = j.length;
        wr.f(ln);
    } elif (k == IM_JOINT_WHEEL) {
        var ws: f64 = j.stiffness;
        var wd: f64 = j.damping;
        wr.v2(j.axis);
        wr.f(ws);
        wr.f(wd);
    } elif (k == IM_JOINT_ROPE) {
        var ml: f64 = j.max_length;
        wr.f(ml);
    } elif (k == IM_JOINT_MOUSE) {
        var ms: f64 = j.stiffness;
        var md: f64 = j.damping;
        var mf: f64 = j.max_force;
        wr.v3(j.target);
        wr.f(ms);
        wr.f(md);
        wr.f(mf);
    } elif (k != IM_JOINT_FIXED) {
        return 0;
    }
    return 1;
}

# Reads a joint type into *out: 1, or 0 for an unknown kind (the read is then bad).
fn _im_snap_get_joint_type(rd: *ImSnapReader, out: *ImJointType): i64 {
    var k = rd.w();
    var j: ImJointType = _im_joint(k);
    if (k == IM_JOINT_REVOLUTE || k == IM_JOINT_PRISMATIC) {
        var v: ImVec2 = rd.v2();
        if (k == IM_JOINT_REVOLUTE) { j.anchor = v; } else { j.axis = v; }
        j.has_limits = rd.flag();
        var lim: ImVec2 = rd.v2();
        j.limits = lim;
    } elif (k == IM_JOINT_SPRING) {
        j.rest_length = rd.f();
        j.stiffness = rd.f();
        j.damping = rd.f();
    } elif (k == IM_JOINT_DISTANCE) {
        j.length = rd.f();
    } elif (k == IM_JOINT_WHEEL) {
        var ax: ImVec2 = rd.v2();
        j.axis = ax;
        j.stiffness = rd.f();
        j.damping = rd.f();
    } elif (k == IM_JOINT_ROPE) {
        j.max_length = rd.f();
    } elif (k == IM_JOINT_MOUSE) {
        var tg: ImVec3 = rd.v3();
        j.target = tg;
        j.stiffness = rd.f();
        j.damping = rd.f();
        j.max_force = rd.f();
    } elif (k != IM_JOINT_FIXED) {
        rd.bad = 1;
        return 0;
    }
    memcpy(out, &j, sizeof(ImJointType));
    return 1;
}

# Writes an arena snapshot: the slot count, three words a slot, the free-list head and the stale flag.
fn _im_snap_put_arena(wr: *ImSnapWriter, a: *ImArenaSnapshot) {
    wr.w(a.slots.len);
    wr.words(a.slots.data, a.slots.len * 3);
    wr.w(a.free_head);
    wr.w(a.free_list_stale);
    return 0;
}

# Reads an arena snapshot into the empty *a: 1, or 0 on a bad read or no memory.
fn _im_snap_get_arena(rd: *ImSnapReader, a: *ImArenaSnapshot): i64 {
    var n = rd.count(3);
    if (a.slots.reserve(n) == 0) { return 0; }
    for (var i = 0; i < n * 3; i = i + 1) { store64(a.slots.data + i * 8, rd.w()); }
    a.slots.len = n;
    a.free_head = rd.w();
    a.free_list_stale = rd.w();
    if (rd.bad == 1) { return 0; }
    return 1;
}

# Writes a pair list: its count, then two words a pair.
fn _im_snap_put_pairs(wr: *ImSnapWriter, p: *ImPairList) {
    wr.w(p.len);
    wr.words(p.data, p.len * 2);
    return 0;
}

# Reads a pair list into the empty *p: 1, or 0 on a bad read or no memory.
fn _im_snap_get_pairs(rd: *ImSnapReader, p: *ImPairList): i64 {
    var n = rd.count(2);
    if (p.reserve(n) == 0) { return 0; }
    for (var i = 0; i < n * 2; i = i + 1) { store64(p.data + i * 8, rd.w()); }
    p.len = n;
    if (rd.bad == 1) { return 0; }
    return 1;
}

# Writes a tracker snapshot: the three pair lists, the flag, then the events (count, three words each).
fn _im_snap_put_tracker(wr: *ImSnapWriter, t: *ImTrackerSnapshot) {
    _im_snap_put_pairs(wr, t.prev);
    _im_snap_put_pairs(wr, t.current);
    _im_snap_put_pairs(wr, t.seen);
    wr.w(t.recorded);
    wr.w(t.events.len);
    wr.words(t.events.data, t.events.len * 3);
    return 0;
}

# Reads a tracker snapshot into the empty *t: 1, or 0 on a bad read or no memory.
fn _im_snap_get_tracker(rd: *ImSnapReader, t: *ImTrackerSnapshot): i64 {
    if (_im_snap_get_pairs(rd, t.prev) == 0 || _im_snap_get_pairs(rd, t.current) == 0) { return 0; }
    if (_im_snap_get_pairs(rd, t.seen) == 0) { return 0; }
    t.recorded = rd.flag();
    var n = rd.count(3);
    if (t.events.reserve(n) == 0) { return 0; }
    for (var i = 0; i < n * 3; i = i + 1) { store64(t.events.data + i * 8, rd.w()); }
    t.events.len = n;
    if (rd.bad == 1) { return 0; }
    return 1;
}

# Writes the config (16 words, its fields in order).
fn _im_snap_put_config(wr: *ImSnapWriter, c: *ImWorldConfig) {
    var ts: f64 = c.timestep;
    var sl: f64 = c.position_slop;
    var pc: f64 = c.position_correction;
    var mv: f64 = c.max_velocity;
    var fq: f64 = c.constraint_frequency;
    var dr: f64 = c.constraint_damping_ratio;
    wr.f(ts);
    wr.v3(c.gravity);
    wr.w(c.velocity_iterations);
    wr.w(c.position_iterations);
    wr.w(c.deterministic);
    wr.w(c.step);
    wr.f(sl);
    wr.f(pc);
    wr.f(mv);
    wr.w(c.sub_steps);
    wr.f(fq);
    wr.f(dr);
    wr.w(c.broadphase);
    wr.w(c.solver);
    return 0;
}

# Reads a config into *c.
fn _im_snap_get_config(rd: *ImSnapReader, c: *ImWorldConfig) {
    c.timestep = rd.f();
    var g: ImVec3 = rd.v3();
    c.gravity = g;
    c.velocity_iterations = rd.w();
    c.position_iterations = rd.w();
    c.deterministic = rd.w();
    c.step = rd.w();
    c.position_slop = rd.f();
    c.position_correction = rd.f();
    c.max_velocity = rd.f();
    c.sub_steps = rd.w();
    c.constraint_frequency = rd.f();
    c.constraint_damping_ratio = rd.f();
    c.broadphase = rd.w();
    c.solver = rd.w();
    return 0;
}

# Writes particle p (20 words): handle, position, velocity, lifetime, radius, drag, restitution, gravity scale,
# damping, then the sub-emitter (flag, count, speed, lifetime, radius, gravity scale, restitution; zeros for none).
fn _im_snap_put_particle(wr: *ImSnapWriter, p: *ImParticle) {
    var lt: f64 = p.lifetime;
    var ra: f64 = p.radius;
    var dg: f64 = p.drag;
    var rs: f64 = p.restitution;
    var gs: f64 = p.gravity_scale;
    var dm: f64 = p.damping;
    wr.w(p.handle);
    wr.v3(p.position);
    wr.v3(p.velocity);
    wr.f(lt);
    wr.f(ra);
    wr.f(dg);
    wr.f(rs);
    wr.f(gs);
    wr.f(dm);
    wr.w(p.has_on_death_emit);
    if (p.has_on_death_emit == 1) {
        var sp: f64 = p.on_death_emit.speed;
        var sl: f64 = p.on_death_emit.lifetime;
        var sr: f64 = p.on_death_emit.radius;
        var sg: f64 = p.on_death_emit.gravity_scale;
        var se: f64 = p.on_death_emit.restitution;
        wr.w(p.on_death_emit.count);
        wr.f(sp);
        wr.f(sl);
        wr.f(sr);
        wr.f(sg);
        wr.f(se);
    } else {
        for (var z = 0; z < 6; z = z + 1) { wr.w(0); }
    }
    return 0;
}

# Reads a particle into *p.
fn _im_snap_get_particle(rd: *ImSnapReader, p: *ImParticle) {
    p.handle = rd.w();
    var pos: ImVec3 = rd.v3();
    var vel: ImVec3 = rd.v3();
    p.position = pos;
    p.velocity = vel;
    p.lifetime = rd.f();
    p.radius = rd.f();
    p.drag = rd.f();
    p.restitution = rd.f();
    p.gravity_scale = rd.f();
    p.damping = rd.f();
    p.has_on_death_emit = rd.flag();
    var cnt = rd.w();
    var sp: f64 = rd.f();
    var sl: f64 = rd.f();
    var sr: f64 = rd.f();
    var sg: f64 = rd.f();
    var se: f64 = rd.f();
    var sub: ImSubEmitter = ImSubEmitter_new(cnt, sp, sl, sr, sg, se);
    p.on_death_emit = sub;
    return 0;
}

# Writes emitter e (18 words, its fields in order).
fn _im_snap_put_emitter(wr: *ImSnapWriter, e: *ImParticleEmitter) {
    var ra: f64 = e.rate;
    var lt: f64 = e.particle_lifetime;
    var rd2: f64 = e.particle_radius;
    var rs: f64 = e.particle_restitution;
    var gs: f64 = e.particle_gravity_scale;
    var dm: f64 = e.particle_damping;
    var ac: f64 = e.accumulator;
    wr.w(e.handle);
    wr.v3(e.position);
    wr.v3(e.velocity);
    wr.v3(e.velocity_spread);
    wr.f(ra);
    wr.f(lt);
    wr.f(rd2);
    wr.f(rs);
    wr.f(gs);
    wr.f(dm);
    wr.w(e.active);
    wr.f(ac);
    return 0;
}

# Reads an emitter into *e.
fn _im_snap_get_emitter(rd: *ImSnapReader, e: *ImParticleEmitter) {
    e.handle = rd.w();
    var pos: ImVec3 = rd.v3();
    var vel: ImVec3 = rd.v3();
    var spr: ImVec3 = rd.v3();
    e.position = pos;
    e.velocity = vel;
    e.velocity_spread = spr;
    e.rate = rd.f();
    e.particle_lifetime = rd.f();
    e.particle_radius = rd.f();
    e.particle_restitution = rd.f();
    e.particle_gravity_scale = rd.f();
    e.particle_damping = rd.f();
    e.active = rd.flag();
    e.accumulator = rd.f();
    return 0;
}

# Writes force field f: its kind, then the radial field's center, strength, falloff and radius, or the directional
# field's force, min and max. 1, or 0 for an unknown kind.
fn _im_snap_put_field(wr: *ImSnapWriter, f: *ImForceField): i64 {
    wr.w(f.kind);
    if (f.kind == IM_FORCE_FIELD_RADIAL) {
        var st: f64 = f.strength;
        var fo: f64 = f.falloff;
        var ra: f64 = f.radius;
        wr.v3(f.center);
        wr.f(st);
        wr.f(fo);
        wr.f(ra);
    } elif (f.kind == IM_FORCE_FIELD_DIRECTIONAL) {
        wr.v3(f.force);
        wr.v3(f.min);
        wr.v3(f.max);
    } else {
        return 0;
    }
    return 1;
}

# Reads a force field into *f: 1, or 0 for an unknown kind (the read is then bad).
fn _im_snap_get_field(rd: *ImSnapReader, f: *ImForceField): i64 {
    var k = rd.w();
    var g: ImForceField = ImForceField_radial(ImVec3_zero(), 0.0, 0.0, 0.0);
    if (k == IM_FORCE_FIELD_RADIAL) {
        var c: ImVec3 = rd.v3();
        var st: f64 = rd.f();
        var fo: f64 = rd.f();
        var ra: f64 = rd.f();
        g = ImForceField_radial(c, st, fo, ra);
    } elif (k == IM_FORCE_FIELD_DIRECTIONAL) {
        var fv: ImVec3 = rd.v3();
        var lo: ImVec3 = rd.v3();
        var hi: ImVec3 = rd.v3();
        g = ImForceField_directional(fv, lo, hi);
    } else {
        rd.bad = 1;
        return 0;
    }
    memcpy(f, &g, sizeof(ImForceField));
    return 1;
}

# ── the JSON form (ADR 0013) ────────────────────────────────────────────────────────
# serde's form for the snapshot: each record an object keyed by its field names, enums by variant name, an absent
# optional (and a -1 slot index) as null, the shared types through their serde-compatible codecs (src/json.cyr, ADR
# 0010). Floats are serde_json's shortest form; a non-finite one has no JSON form, so writing one fails. The field
# readers below take a struct node `o` in `form` and set *bad to 1 when the field is absent or malformed.

# An f64 field.
#must_use
fn _im_sr_f(o, form, i, name, bad): f64 {
    var w[8];
    var zero: f64 = 0.0;
    if (_im_jr_f64(_im_jr_at(o, form, i, name), &w) == 0) {
        store64(bad, 1);
        return zero;
    }
    var x: f64 = load64(&w);
    return x;
}

# An integer field in [lo, hi].
#must_use
fn _im_sr_int(o, form, i, name, lo, hi, bad): i64 {
    var w[8];
    if (_im_jr_int(_im_jr_at(o, form, i, name), lo, hi, &w) == 0) {
        store64(bad, 1);
        return 0;
    }
    return load64(&w);
}

# A handle (u64) field.
#must_use
fn _im_sr_u64(o, form, i, name, bad): i64 { return _im_sr_int(o, form, i, name, 0, 0x7FFFFFFFFFFFFFFF, bad); }

# A boolean field, as 0 or 1.
#must_use
fn _im_sr_bool(o, form, i, name, bad): i64 {
    var w[8];
    if (_im_jr_bool(_im_jr_at(o, form, i, name), &w) == 0) {
        store64(bad, 1);
        return 0;
    }
    return load64(&w);
}

# An [x, y] field.
#must_use
fn _im_sr_v2(o, form, i, name, bad): ImVec2 {
    var v: ImVec2 = ImVec2_new(0.0, 0.0);
    if (_im_jr_vec2(_im_jr_at(o, form, i, name), &v) == 0) { store64(bad, 1); }
    return v;
}

# An [x, y, z] field.
#must_use
fn _im_sr_v3(o, form, i, name, bad): ImVec3 {
    var v: ImVec3 = ImVec3_zero();
    if (_im_jr_vec3(_im_jr_at(o, form, i, name), &v) == 0) { store64(bad, 1); }
    return v;
}

# An optional f64 field (null or absent: none) into *has and the returned value (0.0 for none).
#must_use
fn _im_sr_opt_f(o, form, i, name, has, bad): f64 {
    var v = _im_jr_at(o, form, i, name);
    var zero: f64 = 0.0;
    store64(has, 0);
    if (v == 0 || _im_jr_is_null(v) == 1) { return zero; }
    store64(has, 1);
    return _im_sr_f(o, form, i, name, bad);
}

# A slot index or -1: null, or a non-negative integer.
#must_use
fn _im_sr_index(o, form, i, name, bad): i64 {
    var v = _im_jr_at(o, form, i, name);
    if (v != 0 && _im_jr_is_null(v) == 1) { return 0 - 1; }
    return _im_sr_int(o, form, i, name, 0, 0x7FFFFFFFFFFFFFFF, bad);
}

# The length of array node v, or -1 when v is not an array.
#must_use
fn _im_sr_len(v): i64 {
    if (v == 0 || bayan_json_v_tag(v) != JTAG_ARR) { return 0 - 1; }
    return bayan_json_v_arr_len(v);
}

# Appends the slot index x, or null for -1.
fn _im_sj_index(sb, x) {
    if (x < 0) { str_builder_add_cstr(sb, "null"); } else { str_builder_add_int(sb, x); }
    return 0;
}

# Appends an arena snapshot: {"slots":[{"occupied","generation","next_free"}…],"free_head","free_list_stale"}.
fn _im_sj_arena(sb, a: *ImArenaSnapshot) {
    str_builder_add_cstr(sb, "{\"slots\":[");
    for (var i = 0; i < a.slots.len; i = i + 1) {
        var s: *ImSlotSnapshot = a.slot(i);
        if (i > 0) { str_builder_putc(sb, 44); }
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "occupied", 1);
        _im_jw_bool(sb, s.occupied);
        _im_jw_key(sb, "generation", 0);
        str_builder_add_int(sb, s.generation);
        _im_jw_key(sb, "next_free", 0);
        _im_sj_index(sb, s.next_free);
        str_builder_putc(sb, 125);
    }
    str_builder_putc(sb, 93);
    _im_jw_key(sb, "free_head", 0);
    _im_sj_index(sb, a.free_head);
    _im_jw_key(sb, "free_list_stale", 0);
    _im_jw_bool(sb, a.free_list_stale);
    str_builder_putc(sb, 125);
    return 0;
}

# Reads an arena snapshot node into the empty *a: 1, or 0.
fn _im_sr_arena(o, a: *ImArenaSnapshot): i64 {
    var f = _im_jr_form(o, 3);
    if (f == 0) { return 0; }
    var bad[8];
    store64(&bad, 0);
    var sv = _im_jr_at(o, f, 0, "slots");
    var n = _im_sr_len(sv);
    if (n < 0 || a.slots.reserve(n) == 0) { return 0; }
    for (var i = 0; i < n; i = i + 1) {
        var so = bayan_json_v_arr_get(sv, i);
        var sf = _im_jr_form(so, 3);
        if (sf == 0) { return 0; }
        var s: *ImSlotSnapshot = _im_as_slot(a.slots.at(i));
        s.occupied = _im_sr_bool(so, sf, 0, "occupied", &bad);
        s.generation = _im_sr_int(so, sf, 1, "generation", 0, 0xFFFFFFFF, &bad);
        s.next_free = _im_sr_index(so, sf, 2, "next_free", &bad);
        a.slots.len = i + 1;
    }
    a.free_head = _im_sr_index(o, f, 1, "free_head", &bad);
    a.free_list_stale = _im_sr_bool(o, f, 2, "free_list_stale", &bad);
    if (load64(&bad) == 1) { return 0; }
    return 1;
}

# Appends a pair list: [[a,b],…].
fn _im_sj_pairs(sb, p: *ImPairList) {
    str_builder_putc(sb, 91);
    for (var i = 0; i < p.len; i = i + 1) {
        if (i > 0) { str_builder_putc(sb, 44); }
        str_builder_putc(sb, 91);
        _im_jw_u64(sb, p.first(i));
        str_builder_putc(sb, 44);
        _im_jw_u64(sb, p.second(i));
        str_builder_putc(sb, 93);
    }
    str_builder_putc(sb, 93);
    return 0;
}

# Reads a pair-list node into the empty *p: 1, or 0.
fn _im_sr_pairs(v, p: *ImPairList): i64 {
    var n = _im_sr_len(v);
    if (n < 0 || p.reserve(n) == 0) { return 0; }
    var w[16];
    for (var i = 0; i < n; i = i + 1) {
        var e = bayan_json_v_arr_get(v, i);
        if (_im_sr_len(e) != 2) { return 0; }
        if (_im_jr_u64(bayan_json_v_arr_get(e, 0), &w) == 0 || _im_jr_u64(bayan_json_v_arr_get(e, 1), &w + 8) == 0) {
            return 0;
        }
        p.push(load64(&w), load64(&w + 8));
    }
    return 1;
}

# Appends a tracker snapshot: {"prev","current","seen","recorded","events"}.
fn _im_sj_tracker(sb, t: *ImTrackerSnapshot) {
    str_builder_putc(sb, 123);
    _im_jw_key(sb, "prev", 1);
    _im_sj_pairs(sb, t.prev);
    _im_jw_key(sb, "current", 0);
    _im_sj_pairs(sb, t.current);
    _im_jw_key(sb, "seen", 0);
    _im_sj_pairs(sb, t.seen);
    _im_jw_key(sb, "recorded", 0);
    _im_jw_bool(sb, t.recorded);
    _im_jw_key(sb, "events", 0);
    str_builder_putc(sb, 91);
    for (var i = 0; i < t.events.len; i = i + 1) {
        if (i > 0) { str_builder_putc(sb, 44); }
        var e: *ImCollisionEvent = _im_as_event(t.events.at(i));
        e.to_json(sb);
    }
    str_builder_putc(sb, 93);
    str_builder_putc(sb, 125);
    return 0;
}

# Reads a tracker snapshot node into the empty *t: 1, or 0.
fn _im_sr_tracker(o, t: *ImTrackerSnapshot): i64 {
    var f = _im_jr_form(o, 5);
    if (f == 0) { return 0; }
    if (_im_sr_pairs(_im_jr_at(o, f, 0, "prev"), t.prev) == 0) { return 0; }
    if (_im_sr_pairs(_im_jr_at(o, f, 1, "current"), t.current) == 0) { return 0; }
    if (_im_sr_pairs(_im_jr_at(o, f, 2, "seen"), t.seen) == 0) { return 0; }
    var bad[8];
    store64(&bad, 0);
    t.recorded = _im_sr_bool(o, f, 3, "recorded", &bad);
    var ev = _im_jr_at(o, f, 4, "events");
    var n = _im_sr_len(ev);
    if (n < 0 || load64(&bad) == 1 || t.events.reserve(n) == 0) { return 0; }
    for (var i = 0; i < n; i = i + 1) {
        if (_im_jr_event(bayan_json_v_arr_get(ev, i), _im_as_event(t.events.at(i))) == 0) { return 0; }
        t.events.len = i + 1;
    }
    return 1;
}
