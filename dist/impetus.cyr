        _im_jw_key(sb, "point", 0);
        _im_jw_vec3(sb, self.point);
        _im_jw_key(sb, "normal", 0);
        _im_jw_vec3(sb, self.normal);
        _im_jw_key(sb, "distance", 0);
        im_fmt_f64_json(sb, dist);
