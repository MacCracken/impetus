impl ImRayHit {
    # Appends the hit as serde_json writes a `RayHit`.
    fn to_json(self, sb) {
        var dist: f64 = self.distance;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "collider", 1);
        _im_jw_u64(sb, self.collider);
        _im_jw_key(sb, "point", 0);
        _im_jw_vec3(sb, self.point);
        _im_jw_key(sb, "normal", 0);
        _im_jw_vec3(sb, self.normal);
        _im_jw_key(sb, "distance", 0);
        im_fmt_f64_json(sb, dist);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads a `RayHit` document (every field required) into *out: Ok(0), or Err(IM_ERR_DESERIALIZE).
# Mirrors `serde_json::from_str::<RayHit>`.
#must_use
fn ImRayHit_from_json(buf, len, out: *ImRayHit): Result {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 4);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var w[16];
    if (_im_jr_u64(_im_jr_at(o, f, 0, "collider"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var pt: ImVec3 = ImVec3_zero();
    var nm: ImVec3 = ImVec3_zero();
    if (_im_jr_vec3(_im_jr_at(o, f, 1, "point"), &pt) == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (_im_jr_vec3(_im_jr_at(o, f, 2, "normal"), &nm) == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (_im_jr_f64(_im_jr_at(o, f, 3, "distance"), &w + 8) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var dist: f64 = load64(&w + 8);
    var h: ImRayHit;
    h.collider = load64(&w);
    h.point = pt;
    h.normal = nm;
    h.distance = dist;
    memcpy(out, &h, sizeof(ImRayHit));
    return Ok(0);
}

impl ImPointQuery {
    # Appends the result as serde_json writes a `PointQuery`.
    fn to_json(self, sb) {
        var dist: f64 = self.distance;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "collider", 1);
        _im_jw_u64(sb, self.collider);
        _im_jw_key(sb, "distance", 0);
        im_fmt_f64_json(sb, dist);
        _im_jw_key(sb, "is_inside", 0);
        _im_jw_bool(sb, self.is_inside);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads a `PointQuery` document (every field required) into *out: Ok(0), or Err(IM_ERR_DESERIALIZE).
# Mirrors `serde_json::from_str::<PointQuery>`.
#must_use
fn ImPointQuery_from_json(buf, len, out: *ImPointQuery): Result {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 3);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var w[24];
    if (_im_jr_u64(_im_jr_at(o, f, 0, "collider"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (_im_jr_f64(_im_jr_at(o, f, 1, "distance"), &w + 8) == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (_im_jr_bool(_im_jr_at(o, f, 2, "is_inside"), &w + 16) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var dist: f64 = load64(&w + 8);
    var q: ImPointQuery;
    q.collider = load64(&w);
    q.distance = dist;
    q.is_inside = load64(&w + 16);
    memcpy(out, &q, sizeof(ImPointQuery));
    return Ok(0);
}

# ── Spring, Spring2d, Spring3d ──────────────────────────────────────────────────────

impl ImSpring {
    # Appends the spring as serde_json writes a `Spring` (the cache is `#[serde(skip)]`).
    fn to_json(self, sb) {
        var p: f64 = self.position;
        var v: f64 = self.velocity;
        var t: f64 = self.target;
        var k: f64 = self.stiffness;
        var c: f64 = self.damping;
        var s: f64 = self.settle_threshold;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "position", 1);
        im_fmt_f64_json(sb, p);
        _im_jw_key(sb, "velocity", 0);
        im_fmt_f64_json(sb, v);
        _im_jw_key(sb, "target", 0);
        im_fmt_f64_json(sb, t);
        _im_jw_key(sb, "stiffness", 0);
        im_fmt_f64_json(sb, k);
        _im_jw_key(sb, "damping", 0);
        im_fmt_f64_json(sb, c);
        _im_jw_key(sb, "settle_threshold", 0);
        im_fmt_f64_json(sb, s);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads the `Spring` node v (all six fields required; the cache starts empty) into *out: 1, or 0.
fn _im_jr_spring(v, out: *ImSpring): i64 {
    var f = _im_jr_form(v, 6);
    if (f == 0) { return 0; }
    var names[48];
    store64(&names, "position");
    store64(&names + 8, "velocity");
    store64(&names + 16, "target");
    store64(&names + 24, "stiffness");
    store64(&names + 32, "damping");
    store64(&names + 40, "settle_threshold");
    var w[48];
    if (_im_jr_f64_fields(v, f, &names, 6, &w) == 0) { return 0; }
    var p: f64 = load64(&w);
    var vel: f64 = load64(&w + 8);
    var t: f64 = load64(&w + 16);
    var k: f64 = load64(&w + 24);
    var c: f64 = load64(&w + 32);
    var s: f64 = load64(&w + 40);
    var sp: ImSpring = ImSpring_new(p, t, k, c);
    sp.velocity = vel;
    sp.settle_threshold = s;
    memcpy(out, &sp, sizeof(ImSpring));
    return 1;
}

# Reads a `Spring` document into *out: Ok(0), or Err(IM_ERR_DESERIALIZE). Mirrors
# `serde_json::from_str::<Spring>`.
#must_use
fn ImSpring_from_json(buf, len, out: *ImSpring): Result {
    return _im_jr_result(_im_jr_spring(_im_jr_parse(buf, len), out));
}

impl ImSpring2d {
    # Appends the spring as serde_json writes a `Spring2d`.
    fn to_json(self, sb) {
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "x", 1);
        self.x.to_json(sb);
        _im_jw_key(sb, "y", 0);
        self.y.to_json(sb);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads a `Spring2d` document (x and y required) into *out: Ok(0), or Err(IM_ERR_DESERIALIZE).
# Mirrors `serde_json::from_str::<Spring2d>`.
#must_use
fn ImSpring2d_from_json(buf, len, out: *ImSpring2d): Result {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 2);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var x: ImSpring = ImSpring_new(0.0, 0.0, 0.0, 0.0);
    var y: ImSpring = ImSpring_new(0.0, 0.0, 0.0, 0.0);
    if (_im_jr_spring(_im_jr_at(o, f, 0, "x"), &x) == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (_im_jr_spring(_im_jr_at(o, f, 1, "y"), &y) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var s: ImSpring2d;
    s.x = x;
    s.y = y;
    memcpy(out, &s, sizeof(ImSpring2d));
    return Ok(0);
}

impl ImSpring3d {
    # Appends the spring as serde_json writes a `Spring3d`.
    fn to_json(self, sb) {
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "x", 1);
        self.x.to_json(sb);
        _im_jw_key(sb, "y", 0);
        self.y.to_json(sb);
        _im_jw_key(sb, "z", 0);
        self.z.to_json(sb);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads a `Spring3d` document (x, y and z required) into *out: Ok(0), or Err(IM_ERR_DESERIALIZE).
# Mirrors `serde_json::from_str::<Spring3d>`.
#must_use
fn ImSpring3d_from_json(buf, len, out: *ImSpring3d): Result {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 3);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var x: ImSpring = ImSpring_new(0.0, 0.0, 0.0, 0.0);
    var y: ImSpring = ImSpring_new(0.0, 0.0, 0.0, 0.0);
    var z: ImSpring = ImSpring_new(0.0, 0.0, 0.0, 0.0);
    if (_im_jr_spring(_im_jr_at(o, f, 0, "x"), &x) == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (_im_jr_spring(_im_jr_at(o, f, 1, "y"), &y) == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (_im_jr_spring(_im_jr_at(o, f, 2, "z"), &z) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var s: ImSpring3d;
    s.x = x;
    s.y = y;
    s.z = z;
    memcpy(out, &s, sizeof(ImSpring3d));
    return Ok(0);
}
