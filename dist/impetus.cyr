# --- crmath.cyr ---

# crmath.cyr — correctly rounded exp, sin, cos and hypot (ADR 0011 and its hypot amendment; hypot
# has its own section at the end).
#
# Round-to-nearest-even of the exact mathematical value, on every input, the same bits on every
# target: only + − × ÷, the f64 rounding builtins and integer operations, no x87 and no polyfill.
# Each function follows Ziv's strategy, three phases, each result returned only when a rounding test,
# with an error bound a few bits wider than the evaluation's, shows that every value within the bound
# rounds to the same double:
# - phase 1, table-driven in double with a few exact products (2^(j/64) for exp, sin and cos of i/64),
#   bound 2^-62 (measured worst 2^-66 to 2^-67): decides about 99.7 % of arguments, at about 2× the
#   polyfills' cost;
# - phase 2, in double-double (about 2^-100 relative), bounds 2^-88 and 2^-74;
# - phase 3, the slow path in 364-bit fixed point (14 limbs of 28 bits), with Payne–Hanek reduction
#   for sin and cos against 1,568 bits of 2/π, whose result is rounded once.
# The slow path's error is below 2^-290 relative. A double argument is never that close to a
# rounding boundary of exp, sin or cos: the hardest cases are known to need about 2^-120
# (Lefèvre–Muller), and there are no exact midpoints (Lindemann–Weierstrass). Tables:
# src/crmath_data.cyr, generated by scripts/oracle/crtables.py.

# ── fixed point: 14 limbs of 28 bits, limb 0 the integer part ──────────────────────
# A number is a 112-byte buffer; limb j weighs 2^(-28j). Values here are non-negative and below 2^27.

const _IM_CR_L = 14;
const _IM_CR_MASK = 268435455;

# The word of an f64 (an untyped parameter, an i64 return).
#must_use
fn _im_cr_word(x): i64 {
    return x;
}

# The f64 whose bits are the word w.
#must_use
fn _im_cr_from_word(w): f64 {
    var b[8];
    store64(&b, w);
    var r: f64 = load64(&b);
    return r;
}

# Limb j of fixed-point number a.
#must_use
fn _im_cr_limb(a, j): i64 {
    return load64(a + j * 8);
}

# a = 0.
fn _im_cr_zero(a) {
    for (var j = 0; j < _IM_CR_L; j = j + 1) { store64(a + j * 8, 0); }
    return 0;
}

# 1 when a is 0.
#must_use
fn _im_cr_is_zero(a): i64 {
    for (var j = 0; j < _IM_CR_L; j = j + 1) {
        if (load64(a + j * 8) != 0) { return 0; }
    }
    return 1;
}

# −1, 0 or 1 as a < b, a = b, a > b.
#must_use
fn _im_cr_cmp(a, b): i64 {
    for (var j = 0; j < _IM_CR_L; j = j + 1) {
        var x = load64(a + j * 8);
        var y = load64(b + j * 8);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
    }
    return 0;
}

# d = a + b (d may be a or b).
fn _im_cr_add(d, a, b) {
    var carry = 0;
    var j = _IM_CR_L - 1;
    while (j >= 0) {
        var t = load64(a + j * 8) + load64(b + j * 8) + carry;
        if (j > 0) {
            store64(d + j * 8, t & _IM_CR_MASK);
            carry = t >> 28;
        } else {
            store64(d, t);
        }
        j = j - 1;
    }
    return 0;
}

# d = a − b, for a ≥ b (d may be a or b).
fn _im_cr_sub(d, a, b) {
    var borrow = 0;
    var j = _IM_CR_L - 1;
    while (j >= 0) {
        var t = load64(a + j * 8) - load64(b + j * 8) - borrow;
        borrow = 0;
        if (t < 0 && j > 0) {
            t = t + 268435456;
            borrow = 1;
        }
        store64(d + j * 8, t);
        j = j - 1;
    }
    return 0;
}

# d = a·b, truncated to 13 fraction limbs (d may be a or b). Column sums stay below 2^60.
fn _im_cr_mul(d, a, b) {
    var col[128];
    var n = _IM_CR_L + 2;
    for (var p = 0; p < n; p = p + 1) { store64(&col + p * 8, 0); }
    for (var i = 0; i < _IM_CR_L; i = i + 1) {
        var ai = load64(a + i * 8);
        if (ai != 0) {
            var k = 0;
            while (k < _IM_CR_L && i + k < n) {
                var at = &col + (i + k) * 8;
                store64(at, load64(at) + ai * load64(b + k * 8));
                k = k + 1;
            }
        }
    }
    var p2 = n - 1;
    while (p2 > 0) {
        var v = load64(&col + p2 * 8);
        store64(&col + (p2 - 1) * 8, load64(&col + (p2 - 1) * 8) + (v >> 28));
        store64(&col + p2 * 8, v & _IM_CR_MASK);
        p2 = p2 - 1;
    }
    for (var j = 0; j < _IM_CR_L; j = j + 1) { store64(d + j * 8, load64(&col + j * 8)); }
    return 0;
}

# d = a·s for a small integer 0 ≤ s < 2^28 (d may be a).
fn _im_cr_mul_small(d, a, s) {
    var carry = 0;
    var j = _IM_CR_L - 1;
    while (j >= 0) {
        var t = load64(a + j * 8) * s + carry;
        if (j > 0) {
            store64(d + j * 8, t & _IM_CR_MASK);
            carry = t >> 28;
        } else {
            store64(d, t);
        }
        j = j - 1;
    }
    return 0;
}

# d = a / s, truncated, for a small integer 0 < s < 2^28 (d may be a).
fn _im_cr_div_small(d, a, s) {
    var r = 0;
    for (var j = 0; j < _IM_CR_L; j = j + 1) {
        var cur = (r << 28) + load64(a + j * 8);
        store64(d + j * 8, cur / s);
        r = cur % s;
    }
    return 0;
}

# a = x, exactly, for 0 ≤ x < 2^27 whose lowest set bit is at or above 2^-364.
fn _im_cr_set(a, x: f64) {
    _im_cr_zero(a);
    var w = _im_cr_word(x);
    var ef = (w >> 52) & 2047;
    if (ef == 0) { return 0; }
    var m = (w & 4503599627370495) | 4503599627370496;
    var e = ef - 1075;
    for (var j = 0; j < _IM_CR_L; j = j + 1) {
        var s = e + 28 * j;
        var v = 0;
        if (s >= 0) {
            if (s < 28) { v = (m << s) & _IM_CR_MASK; }
        } elif (0 - s < 53) {
            v = (m >> (0 - s)) & _IM_CR_MASK;
        }
        store64(a + j * 8, v);
    }
    return 0;
}

# Bit q (the bit of weight 2^q, q ≤ 27) of a.
#must_use
fn _im_cr_bit(a, q): i64 {
    var j = (27 - q) / 28;
    if (j >= _IM_CR_L) { return 0; }
    return (load64(a + j * 8) >> (q + 28 * j)) & 1;
}

# 1 when a has a set bit of weight below 2^q.
#must_use
fn _im_cr_sticky(a, q): i64 {
    var j = (27 - q) / 28;
    if (j >= _IM_CR_L) { return 0; }
    var pos = q + 28 * j;
    if ((load64(a + j * 8) & ((1 << pos) - 1)) != 0) { return 1; }
    for (var i = j + 1; i < _IM_CR_L; i = i + 1) {
        if (load64(a + i * 8) != 0) { return 1; }
    }
    return 0;
}

# The double nearest a·2^k (ties to even), negated when neg is 1, for a > 0 whose integer part is
# below 2^28: normal, subnormal, or ±∞ on overflow.
#must_use
fn _im_cr_round(a, k, neg): f64 {
    var j0 = 0;
    while (j0 < _IM_CR_L && load64(a + j0 * 8) == 0) { j0 = j0 + 1; }
    var sign = 0;
    if (neg == 1) { sign = 0 - 9223372036854775807 - 1; }
    if (j0 == _IM_CR_L) { return _im_cr_from_word(sign); }
    var v = load64(a + j0 * 8);
    var b = 0;
    while ((v >> (b + 1)) != 0) { b = b + 1; }
    var top = b - 28 * j0;
    var ex = top + k;
    var p = 53;
    if (ex < 0 - 1022) { p = ex + 1075; }
    if (p < 0) { return _im_cr_from_word(sign); }
    var mant = 0;
    for (var i = 0; i < p; i = i + 1) { mant = (mant << 1) | _im_cr_bit(a, top - i); }
    var rb = _im_cr_bit(a, top - p);
    var st = _im_cr_sticky(a, top - p);
    if (rb == 1 && (st == 1 || (mant & 1) == 1)) { mant = mant + 1; }
    if (ex < 0 - 1022) {
        # Subnormal (or the carry into the smallest normal): the bits are the count of 2^-1074.
        return _im_cr_from_word(sign | mant);
    }
    if (mant == 9007199254740992) {
        mant = 4503599627370496;
        ex = ex + 1;
    }
    if (ex > 1023) { return _im_cr_from_word(sign | 9218868437227405312); }
    return _im_cr_from_word(sign | ((ex + 1023) << 52) | (mant - 4503599627370496));
}

# ── slow paths ──────────────────────────────────────────────────────────────────────

# exp(x), correctly rounded, in fixed point: x = k·ln 2 + r with 0 ≤ r < ln 2, exp(r) by its Taylor
# series, then 2^k. For finite x with 2^-55 ≤ |x| < 746.
#must_use
fn _im_cr_exp_slow(x: f64): f64 {
    _im_cr_load();
    var X[112];
    var A[112];
    var R[112];
    var T[112];
    var S[112];
    var ax: f64 = f64_abs(x);
    _im_cr_set(&X, ax);
    var q: f64 = x * _IM_CR_INVLN2;
    var kf: f64 = f64_floor(q);
    var k = f64_to(kf);
    var tries = 0;
    while (tries < 4) {
        var kk = k;
        if (kk < 0) { kk = 0 - kk; }
        _im_cr_mul_small(&A, &_im_cr_ln2, kk);
        var lo = 0;
        if (x >= 0.0) {
            if (_im_cr_cmp(&X, &A) < 0) { lo = 1; } else { _im_cr_sub(&R, &X, &A); }
        } else {
            if (_im_cr_cmp(&A, &X) < 0) { lo = 1; } else { _im_cr_sub(&R, &A, &X); }
        }
        if (lo == 1) {
            k = k - 1;
        } elif (_im_cr_cmp(&R, &_im_cr_ln2) >= 0) {
            k = k + 1;
        } else {
            tries = 4;
        }
        tries = tries + 1;
    }
    _im_cr_zero(&S);
    _im_cr_zero(&T);
    store64(&S, 1);
    store64(&T, 1);
    for (var n = 1; n < 200; n = n + 1) {
        _im_cr_mul(&T, &T, &R);
        _im_cr_div_small(&T, &T, n);
        if (_im_cr_is_zero(&T) == 1) { break; }
        _im_cr_add(&S, &S, &T);
    }
    return _im_cr_round(&S, k, 0);
}

# Y = (ax·2/π mod 1)·π/2 in fixed point, by Payne–Hanek, and the quadrant floor(ax·2/π) mod 4.
# ax = m·2^e: the 2/π bits that put multiples of 4 into ax·2/π are skipped, and the rest are taken
# in 28-bit chunks aligned so that m·2^d (2 ≤ d ≤ 29, three limbs) times them gives the product's
# limbs directly. For finite ax ≥ π/4.
fn _im_cr_reduce(Y, ax: f64): i64 {
    var w = _im_cr_word(ax);
    var ef = (w >> 52) & 2047;
    var m = (w & 4503599627370495) | 4503599627370496;
    var e = ef - 1075;
    var u = ((e - 2) % 28 + 28) % 28;
    var t = e - 2 - u;
    var d = e - t;
    var mk[24];
    store64(&mk, (m << d) & _IM_CR_MASK);
    if (d >= 28) {
        store64(&mk + 8, (m << (d - 28)) & _IM_CR_MASK);
    } else {
        store64(&mk + 8, (m >> (28 - d)) & _IM_CR_MASK);
    }
    store64(&mk + 16, (m >> (56 - d)) & _IM_CR_MASK);
    var base = t / 28;
    var ncol = _IM_CR_L + 2;
    var col[128];
    for (var f = 0; f < ncol; f = f + 1) {
        var sum = 0;
        for (var kk = 0; kk < 3; kk = kk + 1) {
            var jj = kk + f - 1;
            var idx = base + jj;
            if (jj >= 0 && idx >= 0 && idx < 56) {
                sum = sum + load64(&mk + kk * 8) * load64(&_im_cr_2opi + idx * 8);
            }
        }
        store64(&col + f * 8, sum);
    }
    var p = ncol - 1;
    while (p > 0) {
        var v = load64(&col + p * 8);
        store64(&col + (p - 1) * 8, load64(&col + (p - 1) * 8) + (v >> 28));
        store64(&col + p * 8, v & _IM_CR_MASK);
        p = p - 1;
    }
    var quad = load64(&col) & 3;
    store64(Y, 0);
    for (var j = 1; j < _IM_CR_L; j = j + 1) { store64(Y + j * 8, load64(&col + j * 8)); }
    _im_cr_mul(Y, Y, &_im_cr_pio2);
    return quad;
}

# D = sin(Y) (want_sin 1) or cos(Y) (0) for 0 ≤ Y < π/2, by the Taylor series with the positive and
# negative terms summed apart (both results are non-negative there).
fn _im_cr_sin_cos_series(D, Y, want_sin) {
    var Y2[112];
    var T[112];
    var P[112];
    var N[112];
    _im_cr_mul(&Y2, Y, Y);
    _im_cr_zero(&N);
    if (want_sin == 1) {
        memcpy(&T, Y, 112);
        memcpy(&P, Y, 112);
    } else {
        _im_cr_zero(&T);
        _im_cr_zero(&P);
        store64(&T, 1);
        store64(&P, 1);
    }
    for (var n = 1; n < 120; n = n + 1) {
        _im_cr_mul(&T, &T, &Y2);
        var dv = (2 * n) * (2 * n + 1);
        if (want_sin == 0) { dv = (2 * n - 1) * (2 * n); }
        _im_cr_div_small(&T, &T, dv);
        if (_im_cr_is_zero(&T) == 1) { break; }
        if ((n & 1) == 1) { _im_cr_add(&N, &N, &T); } else { _im_cr_add(&P, &P, &T); }
    }
    _im_cr_sub(D, &P, &N);
    return 0;
}

# sin(x) (want_sin 1) or cos(x) (0), correctly rounded, in fixed point, for finite |x| ≥ 2^-27.
#must_use
fn _im_cr_sin_cos_slow(x: f64, want_sin): f64 {
    _im_cr_load();
    var Y[112];
    var D[112];
    var ax: f64 = f64_abs(x);
    var quad = 0;
    if (ax < 0.78) {
        _im_cr_set(&Y, ax);
    } else {
        quad = _im_cr_reduce(&Y, ax);
    }
    # sin(y + qπ/2) is sin y, cos y, −sin y, −cos y; cos(y + qπ/2) is cos y, −sin y, −cos y, sin y.
    var use_sin = want_sin;
    if ((quad & 1) == 1) { use_sin = 1 - want_sin; }
    var neg = 0;
    if (want_sin == 1 && quad >= 2) { neg = 1; }
    if (want_sin == 0 && (quad == 1 || quad == 2)) { neg = 1; }
    if (want_sin == 1 && x < 0.0) { neg = 1 - neg; }
    _im_cr_sin_cos_series(&D, &Y, use_sin);
    return _im_cr_round(&D, 0, neg);
}

# ── double-double (as kimiya's src/mathx.cyr) ───────────────────────────────────────

# a + b = s + e exactly (Knuth's TwoSum).
#must_use
fn _im_cr_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var bb: f64 = s - a;
    var e: f64 = (a - (s - bb)) + (b - bb);
    return (s, e);
}

# a + b = s + e exactly, for |a| ≥ |b| or a = 0 (Dekker's FastTwoSum).
#must_use
fn _im_cr_fast_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var e: f64 = b - (s - a);
    return (s, e);
}

# a·b = p + e exactly (Dekker's TwoProduct, Veltkamp's 2^27 + 1 split), for |a|, |b| < 2^996 and no
# underflow in e.
#must_use
fn _im_cr_two_prod(a: f64, b: f64): (f64, f64) {
    var p: f64 = a * b;
    var split: f64 = 134217729.0;
    var ca: f64 = split * a;
    var ah: f64 = ca - (ca - a);
    var al: f64 = a - ah;
    var cb: f64 = split * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (al * bl) - (((p - (ah * bh)) - (al * bh)) - (ah * bl));
    return (p, e);
}

# (ah + al) + (bh + bl), renormalised.
#must_use
fn _im_cr_dd_add(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var s, e = _im_cr_two_sum(ah, bh);
    var t, f = _im_cr_two_sum(al, bl);
    var e1: f64 = e + t;
    var s1, e2 = _im_cr_fast_two_sum(s, e1);
    var e3: f64 = e2 + f;
    var s2, e4 = _im_cr_fast_two_sum(s1, e3);
    return (s2, e4);
}

# (ah + al)·(bh + bl), renormalised.
#must_use
fn _im_cr_dd_mul(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var p, e = _im_cr_two_prod(ah, bh);
    var cross: f64 = (ah * bl) + (al * bh);
    var e1: f64 = e + cross;
    var s, t = _im_cr_fast_two_sum(p, e1);
    return (s, t);
}

# (ah + al) / d for a double d ≠ 0.
#must_use
fn _im_cr_dd_div_d(ah: f64, al: f64, d: f64): (f64, f64) {
    var q1: f64 = ah / d;
    var p, e = _im_cr_two_prod(q1, d);
    var r: f64 = ((ah - p) - e) + al;
    var q2: f64 = r / d;
    var s, t = _im_cr_fast_two_sum(q1, q2);
    return (s, t);
}

# 1 when every value within err (≥ 0) of h + l rounds to h: h normal and not near overflow, and
# |l| + err below half the spacing next to h (a quarter of ulp(h) when h is a power of two, where the
# spacing below halves), with a 2^-20 margin for the rounding of the test itself.
#must_use
fn _im_cr_rounds_to(h: f64, l: f64, err: f64): i64 {
    var w = _im_cr_word(h) & 9223372036854775807;
    var ef = w >> 52;
    if (ef < 60 || ef > 2040) { return 0; }
    var half: f64 = _im_cr_from_word((ef - 53) << 52);
    if ((w & 4503599627370495) == 0) { half = half * 0.5; }
    var lim: f64 = half - half * 0.00000095367431640625;
    var al: f64 = f64_abs(l);
    var d: f64 = al + err;
    if (d < lim) { return 1; }
    return 0;
}

# 2^k for −1022 ≤ k ≤ 1023.
#must_use
fn _im_cr_pow2(k): f64 {
    return _im_cr_from_word((k + 1023) << 52);
}

# ── exp, sin, cos ───────────────────────────────────────────────────────────────────

# Calls that phase 1 could not decide, and slow-path calls, since start (diagnostics: the tests
# check that phase 1 decides almost every input).
var _im_cr_phase2_calls = 0;
var _im_cr_slow_calls = 0;

# Phase 1 of exp, for −708 ≤ x ≤ 709.7, into out: h, l (f64 words) and k, with exp(x) = 2^k·(h + l)
# within 2^-62 relative (the analysis gives about 2^-64.5).
# - n = round(x·64/ln 2), j = n mod 64, k = (n − j)/64; r = x − n·(ln 2/64) as rh + rl: n·hi is exact
#   (hi has 36 bits, |n| < 2^17) and so is x − n·hi (Sterbenz); rl from TwoSum, so r is within
#   2^-77 of exact (the hi + lo split of ln 2/64 times n).
# - exp(r) = 1 + r + r²·q(r), q = 1/2 + r/3! + … + r⁵/7! by Horner in double (|r| ≤ 2^-7.5:
#   truncation 2^-75; r²q within about 2^-67 absolute).
# - exp(x)/2^k = T·(1 + rh + rest), rest = r²q + rl, T = 2^(j/64) as hi + lo: T_hi·rh exactly by
#   TwoProduct (inline, Veltkamp's split), T_hi + its high part by FastTwoSum, everything else in a low
#   word whose roundings sum to about 2^-66.
fn _im_cr_exp_p1(x: f64, out) {
    _im_cr_load();
    var qf: f64 = x * _IM_CR_INV_L64;
    var nf: f64 = f64_round(qf);
    var n = f64_to(nf);
    var j = n & 63;
    var k = (n - j) / 64;
    var hn: f64 = nf * _IM_CR_L64_HI;
    var t: f64 = x - hn;
    var pn: f64 = nf * _IM_CR_L64_LO;
    var npn: f64 = -pn;
    # (rh, rl) = TwoSum(t, −n·lo).
    var rh: f64 = t + npn;
    var bb: f64 = rh - t;
    var rl: f64 = (t - (rh - bb)) + (npn - bb);
    var q: f64 = _IM_CR_F6 + rh * _IM_CR_F7;
    q = _IM_CR_F5 + rh * q;
    q = _IM_CR_F4 + rh * q;
    q = _IM_CR_F3 + rh * q;
    q = 0.5 + rh * q;
    var rr: f64 = rh * rh;
    var w: f64 = rr * q;
    var rest: f64 = w + rl;
    var th: f64 = load64(&_im_cr_exp2t + j * 16);
    var tlo: f64 = load64(&_im_cr_exp2t + j * 16 + 8);
    # (ah, al) = TwoProduct(th, rh).
    var ah: f64 = th * rh;
    var split: f64 = 134217729.0;
    var ca: f64 = split * th;
    var t1: f64 = ca - (ca - th);
    var t2: f64 = th - t1;
    var cb: f64 = split * rh;
    var r1: f64 = cb - (cb - rh);
    var r2: f64 = rh - r1;
    var al: f64 = (t2 * r2) - (((ah - (t1 * r1)) - (t2 * r1)) - (t1 * r2));
    # (s, e) = FastTwoSum(th, ah): |th| ≥ |ah|.
    var s: f64 = th + ah;
    var e: f64 = ah - (s - th);
    var low: f64 = ((e + al) + th * rest) + (tlo + tlo * rh);
    var h: f64 = s + low;
    var l: f64 = low - (h - s);
    store64(out, _im_cr_word(h));
    store64(out + 8, _im_cr_word(l));
    store64(out + 16, k);
    return 0;
}

# Phase 2 of exp, for −708 ≤ x ≤ 709.7, into out: h, l and k as phase 1, within 2^-88 relative:
# x = k·ln 2 + r (k·hi exact, r in double-double against a three-part ln 2), exp(r) by 27 Taylor
# terms in double-double.
fn _im_cr_exp_p2(x: f64, out) {
    var qf: f64 = x * _IM_CR_INVLN2;
    var kf: f64 = f64_round(qf);
    var k = f64_to(kf);
    var hk: f64 = kf * _IM_CR_LN2_HI;
    var t: f64 = x - hk;
    var ph, pl = _im_cr_two_prod(kf, _IM_CR_LN2_MID);
    var rh, rl = _im_cr_dd_add(t, 0.0, -ph, -pl);
    var lo: f64 = kf * _IM_CR_LN2_LO;
    var r2h, r2l = _im_cr_dd_add(rh, rl, -lo, 0.0);
    var sh: f64 = 1.0;
    var sl: f64 = 0.0;
    var th: f64 = 1.0;
    var tl: f64 = 0.0;
    for (var n = 1; n <= 27; n = n + 1) {
        var mh, ml = _im_cr_dd_mul(th, tl, r2h, r2l);
        var nf: f64 = f64_from(n);
        var qh, ql = _im_cr_dd_div_d(mh, ml, nf);
        th = qh;
        tl = ql;
        var ah, al = _im_cr_dd_add(sh, sl, th, tl);
        sh = ah;
        sl = al;
    }
    store64(out, _im_cr_word(sh));
    store64(out + 8, _im_cr_word(sl));
    store64(out + 16, k);
    return 0;
}

# h·2^k for a phase result h in [0.5, 2.1) whose product is a normal double (−1022 ≤ k ≤ 1024).
#must_use
fn _im_cr_scale(h: f64, k): f64 {
    if (k > 1000) {
        var big: f64 = h * _im_cr_pow2(1000);
        var bk: f64 = big * _im_cr_pow2(k - 1000);
        return bk;
    }
    var r: f64 = h * _im_cr_pow2(k);
    return r;
}

# exp(x), correctly rounded. NaN for NaN, +∞ for +∞ and x above the overflow point, +0 for −∞ and
# x below the underflow point, subnormal results rounded once. For −708 ≤ x ≤ 709.7: phase 1 (the
# 2^(j/64) table, error bound 2^-62), then phase 2 (double-double, 2^-88), each returned only when
# the rounding test decides it, with 2^k by exact scaling; then, or outside that range, the slow
# path.
#must_use
fn _im_cr_exp(x: f64): f64 {
    if (x != x) { return x; }
    if (x > 710.0) {
        var inf: f64 = _im_cr_from_word(9218868437227405312);
        return inf;
    }
    if (x < 0.0 - 746.0) { return 0.0; }
    var ax: f64 = f64_abs(x);
    if (ax < 0.0000000000000000277555756156289135105907917022705078125) { return 1.0; }
    if (x >= 0.0 - 708.0 && x <= 709.7) {
        var o[24];
        _im_cr_exp_p1(x, &o);
        var h1: f64 = load64(&o);
        var l1: f64 = load64(&o + 8);
        var e1: f64 = h1 * 0.00000000000000000021684043449710088680149056017398834228515625;
        if (_im_cr_rounds_to(h1, l1, e1) == 1) { return _im_cr_scale(h1, load64(&o + 16)); }
        _im_cr_phase2_calls = _im_cr_phase2_calls + 1;
        _im_cr_exp_p2(x, &o);
        var h2: f64 = load64(&o);
        var l2: f64 = load64(&o + 8);
        var e2: f64 = h2 * 0.0000000000000000000000000032311742677852643549664402;
        if (_im_cr_rounds_to(h2, l2, e2) == 1) { return _im_cr_scale(h2, load64(&o + 16)); }
    }
    _im_cr_slow_calls = _im_cr_slow_calls + 1;
    var rs: f64 = _im_cr_exp_slow(x);
    return rs;
}

# cos(r) (want_sin 0) or sin(r) (1) of a double-double |r| ≤ π/4 (+ a rounding), by 16 Taylor terms,
# the last below 2^-128 of the sum (as kimiya's _km_dd_cos_sin).
#must_use
fn _im_cr_dd_sin_cos(rh: f64, rl: f64, want_sin): (f64, f64) {
    var r2h, r2l = _im_cr_dd_mul(rh, rl, rh, rl);
    var th: f64 = 1.0;
    var tl: f64 = 0.0;
    var k = 0;
    if (want_sin == 1) {
        th = rh;
        tl = rl;
        k = 1;
    }
    var sh: f64 = th;
    var sl: f64 = tl;
    for (var n = 1; n <= 16; n = n + 1) {
        var mh, ml = _im_cr_dd_mul(th, tl, r2h, r2l);
        var d: f64 = f64_from((k + 1) * (k + 2));
        var qh, ql = _im_cr_dd_div_d(mh, ml, d);
        th = -qh;
        tl = -ql;
        var ah, al = _im_cr_dd_add(sh, sl, th, tl);
        sh = ah;
        sl = al;
        k = k + 2;
    }
    return (sh, sl);
}

# Phase 1 of sin and cos, for 2^-27 ≤ |x| ≤ 2^20, into out: sin x as hi, lo (words 0, 1) and cos x
# (words 2, 3), whichever `want` asks for (1 sin, 2 cos, 3 both), each within 2^-62 relative (the
# analysis gives about 2^-65). 0 when the reduction cancels below 2^-24 (k ≠ 0), else 1.
# - k = round(|x|·2/π), y = |x| − k·π/2 against c1 + c2 + c3 (c1, c2 of 33 bits, so k·c1 and k·c2 are
#   exact): |x| − k·c1 exactly (Sterbenz), the next by TwoSum, k·c3 rounded: y = yh + yl within 2^-96.
# - u = |y| = a + z + ul with a = i/64 (i = round(64u)), |z| ≤ 2^-7, z exact; the table holds sin a and
#   cos a as hi + lo. sin z = z + z³·p(z²) and cos z − 1 = −z²/2 + z⁴·p(z²) in double, z² by TwoProduct
#   so the −z²/2 term is exact; ul enters linearly.
# - sin u = S + C·z + [S·(cos z − 1) + C·(sin z − z + ul) + S_lo + C_lo·z], with C·z by TwoProduct and
#   S + C_hi·z by TwoSum; cos u likewise with −S·z. Every other term's rounding is below 2^-66 of the
#   result (the result is at least S/2, or z itself when i = 0).
fn _im_cr_sc_p1(x: f64, ax: f64, want, out): i64 {
    _im_cr_load();
    var qf: f64 = ax * _IM_CR_TWO_OVER_PI;
    var kf: f64 = f64_round(qf);
    var k = f64_to(kf);
    var uh: f64 = ax;
    var ul: f64 = 0.0;
    var sg = 1;
    if (k != 0) {
        var m1: f64 = kf * _IM_CR_PIO2_C1;
        var t1: f64 = ax - m1;
        var m2: f64 = kf * _IM_CR_PIO2_C2;
        var nm2: f64 = -m2;
        var t2: f64 = t1 + nm2;
        var bb: f64 = t2 - t1;
        var e2: f64 = (t1 - (t2 - bb)) + (nm2 - bb);
        var p3: f64 = kf * _IM_CR_PIO2_C3;
        var lo: f64 = e2 - p3;
        var yh: f64 = t2 + lo;
        var yl: f64 = lo - (yh - t2);
        var ay: f64 = f64_abs(yh);
        if (ay < 0.000000059604644775390625) { return 0; }
        uh = ay;
        ul = yl;
        if (yh < 0.0) {
            sg = 0 - 1;
            ul = -yl;
        }
    }
    var q = k & 3;
    var need_s = 0;
    var need_c = 0;
    if ((want & 1) == 1) {
        if ((q & 1) == 0) { need_s = 1; } else { need_c = 1; }
    }
    if ((want & 2) == 2) {
        if ((q & 1) == 0) { need_c = 1; } else { need_s = 1; }
    }
    var i64f: f64 = uh * 64.0;
    var ri: f64 = f64_round(i64f);
    var i = f64_to(ri);
    var a: f64 = ri * 0.015625;
    var z: f64 = uh - a;
    var shi: f64 = load64(&_im_cr_sct + i * 32);
    var slo: f64 = load64(&_im_cr_sct + i * 32 + 8);
    var chi: f64 = load64(&_im_cr_sct + i * 32 + 16);
    var clo: f64 = load64(&_im_cr_sct + i * 32 + 24);
    # (zh, zl) = TwoProduct(z, z).
    var split: f64 = 134217729.0;
    var zh: f64 = z * z;
    var cz: f64 = split * z;
    var z1: f64 = cz - (cz - z);
    var z2: f64 = z - z1;
    var zl: f64 = (z2 * z2) - (((zh - (z1 * z1)) - (z2 * z1)) - (z1 * z2));
    var clead: f64 = -0.5 * zh;
    var pc: f64 = _IM_CR_F4 - zh * _IM_CR_F6;
    var crest: f64 = (-0.5 * zl + (zh * zh) * pc) - ul * z;
    var ps: f64 = _IM_CR_F5 - zh * _IM_CR_F7;
    ps = zh * ps - _IM_CR_F3;
    var sz: f64 = (z * zh) * ps;
    var szl: f64 = sz + ul;
    var su_h: f64 = 0.0;
    var su_l: f64 = 0.0;
    var cu_h: f64 = 0.0;
    var cu_l: f64 = 0.0;
    var cs1: f64 = split * z;
    var zs1: f64 = cs1 - (cs1 - z);
    var zs2: f64 = z - zs1;
    if (need_s == 1) {
        # (mh, ml) = TwoProduct(C_hi, z); (s0, e0) = TwoSum(S_hi, mh).
        var mh: f64 = chi * z;
        var cc: f64 = split * chi;
        var c1: f64 = cc - (cc - chi);
        var c2: f64 = chi - c1;
        var ml: f64 = (c2 * zs2) - (((mh - (c1 * zs1)) - (c2 * zs1)) - (c1 * zs2));
        var s0: f64 = shi + mh;
        var b0: f64 = s0 - shi;
        var e0: f64 = (shi - (s0 - b0)) + (mh - b0);
        var low: f64 = (((e0 + ml) + shi * clead) + shi * crest) + ((chi * szl + slo) + clo * z);
        su_h = s0 + low;
        su_l = low - (su_h - s0);
    }
    if (need_c == 1) {
        # (nh, nl) = TwoProduct(S_hi, z); (c0, f0) = TwoSum(C_hi, −nh).
        var nh: f64 = shi * z;
        var sc: f64 = split * shi;
        var s1: f64 = sc - (sc - shi);
        var s2: f64 = shi - s1;
        var nl: f64 = (s2 * zs2) - (((nh - (s1 * zs1)) - (s2 * zs1)) - (s1 * zs2));
        var nnh: f64 = -nh;
        var c0: f64 = chi + nnh;
        var b1: f64 = c0 - chi;
        var f0: f64 = (chi - (c0 - b1)) + (nnh - b1);
        var lowc: f64 = (((f0 - nl) + chi * clead) + chi * crest) + ((clo - shi * szl) - slo * z);
        cu_h = c0 + lowc;
        cu_l = lowc - (cu_h - c0);
    }
    # y = sg·u: sin y = sg·sin u, cos y = cos u. Then by quadrant, then the sign of x for sin.
    if (sg < 0) {
        su_h = -su_h;
        su_l = -su_l;
    }
    var sxh: f64 = su_h;
    var sxl: f64 = su_l;
    var cxh: f64 = cu_h;
    var cxl: f64 = cu_l;
    if ((q & 1) == 1) {
        sxh = cu_h;
        sxl = cu_l;
        cxh = su_h;
        cxl = su_l;
    }
    if (q == 2 || q == 3) {
        sxh = -sxh;
        sxl = -sxl;
    }
    if (q == 1 || q == 2) {
        cxh = -cxh;
        cxl = -cxl;
    }
    if (x < 0.0) {
        sxh = -sxh;
        sxl = -sxl;
    }
    store64(out, _im_cr_word(sxh));
    store64(out + 8, _im_cr_word(sxl));
    store64(out + 16, _im_cr_word(cxh));
    store64(out + 24, _im_cr_word(cxl));
    return 1;
}

# Phase 2 of sin and cos, for 2^-27 ≤ |x| ≤ 2^20, into out: sin x as hi, lo (words 0, 1), cos x (2, 3)
# and their relative error bounds (4, 5), whichever `want` asks for. k = round(|x|·2/π), y = |x| − k·π/2
# in double-double against a four-part π/2 (k·p1 exact), the 16-term series of y in double-double:
# 2^-74 for sin y and 2^-88 for cos y, swapped with the quadrant. 0 when the reduction cancels below
# |y| = 2^-24 (k ≠ 0), else 1.
fn _im_cr_sc_p2(x: f64, ax: f64, want, out): i64 {
    var qf: f64 = ax * _IM_CR_TWO_OVER_PI;
    var kf: f64 = f64_round(qf);
    var k = f64_to(kf);
    var h1: f64 = kf * _IM_CR_PIO2_1;
    var t: f64 = ax - h1;
    var p2h, p2l = _im_cr_two_prod(kf, _IM_CR_PIO2_2);
    var ah, al = _im_cr_dd_add(t, 0.0, -p2h, -p2l);
    var p3h, p3l = _im_cr_two_prod(kf, _IM_CR_PIO2_3);
    var bh, bl = _im_cr_dd_add(ah, al, -p3h, -p3l);
    var p4: f64 = kf * _IM_CR_PIO2_4;
    var yh, yl = _im_cr_dd_add(bh, bl, -p4, 0.0);
    var ay: f64 = f64_abs(yh);
    # A reduction that cancels to |y| < 2^-24 loses the error bound; with k = 0 there is none (y = x).
    if (k != 0 && ay < 0.000000059604644775390625) { return 0; }
    var q = k & 3;
    # Series needed: sin y for an even quadrant's sin or an odd one's cos, cos y otherwise.
    var need_sn = 0;
    var need_cs = 0;
    if ((want & 1) == 1) {
        if ((q & 1) == 0) { need_sn = 1; } else { need_cs = 1; }
    }
    if ((want & 2) == 2) {
        if ((q & 1) == 0) { need_cs = 1; } else { need_sn = 1; }
    }
    var snh: f64 = 0.0;
    var snl: f64 = 0.0;
    var csh: f64 = 0.0;
    var csl: f64 = 0.0;
    if (need_sn == 1) {
        var a1, a2 = _im_cr_dd_sin_cos(yh, yl, 1);
        snh = a1;
        snl = a2;
    }
    if (need_cs == 1) {
        var b1, b2 = _im_cr_dd_sin_cos(yh, yl, 0);
        csh = b1;
        csl = b2;
    }
    # sin(y + qπ/2): sin y, cos y, −sin y, −cos y; cos(y + qπ/2): cos y, −sin y, −cos y, sin y.
    var s1h: f64 = snh;
    var s1l: f64 = snl;
    var es: f64 = 0.000000000000000000000052939559203393770;
    var c1h: f64 = csh;
    var c1l: f64 = csl;
    var ec: f64 = 0.0000000000000000000000000032311742677852643549664402;
    if (q == 1 || q == 3) {
        s1h = csh;
        s1l = csl;
        c1h = snh;
        c1l = snl;
        var tmp: f64 = es;
        es = ec;
        ec = tmp;
    }
    if (q == 2 || q == 3) {
        s1h = -s1h;
        s1l = -s1l;
    }
    if (q == 1 || q == 2) {
        c1h = -c1h;
        c1l = -c1l;
    }
    if (x < 0.0) {
        s1h = -s1h;
        s1l = -s1l;
    }
    store64(out, _im_cr_word(s1h));
    store64(out + 8, _im_cr_word(s1l));
    store64(out + 16, _im_cr_word(c1h));
    store64(out + 24, _im_cr_word(c1l));
    store64(out + 32, _im_cr_word(es));
    store64(out + 40, _im_cr_word(ec));
    return 1;
}

# (sin x, cos x), each correctly rounded. sin(±0) = ±0, cos(±0) = 1; NaN for NaN and ±∞. |x| < 2^-27:
# (x, 1) exactly. For |x| ≤ 2^20: phase 1 (the i/64 table, error bound 2^-62), then phase 2
# (double-double, 2^-74 for a sin y and 2^-88 for a cos y), each value returned only when the rounding
# test decides it; then, or for |x| > 2^20, the slow path.
#must_use
fn _im_cr_sin_cos(x: f64): (f64, f64) {
    var s, c = _im_cr_sc(x, 3);
    return (s, c);
}

# (sin x, cos x) as _im_cr_sin_cos, evaluating only what `want` asks for: 1 sin, 2 cos, 3 both (the
# other is returned as 0).
#must_use
fn _im_cr_sc(x: f64, want): (f64, f64) {
    if (x != x) { return (x, x); }
    var ax: f64 = f64_abs(x);
    var d0: f64 = x - x;
    if (d0 != 0.0) {
        var nan: f64 = d0 / d0;
        return (nan, nan);
    }
    if (ax < 0.000000007450580596923828125) { return (x, 1.0); }
    var sv: f64 = 0.0;
    var cv: f64 = 0.0;
    var wnt = want;
    if (ax <= 1048576.0) {
        var o[48];
        if (_im_cr_sc_p1(x, ax, wnt, &o) == 1) {
            if ((wnt & 1) == 1) {
                var h1: f64 = load64(&o);
                var a1: f64 = f64_abs(h1);
                var e1: f64 = a1 * 0.00000000000000000021684043449710088680149056017398834228515625;
                if (_im_cr_rounds_to(h1, load64(&o + 8), e1) == 1) {
                    sv = h1;
                    wnt = wnt - 1;
                }
            }
            if ((wnt & 2) == 2) {
                var h2: f64 = load64(&o + 16);
                var a2: f64 = f64_abs(h2);
                var e2: f64 = a2 * 0.00000000000000000021684043449710088680149056017398834228515625;
                if (_im_cr_rounds_to(h2, load64(&o + 24), e2) == 1) {
                    cv = h2;
                    wnt = wnt - 2;
                }
            }
            if (wnt == 0) { return (sv, cv); }
        }
        _im_cr_phase2_calls = _im_cr_phase2_calls + 1;
        if (_im_cr_sc_p2(x, ax, wnt, &o) == 1) {
            var es: f64 = load64(&o + 32);
            var ec: f64 = load64(&o + 40);
            if ((wnt & 1) == 1) {
                var h3: f64 = load64(&o);
                var a3: f64 = f64_abs(h3);
                var e3: f64 = a3 * es;
                if (_im_cr_rounds_to(h3, load64(&o + 8), e3) == 1) {
                    sv = h3;
                    wnt = wnt - 1;
                }
            }
            if ((wnt & 2) == 2) {
                var h4: f64 = load64(&o + 16);
                var a4: f64 = f64_abs(h4);
                var e4: f64 = a4 * ec;
                if (_im_cr_rounds_to(h4, load64(&o + 24), e4) == 1) {
                    cv = h4;
                    wnt = wnt - 2;
                }
            }
        }
    }
    if ((wnt & 1) == 1) {
        _im_cr_slow_calls = _im_cr_slow_calls + 1;
        sv = _im_cr_sin_cos_slow(x, 1);
    }
    if ((wnt & 2) == 2) {
        _im_cr_slow_calls = _im_cr_slow_calls + 1;
        cv = _im_cr_sin_cos_slow(x, 0);
    }
    return (sv, cv);
}

# sin(x), correctly rounded (see _im_cr_sin_cos).
#must_use
fn _im_cr_sin(x: f64): f64 {
    var s, c = _im_cr_sc(x, 1);
    var r: f64 = s;
    return r;
}

# cos(x), correctly rounded (see _im_cr_sin_cos).
#must_use
fn _im_cr_cos(x: f64): f64 {
    var s, c = _im_cr_sc(x, 2);
    var r: f64 = c;
    return r;
}

# ── hypot ───────────────────────────────────────────────────────────────────────────
# hypot(x, y) = √(x² + y²), correctly rounded (ADR 0011, amended for hypot). The operands are scaled by a
# power of two so the larger is in [1, 2); x² + y² is formed in double-double from exact products, its
# square root corrected once by the residual (relative error below 2^-100, tested against 2^-96), and
# the result scaled back exactly. Undecided cases, and results in the first normal binade or below
# (whose spacing is the subnormal grid's), take the slow path: x² + y² exactly in fixed point,
# compared with the exact squares of the midpoints next to the candidate. An exact midpoint can occur
# (a Pythagorean triple with a 54-bit odd hypotenuse) and rounds to even.

var _im_cr_hypot_slow_calls = 0;

# h·2^k, exact whenever the result is representable (subnormal included) and in up to three exact
# steps; ±∞ on overflow.
#must_use
fn _im_cr_ldexp(h: f64, k): f64 {
    var r: f64 = h;
    var j = k;
    while (j > 1000) {
        var up: f64 = _im_cr_pow2(1000);
        r = r * up;
        j = j - 1000;
    }
    while (j < 0 - 1000) {
        var down: f64 = _im_cr_pow2(0 - 1000);
        r = r * down;
        j = j + 1000;
    }
    var p: f64 = _im_cr_pow2(j);
    var out: f64 = r * p;
    return out;
}

# The doubles next above and below a positive finite double.
#must_use
fn _im_cr_next_up(x: f64): f64 { return _im_cr_from_word(_im_cr_word(x) + 1); }
#must_use
fn _im_cr_next_down(x: f64): f64 { return _im_cr_from_word(_im_cr_word(x) - 1); }

# The exact square of (c + g) into Q, for c ≥ 0, |g| ≤ c a power of two, sign gs (1 adds, -1
# subtracts), both with no set bit below 2^-60, using M and G as scratch.
fn _im_cr_sq_mid(Q, M, G, c: f64, g: f64, gs) {
    _im_cr_set(M, c);
    _im_cr_set(G, g);
    if (gs > 0) { _im_cr_add(M, M, G); } else { _im_cr_sub(M, M, G); }
    _im_cr_mul(Q, M, M);
    return 0;
}

# The slow path: a in [1, 2), b ≤ a (at least 2^-54), the result c·2^k for the candidate c0 within an
# ulp. The grid is the doubles' near c0, or, when c0·2^k is in the first normal binade or below, the
# multiples of 2^(-1074-k).
#must_use
fn _im_cr_hypot_slow(a: f64, b: f64, k, c0: f64): f64 {
    _im_cr_hypot_slow_calls = _im_cr_hypot_slow_calls + 1;
    var A[112];
    var B[112];
    var S[112];
    var Q[112];
    var M[112];
    var G[112];
    _im_cr_set(&A, a);
    _im_cr_set(&B, b);
    _im_cr_mul(&S, &A, &A);
    _im_cr_mul(&Q, &B, &B);
    _im_cr_add(&S, &S, &Q);
    var c: f64 = c0;
    var sub = 0;
    var u: f64 = 0.0;
    var ce = (_im_cr_word(c) >> 52) - 1023;
    if (ce + k <= 0 - 1022) {
        sub = 1;
        u = _im_cr_pow2(0 - 1074 - k);
        var q: f64 = c / u + 0.5;
        var n: f64 = f64_floor(q);
        c = n * u;
    }
    var done = 0;
    var it = 0;
    while (done == 0 && it < 8) {
        it = it + 1;
        var lo: f64 = 0.0;
        var hi: f64 = 0.0;
        if (sub == 1) {
            lo = c - u;
            hi = c + u;
        } else {
            lo = _im_cr_next_down(c);
            hi = _im_cr_next_up(c);
        }
        var gl: f64 = (c - lo) * 0.5;
        var gh: f64 = (hi - c) * 0.5;
        _im_cr_sq_mid(&Q, &M, &G, c, gl, 0 - 1);
        var cl = _im_cr_cmp(&S, &Q);
        if (cl < 0) {
            c = lo;
        } else {
            _im_cr_sq_mid(&Q, &M, &G, c, gh, 1);
            var chi = _im_cr_cmp(&S, &Q);
            if (chi > 0) {
                c = hi;
            } else {
                # Inside [lower midpoint, upper midpoint]: c, unless exactly on a midpoint (ties to even).
                var odd = _im_cr_word(c) & 1;
                if (sub == 1) {
                    var nc: f64 = c / u;
                    odd = f64_to(nc) & 1;
                }
                if (odd == 1) {
                    if (chi == 0) { c = hi; } elif (cl == 0) { c = lo; }
                }
                done = 1;
            }
        }
    }
    return _im_cr_ldexp(c, k);
}

# hypot(x, y), correctly rounded: +∞ when either is infinite (even with a NaN), NaN when either is NaN,
# |x| when y is 0, +∞ on overflow, subnormal results rounded once. Mirrors `f64::hypot` with the
# exact result in place of libm's.
#must_use
fn _im_cr_hypot(x: f64, y: f64): f64 {
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    var inf: f64 = _im_cr_from_word(9218868437227405312);
    if (ax == inf || ay == inf) { return inf; }
    if (ax != ax || ay != ay) {
        var nan: f64 = x + y;
        return nan;
    }
    var a: f64 = ax;
    var b: f64 = ay;
    if (b > a) {
        a = ay;
        b = ax;
    }
    if (b == 0.0) { return a; }
    var top: f64 = a;
    var k = 0;
    var ef = _im_cr_word(a) >> 52;
    if (ef == 0) {
        var up: f64 = _im_cr_pow2(64);
        a = a * up;
        b = b * up;
        k = 0 - 64;
        ef = _im_cr_word(a) >> 52;
    }
    var e = ef - 1023;
    var sa: f64 = _im_cr_ldexp(a, 0 - e);
    var sb: f64 = _im_cr_ldexp(b, 0 - e);
    k = k + e;
    # b/a below 2^-54: the true value exceeds a by under 2^-109 of it, so it rounds to a.
    var tiny: f64 = _im_cr_pow2(0 - 54);
    if (sb < tiny) { return top; }
    var ph, pl = _im_cr_two_prod(sa, sa);
    var qh, ql = _im_cr_two_prod(sb, sb);
    var sh, sl = _im_cr_dd_add(ph, pl, qh, ql);
    var s_hi: f64 = sh;
    var s_lo: f64 = sl;
    var r: f64 = f64_sqrt(s_hi);
    var rh, rl = _im_cr_two_prod(r, r);
    var rhf: f64 = rh;
    var rlf: f64 = rl;
    var d1: f64 = s_hi - rhf;
    var e1: f64 = d1 - rlf;
    var e2: f64 = e1 + s_lo;
    var two_r: f64 = 2.0 * r;
    var corr: f64 = e2 / two_r;
    var h, l = _im_cr_fast_two_sum(r, corr);
    var hf: f64 = h;
    var lf: f64 = l;
    var bound: f64 = _im_cr_pow2(0 - 96);
    var err: f64 = hf * bound;
    var he = (_im_cr_word(hf) >> 52) - 1023;
    if (he + k > 0 - 1022 && _im_cr_rounds_to(hf, lf, err) == 1) {
        return _im_cr_ldexp(hf, k);
    }
    return _im_cr_hypot_slow(sa, sb, k, hf);
}

# --- mathx.cyr ---

# mathx.cyr — impetus's math helpers: Rust std semantics on top of the Cyrius builtins.
#
# Port plan §7.1; port-parity.md §1–§2. Each helper mirrors one std f64 method as rustc 1.99.1
# compiles it, and is pinned by tests/golden/math.tsv:
# - min / max / clamp ignore a NaN operand as Rust does (the stdlib f64_min / f64_max return the
#   second operand when the first is NaN, and NaN when the second is);
# - the predicates have no public stdlib counterpart;
# - to_radians and the literal-exponent powi are Rust's exact operation order;
# - exp, sin and cos are correctly rounded (src/crmath.cyr, ADR 0011), the same bits on every target;
# - atan2 is ganita's on the atan polyfill, the same bits on every target (the native f64_atan is
#   x87 on x86_64); hypot is ganita's. Both are within K = 2 ulp of glibc (port-parity.md §2).

# π/180 as Rust folds `consts::PI / 180.0`: the double nearest, pinned by the to_radians rows.
var _IM_RADS_PER_DEG: f64 = 0.017453292519943295;

# The bits of an f64 as an integer word: an untyped parameter, an i64 return.
#must_use
fn _im_bits(x): i64 {
    return x;
}

# 1 when x is NaN. Mirrors `f64::is_nan`.
#must_use
fn _im_is_nan(x: f64): i64 {
    if (x != x) { return 1; }
    return 0;
}

# 1 when x is neither infinite nor NaN (x − x is 0 only then). Mirrors `f64::is_finite`.
#must_use
fn _im_is_finite(x: f64): i64 {
    var d: f64 = x - x;
    if (d == 0.0) { return 1; }
    return 0;
}

# The smaller of x and y, ignoring a NaN operand (NaN only when both are). Equal operands, +0 and
# −0 included, give y, as rustc 1.99.1's `x.min(y)` does (minsd). Mirrors `f64::min`.
#must_use
fn _im_min(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x < y) { return x; }
    return y;
}

# The larger of x and y, ignoring a NaN operand (NaN only when both are). Equal operands give y
# (maxsd). Mirrors `f64::max`.
#must_use
fn _im_max(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x > y) { return x; }
    return y;
}

# x restricted to [lo, hi]: lo when x < lo, hi when x > hi, else x (a NaN x stays NaN). Rust
# panics on lo > hi or a NaN bound; every caller passes valid bounds. Mirrors `f64::clamp`.
#must_use
fn _im_clamp(x: f64, lo: f64, hi: f64): f64 {
    var r: f64 = x;
    if (r < lo) { r = lo; }
    if (r > hi) { r = hi; }
    return r;
}

# Degrees to radians: one multiply by the folded π/180. Mirrors `f64::to_radians`.
#must_use
fn _im_to_radians(x: f64): f64 {
    var r: f64 = x * _IM_RADS_PER_DEG;
    return r;
}

# x², as LLVM expands a literal `x.powi(2)`.
#must_use
fn _im_powi2(x: f64): f64 {
    var r: f64 = x * x;
    return r;
}

# x³, as LLVM expands a literal `x.powi(3)`: (x·x)·x.
#must_use
fn _im_powi3(x: f64): f64 {
    var sq: f64 = x * x;
    var r: f64 = sq * x;
    return r;
}

# e^x, correctly rounded (src/crmath.cyr). Stands for `f64::exp`.
#must_use
fn _im_exp(x: f64): f64 {
    var r: f64 = _im_cr_exp(x);
    return r;
}

# √(x² + y²), correctly rounded (src/crmath.cyr, ADR 0011 as amended). Stands for `f64::hypot`.
#must_use
fn _im_hypot(x: f64, y: f64): f64 {
    var r: f64 = _im_cr_hypot(x, y);
    return r;
}

# (sin x, cos x), each correctly rounded (src/crmath.cyr). Stands for `f64::sin_cos`, which is
# Rust's (x.sin(), x.cos()). Read as `var s, c = _im_sin_cos(x);` and bind each to an f64 local.
#must_use
fn _im_sin_cos(x: f64) {
    var s, c = _im_cr_sin_cos(x);
    var sv: f64 = s;
    var cv: f64 = c;
    return (sv, cv);
}

# sin x, correctly rounded. Stands for `f64::sin`.
#must_use
fn _im_sin(x: f64): f64 {
    var r: f64 = _im_cr_sin(x);
    return r;
}

# cos x, correctly rounded. Stands for `f64::cos`.
#must_use
fn _im_cos(x: f64): f64 {
    var r: f64 = _im_cr_cos(x);
    return r;
}

# The angle of (x, y) in [−π, π]: ganita_f64_atan2 (1.2.15) with `_f64_atan_polyfill` in place of
# the `f64_atan` builtin, so the same bits on every target (port-parity.md §2). The whole C99
# Annex F table, signs of zero included, as ganita. Words in, word out. Stands for `y.atan2(x)`.
#must_use
fn _im_atan2(y, x): i64 {
    var ay = y & 0x7FFFFFFFFFFFFFFF;
    var ax = x & 0x7FFFFFFFFFFFFFFF;
    if (ay > 0x7FF0000000000000) { return y; }
    if (ax > 0x7FF0000000000000) { return x; }
    var ysign = y & 0x8000000000000000;
    var xneg = (x >> 63) & 1;
    if (ay == 0) {
        if (xneg == 1) { return F64_PI | ysign; }
        return y;
    }
    if (ax == 0) { return F64_PI_2 | ysign; }
    if ((ay == 0x7FF0000000000000) && (ax == 0x7FF0000000000000)) {
        if (xneg == 1) { return _F64_3PI_4 | ysign; }
        return F64_PI_4 | ysign;
    }
    var q = _f64_atan_polyfill(f64_div(y, x));
    if (xneg == 0) { return q; }
    if (ysign != 0) { return f64_sub(q, F64_PI); }
    return f64_add(q, F64_PI);
}

# --- fmtf.cyr ---

# fmtf.cyr — f64 to text: the shortest round-trip digits, in Rust's Display and serde_json's forms.
#
# ADR 0010. Both Rust printers impetus's documents come from print the SHORTEST digits that parse back
# to the same double, choosing the closest to the exact value among them: Rust's `Display` (core's
# Grisu with a Dragon fallback) and serde_json 1.0.154's zmij (Schubfach). They differ only on an
# exact tie between two closest candidates: core rounds it up, zmij to the even digit. The stdlib has no such
# printer yet (port plan §8, S2), so this file computes the digits with Burger & Dybvig's free-format
# algorithm ("Printing Floating-Point Numbers Quickly and Accurately", 1996) on a small bignum: exact,
# with no tables. Printing is never on the step path, so its speed is secondary. tests/golden/fmtf.tsv
# pins both forms against Rust over every binade, the powers of ten and a seeded sweep.
#
# Forms:
# - `im_fmt_f64_display`: Rust's `{}` — always positional, no ".0" (`100`, `0.1`, `-0`), `NaN`, `inf`,
#   `-inf`.
# - `im_fmt_f64_json`: serde_json — positional while the decimal exponent is in −5..=15, with ".0" on an
#   integer (`100.0`, `0.00001`); otherwise `d.ddde±x` (`1e+16`, `1.5e-7`); `null` for NaN and ±∞.

include "lib/str.cyr"

# ── bignum ──────────────────────────────────────────────────────────────────────────
# A non-negative integer in 32-bit limbs, little-endian: word 0 the limb count, words 1..40 the limbs.
# 40 limbs hold 2^1280; the algorithm's values stay below 2^1140. No leading zero limbs.
var _IM_BN_WORDS = 41;

# a := v, for 0 <= v < 2^63.
fn _im_bn_set(a, v) {
    var n = 0;
    var x = v;
    while (x != 0) {
        store64(a + 8 + n * 8, x & 0xFFFFFFFF);
        x = x >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# dst := src.
fn _im_bn_copy(dst, src) {
    var n = load64(src);
    for (var i = 0; i <= n; i = i + 1) { store64(dst + i * 8, load64(src + i * 8)); }
    return 0;
}

# a := a × m, for 0 < m < 2^31.
fn _im_bn_mul_small(a, m) {
    var n = load64(a);
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var t = load64(a + 8 + i * 8) * m + carry;
        store64(a + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    while (carry != 0) {
        store64(a + 8 + n * 8, carry & 0xFFFFFFFF);
        carry = carry >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# a := a × 10^k, for k >= 0 (in steps of 10^9).
fn _im_bn_mul_pow10(a, k) {
    var left = k;
    while (left >= 9) {
        _im_bn_mul_small(a, 1000000000);
        left = left - 9;
    }
    var m = 1;
    for (var i = 0; i < left; i = i + 1) { m = m * 10; }
    if (m > 1) { _im_bn_mul_small(a, m); }
    return 0;
}

# a := a × 2^k, for k >= 0.
fn _im_bn_shl(a, k) {
    var n = load64(a);
    if (n == 0) { return 0; }
    var q = k / 32;
    var b = k % 32;
    if (b != 0) {
        var carry = 0;
        for (var i = 0; i < n; i = i + 1) {
            var t = (load64(a + 8 + i * 8) << b) | carry;
            store64(a + 8 + i * 8, t & 0xFFFFFFFF);
            carry = t >> 32;
        }
        if (carry != 0) {
            store64(a + 8 + n * 8, carry);
            n = n + 1;
        }
    }
    if (q > 0) {
        var i = n - 1;
        while (i >= 0) {
            store64(a + 8 + (i + q) * 8, load64(a + 8 + i * 8));
            i = i - 1;
        }
        for (var j = 0; j < q; j = j + 1) { store64(a + 8 + j * 8, 0); }
        n = n + q;
    }
    store64(a, n);
    return 0;
}

# dst := a + b (dst distinct from both).
fn _im_bn_sum(dst, a, b) {
    var na = load64(a);
    var nb = load64(b);
    var n = na;
    if (nb > n) { n = nb; }
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x = 0;
        var y = 0;
        if (i < na) { x = load64(a + 8 + i * 8); }
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = x + y + carry;
        store64(dst + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    if (carry != 0) {
        store64(dst + 8 + n * 8, carry);
        n = n + 1;
    }
    store64(dst, n);
    return 0;
}

# -1, 0 or 1 as a < b, a = b, a > b.
#must_use
fn _im_bn_cmp(a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    if (na != nb) {
        if (na < nb) { return 0 - 1; }
        return 1;
    }
    var i = na - 1;
    while (i >= 0) {
        var x = load64(a + 8 + i * 8);
        var y = load64(b + 8 + i * 8);
        if (x != y) {
            if (x < y) { return 0 - 1; }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

# a := a − b, for a >= b.
fn _im_bn_sub(a, b) {
    var na = load64(a);
    var nb = load64(b);
    var borrow = 0;
    for (var i = 0; i < na; i = i + 1) {
        var y = 0;
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = load64(a + 8 + i * 8) - y - borrow;
        borrow = 0;
        if (t < 0) {
            t = t + 0x100000000;
            borrow = 1;
        }
        store64(a + 8 + i * 8, t);
    }
    while (na > 0 && load64(a + na * 8) == 0) { na = na - 1; }
    store64(a, na);
    return 0;
}

# The number of bits in x > 0.
#must_use
fn _im_bitlen(x): i64 {
    var n = 0;
    var v = x;
    while (v != 0) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

# ── shortest digits (Burger & Dybvig, free format) ──────────────────────────────────

# The shortest decimal digits of the positive finite double with bits `bits` that read back to it,
# the closest to its exact value among them: writes the ASCII digits to `digits` (17 bytes is
# enough) and returns (n, k) with value = 0.d1d2…dn × 10^k. When the exact value lies exactly
# halfway between the two closest candidates, `tie_even` 0 takes the upper one (Rust's core
# printer: 2^-25 is 2.9802322387695313e-8) and 1 the even one (serde_json's zmij: …5312e-8).
fn _im_shortest(bits, digits, tie_even) {
    var be = (bits >> 52) & 0x7FF;
    var f = bits & 0xFFFFFFFFFFFFF;
    var e = 0 - 1074;
    if (be != 0) {
        f = f | 0x10000000000000;
        e = be - 1075;
    }
    # IEEE round-half-even on reading: the interval's ends belong to it when f is even.
    var even = 1 - (f & 1);
    var r[328];
    var s[328];
    var mp[328];
    var mm[328];
    var t[328];
    if (e >= 0) {
        if (f != 0x10000000000000) {
            _im_bn_set(&r, f);
            _im_bn_shl(&r, e + 1);
            _im_bn_set(&s, 2);
            _im_bn_set(&mp, 1);
            _im_bn_shl(&mp, e);
            _im_bn_copy(&mm, &mp);
        } else {
            _im_bn_set(&r, f);
            _im_bn_shl(&r, e + 2);
            _im_bn_set(&s, 4);
            _im_bn_set(&mp, 1);
            _im_bn_shl(&mp, e + 1);
            _im_bn_set(&mm, 1);
            _im_bn_shl(&mm, e);
        }
    } else {
        if (e == 0 - 1074 || f != 0x10000000000000) {
            _im_bn_set(&r, f);
            _im_bn_shl(&r, 1);
            _im_bn_set(&s, 1);
            _im_bn_shl(&s, 1 - e);
            _im_bn_set(&mp, 1);
            _im_bn_set(&mm, 1);
        } else {
            _im_bn_set(&r, f);
            _im_bn_shl(&r, 2);
            _im_bn_set(&s, 1);
            _im_bn_shl(&s, 2 - e);
            _im_bn_set(&mp, 2);
            _im_bn_set(&mm, 1);
        }
    }
    # k = ⌈log10(v) − 1e-10⌉ from the binary exponent: never too large, at most one too small
    # (the fixup below adds the one).
    var lg: f64 = f64_from(e + _im_bitlen(f) - 1);
    var est: f64 = lg * 0.30102999566398114 - 0.0000000001;
    var k = f64_to(f64_ceil(est));
    if (k >= 0) {
        _im_bn_mul_pow10(&s, k);
    } else {
        _im_bn_mul_pow10(&r, 0 - k);
        _im_bn_mul_pow10(&mp, 0 - k);
        _im_bn_mul_pow10(&mm, 0 - k);
    }
    _im_bn_sum(&t, &r, &mp);
    var c = _im_bn_cmp(&t, &s);
    if ((even == 1 && c >= 0) || (even == 0 && c > 0)) {
        _im_bn_mul_small(&s, 10);
        k = k + 1;
    }
    var n = 0;
    while (1) {
        _im_bn_mul_small(&r, 10);
        _im_bn_mul_small(&mp, 10);
        _im_bn_mul_small(&mm, 10);
        var d = 0;
        while (_im_bn_cmp(&r, &s) >= 0) {
            _im_bn_sub(&r, &s);
            d = d + 1;
        }
        var lo = _im_bn_cmp(&r, &mm);
        var tc1 = 0;
        if (lo < 0 || (even == 1 && lo == 0)) { tc1 = 1; }
        _im_bn_sum(&t, &r, &mp);
        var hi = _im_bn_cmp(&t, &s);
        var tc2 = 0;
        if (hi > 0 || (even == 1 && hi == 0)) { tc2 = 1; }
        if (tc1 == 0 && tc2 == 0) {
            store8(digits + n, 48 + d);
            n = n + 1;
        } else {
            if (tc1 == 1 && tc2 == 1) {
                # Both neighbours read back: the closer one, 2r against s; a tie per `tie_even`.
                _im_bn_copy(&t, &r);
                _im_bn_shl(&t, 1);
                var half = _im_bn_cmp(&t, &s);
                if (half > 0) { d = d + 1; }
                if (half == 0 && (tie_even == 0 || (d & 1) == 1)) { d = d + 1; }
            } elif (tc2 == 1) {
                d = d + 1;
            }
            store8(digits + n, 48 + d);
            n = n + 1;
            return (n, k);
        }
    }
    return (n, k);
}

# ── formatting ──────────────────────────────────────────────────────────────────────

# Appends `count` copies of byte c.
fn _im_sb_repeat(sb, c, count) {
    for (var i = 0; i < count; i = i + 1) { str_builder_putc(sb, c); }
    return 0;
}

# Appends digits [from, to) of `digits`.
fn _im_sb_digits(sb, digits, from, to) {
    for (var i = from; i < to; i = i + 1) { str_builder_putc(sb, load8(digits + i)); }
    return 0;
}

# Appends 0.d1…dn × 10^k positionally: "123.45", "0.00012", "12300". With `int_suffix` 1, an integer
# gets ".0" (serde_json's form).
fn _im_sb_positional(sb, digits, n, k, int_suffix) {
    if (k <= 0) {
        str_builder_putc(sb, 48);
        str_builder_putc(sb, 46);
        _im_sb_repeat(sb, 48, 0 - k);
        _im_sb_digits(sb, digits, 0, n);
        return 0;
    }
    if (k >= n) {
        _im_sb_digits(sb, digits, 0, n);
        _im_sb_repeat(sb, 48, k - n);
        if (int_suffix == 1) {
            str_builder_putc(sb, 46);
            str_builder_putc(sb, 48);
        }
        return 0;
    }
    _im_sb_digits(sb, digits, 0, k);
    str_builder_putc(sb, 46);
    _im_sb_digits(sb, digits, k, n);
    return 0;
}

# Appends x as Rust's `Display` (`{}`) writes an f64. Mirrors `<f64 as Display>::fmt`.
fn im_fmt_f64_display(sb, x: f64) {
    var bits = _im_bits(x);
    if (x != x) {
        str_builder_add_cstr(sb, "NaN");
        return 0;
    }
    if (bits < 0) { str_builder_putc(sb, 45); }
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag == 0x7FF0000000000000) {
        str_builder_add_cstr(sb, "inf");
        return 0;
    }
    if (mag == 0) {
        str_builder_putc(sb, 48);
        return 0;
    }
    var digits[24];
    var n, k = _im_shortest(mag, &digits, 0);
    _im_sb_positional(sb, &digits, n, k, 0);
    return 0;
}

# Appends x as serde_json 1.0.154 writes an f64 (zmij's format). Mirrors `serde_json::to_string(&x)`.
fn im_fmt_f64_json(sb, x: f64) {
    var bits = _im_bits(x);
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag >= 0x7FF0000000000000) {
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    if (bits < 0) { str_builder_putc(sb, 45); }
    if (mag == 0) {
        str_builder_add_cstr(sb, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _im_shortest(mag, &digits, 1);
    var ex = k - 1;
    if (ex >= 0 - 5 && ex <= 15) {
        _im_sb_positional(sb, &digits, n, k, 1);
        return 0;
    }
    str_builder_putc(sb, load8(&digits));
    if (n > 1) {
        str_builder_putc(sb, 46);
        _im_sb_digits(sb, &digits, 1, n);
    }
    str_builder_putc(sb, 101);
    if (ex >= 0) {
        str_builder_putc(sb, 43);
        str_builder_add_int(sb, ex);
    } else {
        str_builder_putc(sb, 45);
        str_builder_add_int(sb, 0 - ex);
    }
    return 0;
}

# --- vec.cyr ---

# vec.cyr — impetus's value vectors.
#
# The Rust crate passes `[f64; 2]` and `[f64; 3]` arrays at its API; the port passes these structs
# by value (16 bytes in two registers, 24 through the hidden return pointer). Hot loops read the
# components into f64 locals instead (port-parity.md §4.2). Operations arrive with the modules that
# use them.

struct ImVec2 { x: f64; y: f64; }
struct ImVec3 { x: f64; y: f64; z: f64; }

# (x, y) as a value.
#must_use
fn ImVec2_new(x: f64, y: f64): ImVec2 {
    var v: ImVec2;
    v.x = x;
    v.y = y;
    return v;
}

# (x, y, z) as a value.
#must_use
fn ImVec3_new(x: f64, y: f64, z: f64): ImVec3 {
    var v: ImVec3;
    v.x = x;
    v.y = y;
    v.z = z;
    return v;
}

# (0, 0, 0).
#must_use
fn ImVec3_zero(): ImVec3 {
    var v: ImVec3;
    v.x = 0.0;
    v.y = 0.0;
    v.z = 0.0;
    return v;
}

# --- config.cyr ---

# config.cyr — world configuration (port of rust-old/src/config.rs).
#
# `ImWorldConfig` holds the Rust `WorldConfig` fields in declaration order. Rust's `u32` counts and
# `u64` step are i64 words here; a value no `u32` could hold is refused by `validate` (as kimiya
# refuses out-of-type inputs). `validate` checks the fields in Rust's order and returns the same
# verdict for every config Rust can hold, with two Cyrius-only refusals after them (ADR 0008):
# `IM_SOLVER_XPBD` (#6, Err(IM_ERR_UNSUPPORTED)) and an enum value that is no variant
# (Err(IM_ERR_INVALID_CONFIG)).

enum ImBroadphaseKind {
    IM_BROADPHASE_SPATIAL_HASH = 0;
    IM_BROADPHASE_AABB_TREE = 1;
}

enum ImSolverKind {
    IM_SOLVER_SEQUENTIAL_IMPULSE = 0;
    IM_SOLVER_XPBD = 1;
}

struct ImWorldConfig {
    timestep: f64;
    gravity: ImVec3;
    velocity_iterations;
    position_iterations;
    deterministic;
    step;
    position_slop: f64;
    position_correction: f64;
    max_velocity: f64;
    sub_steps;
    constraint_frequency: f64;
    constraint_damping_ratio: f64;
    broadphase;
    solver;
}

# The Rust variant name of a broadphase kind (`"SpatialHash"`), or "Unknown".
#must_use
fn broadphase_kind_name(k): i64 {
    if (k == IM_BROADPHASE_SPATIAL_HASH) { return "SpatialHash"; }
    if (k == IM_BROADPHASE_AABB_TREE) { return "AabbTree"; }
    return "Unknown";
}

# The Rust variant name of a solver kind (`"SequentialImpulse"`), or "Unknown".
#must_use
fn solver_kind_name(k): i64 {
    if (k == IM_SOLVER_SEQUENTIAL_IMPULSE) { return "SequentialImpulse"; }
    if (k == IM_SOLVER_XPBD) { return "Xpbd"; }
    return "Unknown";
}

# The default configuration: 1/60 s, gravity (0, −9.81, 0), 4 velocity and 1 position iteration,
# slop 0.01, correction 0.2, max velocity 100, 1 sub-step, 30 Hz critically damped soft
# constraints, the spatial hash and the sequential-impulse solver. Mirrors `WorldConfig::default`.
#must_use
fn ImWorldConfig_default(): ImWorldConfig {
    var c: ImWorldConfig;
    c.timestep = 1.0 / 60.0;
    c.gravity = ImVec3_new(0.0, -9.81, 0.0);
    c.velocity_iterations = 4;
    c.position_iterations = 1;
    c.deterministic = 1;
    c.step = 0;
    c.position_slop = 0.01;
    c.position_correction = 0.2;
    c.max_velocity = 100.0;
    c.sub_steps = 1;
    c.constraint_frequency = 30.0;
    c.constraint_damping_ratio = 1.0;
    c.broadphase = IM_BROADPHASE_SPATIAL_HASH;
    c.solver = IM_SOLVER_SEQUENTIAL_IMPULSE;
    return c;
}

# 1 when n is a count a Rust `u32` could hold and at most `max`.
#must_use
fn _im_count_ok(n, max): i64 {
    if (n < 0 || n > max) { return 0; }
    return 1;
}

# 1 when x is finite and at least 0.
#must_use
fn _im_finite_non_negative(x: f64): i64 {
    if (_im_is_finite(x) == 0) { return 0; }
    if (x >= 0.0) { return 1; }
    return 0;
}

impl ImWorldConfig {
    # Ok(0) when every setting is usable; else Err(IM_ERR_INVALID_CONFIG) for the first offending
    # field in Rust's order: a finite positive timestep, finite gravity, sub_steps ≤
    # IM_MAX_SUB_STEPS, iteration counts ≤ IM_MAX_ITERATIONS, finite slop ≥ 0, correction in
    # [0, 1], max_velocity > 0 (∞ disables the clamp), finite frequency and damping ratio ≥ 0.
    # Then the Cyrius-only checks: Err(IM_ERR_UNSUPPORTED) for the XPBD solver (ADR 0008 #6), and
    # Err(IM_ERR_INVALID_CONFIG) for a broadphase or solver value that is no variant.
    # Mirrors `WorldConfig::validate`.
    #must_use
    fn validate(self): Result {
        var ts: f64 = self.timestep;
        if (_im_is_finite(ts) == 0) { return Err(IM_ERR_INVALID_CONFIG); }
        if (ts <= 0.0) { return Err(IM_ERR_INVALID_CONFIG); }
        var gx: f64 = self.gravity.x;
        var gy: f64 = self.gravity.y;
        var gz: f64 = self.gravity.z;
        if (_im_is_finite(gx) == 0 || _im_is_finite(gy) == 0 || _im_is_finite(gz) == 0) {
            return Err(IM_ERR_INVALID_CONFIG);
        }
        if (_im_count_ok(self.sub_steps, IM_MAX_SUB_STEPS) == 0) { return Err(IM_ERR_INVALID_CONFIG); }
        if (_im_count_ok(self.velocity_iterations, IM_MAX_ITERATIONS) == 0) { return Err(IM_ERR_INVALID_CONFIG); }
        if (_im_count_ok(self.position_iterations, IM_MAX_ITERATIONS) == 0) { return Err(IM_ERR_INVALID_CONFIG); }
        if (_im_finite_non_negative(self.position_slop) == 0) { return Err(IM_ERR_INVALID_CONFIG); }
        # `(0.0..=1.0).contains(&x)`: false for NaN.
        var corr: f64 = self.position_correction;
        if (corr >= 0.0 && corr <= 1.0) {} else { return Err(IM_ERR_INVALID_CONFIG); }
        var mv: f64 = self.max_velocity;
        if (_im_is_nan(mv) == 1 || mv <= 0.0) { return Err(IM_ERR_INVALID_CONFIG); }
        if (_im_finite_non_negative(self.constraint_frequency) == 0) { return Err(IM_ERR_INVALID_CONFIG); }
        if (_im_finite_non_negative(self.constraint_damping_ratio) == 0) { return Err(IM_ERR_INVALID_CONFIG); }
        if (self.broadphase != IM_BROADPHASE_SPATIAL_HASH && self.broadphase != IM_BROADPHASE_AABB_TREE) {
            return Err(IM_ERR_INVALID_CONFIG);
        }
        if (self.solver == IM_SOLVER_XPBD) { return Err(IM_ERR_UNSUPPORTED); }
        if (self.solver != IM_SOLVER_SEQUENTIAL_IMPULSE) { return Err(IM_ERR_INVALID_CONFIG); }
        return Ok(0);
    }
}

# --- material.cyr ---

# material.cyr — physics materials (port of rust-old/src/material.rs).
#
# `ImCombineRule` keeps the Rust variant order, which is also the priority order the solver uses
# when two materials disagree (Max > Multiply > Average > Min). `ImPhysicsMaterial` holds the Rust
# fields in declaration order; Rust's `static_friction: Option<f64>` is a presence flag plus the
# value (as kimiya's Option<f64> fields).

enum ImCombineRule {
    IM_COMBINE_MIN = 0;
    IM_COMBINE_AVERAGE = 1;
    IM_COMBINE_MULTIPLY = 2;
    IM_COMBINE_MAX = 3;
}

struct ImPhysicsMaterial {
    friction: f64;
    restitution: f64;
    density: f64;
    has_static_friction;
    static_friction: f64;
    rolling_friction: f64;
    friction_combine;
    restitution_combine;
}

# The Rust variant name of a combine rule (`"Average"`), or "Unknown".
#must_use
fn combine_rule_name(rule): i64 {
    if (rule == IM_COMBINE_MIN) { return "Min"; }
    if (rule == IM_COMBINE_AVERAGE) { return "Average"; }
    if (rule == IM_COMBINE_MULTIPLY) { return "Multiply"; }
    if (rule == IM_COMBINE_MAX) { return "Max"; }
    return "Unknown";
}

# Combine two values by `rule`: the mean (a + b)·0.5, the smaller, the product, or the larger
# (min and max ignore a NaN operand, as Rust's). NaN for a value that is no rule.
# Mirrors `CombineRule::combine`.
#must_use
fn combine_rule_combine(rule, a: f64, b: f64): f64 {
    if (rule == IM_COMBINE_AVERAGE) { var r: f64 = (a + b) * 0.5; return r; }
    if (rule == IM_COMBINE_MIN) { var r: f64 = _im_min(a, b); return r; }
    if (rule == IM_COMBINE_MAX) { var r: f64 = _im_max(a, b); return r; }
    if (rule == IM_COMBINE_MULTIPLY) { var r: f64 = a * b; return r; }
    var nan: f64 = 0.0 / 0.0;
    return nan;
}

# A material with the given friction, restitution and density and every other field at its
# default: no static friction override, no rolling friction, Average friction, Min restitution.
#must_use
fn _im_material(friction: f64, restitution: f64, density: f64): ImPhysicsMaterial {
    var m: ImPhysicsMaterial;
    m.friction = friction;
    m.restitution = restitution;
    m.density = density;
    m.has_static_friction = 0;
    m.static_friction = 0.0;
    m.rolling_friction = 0.0;
    m.friction_combine = IM_COMBINE_AVERAGE;
    m.restitution_combine = IM_COMBINE_MIN;
    return m;
}

# Friction 0.5, restitution 0, density 1. Mirrors `PhysicsMaterial::default`.
#must_use
fn ImPhysicsMaterial_default(): ImPhysicsMaterial {
    return _im_material(0.5, 0.0, 1.0);
}

# Low friction, low bounce (ice rink). Mirrors `PhysicsMaterial::ice`.
#must_use
fn ImPhysicsMaterial_ice(): ImPhysicsMaterial {
    return _im_material(0.05, 0.1, 0.9);
}

# High friction, bouncy (rubber). Mirrors `PhysicsMaterial::rubber`.
#must_use
fn ImPhysicsMaterial_rubber(): ImPhysicsMaterial {
    return _im_material(1.0, 0.8, 1.1);
}

# Moderate friction, low density (wood). Mirrors `PhysicsMaterial::wood`.
#must_use
fn ImPhysicsMaterial_wood(): ImPhysicsMaterial {
    return _im_material(0.4, 0.2, 0.6);
}

# Moderate friction, high density (steel). Mirrors `PhysicsMaterial::steel`.
#must_use
fn ImPhysicsMaterial_steel(): ImPhysicsMaterial {
    return _im_material(0.6, 0.3, 7.8);
}

# Low friction, maximum bounce (super ball). Mirrors `PhysicsMaterial::bouncy`.
#must_use
fn ImPhysicsMaterial_bouncy(): ImPhysicsMaterial {
    return _im_material(0.3, 1.0, 1.0);
}

impl ImPhysicsMaterial {
    # The static friction coefficient: the override when set, else friction × 1.5.
    # Mirrors `PhysicsMaterial::effective_static_friction`.
    #must_use
    fn effective_static_friction(self): f64 {
        if (self.has_static_friction == 1) {
            var s: f64 = self.static_friction;
            return s;
        }
        var r: f64 = self.friction * 1.5;
        return r;
    }
}

# --- units.cyr ---

# units.cyr — unit-tagged quantities (port of rust-old/src/units.rs).
#
# A value plus a unit tag; no unit arithmetic or conversion beyond degrees → radians.
# `ImPhysicsUnit` keeps the Rust variant order. `fmt` writes Rust's `Display`: the value in its
# shortest round-trip form (src/fmtf.cyr, ADR 0010), a space, the unit symbol.

enum ImPhysicsUnit {
    IM_UNIT_METERS = 0;
    IM_UNIT_KILOGRAMS = 1;
    IM_UNIT_SECONDS = 2;
    IM_UNIT_METERS_PER_SECOND = 3;
    IM_UNIT_METERS_PER_SECOND_SQUARED = 4;
    IM_UNIT_NEWTONS = 5;
    IM_UNIT_NEWTON_METERS = 6;
    IM_UNIT_JOULES = 7;
    IM_UNIT_RADIANS = 8;
    IM_UNIT_DEGREES = 9;
    IM_UNIT_RADIANS_PER_SECOND = 10;
    IM_UNIT_KG_PER_CUBIC_METER = 11;
    IM_UNIT_KG_PER_SQUARE_METER = 12;
    IM_UNIT_PASCALS = 13;
}

struct ImQuantity { value: f64; unit; }

# π as Rust's `consts::PI`: the double nearest.
var _IM_PI: f64 = 3.141592653589793;

# The Rust variant name of a unit (`"MetersPerSecond"`), or "Unknown".
#must_use
fn physics_unit_name(u): i64 {
    if (u == IM_UNIT_METERS) { return "Meters"; }
    if (u == IM_UNIT_KILOGRAMS) { return "Kilograms"; }
    if (u == IM_UNIT_SECONDS) { return "Seconds"; }
    if (u == IM_UNIT_METERS_PER_SECOND) { return "MetersPerSecond"; }
    if (u == IM_UNIT_METERS_PER_SECOND_SQUARED) { return "MetersPerSecondSquared"; }
    if (u == IM_UNIT_NEWTONS) { return "Newtons"; }
    if (u == IM_UNIT_NEWTON_METERS) { return "NewtonMeters"; }
    if (u == IM_UNIT_JOULES) { return "Joules"; }
    if (u == IM_UNIT_RADIANS) { return "Radians"; }
    if (u == IM_UNIT_DEGREES) { return "Degrees"; }
    if (u == IM_UNIT_RADIANS_PER_SECOND) { return "RadiansPerSecond"; }
    if (u == IM_UNIT_KG_PER_CUBIC_METER) { return "KgPerCubicMeter"; }
    if (u == IM_UNIT_KG_PER_SQUARE_METER) { return "KgPerSquareMeter"; }
    if (u == IM_UNIT_PASCALS) { return "Pascals"; }
    return "Unknown";
}

# The unit's symbol as Rust's `Display` writes it (UTF-8: "m/s²", "N·m", "°"), or "" for a value
# that is no unit.
#must_use
fn physics_unit_symbol(u): i64 {
    if (u == IM_UNIT_METERS) { return "m"; }
    if (u == IM_UNIT_KILOGRAMS) { return "kg"; }
    if (u == IM_UNIT_SECONDS) { return "s"; }
    if (u == IM_UNIT_METERS_PER_SECOND) { return "m/s"; }
    if (u == IM_UNIT_METERS_PER_SECOND_SQUARED) { return "m/s²"; }
    if (u == IM_UNIT_NEWTONS) { return "N"; }
    if (u == IM_UNIT_NEWTON_METERS) { return "N·m"; }
    if (u == IM_UNIT_JOULES) { return "J"; }
    if (u == IM_UNIT_RADIANS) { return "rad"; }
    if (u == IM_UNIT_DEGREES) { return "°"; }
    if (u == IM_UNIT_RADIANS_PER_SECOND) { return "rad/s"; }
    if (u == IM_UNIT_KG_PER_CUBIC_METER) { return "kg/m³"; }
    if (u == IM_UNIT_KG_PER_SQUARE_METER) { return "kg/m²"; }
    if (u == IM_UNIT_PASCALS) { return "Pa"; }
    return "";
}

# A quantity with the given value and unit. Mirrors `Quantity::new`.
#must_use
fn ImQuantity_new(value: f64, unit): ImQuantity {
    var q: ImQuantity;
    q.value = value;
    q.unit = unit;
    return q;
}

# A distance in meters. Mirrors `Quantity::meters`.
#must_use
fn ImQuantity_meters(value: f64): ImQuantity { return ImQuantity_new(value, IM_UNIT_METERS); }

# A mass in kilograms. Mirrors `Quantity::kilograms`.
#must_use
fn ImQuantity_kilograms(value: f64): ImQuantity { return ImQuantity_new(value, IM_UNIT_KILOGRAMS); }

# A time in seconds. Mirrors `Quantity::seconds`.
#must_use
fn ImQuantity_seconds(value: f64): ImQuantity { return ImQuantity_new(value, IM_UNIT_SECONDS); }

# A force in newtons. Mirrors `Quantity::newtons`.
#must_use
fn ImQuantity_newtons(value: f64): ImQuantity { return ImQuantity_new(value, IM_UNIT_NEWTONS); }

# An energy in joules. Mirrors `Quantity::joules`.
#must_use
fn ImQuantity_joules(value: f64): ImQuantity { return ImQuantity_new(value, IM_UNIT_JOULES); }

# An angle in radians. Mirrors `Quantity::radians`.
#must_use
fn ImQuantity_radians(value: f64): ImQuantity { return ImQuantity_new(value, IM_UNIT_RADIANS); }

# An angle in degrees. Mirrors `Quantity::degrees`.
#must_use
fn ImQuantity_degrees(value: f64): ImQuantity { return ImQuantity_new(value, IM_UNIT_DEGREES); }

# A velocity in meters per second. Mirrors `Quantity::meters_per_second`.
#must_use
fn ImQuantity_meters_per_second(value: f64): ImQuantity {
    return ImQuantity_new(value, IM_UNIT_METERS_PER_SECOND);
}

# A pressure in pascals. Mirrors `Quantity::pascals`.
#must_use
fn ImQuantity_pascals(value: f64): ImQuantity { return ImQuantity_new(value, IM_UNIT_PASCALS); }

impl ImQuantity {
    # The value in radians for an angle (degrees converted as Rust writes it, (value·π) / 180);
    # any other quantity's raw value. Mirrors `Quantity::to_radians`.
    #must_use
    fn to_radians(self): f64 {
        if (self.unit == IM_UNIT_DEGREES) {
            var r: f64 = self.value * _IM_PI / 180.0;
            return r;
        }
        var v: f64 = self.value;
        return v;
    }

    # Appends the quantity as Rust's `Display` writes it: "9.81 N", "5 m", "90 °".
    # Mirrors `<Quantity as Display>::fmt`.
    fn fmt(self, sb) {
        var v: f64 = self.value;
        im_fmt_f64_display(sb, v);
        str_builder_putc(sb, 32);
        str_builder_add_cstr(sb, physics_unit_symbol(self.unit));
        return 0;
    }
}

# --- force.cyr ---

# force.cyr — forces, impulses and torques (port of rust-old/src/force.rs).
#
# Rust's `point: Option<[f64; 3]>` is a presence flag plus the point (as material.cyr's Option
# fields). Magnitudes keep Rust's operation order: (x² + y²) + z², then the square root.

struct ImForce { vector: ImVec3; has_point; point: ImVec3; }
struct ImImpulse { vector: ImVec3; has_point; point: ImVec3; }
struct ImTorque { value: f64; }

# √((x² + y²) + z²), as Rust's `(x.powi(2) + y.powi(2) + z.powi(2)).sqrt()`.
#must_use
fn _im_magnitude3(v: ImVec3): f64 {
    var x: f64 = v.x;
    var y: f64 = v.y;
    var z: f64 = v.z;
    var s: f64 = x * x + y * y + z * z;
    var r: f64 = f64_sqrt(s);
    return r;
}

# A force (x, y, z) in newtons at the centre of mass. Mirrors `Force::new`.
#must_use
fn ImForce_new(x: f64, y: f64, z: f64): ImForce {
    var f: ImForce;
    f.vector = ImVec3_new(x, y, z);
    f.has_point = 0;
    f.point = ImVec3_zero();
    return f;
}

# A force (x, y, z) applied at (px, py, pz) relative to the body centre. Mirrors `Force::at_point`.
#must_use
fn ImForce_at_point(x: f64, y: f64, z: f64, px: f64, py: f64, pz: f64): ImForce {
    var f: ImForce;
    f.vector = ImVec3_new(x, y, z);
    f.has_point = 1;
    f.point = ImVec3_new(px, py, pz);
    return f;
}

# The weight of `mass` under gravity `g`: (0, −mass·g, 0). Mirrors `Force::gravity`.
#must_use
fn ImForce_gravity(mass: f64, g: f64): ImForce {
    var w: f64 = -mass * g;
    return ImForce_new(0.0, w, 0.0);
}

impl ImForce {
    # The force's magnitude. Mirrors `Force::magnitude`.
    #must_use
    fn magnitude(self): f64 {
        return _im_magnitude3(self.vector);
    }
}

# An impulse (x, y, z) in newton-seconds at the centre of mass. Mirrors `Impulse::new`.
#must_use
fn ImImpulse_new(x: f64, y: f64, z: f64): ImImpulse {
    var i: ImImpulse;
    i.vector = ImVec3_new(x, y, z);
    i.has_point = 0;
    i.point = ImVec3_zero();
    return i;
}

# An impulse (x, y, z) applied at (px, py, pz) relative to the body centre.
# Mirrors `Impulse::at_point`.
#must_use
fn ImImpulse_at_point(x: f64, y: f64, z: f64, px: f64, py: f64, pz: f64): ImImpulse {
    var i: ImImpulse;
    i.vector = ImVec3_new(x, y, z);
    i.has_point = 1;
    i.point = ImVec3_new(px, py, pz);
    return i;
}

impl ImImpulse {
    # The impulse's magnitude. Mirrors `Impulse::magnitude`.
    #must_use
    fn magnitude(self): f64 {
        return _im_magnitude3(self.vector);
    }
}

# A torque in newton-meters (positive is counter-clockwise). Mirrors `Torque::new`.
#must_use
fn ImTorque_new(value: f64): ImTorque {
    var t: ImTorque;
    t.value = value;
    return t;
}

# --- types.cyr ---

# types.cyr — bodies, colliders, joints, events and queries (port of rust-old/src/{body,collider,joint,
# event,query}.rs).
#
# Handles (`BodyHandle(u64)`, `ColliderHandle`, `JointHandle`) are plain words: index in the low 32
# bits, generation in the high 32 (src/arena.cyr). Each Rust struct keeps its fields in declaration
# order; an `Option<T>` field is a presence flag plus the value, an `[f64; 2]` / `[f64; 3]` an ImVec2 /
# ImVec3. Rust's payload enums (`ColliderShape`, `JointType`, `CollisionEvent`) become a kind enum,
# values in Rust variant order and append-only, plus one struct carrying every variant's fields.
#
# A shape's `Vec` payloads (hull points, mesh vertices and indices, heights) live on freelist storage
# the shape owns: the constructors copy the caller's data, and `free` releases it.

enum ImBodyType {
    IM_BODY_STATIC = 0;
    IM_BODY_DYNAMIC = 1;
    IM_BODY_KINEMATIC = 2;
}

struct ImBodyDesc {
    body_type;
    position: ImVec3;
    rotation: f64;
    linear_velocity: ImVec3;
    angular_velocity: f64;
    linear_damping: f64;
    angular_damping: f64;
    fixed_rotation;
    has_gravity_scale;
    gravity_scale: f64;
}

struct ImBodyState {
    handle;
    body_type;
    position: ImVec3;
    rotation: f64;
    linear_velocity: ImVec3;
    angular_velocity: f64;
    is_sleeping;
}

# The Rust variant name of a body type (`"Dynamic"`), or "Unknown".
#must_use
fn body_type_name(t): i64 {
    if (t == IM_BODY_STATIC) { return "Static"; }
    if (t == IM_BODY_DYNAMIC) { return "Dynamic"; }
    if (t == IM_BODY_KINEMATIC) { return "Kinematic"; }
    return "Unknown";
}

# A dynamic body at rest at the origin: no rotation, velocity or damping, rotation free, the world's
# gravity scale. Mirrors `BodyDesc::default`.
#must_use
fn ImBodyDesc_default(): ImBodyDesc {
    var d: ImBodyDesc;
    d.body_type = IM_BODY_DYNAMIC;
    d.position = ImVec3_zero();
    d.rotation = 0.0;
    d.linear_velocity = ImVec3_zero();
    d.angular_velocity = 0.0;
    d.linear_damping = 0.0;
    d.angular_damping = 0.0;
    d.fixed_rotation = 0;
    d.has_gravity_scale = 0;
    d.gravity_scale = 0.0;
    return d;
}

# ── colliders ───────────────────────────────────────────────────────────────────────

enum ImShapeKind {
    IM_SHAPE_BOX = 0;
    IM_SHAPE_BALL = 1;
    IM_SHAPE_CAPSULE = 2;
    IM_SHAPE_CONVEX_HULL = 3;
    IM_SHAPE_TRI_MESH = 4;
    IM_SHAPE_HEIGHTFIELD = 5;
    IM_SHAPE_SEGMENT = 6;
}

# Every variant's fields. `points` (hull) and `vertices` (mesh) are `count` f64 triples, `indices`
# `index_count` triples of words (u32 values), `heights` `height_count` f64s.
struct ImColliderShape {
    kind;
    half_extents: ImVec3;
    radius: f64;
    half_height: f64;
    points;
    point_count;
    vertices;
    vertex_count;
    indices;
    index_count;
    heights;
    height_count;
    scale: ImVec3;
    a: ImVec3;
    b: ImVec3;
}

struct ImColliderDesc {
    shape: ImColliderShape;
    offset: ImVec3;
    material: ImPhysicsMaterial;
    is_sensor;
    has_mass;
    mass: f64;
    collision_layer;
    collision_mask;
}

# The Rust variant name of a shape kind (`"ConvexHull"`), or "Unknown".
#must_use
fn shape_kind_name(k): i64 {
    if (k == IM_SHAPE_BOX) { return "Box"; }
    if (k == IM_SHAPE_BALL) { return "Ball"; }
    if (k == IM_SHAPE_CAPSULE) { return "Capsule"; }
    if (k == IM_SHAPE_CONVEX_HULL) { return "ConvexHull"; }
    if (k == IM_SHAPE_TRI_MESH) { return "TriMesh"; }
    if (k == IM_SHAPE_HEIGHTFIELD) { return "Heightfield"; }
    if (k == IM_SHAPE_SEGMENT) { return "Segment"; }
    return "Unknown";
}

# A shape of `kind` with every field zero and no arrays.
#must_use
fn _im_shape(kind): ImColliderShape {
    var s: ImColliderShape;
    s.kind = kind;
    s.half_extents = ImVec3_zero();
    s.radius = 0.0;
    s.half_height = 0.0;
    s.points = 0;
    s.point_count = 0;
    s.vertices = 0;
    s.vertex_count = 0;
    s.indices = 0;
    s.index_count = 0;
    s.heights = 0;
    s.height_count = 0;
    s.scale = ImVec3_zero();
    s.a = ImVec3_zero();
    s.b = ImVec3_zero();
    return s;
}

# A freelist copy of `words` 8-byte words from `src`, or 0 (none to copy, or no memory).
#must_use
fn _im_copy_words(src, words): i64 {
    if (words <= 0 || src == 0) { return 0; }
    var p = fl_alloc(words * 8);
    if (p == 0) { return 0; }
    memcpy(p, src, words * 8);
    return p;
}

# A box with the given half extents. Mirrors `ColliderShape::Box`.
#must_use
fn ImColliderShape_box(hx: f64, hy: f64, hz: f64): ImColliderShape {
    var s: ImColliderShape = _im_shape(IM_SHAPE_BOX);
    s.half_extents = ImVec3_new(hx, hy, hz);
    return s;
}

# A circle (2D) or sphere (3D). Mirrors `ColliderShape::Ball`.
#must_use
fn ImColliderShape_ball(radius: f64): ImColliderShape {
    var s: ImColliderShape = _im_shape(IM_SHAPE_BALL);
    s.radius = radius;
    return s;
}

# A capsule of the given half height and radius. Mirrors `ColliderShape::Capsule`.
#must_use
fn ImColliderShape_capsule(half_height: f64, radius: f64): ImColliderShape {
    var s: ImColliderShape = _im_shape(IM_SHAPE_CAPSULE);
    s.half_height = half_height;
    s.radius = radius;
    return s;
}

# A convex hull of `count` points (f64 triples at `points`, copied). Mirrors `ColliderShape::ConvexHull`.
#must_use
fn ImColliderShape_convex_hull(points, count): ImColliderShape {
    var s: ImColliderShape = _im_shape(IM_SHAPE_CONVEX_HULL);
    s.points = _im_copy_words(points, count * 3);
    if (s.points != 0) { s.point_count = count; }
    return s;
}

# A triangle mesh: `vertex_count` f64 triples and `index_count` index triples (words), both copied.
# Mirrors `ColliderShape::TriMesh`.
#must_use
fn ImColliderShape_tri_mesh(vertices, vertex_count, indices, index_count): ImColliderShape {
    var s: ImColliderShape = _im_shape(IM_SHAPE_TRI_MESH);
    s.vertices = _im_copy_words(vertices, vertex_count * 3);
    if (s.vertices != 0) { s.vertex_count = vertex_count; }
    s.indices = _im_copy_words(indices, index_count * 3);
    if (s.indices != 0) { s.index_count = index_count; }
    return s;
}

# A heightfield of `count` heights (copied) and a scale. Mirrors `ColliderShape::Heightfield`.
#must_use
fn ImColliderShape_heightfield(heights, count, scale: ImVec3): ImColliderShape {
    var s: ImColliderShape = _im_shape(IM_SHAPE_HEIGHTFIELD);
    s.heights = _im_copy_words(heights, count);
    if (s.heights != 0) { s.height_count = count; }
    s.scale = scale;
    return s;
}

# A segment from a to b. Mirrors `ColliderShape::Segment`.
#must_use
fn ImColliderShape_segment(a: ImVec3, b: ImVec3): ImColliderShape {
    var s: ImColliderShape = _im_shape(IM_SHAPE_SEGMENT);
    s.a = a;
    s.b = b;
    return s;
}

impl ImColliderShape {
    # A copy with arrays of its own (Rust's derived `Clone`): the copy is freed separately. An array
    # that can't be copied (no memory) comes back empty.
    #must_use
    fn clone(self): ImColliderShape {
        var c: ImColliderShape;
        memcpy(&c, self, sizeof(ImColliderShape));
        c.points = _im_copy_words(self.points, self.point_count * 3);
        if (c.points == 0) { c.point_count = 0; }
        c.vertices = _im_copy_words(self.vertices, self.vertex_count * 3);
        if (c.vertices == 0) { c.vertex_count = 0; }
        c.indices = _im_copy_words(self.indices, self.index_count * 3);
        if (c.indices == 0) { c.index_count = 0; }
        c.heights = _im_copy_words(self.heights, self.height_count);
        if (c.heights == 0) { c.height_count = 0; }
        return c;
    }

    # Releases the shape's arrays (none for the fixed-size kinds) and clears them.
    fn free(self) {
        if (self.points != 0) { fl_free(self.points); }
        if (self.vertices != 0) { fl_free(self.vertices); }
        if (self.indices != 0) { fl_free(self.indices); }
        if (self.heights != 0) { fl_free(self.heights); }
        self.points = 0;
        self.point_count = 0;
        self.vertices = 0;
        self.vertex_count = 0;
        self.indices = 0;
        self.index_count = 0;
        self.heights = 0;
        self.height_count = 0;
        return 0;
    }
}

# A collider of `shape` with Rust's serde defaults for the rest: no offset, the default material, not
# a sensor, mass from density, every collision layer and mask bit set.
#must_use
fn ImColliderDesc_new(shape: ImColliderShape): ImColliderDesc {
    var d: ImColliderDesc;
    d.shape = shape;
    d.offset = ImVec3_zero();
    d.material = ImPhysicsMaterial_default();
    d.is_sensor = 0;
    d.has_mass = 0;
    d.mass = 0.0;
    d.collision_layer = 4294967295;
    d.collision_mask = 4294967295;
    return d;
}

# ── joints ──────────────────────────────────────────────────────────────────────────

enum ImJointKind {
    IM_JOINT_FIXED = 0;
    IM_JOINT_REVOLUTE = 1;
    IM_JOINT_PRISMATIC = 2;
    IM_JOINT_SPRING = 3;
    IM_JOINT_DISTANCE = 4;
    IM_JOINT_WHEEL = 5;
    IM_JOINT_ROPE = 6;
    IM_JOINT_MOUSE = 7;
}

# Every variant's fields: Revolute's anchor and limits, Prismatic's and Wheel's axis, the spring
# terms (Spring, Wheel, Mouse), Distance's length, Rope's max_length, Mouse's target and max_force.
struct ImJointType {
    kind;
    anchor: ImVec2;
    axis: ImVec2;
    has_limits;
    limits: ImVec2;
    rest_length: f64;
    stiffness: f64;
    damping: f64;
    length: f64;
    max_length: f64;
    target: ImVec3;
    max_force: f64;
}

struct ImJointMotor { target_velocity: f64; max_force: f64; }

struct ImJointDesc {
    body_a;
    body_b;
    joint_type: ImJointType;
    local_anchor_a: ImVec2;
    local_anchor_b: ImVec2;
    has_motor;
    motor: ImJointMotor;
    damping: f64;
    has_break_force;
    break_force: f64;
}

# The Rust variant name of a joint kind (`"Revolute"`), or "Unknown".
#must_use
fn joint_kind_name(k): i64 {
    if (k == IM_JOINT_FIXED) { return "Fixed"; }
    if (k == IM_JOINT_REVOLUTE) { return "Revolute"; }
    if (k == IM_JOINT_PRISMATIC) { return "Prismatic"; }
    if (k == IM_JOINT_SPRING) { return "Spring"; }
    if (k == IM_JOINT_DISTANCE) { return "Distance"; }
    if (k == IM_JOINT_WHEEL) { return "Wheel"; }
    if (k == IM_JOINT_ROPE) { return "Rope"; }
    if (k == IM_JOINT_MOUSE) { return "Mouse"; }
    return "Unknown";
}

# A joint type of `kind` with every field zero and no limits.
#must_use
fn _im_joint(kind): ImJointType {
    var j: ImJointType;
    j.kind = kind;
    j.anchor = ImVec2_new(0.0, 0.0);
    j.axis = ImVec2_new(0.0, 0.0);
    j.has_limits = 0;
    j.limits = ImVec2_new(0.0, 0.0);
    j.rest_length = 0.0;
    j.stiffness = 0.0;
    j.damping = 0.0;
    j.length = 0.0;
    j.max_length = 0.0;
    j.target = ImVec3_zero();
    j.max_force = 0.0;
    return j;
}

# Bodies keep their relative position and rotation. Mirrors `JointType::Fixed`.
#must_use
fn ImJointType_fixed(): ImJointType { return _im_joint(IM_JOINT_FIXED); }

# Rotation about a shared anchor, with optional [lo, hi] limits (`has_limits` 0 for none).
# Mirrors `JointType::Revolute`.
#must_use
fn ImJointType_revolute(anchor: ImVec2, has_limits, lo: f64, hi: f64): ImJointType {
    var j: ImJointType = _im_joint(IM_JOINT_REVOLUTE);
    j.anchor = anchor;
    j.has_limits = has_limits;
    if (has_limits == 1) { j.limits = ImVec2_new(lo, hi); }
    return j;
}

# Sliding along an axis, with optional [lo, hi] limits. Mirrors `JointType::Prismatic`.
#must_use
fn ImJointType_prismatic(axis: ImVec2, has_limits, lo: f64, hi: f64): ImJointType {
    var j: ImJointType = _im_joint(IM_JOINT_PRISMATIC);
    j.axis = axis;
    j.has_limits = has_limits;
    if (has_limits == 1) { j.limits = ImVec2_new(lo, hi); }
    return j;
}

# A damped spring between the anchors. Mirrors `JointType::Spring`.
#must_use
fn ImJointType_spring(rest_length: f64, stiffness: f64, damping: f64): ImJointType {
    var j: ImJointType = _im_joint(IM_JOINT_SPRING);
    j.rest_length = rest_length;
    j.stiffness = stiffness;
    j.damping = damping;
    return j;
}

# A fixed distance between the anchors. Mirrors `JointType::Distance`.
#must_use
fn ImJointType_distance(length: f64): ImJointType {
    var j: ImJointType = _im_joint(IM_JOINT_DISTANCE);
    j.length = length;
    return j;
}

# Suspension along an axis plus free spin. Mirrors `JointType::Wheel`.
#must_use
fn ImJointType_wheel(axis: ImVec2, stiffness: f64, damping: f64): ImJointType {
    var j: ImJointType = _im_joint(IM_JOINT_WHEEL);
    j.axis = axis;
    j.stiffness = stiffness;
    j.damping = damping;
    return j;
}

# At most `max_length` apart. Mirrors `JointType::Rope`.
#must_use
fn ImJointType_rope(max_length: f64): ImJointType {
    var j: ImJointType = _im_joint(IM_JOINT_ROPE);
    j.max_length = max_length;
    return j;
}

# Drags body A toward a world-space target. Mirrors `JointType::Mouse`.
#must_use
fn ImJointType_mouse(target: ImVec3, stiffness: f64, damping: f64, max_force: f64): ImJointType {
    var j: ImJointType = _im_joint(IM_JOINT_MOUSE);
    j.target = target;
    j.stiffness = stiffness;
    j.damping = damping;
    j.max_force = max_force;
    return j;
}

# A motor driving toward `target_velocity` with up to `max_force`. Mirrors `JointMotor`.
#must_use
fn ImJointMotor_new(target_velocity: f64, max_force: f64): ImJointMotor {
    var m: ImJointMotor;
    m.target_velocity = target_velocity;
    m.max_force = max_force;
    return m;
}

# A joint between bodies a and b with Rust's serde defaults for the rest: no motor, no damping,
# unbreakable.
#must_use
fn ImJointDesc_new(body_a, body_b, joint_type: ImJointType, anchor_a: ImVec2, anchor_b: ImVec2): ImJointDesc {
    var d: ImJointDesc;
    d.body_a = body_a;
    d.body_b = body_b;
    d.joint_type = joint_type;
    d.local_anchor_a = anchor_a;
    d.local_anchor_b = anchor_b;
    d.has_motor = 0;
    d.motor = ImJointMotor_new(0.0, 0.0);
    d.damping = 0.0;
    d.has_break_force = 0;
    d.break_force = 0.0;
    return d;
}

# ── events and queries ──────────────────────────────────────────────────────────────

enum ImEventKind {
    IM_EVENT_STARTED = 0;
    IM_EVENT_STOPPED = 1;
    IM_EVENT_ONGOING = 2;
}

struct ImCollisionEvent { kind; collider_a; collider_b; }

struct ImContactPoint { local_a: ImVec3; local_b: ImVec3; impulse: f64; }

# `points` is `point_count` ImContactPoint records on freelist storage the data owns.
struct ImContactData {
    collider_a;
    collider_b;
    normal: ImVec3;
    depth: f64;
    points;
    point_count;
}

struct ImRayHit { collider; point: ImVec3; normal: ImVec3; distance: f64; }

struct ImPointQuery { collider; distance: f64; is_inside; }

# The Rust variant name of an event kind (`"Started"`), or "Unknown".
#must_use
fn event_kind_name(k): i64 {
    if (k == IM_EVENT_STARTED) { return "Started"; }
    if (k == IM_EVENT_STOPPED) { return "Stopped"; }
    if (k == IM_EVENT_ONGOING) { return "Ongoing"; }
    return "Unknown";
}

# An event of `kind` for the pair (a, b).
#must_use
fn ImCollisionEvent_new(kind, a, b): ImCollisionEvent {
    var e: ImCollisionEvent;
    e.kind = kind;
    e.collider_a = a;
    e.collider_b = b;
    return e;
}

# --- arena.cyr ---

# arena.cyr — generational arena: O(1) insert, remove and lookup by handle (port of
# rust-old/src/arena.rs).
#
# Values are fixed-size records (`elem_size` bytes) in one freelist buffer; a handle is a word with the
# slot index in the low 32 bits and the slot's generation in the high 32, exactly the Rust
# `ArenaHandle`, so the port hands out the same handles in the same order (M3's dump rows check it).
# Slot semantics follow Rust's:
# - `insert` reuses the free-list head, else appends a slot at generation 0;
# - `remove` bumps the slot's generation (wrapping at 2^32) and pushes it on the free-list head;
# - `insert_at` places a value at a given handle, growing with free generation-0 slots, and marks the
#   free list stale; the next `insert` rebuilds it, lowest index first;
# - `retain` frees, in index order, every value its callback rejects.
# `get` returns the value's address, valid until the next insert (which may move the buffer); view it
# through a typed pointer (`*ImBody`). Storage is freelist, released by `free`, so a world's arenas
# never grow the global heap (port-parity.md §4.1). An allocation failure makes `insert` return -1 and
# `insert_at` 0; nothing aborts. (-1 is also the handle of slot 2^32 − 1 at generation 2^32 − 1, which
# no arena reaches.)

struct ImArena {
    elem_size;
    cap;
    count;
    len;
    free_head;
    free_list_stale;
    values;
    meta;
}

# Each slot's metadata: three words — occupied (0/1), generation (u32), next free slot (-1 for none).
const _IM_ARENA_META = 24;

# The handle word for slot `index` at `generation`. Mirrors `ArenaHandle::new`.
#must_use
fn _im_arena_handle(index, generation): i64 {
    return ((generation & 0xFFFFFFFF) << 32) | (index & 0xFFFFFFFF);
}

# A handle's slot index (low 32 bits). Mirrors `ArenaHandle::index`.
#must_use
fn _im_handle_index(h): i64 {
    return h & 0xFFFFFFFF;
}

# A handle's generation (high 32 bits). Mirrors `ArenaHandle::generation`.
#must_use
fn _im_handle_generation(h): i64 {
    return (h >> 32) & 0xFFFFFFFF;
}

# A typed view of a word (what fl_alloc returns).
#must_use
fn _im_as_arena(p): *ImArena {
    return p;
}

# An empty arena for records of `elem_size` bytes, or 0 when there is no memory. Mirrors `Arena::new`.
#must_use
fn ImArena_new(elem_size): *ImArena {
    var a: *ImArena = _im_as_arena(fl_alloc(sizeof(ImArena)));
    if (a == 0) { return a; }
    a.elem_size = elem_size;
    a.cap = 0;
    a.count = 0;
    a.len = 0;
    a.free_head = 0 - 1;
    a.free_list_stale = 0;
    a.values = 0;
    a.meta = 0;
    return a;
}

impl ImArena {
    # The address of slot i's metadata.
    #must_use
    fn _meta(self, i): i64 {
        return self.meta + i * _IM_ARENA_META;
    }

    # Room for at least `need` slots: 1, or 0 when there is no memory (the arena is unchanged).
    fn _reserve(self, need): i64 {
        if (need <= self.cap) { return 1; }
        var cap = self.cap * 2;
        if (cap < 8) { cap = 8; }
        while (cap < need) { cap = cap * 2; }
        var v = fl_alloc(cap * self.elem_size);
        var m = fl_alloc(cap * _IM_ARENA_META);
        if (v == 0 || m == 0) {
            if (v != 0) { fl_free(v); }
            if (m != 0) { fl_free(m); }
            return 0;
        }
        if (self.count > 0) {
            memcpy(v, self.values, self.count * self.elem_size);
            memcpy(m, self.meta, self.count * _IM_ARENA_META);
        }
        if (self.values != 0) { fl_free(self.values); }
        if (self.meta != 0) { fl_free(self.meta); }
        self.values = v;
        self.meta = m;
        self.cap = cap;
        return 1;
    }

    # Rebuilds the free list from the slots, lowest index first. Mirrors `rebuild_free_list`.
    fn _rebuild_free_list(self) {
        self.free_head = 0 - 1;
        var i = self.count - 1;
        while (i >= 0) {
            var m = self._meta(i);
            if (load64(m) == 0) {
                store64(m + 16, self.free_head);
                self.free_head = i;
            }
            i = i - 1;
        }
        self.free_list_stale = 0;
        return 0;
    }

    # Copies `elem_size` bytes from `value` into a slot and returns its handle, or -1 when there is no
    # memory. Mirrors `Arena::insert`.
    fn insert(self, value): i64 {
        if (self.free_list_stale == 1) { self._rebuild_free_list(); }
        if (self.free_head >= 0) {
            var idx = self.free_head;
            var m = self._meta(idx);
            self.free_head = load64(m + 16);
            store64(m, 1);
            store64(m + 16, 0 - 1);
            memcpy(self.values + idx * self.elem_size, value, self.elem_size);
            self.len = self.len + 1;
            return _im_arena_handle(idx, load64(m + 8));
        }
        if (self._reserve(self.count + 1) == 0) { return 0 - 1; }
        var i = self.count;
        var mi = self._meta(i);
        store64(mi, 1);
        store64(mi + 8, 0);
        store64(mi + 16, 0 - 1);
        memcpy(self.values + i * self.elem_size, value, self.elem_size);
        self.count = self.count + 1;
        self.len = self.len + 1;
        return _im_arena_handle(i, 0);
    }

    # The slot index of a live handle, or -1 (out of range, free, or another generation).
    #must_use
    fn _live(self, h): i64 {
        var idx = _im_handle_index(h);
        if (idx >= self.count) { return 0 - 1; }
        var m = self._meta(idx);
        if (load64(m) != 1 || load64(m + 8) != _im_handle_generation(h)) { return 0 - 1; }
        return idx;
    }

    # Removes the value at handle h, copying it to `out` (when not 0): 1, or 0 when the handle is not
    # live. Mirrors `Arena::remove`.
    fn remove(self, h, out): i64 {
        var idx = self._live(h);
        if (idx < 0) { return 0; }
        if (out != 0) { memcpy(out, self.values + idx * self.elem_size, self.elem_size); }
        var m = self._meta(idx);
        store64(m, 0);
        store64(m + 8, (_im_handle_generation(h) + 1) & 0xFFFFFFFF);
        store64(m + 16, self.free_head);
        self.free_head = idx;
        self.len = self.len - 1;
        return 1;
    }

    # The address of the value at handle h, or 0 when the handle is not live. Mirrors `Arena::get` and
    # `get_mut`.
    #must_use
    fn get(self, h): i64 {
        var idx = self._live(h);
        if (idx < 0) { return 0; }
        return self.values + idx * self.elem_size;
    }

    # 1 when handle h is live. Mirrors `Arena::contains`.
    #must_use
    fn contains(self, h): i64 {
        if (self._live(h) < 0) { return 0; }
        return 1;
    }

    # The number of live values. Mirrors `Arena::len`.
    #must_use
    fn len(self): i64 {
        return self.len;
    }

    # The number of slots, live or free (iteration bound).
    #must_use
    fn slot_count(self): i64 {
        return self.count;
    }

    # The handle of slot i, or -1 when the slot is free or out of range. Iterating i over
    # 0..slot_count() and skipping -1 visits the live values in Rust's `iter` order.
    #must_use
    fn slot_handle(self, i): i64 {
        if (i < 0 || i >= self.count) { return 0 - 1; }
        var m = self._meta(i);
        if (load64(m) != 1) { return 0 - 1; }
        return _im_arena_handle(i, load64(m + 8));
    }

    # Places a copy of `value` at handle h (its index and generation), growing with free generation-0
    # slots; marks the free list stale. 1, or 0 when the slot is occupied or there is no memory. The
    # caller bounds the index (it allocates up to index + 1 slots). Mirrors `Arena::insert_at`.
    fn insert_at(self, h, value): i64 {
        var idx = _im_handle_index(h);
        if (idx >= self.count) {
            if (self._reserve(idx + 1) == 0) { return 0; }
            for (var i = self.count; i <= idx; i = i + 1) {
                var mf = self._meta(i);
                store64(mf, 0);
                store64(mf + 8, 0);
                store64(mf + 16, 0 - 1);
            }
            self.count = idx + 1;
        } elif (load64(self._meta(idx)) == 1) {
            return 0;
        }
        var m = self._meta(idx);
        store64(m, 1);
        store64(m + 8, _im_handle_generation(h));
        store64(m + 16, 0 - 1);
        memcpy(self.values + idx * self.elem_size, value, self.elem_size);
        self.len = self.len + 1;
        self.free_list_stale = 1;
        return 1;
    }

    # Removes, in index order, every value for which `keep(handle, value_address, ctx)` returns 0.
    # Mirrors `Arena::retain`.
    fn retain(self, keep, ctx) {
        for (var i = 0; i < self.count; i = i + 1) {
            var m = self._meta(i);
            if (load64(m) == 1) {
                var g = load64(m + 8);
                var h = _im_arena_handle(i, g);
                if (fncall3(keep, h, self.values + i * self.elem_size, ctx) == 0) {
                    store64(m, 0);
                    store64(m + 8, (g + 1) & 0xFFFFFFFF);
                    store64(m + 16, self.free_head);
                    self.free_head = i;
                    self.len = self.len - 1;
                }
            }
        }
        return 0;
    }

    # Releases the arena's storage and the arena itself.
    fn free(self) {
        if (self.values != 0) { fl_free(self.values); }
        if (self.meta != 0) { fl_free(self.meta); }
        fl_free(self);
        return 0;
    }
}

# --- contact_tracker.cyr ---

# contact_tracker.cyr — frame-level contact bookkeeping for collision events (port of
# rust-old/src/contact_tracker.rs).
#
# Backends record the touching collider pairs after every sub-step; `finish` diffs the frame
# against the previous one, so events come once per world step however many sub-steps ran, and
# a contact that begins and ends inside one frame still reports `Started` then `Stopped`.
#
# A pair key is two collider handle words, the smaller first. Handles are u64 in Rust, and Cyrius
# compares words signed, so every comparison here goes through `_im_ult` (flip the sign bit, then
# compare signed): a handle at generation ≥ 2^31 sorts after the others exactly as in Rust.
# Pair lists are sorted and unique, in freelist buffers the tracker owns and reuses across frames,
# so a steady state allocates nothing (port-parity.md §4.1). The events of the last `finish` live
# in the tracker until the next one.

# A sorted, de-duplicated list of pair keys: `len` pairs of two words at `data`.
struct ImPairList { data; len; cap; }

# 1 when a < b as unsigned 64-bit words.
#must_use
fn _im_ult(a, b): i64 {
    if ((a ^ 0x8000000000000000) < (b ^ 0x8000000000000000)) { return 1; }
    return 0;
}

# Orders pair (a0, a1) against (b0, b1), unsigned and lexicographic: −1, 0 or 1. Rust's
# `PairKey::cmp`.
#must_use
fn _im_pair_cmp(a0, a1, b0, b1): i64 {
    if (a0 != b0) {
        if (_im_ult(a0, b0) == 1) { return 0 - 1; }
        return 1;
    }
    if (a1 == b1) { return 0; }
    if (_im_ult(a1, b1) == 1) { return 0 - 1; }
    return 1;
}

# The pair key of colliders a and b, the smaller handle first: `var lo, hi = _im_pair_key(a, b);`.
# Mirrors `pair_key`.
#must_use
fn _im_pair_key(a, b) {
    if (a == b || _im_ult(a, b) == 1) { return (a, b); }
    return (b, a);
}

# An empty pair list.
#must_use
fn ImPairList_new(): ImPairList {
    var l: ImPairList;
    l.data = 0;
    l.len = 0;
    l.cap = 0;
    return l;
}

impl ImPairList {
    # Room for at least `need` pairs: 1, or 0 when there is no memory (the list is unchanged).
    fn reserve(self, need): i64 {
        if (need <= self.cap) { return 1; }
        var cap = self.cap * 2;
        if (cap < 8) { cap = 8; }
        while (cap < need) { cap = cap * 2; }
        var d = fl_alloc(cap * 16);
        if (d == 0) { return 0; }
        if (self.len > 0) { memcpy(d, self.data, self.len * 16); }
        if (self.data != 0) { fl_free(self.data); }
        self.data = d;
        self.cap = cap;
        return 1;
    }

    # Appends pair (a, b): 1, or 0 when there is no memory.
    fn push(self, a, b): i64 {
        if (self.len == self.cap) {
            if (self.reserve(self.len + 1) == 0) { return 0; }
        }
        var p = self.data + self.len * 16;
        store64(p, a);
        store64(p + 8, b);
        self.len = self.len + 1;
        return 1;
    }

    # The first word of pair i.
    #must_use
    fn first(self, i): i64 {
        return load64(self.data + i * 16);
    }

    # The second word of pair i.
    #must_use
    fn second(self, i): i64 {
        return load64(self.data + i * 16 + 8);
    }

    # Empties the list, keeping its buffer.
    fn clear(self) {
        self.len = 0;
        return 0;
    }

    # 1 when the sorted list holds pair (a, b). Binary search, as Rust's `binary_search(..).is_ok()`.
    #must_use
    fn contains(self, a, b): i64 {
        var lo = 0;
        var hi = self.len;
        while (lo < hi) {
            var mid = lo + (hi - lo) / 2;
            var c = _im_pair_cmp(self.first(mid), self.second(mid), a, b);
            if (c == 0) { return 1; }
            if (c < 0) { lo = mid + 1; } else { hi = mid; }
        }
        return 0;
    }

    # 1 when the pairs are in strictly or non-strictly ascending order. Rust's `is_sorted`.
    #must_use
    fn is_sorted(self): i64 {
        for (var i = 1; i < self.len; i = i + 1) {
            var c = _im_pair_cmp(self.first(i - 1), self.second(i - 1), self.first(i), self.second(i));
            if (c > 0) { return 0; }
        }
        return 1;
    }

    # Drops adjacent duplicates. Rust's `dedup`.
    fn dedup(self) {
        if (self.len < 2) { return 0; }
        var w = 1;
        for (var r = 1; r < self.len; r = r + 1) {
            var a = self.first(r);
            var b = self.second(r);
            if (a != self.first(w - 1) || b != self.second(w - 1)) {
                var p = self.data + w * 16;
                store64(p, a);
                store64(p + 8, b);
                w = w + 1;
            }
        }
        self.len = w;
        return 0;
    }

    # Drops every pair with a word among the `n` handles at `handles`.
    fn forget(self, handles, n) {
        var w = 0;
        for (var r = 0; r < self.len; r = r + 1) {
            var a = self.first(r);
            var b = self.second(r);
            var drop = 0;
            for (var j = 0; j < n; j = j + 1) {
                var h = load64(handles + j * 8);
                if (a == h || b == h) { drop = 1; }
            }
            if (drop == 0) {
                var p = self.data + w * 16;
                store64(p, a);
                store64(p + 8, b);
                w = w + 1;
            }
        }
        self.len = w;
        return 0;
    }

    # Makes this list the union of sorted, unique lists a and b (neither may be this list): 1, or 0
    # when there is no memory. Mirrors `merge_union`.
    fn set_union(self, a: ImPairList, b: ImPairList): i64 {
        self.len = 0;
        if (self.reserve(a.len + b.len) == 0) { return 0; }
        var i = 0;
        var j = 0;
        while (i < a.len && j < b.len) {
            var c = _im_pair_cmp(a.first(i), a.second(i), b.first(j), b.second(j));
            if (c < 0) {
                self.push(a.first(i), a.second(i));
                i = i + 1;
            } elif (c > 0) {
                self.push(b.first(j), b.second(j));
                j = j + 1;
            } else {
                self.push(a.first(i), a.second(i));
                i = i + 1;
                j = j + 1;
            }
        }
        while (i < a.len) {
            self.push(a.first(i), a.second(i));
            i = i + 1;
        }
        while (j < b.len) {
            self.push(b.first(j), b.second(j));
            j = j + 1;
        }
        return 1;
    }

    # Releases the buffer.
    fn free(self) {
        if (self.data != 0) { fl_free(self.data); }
        self.data = 0;
        self.len = 0;
        self.cap = 0;
        return 0;
    }
}

# Sorts the `n` pairs at `data` ascending (unsigned, lexicographic), using `tmp` (room for n pairs).
# A bottom-up merge sort; keys are total and the caller de-duplicates, so the result is the one
# Rust's `sort_unstable` gives.
fn _im_pairs_sort(data, n, tmp) {
    var src = data;
    var dst = tmp;
    var width = 1;
    while (width < n) {
        var lo = 0;
        while (lo < n) {
            var mid = lo + width;
            if (mid > n) { mid = n; }
            var hi = lo + 2 * width;
            if (hi > n) { hi = n; }
            var i = lo;
            var j = mid;
            var k = lo;
            while (k < hi) {
                var take_i = 0;
                if (i < mid) {
                    if (j >= hi) {
                        take_i = 1;
                    } else {
                        var pi = src + i * 16;
                        var pj = src + j * 16;
                        if (_im_pair_cmp(load64(pi), load64(pi + 8), load64(pj), load64(pj + 8)) <= 0) {
                            take_i = 1;
                        }
                    }
                }
                var from = src + j * 16;
                if (take_i == 1) {
                    from = src + i * 16;
                    i = i + 1;
                } else {
                    j = j + 1;
                }
                store64(dst + k * 16, load64(from));
                store64(dst + k * 16 + 8, load64(from + 8));
                k = k + 1;
            }
            lo = hi;
        }
        var t = src;
        src = dst;
        dst = t;
        width = width * 2;
    }
    if (src != data) { memcpy(data, src, n * 16); }
    return 0;
}

# Pair bookkeeping across one frame's sub-steps. `prev`: pairs touching at the end of the previous
# frame; `current`: at the end of the latest sub-step; `seen`: at the end of an earlier sub-step this
# frame (empty with one sub-step); `recorded`: `current` holds a sub-step of this frame. `scratch`
# backs the unions and the sort; `events` holds the last `finish`'s `event_count` events.
struct ImContactTracker {
    prev: ImPairList;
    current: ImPairList;
    seen: ImPairList;
    scratch: ImPairList;
    recorded;
    events;
    event_count;
    event_cap;
}

# An empty tracker. Mirrors `ContactTracker::default`.
#must_use
fn ImContactTracker_new(): ImContactTracker {
    var t: ImContactTracker;
    t.prev = ImPairList_new();
    t.current = ImPairList_new();
    t.seen = ImPairList_new();
    t.scratch = ImPairList_new();
    t.recorded = 0;
    t.events = 0;
    t.event_count = 0;
    t.event_cap = 0;
    return t;
}

impl ImContactTracker {
    # Records the `n` pair keys at `pairs` (two words each, smaller handle first; any order,
    # duplicates fine) touching at the end of a sub-step: 1, or 0 when there is no memory. Mirrors
    # `record_substep`.
    fn record_substep(self, pairs, n): i64 {
        if (self.recorded == 1 && self.current.len > 0) {
            if (self.scratch.set_union(self.seen, self.current) == 0) { return 0; }
            var t: ImPairList = self.seen;
            self.seen = self.scratch;
            self.scratch = t;
        }
        self.current.clear();
        if (self.current.reserve(n) == 0) { return 0; }
        if (n > 0) { memcpy(self.current.data, pairs, n * 16); }
        self.current.len = n;
        # Manifold keys arrive sorted already; this is then a linear check.
        if (self.current.is_sorted() == 0) {
            if (self.scratch.reserve(n) == 0) { return 0; }
            _im_pairs_sort(self.current.data, n, self.scratch.data);
        }
        self.current.dedup();
        self.recorded = 1;
        return 1;
    }

    # Appends event (kind, a, b): 1, or 0 when there is no memory.
    fn _emit(self, kind, a, b): i64 {
        if (self.event_count == self.event_cap) {
            var cap = self.event_cap * 2;
            if (cap < 8) { cap = 8; }
            var e = fl_alloc(cap * sizeof(ImCollisionEvent));
            if (e == 0) { return 0; }
            if (self.event_count > 0) {
                memcpy(e, self.events, self.event_count * sizeof(ImCollisionEvent));
            }
            if (self.events != 0) { fl_free(self.events); }
            self.events = e;
            self.event_cap = cap;
        }
        var p = self.events + self.event_count * sizeof(ImCollisionEvent);
        store64(p, kind);
        store64(p + 8, a);
        store64(p + 16, b);
        self.event_count = self.event_count + 1;
        return 1;
    }

    # Closes the frame and returns its event count, or -1 when there is no memory; read them with
    # `event(i)`. Order: pairs touching now (`Started`/`Ongoing`), then pairs that stopped
    # (`Stopped`, after a `Started` for contacts that began this frame). Mirrors `finish`.
    fn finish(self): i64 {
        self.event_count = 0;
        for (var i = 0; i < self.current.len; i = i + 1) {
            var a = self.current.first(i);
            var b = self.current.second(i);
            var kind = IM_EVENT_STARTED;
            if (self.prev.contains(a, b) == 1) { kind = IM_EVENT_ONGOING; }
            if (self._emit(kind, a, b) == 0) { return 0 - 1; }
        }
        var cand: ImPairList = self.prev;
        if (self.seen.len > 0) {
            if (self.scratch.set_union(self.prev, self.seen) == 0) { return 0 - 1; }
            cand = self.scratch;
        }
        for (var i = 0; i < cand.len; i = i + 1) {
            var a = cand.first(i);
            var b = cand.second(i);
            if (self.current.contains(a, b) == 0) {
                if (self.prev.contains(a, b) == 0) {
                    # Touched only within this frame.
                    if (self._emit(IM_EVENT_STARTED, a, b) == 0) { return 0 - 1; }
                }
                if (self._emit(IM_EVENT_STOPPED, a, b) == 0) { return 0 - 1; }
            }
        }
        var t: ImPairList = self.prev;
        self.prev = self.current;
        self.current = t;
        self.current.clear();
        self.seen.clear();
        self.recorded = 0;
        return self.event_count;
    }

    # Event i of the last `finish`, valid until the next one.
    #must_use
    fn event(self, i): *ImCollisionEvent {
        return self.events + i * sizeof(ImCollisionEvent);
    }

    # 1 when any pair was touching at the end of the previous frame. Mirrors
    # `has_previous_contacts`.
    #must_use
    fn has_previous_contacts(self): i64 {
        if (self.prev.len > 0) { return 1; }
        return 0;
    }

    # Forgets every pair involving one of the `n` collider handles at `colliders`, so no `Stopped`
    # is reported for them (backends call it when colliders are removed). Mirrors
    # `forget_colliders`.
    fn forget_colliders(self, colliders, n) {
        self.prev.forget(colliders, n);
        self.current.forget(colliders, n);
        self.seen.forget(colliders, n);
        return 0;
    }

    # Releases the tracker's buffers.
    fn free(self) {
        self.prev.free();
        self.current.free();
        self.seen.free();
        self.scratch.free();
        if (self.events != 0) { fl_free(self.events); }
        self.events = 0;
        self.event_count = 0;
        self.event_cap = 0;
        return 0;
    }
}

# --- spring.cyr ---

# spring.cyr — standalone damped springs for animation: no world, bodies or colliders (port of
# rust-old/src/spring.rs).
#
# The step is the exact solution of x'' = −k·(x − target) − c·x', linear in (displacement, velocity):
# [y; v] = M·[y0; v0], with M a function of (dt, k, c) alone, cached for the fixed-timestep case.
# Every expression keeps Rust's operation order, so a cached step (× and + only) is class B and the
# transition (exp, sin, cos) class C (port plan §5). exp and sin/cos go through `_im_exp` and
# `_im_sin_cos`, the polyfills, so the bits are the same on every target (ADR 0008 #7).
#
#     var s: ImSpring = ImSpring_new(0.0, 100.0, 300.0, 15.0);
#     while (s.is_settled() == 0) { s.step(dt); draw_at(s.position()); }

# A 1D spring that animates a value toward a target. `cache_*` hold the last transition and its key
# (dt, stiffness, damping); the cache is not part of equality or serialization, as in Rust.
struct ImSpring {
    position: f64;
    velocity: f64;
    target: f64;
    stiffness: f64;
    damping: f64;
    settle_threshold: f64;
    cache_valid;
    cache_dt: f64;
    cache_k: f64;
    cache_c: f64;
    m0: f64;
    m1: f64;
    m2: f64;
    m3: f64;
}

# A spring from `from` toward `to`. Stiffness: force per unit displacement (try 100–500 for UI).
# Damping: critical is 2·√stiffness (try 10–30 for UI). Settles within 0.01. Mirrors `Spring::new`.
#must_use
fn ImSpring_new(from: f64, to: f64, stiffness: f64, damping: f64): ImSpring {
    var s: ImSpring;
    s.position = from;
    s.velocity = 0.0;
    s.target = to;
    s.stiffness = stiffness;
    s.damping = damping;
    s.settle_threshold = 0.01;
    s.cache_valid = 0;
    s.cache_dt = 0.0;
    s.cache_k = 0.0;
    s.cache_c = 0.0;
    s.m0 = 0.0;
    s.m1 = 0.0;
    s.m2 = 0.0;
    s.m3 = 0.0;
    return s;
}

# A critically damped spring (no overshoot); a negative stiffness counts as its magnitude. Mirrors
# `Spring::critically_damped`.
#must_use
fn ImSpring_critically_damped(from: f64, to: f64, stiffness: f64): ImSpring {
    var k: f64 = f64_abs(stiffness);
    var r: f64 = f64_sqrt(k);
    var c: f64 = 2.0 * r;
    return ImSpring_new(from, to, k, c);
}

# An over-damped spring (slow approach, no overshoot). Mirrors `Spring::over_damped`.
#must_use
fn ImSpring_over_damped(from: f64, to: f64, stiffness: f64): ImSpring {
    var k: f64 = f64_abs(stiffness);
    var r: f64 = f64_sqrt(k);
    var c: f64 = 3.0 * r;
    return ImSpring_new(from, to, k, c);
}

# An under-damped spring (bouncy overshoot). Mirrors `Spring::under_damped`.
#must_use
fn ImSpring_under_damped(from: f64, to: f64, stiffness: f64): ImSpring {
    var k: f64 = f64_abs(stiffness);
    var r: f64 = f64_sqrt(k);
    var c: f64 = 0.5 * r;
    return ImSpring_new(from, to, k, c);
}

impl ImSpring {
    # Sets m0..m3 to the transition `[m00, m01, m10, m11]` of y'' = −k·y − c·y' over dt. Mirrors
    # `transition`.
    fn _transition(self, k: f64, c: f64, dt: f64) {
        var alpha: f64 = 0.5 * c;
        var disc: f64 = alpha * alpha - k;
        var ak: f64 = f64_abs(k);
        var scale: f64 = alpha * alpha + ak;
        var ad: f64 = f64_abs(disc);
        var na: f64 = -alpha;
        if (ad <= 0.000000001 * scale || scale == 0.0) {
            # Critically damped (or free motion when k = c = 0).
            var e: f64 = _im_exp(na * dt);
            var ne: f64 = -e;
            self.m0 = e * (1.0 + alpha * dt);
            self.m1 = e * dt;
            self.m2 = ((ne * alpha) * alpha) * dt;
            self.m3 = e * (1.0 - alpha * dt);
        } elif (disc < 0.0) {
            # Under-damped.
            var nd: f64 = -disc;
            var wd: f64 = f64_sqrt(nd);
            var e: f64 = _im_exp(na * dt);
            var ne: f64 = -e;
            var sn, cs = _im_sin_cos(wd * dt);
            var sin: f64 = sn;
            var cos: f64 = cs;
            var aw: f64 = alpha / wd;
            self.m0 = e * (cos + aw * sin);
            self.m1 = (e * sin) / wd;
            self.m2 = ((ne * k) / wd) * sin;
            self.m3 = e * (cos - aw * sin);
        } else {
            # Over-damped: two real roots.
            var beta: f64 = f64_sqrt(disc);
            var r1: f64 = na + beta;
            var r2: f64 = na - beta;
            var d: f64 = r1 - r2;
            var e1: f64 = _im_exp(r1 * dt);
            var e2: f64 = _im_exp(r2 * dt);
            self.m0 = (r1 * e2 - r2 * e1) / d;
            self.m1 = (e1 - e2) / d;
            self.m2 = ((r1 * r2) * (e2 - e1)) / d;
            self.m3 = (r1 * e1 - r2 * e2) / d;
        }
        return 0;
    }

    # Advances the spring by dt seconds, exactly: one step of a second lands where many smaller ones
    # do, and no dt or stiffness can make it explode. A non-positive or NaN dt does nothing; an
    # infinite one snaps a damped spring. Mirrors `Spring::step`.
    fn step(self, dt: f64) {
        if (_im_is_nan(dt) == 1 || dt <= 0.0) { return 0; }
        var k: f64 = self.stiffness;
        var c: f64 = self.damping;
        if (_im_is_finite(dt) == 0) {
            if (c > 0.0 && k >= 0.0) { self.snap(); }
            return 0;
        }
        var hit = 0;
        if (self.cache_valid == 1) {
            var cdt: f64 = self.cache_dt;
            var ck: f64 = self.cache_k;
            var cc: f64 = self.cache_c;
            if (cdt == dt && ck == k && cc == c) { hit = 1; }
        }
        if (hit == 0) {
            self._transition(k, c, dt);
            self.cache_valid = 1;
            self.cache_dt = dt;
            self.cache_k = k;
            self.cache_c = c;
        }
        var m0: f64 = self.m0;
        var m1: f64 = self.m1;
        var m2: f64 = self.m2;
        var m3: f64 = self.m3;
        var p: f64 = self.position;
        var t: f64 = self.target;
        var y0: f64 = p - t;
        var v0: f64 = self.velocity;
        var y: f64 = m0 * y0 + m1 * v0;
        var v: f64 = m2 * y0 + m3 * v0;
        if (_im_is_finite(y) == 1 && _im_is_finite(v) == 1) {
            self.position = t + y;
            self.velocity = v;
        }
        return 0;
    }

    # Current position. Mirrors `Spring::position`.
    #must_use
    fn position(self): f64 {
        var r: f64 = self.position;
        return r;
    }

    # Current velocity. Mirrors `Spring::velocity`.
    #must_use
    fn velocity(self): f64 {
        var r: f64 = self.velocity;
        return r;
    }

    # Target position. Mirrors `Spring::target`.
    #must_use
    fn target(self): f64 {
        var r: f64 = self.target;
        return r;
    }

    # Sets a new target (the user dragged the window). Mirrors `Spring::set_target`.
    fn set_target(self, target: f64) {
        self.target = target;
        return 0;
    }

    # Sets the position directly (teleport). Mirrors `Spring::set_position`.
    fn set_position(self, position: f64) {
        self.position = position;
        return 0;
    }

    # Adds velocity (a fling). Mirrors `Spring::add_velocity`.
    fn add_velocity(self, v: f64) {
        var cur: f64 = self.velocity;
        self.velocity = cur + v;
        return 0;
    }

    # Sets the velocity directly. Mirrors `Spring::set_velocity`.
    fn set_velocity(self, v: f64) {
        self.velocity = v;
        return 0;
    }

    # 1 when |position − target| and |velocity| are both below the settle threshold. Mirrors
    # `Spring::is_settled`.
    #must_use
    fn is_settled(self): i64 {
        var p: f64 = self.position;
        var t: f64 = self.target;
        var d: f64 = p - t;
        var ad: f64 = f64_abs(d);
        var v: f64 = self.velocity;
        var av: f64 = f64_abs(v);
        var thr: f64 = self.settle_threshold;
        if (ad < thr && av < thr) { return 1; }
        return 0;
    }

    # Sets the settle threshold. Mirrors `Spring::set_settle_threshold`.
    fn set_settle_threshold(self, threshold: f64) {
        self.settle_threshold = threshold;
        return 0;
    }

    # Snaps to the target with no velocity. Mirrors `Spring::snap`.
    fn snap(self) {
        var t: f64 = self.target;
        self.position = t;
        self.velocity = 0.0;
        return 0;
    }

    # Stiffness. Mirrors `Spring::stiffness`.
    #must_use
    fn stiffness(self): f64 {
        var r: f64 = self.stiffness;
        return r;
    }

    # Damping. Mirrors `Spring::damping`.
    #must_use
    fn damping(self): f64 {
        var r: f64 = self.damping;
        return r;
    }

    # Sets the stiffness. Mirrors `Spring::set_stiffness`.
    fn set_stiffness(self, stiffness: f64) {
        self.stiffness = stiffness;
        return 0;
    }

    # Sets the damping. Mirrors `Spring::set_damping`.
    fn set_damping(self, damping: f64) {
        self.damping = damping;
        return 0;
    }

    # 1 when the six serialized fields are equal (f64 ==, so NaN is unequal); the cache is ignored.
    # Mirrors `PartialEq for Spring`.
    #must_use
    fn eq(self, o: *ImSpring): i64 {
        var a0: f64 = self.position;
        var b0: f64 = o.position;
        var a1: f64 = self.velocity;
        var b1: f64 = o.velocity;
        var a2: f64 = self.target;
        var b2: f64 = o.target;
        var a3: f64 = self.stiffness;
        var b3: f64 = o.stiffness;
        var a4: f64 = self.damping;
        var b4: f64 = o.damping;
        var a5: f64 = self.settle_threshold;
        var b5: f64 = o.settle_threshold;
        if (a0 == b0 && a1 == b1 && a2 == b2 && a3 == b3 && a4 == b4 && a5 == b5) { return 1; }
        return 0;
    }
}

# A 2D spring: two independent axes. Mirrors `Spring2d`.
struct ImSpring2d { x: ImSpring; y: ImSpring; }

# A 2D spring from `from` toward `to`. Mirrors `Spring2d::new`.
#must_use
fn ImSpring2d_new(from: ImVec2, to: ImVec2, stiffness: f64, damping: f64): ImSpring2d {
    var s: ImSpring2d;
    s.x = ImSpring_new(from.x, to.x, stiffness, damping);
    s.y = ImSpring_new(from.y, to.y, stiffness, damping);
    return s;
}

# A critically damped 2D spring. Mirrors `Spring2d::critically_damped`.
#must_use
fn ImSpring2d_critically_damped(from: ImVec2, to: ImVec2, stiffness: f64): ImSpring2d {
    var s: ImSpring2d;
    s.x = ImSpring_critically_damped(from.x, to.x, stiffness);
    s.y = ImSpring_critically_damped(from.y, to.y, stiffness);
    return s;
}

impl ImSpring2d {
    # Steps both axes. Mirrors `Spring2d::step`.
    fn step(self, dt: f64) {
        self.x.step(dt);
        self.y.step(dt);
        return 0;
    }

    # The position (x, y). Mirrors `Spring2d::position`.
    #must_use
    fn position(self): ImVec2 {
        var px: f64 = self.x.position;
        var py: f64 = self.y.position;
        return ImVec2_new(px, py);
    }

    # Sets the target. Mirrors `Spring2d::set_target`.
    fn set_target(self, target: ImVec2) {
        self.x.set_target(target.x);
        self.y.set_target(target.y);
        return 0;
    }

    # 1 when both axes have settled. Mirrors `Spring2d::is_settled`.
    #must_use
    fn is_settled(self): i64 {
        if (self.x.is_settled() == 1 && self.y.is_settled() == 1) { return 1; }
        return 0;
    }

    # Snaps to the target. Mirrors `Spring2d::snap`.
    fn snap(self) {
        self.x.snap();
        self.y.snap();
        return 0;
    }

    # Adds velocity. Mirrors `Spring2d::add_velocity`.
    fn add_velocity(self, v: ImVec2) {
        self.x.add_velocity(v.x);
        self.y.add_velocity(v.y);
        return 0;
    }
}

# A 3D spring: three independent axes. Mirrors `Spring3d`.
struct ImSpring3d { x: ImSpring; y: ImSpring; z: ImSpring; }

# A 3D spring from `from` toward `to`. Mirrors `Spring3d::new`.
#must_use
fn ImSpring3d_new(from: ImVec3, to: ImVec3, stiffness: f64, damping: f64): ImSpring3d {
    var s: ImSpring3d;
    s.x = ImSpring_new(from.x, to.x, stiffness, damping);
    s.y = ImSpring_new(from.y, to.y, stiffness, damping);
    s.z = ImSpring_new(from.z, to.z, stiffness, damping);
    return s;
}

# A critically damped 3D spring. Mirrors `Spring3d::critically_damped`.
#must_use
fn ImSpring3d_critically_damped(from: ImVec3, to: ImVec3, stiffness: f64): ImSpring3d {
    var s: ImSpring3d;
    s.x = ImSpring_critically_damped(from.x, to.x, stiffness);
    s.y = ImSpring_critically_damped(from.y, to.y, stiffness);
    s.z = ImSpring_critically_damped(from.z, to.z, stiffness);
    return s;
}

impl ImSpring3d {
    # Steps all axes. Mirrors `Spring3d::step`.
    fn step(self, dt: f64) {
        self.x.step(dt);
        self.y.step(dt);
        self.z.step(dt);
        return 0;
    }

    # The position (x, y, z). Mirrors `Spring3d::position`.
    #must_use
    fn position(self): ImVec3 {
        var px: f64 = self.x.position;
        var py: f64 = self.y.position;
        var pz: f64 = self.z.position;
        return ImVec3_new(px, py, pz);
    }

    # Sets the target. Mirrors `Spring3d::set_target`.
    fn set_target(self, target: ImVec3) {
        self.x.set_target(target.x);
        self.y.set_target(target.y);
        self.z.set_target(target.z);
        return 0;
    }

    # 1 when all axes have settled. Mirrors `Spring3d::is_settled`.
    #must_use
    fn is_settled(self): i64 {
        if (self.x.is_settled() == 1 && self.y.is_settled() == 1 && self.z.is_settled() == 1) {
            return 1;
        }
        return 0;
    }

    # Snaps to the target. Mirrors `Spring3d::snap`.
    fn snap(self) {
        self.x.snap();
        self.y.snap();
        self.z.snap();
        return 0;
    }

    # Adds velocity. Mirrors `Spring3d::add_velocity`.
    fn add_velocity(self, v: ImVec3) {
        self.x.add_velocity(v.x);
        self.y.add_velocity(v.y);
        self.z.add_velocity(v.z);
        return 0;
    }
}

# --- aabb_tree.cyr ---

# aabb_tree.cyr — the dynamic AABB tree (balanced BVH) for broadphase candidate pairs (port of
# rust-old/src/aabb_tree.rs).
#
# Leaves hold a key (a collider handle word) and its box fattened by 0.1 a side. Insertion picks the
# sibling by the surface-area heuristic and rebalances on the way up with Box2D's AVL rotation, so
# sorted inserts stay logarithmic. `query_pairs` reports every pair of leaves whose fattened boxes
# overlap, ordered by key as unsigned words (Rust's u64 handles), sorted and unique: the pair set
# depends only on the boxes, never on the tree's shape. Boxes are 3D; 2D ones have z = 0.
#
# Storage is freelist buffers the tree owns and reuses: `clear` empties it for the next step's
# rebuild without freeing, so a steady state allocates nothing (port-parity.md §4.1).

struct ImTreeAabb { min: ImVec3; max: ImVec3; }

# A box from 2D bounds (z = 0). Mirrors `TreeAabb::from_2d`.
#must_use
fn ImTreeAabb_from_2d(min: ImVec2, max: ImVec2): ImTreeAabb {
    var a: ImTreeAabb;
    var x0: f64 = min.x;
    var y0: f64 = min.y;
    var x1: f64 = max.x;
    var y1: f64 = max.y;
    a.min = ImVec3_new(x0, y0, 0.0);
    a.max = ImVec3_new(x1, y1, 0.0);
    return a;
}

# A box from 3D bounds. Mirrors `TreeAabb::from_3d`.
#must_use
fn ImTreeAabb_from_3d(min: ImVec3, max: ImVec3): ImTreeAabb {
    var a: ImTreeAabb;
    a.min = min;
    a.max = max;
    return a;
}

# A growable list of words on freelist storage.
struct ImWordList { data; len; cap; }

# An empty word list.
#must_use
fn ImWordList_new(): ImWordList {
    var l: ImWordList;
    l.data = 0;
    l.len = 0;
    l.cap = 0;
    return l;
}

impl ImWordList {
    # Room for at least `need` words: 1, or 0 when there is no memory (the list is unchanged).
    fn reserve(self, need): i64 {
        if (need <= self.cap) { return 1; }
        var cap = self.cap * 2;
        if (cap < 16) { cap = 16; }
        while (cap < need) { cap = cap * 2; }
        var d = fl_alloc(cap * 8);
        if (d == 0) { return 0; }
        if (self.len > 0) { memcpy(d, self.data, self.len * 8); }
        if (self.data != 0) { fl_free(self.data); }
        self.data = d;
        self.cap = cap;
        return 1;
    }

    # Appends w: 1, or 0 when there is no memory.
    fn push(self, w): i64 {
        if (self.len == self.cap) {
            if (self.reserve(self.len + 1) == 0) { return 0; }
        }
        store64(self.data + self.len * 8, w);
        self.len = self.len + 1;
        return 1;
    }

    # Removes and returns the last word (the list must not be empty).
    fn pop(self): i64 {
        self.len = self.len - 1;
        return load64(self.data + self.len * 8);
    }

    # Word i.
    #must_use
    fn at(self, i): i64 {
        return load64(self.data + i * 8);
    }

    # Releases the buffer.
    fn free(self) {
        if (self.data != 0) { fl_free(self.data); }
        self.data = 0;
        self.len = 0;
        self.cap = 0;
        return 0;
    }
}

# A node is 12 words: the box (min x, y, z, max x, y, z as f64 words), parent, left, right (−1 for
# none), whether it holds a key, the key, and its height (0 for a leaf).
const _IM_TN = 96;

# The tree. `nodes` holds `count` node slots (`cap` allocated); `free` the slots to reuse (LIFO, as
# Rust's free_list.pop()); `walk`, `leaves` and `tmp` are query scratch.
struct ImAabbTree {
    nodes;
    count;
    cap;
    root;
    free: ImWordList;
    walk: ImWordList;
    leaves: ImWordList;
    tmp: ImPairList;
}

# An empty tree. Mirrors `AabbTree::new`.
#must_use
fn ImAabbTree_new(): ImAabbTree {
    var t: ImAabbTree;
    t.nodes = 0;
    t.count = 0;
    t.cap = 0;
    t.root = 0 - 1;
    t.free = ImWordList_new();
    t.walk = ImWordList_new();
    t.leaves = ImWordList_new();
    t.tmp = ImPairList_new();
    return t;
}

# The surface area of the box at b (six f64 words): 2·(dx·dy + dy·dz + dz·dx).
#must_use
fn _im_box_area(b): f64 {
    var x0: f64 = load64(b);
    var y0: f64 = load64(b + 8);
    var z0: f64 = load64(b + 16);
    var x1: f64 = load64(b + 24);
    var y1: f64 = load64(b + 32);
    var z1: f64 = load64(b + 40);
    var dx: f64 = x1 - x0;
    var dy: f64 = y1 - y0;
    var dz: f64 = z1 - z0;
    var s: f64 = 2.0 * (dx * dy + dy * dz + dz * dx);
    return s;
}

# d = the union of boxes a and b (Rust's NaN-ignoring min / max, a first). d may be a or b.
fn _im_box_merge(d, a, b) {
    for (var k = 0; k < 3; k = k + 1) {
        var amin: f64 = load64(a + k * 8);
        var bmin: f64 = load64(b + k * 8);
        var amax: f64 = load64(a + 24 + k * 8);
        var bmax: f64 = load64(b + 24 + k * 8);
        var mn: f64 = _im_min(amin, bmin);
        var mx: f64 = _im_max(amax, bmax);
        store64(d + k * 8, _im_bits(mn));
        store64(d + 24 + k * 8, _im_bits(mx));
    }
    return 0;
}

# 1 when boxes a and b overlap (closed intervals; a NaN bound overlaps nothing).
#must_use
fn _im_box_overlaps(a, b): i64 {
    for (var k = 0; k < 3; k = k + 1) {
        var amin: f64 = load64(a + k * 8);
        var amax: f64 = load64(a + 24 + k * 8);
        var bmin: f64 = load64(b + k * 8);
        var bmax: f64 = load64(b + 24 + k * 8);
        if (!(amin <= bmax && amax >= bmin)) { return 0; }
    }
    return 1;
}

# 1 when box a contains box b.
#must_use
fn _im_box_contains(a, b): i64 {
    for (var k = 0; k < 3; k = k + 1) {
        var amin: f64 = load64(a + k * 8);
        var amax: f64 = load64(a + 24 + k * 8);
        var bmin: f64 = load64(b + k * 8);
        var bmax: f64 = load64(b + 24 + k * 8);
        if (!(amin <= bmin && amax >= bmax)) { return 0; }
    }
    return 1;
}

# Writes aabb, fattened by _IM_AABB_MARGIN (0.1) a side, into the six words at d.
fn _im_box_fat(d, aabb: ImTreeAabb) {
    var x0: f64 = aabb.min.x;
    var y0: f64 = aabb.min.y;
    var z0: f64 = aabb.min.z;
    var x1: f64 = aabb.max.x;
    var y1: f64 = aabb.max.y;
    var z1: f64 = aabb.max.z;
    var m: f64 = _IM_AABB_MARGIN;
    var a0: f64 = x0 - m;
    var a1: f64 = y0 - m;
    var a2: f64 = z0 - m;
    var b0: f64 = x1 + m;
    var b1: f64 = y1 + m;
    var b2: f64 = z1 + m;
    store64(d, _im_bits(a0));
    store64(d + 8, _im_bits(a1));
    store64(d + 16, _im_bits(a2));
    store64(d + 24, _im_bits(b0));
    store64(d + 32, _im_bits(b1));
    store64(d + 40, _im_bits(b2));
    return 0;
}

# Writes aabb (unfattened) into the six words at d.
fn _im_box_tight(d, aabb: ImTreeAabb) {
    var x0: f64 = aabb.min.x;
    var y0: f64 = aabb.min.y;
    var z0: f64 = aabb.min.z;
    var x1: f64 = aabb.max.x;
    var y1: f64 = aabb.max.y;
    var z1: f64 = aabb.max.z;
    store64(d, _im_bits(x0));
    store64(d + 8, _im_bits(y0));
    store64(d + 16, _im_bits(z0));
    store64(d + 24, _im_bits(x1));
    store64(d + 32, _im_bits(y1));
    store64(d + 40, _im_bits(z1));
    return 0;
}

impl ImAabbTree {
    # The address of node i.
    #must_use
    fn _n(self, i): i64 {
        return self.nodes + i * _IM_TN;
    }

    #must_use
    fn _parent(self, i): i64 { return load64(self.nodes + i * _IM_TN + 48); }
    #must_use
    fn _left(self, i): i64 { return load64(self.nodes + i * _IM_TN + 56); }
    #must_use
    fn _right(self, i): i64 { return load64(self.nodes + i * _IM_TN + 64); }
    #must_use
    fn _height(self, i): i64 { return load64(self.nodes + i * _IM_TN + 88); }
    fn _set_parent(self, i, v) { store64(self.nodes + i * _IM_TN + 48, v); return 0; }
    fn _set_left(self, i, v) { store64(self.nodes + i * _IM_TN + 56, v); return 0; }
    fn _set_right(self, i, v) { store64(self.nodes + i * _IM_TN + 64, v); return 0; }
    fn _set_height(self, i, v) { store64(self.nodes + i * _IM_TN + 88, v); return 0; }

    # 1 when node i is a leaf (no left child).
    #must_use
    fn _is_leaf(self, i): i64 {
        if (load64(self.nodes + i * _IM_TN + 56) == 0 - 1) { return 1; }
        return 0;
    }

    # A node slot, reused from the free list (last freed first) or appended; -1 when there is no
    # memory. Its words are left for the caller to set. Mirrors `alloc_node`.
    fn _alloc(self): i64 {
        if (self.free.len > 0) { return self.free.pop(); }
        if (self.count == self.cap) {
            var cap = self.cap * 2;
            if (cap < 16) { cap = 16; }
            var d = fl_alloc(cap * _IM_TN);
            if (d == 0) { return 0 - 1; }
            if (self.count > 0) { memcpy(d, self.nodes, self.count * _IM_TN); }
            if (self.nodes != 0) { fl_free(self.nodes); }
            self.nodes = d;
            self.cap = cap;
        }
        var i = self.count;
        self.count = self.count + 1;
        return i;
    }

    # Inserts a leaf for `key` with the tight box `aabb`: its node index, or -1 when there is no
    # memory. Mirrors `AabbTree::insert`.
    fn insert(self, key, aabb: ImTreeAabb): i64 {
        var fat[48];
        _im_box_fat(&fat, aabb);
        var leaf = self._alloc();
        if (leaf < 0) { return 0 - 1; }
        var ln = self._n(leaf);
        memcpy(ln, &fat, 48);
        store64(ln + 48, 0 - 1);
        store64(ln + 56, 0 - 1);
        store64(ln + 64, 0 - 1);
        store64(ln + 72, 1);
        store64(ln + 80, key);
        store64(ln + 88, 0);
        if (self.root == 0 - 1) {
            self.root = leaf;
            return leaf;
        }
        # The best sibling by the surface-area heuristic.
        var best = self.root;
        var comb[48];
        var m1[48];
        while (self._is_leaf(best) == 0) {
            var left = self._left(best);
            var right = self._right(best);
            _im_box_merge(&comb, self._n(best), &fat);
            var csa: f64 = _im_box_area(&comb);
            var cost: f64 = 2.0 * csa;
            var nsa: f64 = _im_box_area(self._n(best));
            var inherit: f64 = 2.0 * (csa - nsa);
            _im_box_merge(&m1, self._n(left), &fat);
            var cl: f64 = _im_box_area(&m1);
            if (self._is_leaf(left) == 1) {
                cl = cl + inherit;
            } else {
                var lsa: f64 = _im_box_area(self._n(left));
                cl = cl - lsa + inherit;
            }
            _im_box_merge(&m1, self._n(right), &fat);
            var cr: f64 = _im_box_area(&m1);
            if (self._is_leaf(right) == 1) {
                cr = cr + inherit;
            } else {
                var rsa: f64 = _im_box_area(self._n(right));
                cr = cr - rsa + inherit;
            }
            if (cost < cl && cost < cr) { break; }
            if (cl < cr) { best = left; } else { best = right; }
        }
        # A new internal node: parent of the sibling and the new leaf.
        var old_parent = self._parent(best);
        var np = self._alloc();
        if (np < 0) { return 0 - 1; }
        var pn = self._n(np);
        _im_box_merge(pn, self._n(best), &fat);
        store64(pn + 48, old_parent);
        store64(pn + 56, best);
        store64(pn + 64, leaf);
        store64(pn + 72, 0);
        store64(pn + 80, 0);
        store64(pn + 88, self._height(best) + 1);
        self._set_parent(best, np);
        self._set_parent(leaf, np);
        if (old_parent == 0 - 1) {
            self.root = np;
        } elif (self._left(old_parent) == best) {
            self._set_left(old_parent, np);
        } else {
            self._set_right(old_parent, np);
        }
        self._fix_upwards(np);
        return leaf;
    }

    # Removes leaf `leaf`. Mirrors `AabbTree::remove`.
    fn remove(self, leaf) {
        if (leaf == self.root) {
            self.root = 0 - 1;
            self.free.push(leaf);
            return 0;
        }
        var parent = self._parent(leaf);
        var grand = self._parent(parent);
        var sibling = self._left(parent);
        if (sibling == leaf) { sibling = self._right(parent); }
        if (grand == 0 - 1) {
            self.root = sibling;
            self._set_parent(sibling, 0 - 1);
        } else {
            if (self._left(grand) == parent) {
                self._set_left(grand, sibling);
            } else {
                self._set_right(grand, sibling);
            }
            self._set_parent(sibling, grand);
            self._fix_upwards(grand);
        }
        self.free.push(parent);
        self.free.push(leaf);
        return 0;
    }

    # Moves leaf `leaf` to the tight box `aabb`, reinserting only when it escapes its fattened box:
    # 1 when reinserted. A non-leaf is left alone (0). Mirrors `AabbTree::update`.
    fn update(self, leaf, aabb: ImTreeAabb): i64 {
        var tight[48];
        _im_box_tight(&tight, aabb);
        if (_im_box_contains(self._n(leaf), &tight) == 1) { return 0; }
        if (load64(self._n(leaf) + 72) == 0) { return 0; }
        var key = load64(self._n(leaf) + 80);
        self.remove(leaf);
        self.insert(key, aabb);
        return 1;
    }

    # The leaves, depth first (right child popped first, as Rust's stack), into self.leaves.
    fn _collect_leaves(self) {
        self.leaves.len = 0;
        if (self.root == 0 - 1) { return 0; }
        self.walk.len = 0;
        self.walk.push(self.root);
        while (self.walk.len > 0) {
            var node = self.walk.pop();
            if (self._is_leaf(node) == 1) {
                self.leaves.push(node);
            } else {
                self.walk.push(self._left(node));
                self.walk.push(self._right(node));
            }
        }
        return 0;
    }

    # Every pair of keys whose fattened boxes overlap, into `out` (cleared first): each ordered
    # (smaller first, unsigned), the list sorted and unique as Rust's BTreeSet. 1, or 0 when there
    # is no memory. Mirrors `AabbTree::query_pairs`.
    fn query_pairs(self, out: *ImPairList): i64 {
        out.clear();
        if (self.root == 0 - 1) { return 1; }
        self._collect_leaves();
        for (var li = 0; li < self.leaves.len; li = li + 1) {
            var leaf = self.leaves.at(li);
            var lnode = self._n(leaf);
            if (load64(lnode + 72) == 1) {
                var key_a = load64(lnode + 80);
                self.walk.len = 0;
                self.walk.push(self.root);
                while (self.walk.len > 0) {
                    var node = self.walk.pop();
                    if (_im_box_overlaps(self._n(node), lnode) == 1) {
                        if (self._is_leaf(node) == 1) {
                            # Each pair once, from its lower-indexed leaf.
                            if (node > leaf && load64(self._n(node) + 72) == 1) {
                                var lo, hi = _im_pair_key(key_a, load64(self._n(node) + 80));
                                if (out.push(lo, hi) == 0) { return 0; }
                            }
                        } else {
                            self.walk.push(self._left(node));
                            self.walk.push(self._right(node));
                        }
                    }
                }
            }
        }
        if (out.is_sorted() == 0) {
            if (self.tmp.reserve(out.len) == 0) { return 0; }
            _im_pairs_sort(out.data, out.len, self.tmp.data);
        }
        out.dedup();
        return 1;
    }

    # The tree's height: 0 for one leaf, −1 when empty. (Rust's is test-only.)
    #must_use
    fn height(self): i64 {
        if (self.root == 0 - 1) { return 0 - 1; }
        return self._height(self.root);
    }

    # Walks from `node` to the root, rebalancing and refitting heights and boxes. Mirrors
    # `fix_upwards`.
    fn _fix_upwards(self, node0) {
        var node = node0;
        while (node != 0 - 1) {
            node = self._balance(node);
            var left = self._left(node);
            var right = self._right(node);
            if (left != 0 - 1 && right != 0 - 1) {
                var hl = self._height(left);
                var hr = self._height(right);
                if (hr > hl) { hl = hr; }
                self._set_height(node, 1 + hl);
                _im_box_merge(self._n(node), self._n(left), self._n(right));
            }
            node = self._parent(node);
        }
        return 0;
    }

    # Puts `new` in `old`'s place under `parent` (or as the root). Mirrors `replace_child`.
    fn _replace_child(self, parent, old, new) {
        if (parent == 0 - 1) {
            self.root = new;
        } elif (self._left(parent) == old) {
            self._set_left(parent, new);
        } else {
            self._set_right(parent, new);
        }
        return 0;
    }

    # Box2D's AVL rotation: when a's children differ in height by more than one, promote the taller.
    # The node now at a's place. Mirrors `balance`.
    fn _balance(self, a): i64 {
        if (self._is_leaf(a) == 1 || self._height(a) < 2) { return a; }
        var b = self._left(a);
        var c = self._right(a);
        var bal = self._height(c) - self._height(b);
        if (bal > 1) {
            # Promote C.
            var f = self._left(c);
            var g = self._right(c);
            var ap = self._parent(a);
            self._set_left(c, a);
            self._set_parent(c, ap);
            self._set_parent(a, c);
            self._replace_child(ap, a, c);
            var keep = g;
            var give = f;
            if (self._height(f) > self._height(g)) {
                keep = f;
                give = g;
            }
            self._set_right(c, keep);
            self._set_right(a, give);
            self._set_parent(give, a);
            _im_box_merge(self._n(a), self._n(b), self._n(give));
            _im_box_merge(self._n(c), self._n(a), self._n(keep));
            var h1 = self._height(b);
            if (self._height(give) > h1) { h1 = self._height(give); }
            self._set_height(a, 1 + h1);
            var h2 = self._height(a);
            if (self._height(keep) > h2) { h2 = self._height(keep); }
            self._set_height(c, 1 + h2);
            return c;
        }
        if (bal < 0 - 1) {
            # Promote B.
            var d = self._left(b);
            var e = self._right(b);
            var ap2 = self._parent(a);
            self._set_left(b, a);
            self._set_parent(b, ap2);
            self._set_parent(a, b);
            self._replace_child(ap2, a, b);
            var keep2 = e;
            var give2 = d;
            if (self._height(d) > self._height(e)) {
                keep2 = d;
                give2 = e;
            }
            self._set_right(b, keep2);
            self._set_left(a, give2);
            self._set_parent(give2, a);
            _im_box_merge(self._n(a), self._n(c), self._n(give2));
            _im_box_merge(self._n(b), self._n(a), self._n(keep2));
            var h3 = self._height(c);
            if (self._height(give2) > h3) { h3 = self._height(give2); }
            self._set_height(a, 1 + h3);
            var h4 = self._height(a);
            if (self._height(keep2) > h4) { h4 = self._height(keep2); }
            self._set_height(b, 1 + h4);
            return b;
        }
        return a;
    }

    # Empties the tree, keeping its storage, for the next step's rebuild.
    fn clear(self) {
        self.count = 0;
        self.root = 0 - 1;
        self.free.len = 0;
        return 0;
    }

    # Releases the tree's storage.
    fn free(self) {
        if (self.nodes != 0) { fl_free(self.nodes); }
        self.nodes = 0;
        self.count = 0;
        self.cap = 0;
        self.root = 0 - 1;
        self.free.free();
        self.walk.free();
        self.leaves.free();
        self.tmp.free();
        return 0;
    }
}

# --- spatial_hash.cyr ---

# spatial_hash.cyr — the spatial hash grid for broadphase candidate pairs (port of
# rust-old/src/spatial_hash.rs).
#
# Each box is rasterised into the cells it covers, (i32, i32, i32) keys, z = 0 in 2D. A box that is
# non-finite, inverted, past the i32 cell range or more than 4,096 cells is kept in an oversized list
# and paired with every other entry instead, so one bad box can't stall the broadphase.
# `query_pairs` reports every pair that shares a cell, plus every pair with an oversized entry,
# ordered by key as unsigned words (Rust's u64 handles), sorted and unique as Rust's BTreeSet.
#
# Rust keeps a BTreeMap of cells; the port keeps (cell, key) records and sorts them by cell, which
# groups each cell's keys together. The pair set doesn't depend on the order the cells are visited
# in, so any total order on cells serves. Storage is freelist buffers the grid owns and reuses (`clear`).

# Records are three words: the cell as two words (x; y in the high half and z in the low half of
# the second, an injective packing), then the key.
struct ImSpatialHashGrid {
    inv_cell_size: f64;
    recs: ImWordList;
    over: ImWordList;
    all: ImWordList;
    tmp: ImWordList;
    ptmp: ImPairList;
}

# A grid of `cell_size` (its magnitude; 1 when it isn't finite or is below 1e-10). Mirrors
# `SpatialHashGrid::new`.
#must_use
fn ImSpatialHashGrid_new(cell_size: f64): ImSpatialHashGrid {
    var g: ImSpatialHashGrid;
    var safe: f64 = 1.0;
    var ac: f64 = f64_abs(cell_size);
    if (_im_is_finite(cell_size) == 1 && ac >= 0.0000000001) { safe = ac; }
    var inv: f64 = 1.0 / safe;
    g.inv_cell_size = inv;
    g.recs = ImWordList_new();
    g.over = ImWordList_new();
    g.all = ImWordList_new();
    g.tmp = ImWordList_new();
    g.ptmp = ImPairList_new();
    return g;
}

# The cell size for boxes of the `n` maximum dimensions at `dims` (f64 words): twice the mean of the
# finite, non-negative ones, at least 0.1; 1 when there are none. Mirrors
# `SpatialHashGrid::auto_cell_size`.
#must_use
fn ImSpatialHashGrid_auto_cell_size(dims, n): f64 {
    var total: f64 = 0.0;
    var count = 0;
    for (var i = 0; i < n; i = i + 1) {
        var d: f64 = load64(dims + i * 8);
        if (_im_is_finite(d) == 1 && d >= 0.0) {
            total = total + d;
            count = count + 1;
        }
    }
    if (count == 0) { return 1.0; }
    var cf: f64 = f64_from(count);
    var mean: f64 = total / cf * 2.0;
    var r: f64 = _im_max(mean, 0.1);
    return r;
}

# Sorts the n three-word records at data by their first two words (signed), with tmp of the same
# size: a bottom-up merge sort.
fn _im_sort_rec3(data, n, tmp) {
    var src = data;
    var dst = tmp;
    var width = 1;
    while (width < n) {
        var lo = 0;
        while (lo < n) {
            var mid = lo + width;
            if (mid > n) { mid = n; }
            var hi = lo + 2 * width;
            if (hi > n) { hi = n; }
            var i = lo;
            var j = mid;
            var k = lo;
            while (k < hi) {
                var take_i = 0;
                if (i < mid) {
                    if (j >= hi) {
                        take_i = 1;
                    } else {
                        var a0 = load64(src + i * 24);
                        var b0 = load64(src + j * 24);
                        if (a0 < b0 || (a0 == b0 && load64(src + i * 24 + 8) <= load64(src + j * 24 + 8))) {
                            take_i = 1;
                        }
                    }
                }
                var from = src + j * 24;
                if (take_i == 1) {
                    from = src + i * 24;
                    i = i + 1;
                } else {
                    j = j + 1;
                }
                memcpy(dst + k * 24, from, 24);
                k = k + 1;
            }
            lo = hi;
        }
        var t = src;
        src = dst;
        dst = t;
        width = width * 2;
    }
    if (src != data) { memcpy(data, src, n * 24); }
    return 0;
}

impl ImSpatialHashGrid {
    # The inclusive cell range of [min, max] on one axis into *out (lo, hi): 1, or 0 when it is
    # non-finite, inverted or outside the i32 cell range. Mirrors `axis_range`.
    fn _axis(self, min: f64, max: f64, out): i64 {
        var inv: f64 = self.inv_cell_size;
        var a: f64 = min * inv;
        var b: f64 = max * inv;
        var lo: f64 = f64_floor(a);
        var hi: f64 = f64_floor(b);
        if (!(lo <= hi)) { return 0; }
        if (!(lo >= -2147483648.0 && lo <= 2147483647.0)) { return 0; }
        if (!(hi >= -2147483648.0 && hi <= 2147483647.0)) { return 0; }
        store64(out, f64_to(lo));
        store64(out + 8, f64_to(hi));
        return 1;
    }

    # Inserts `key` for the box [min, max]: into every cell it covers, or the oversized list.
    # 1, or 0 when there is no memory. Mirrors `insert`.
    fn _insert(self, key, x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64): i64 {
        if (self.all.push(key) == 0) { return 0; }
        var r[48];
        var ok = self._axis(x0, x1, &r);
        if (ok == 1) { ok = self._axis(y0, y1, &r + 16); }
        if (ok == 1) { ok = self._axis(z0, z1, &r + 32); }
        if (ok == 1) {
            var count: f64 = 1.0;
            for (var k = 0; k < 3; k = k + 1) {
                var lof: f64 = f64_from(load64(&r + k * 16));
                var hif: f64 = f64_from(load64(&r + k * 16 + 8));
                var span: f64 = hif - lof + 1.0;
                count = count * span;
            }
            var cap: f64 = _IM_MAX_CELLS_PER_ENTRY;
            if (!(count <= cap)) { ok = 0; }
        }
        if (ok == 0) { return self.over.push(key); }
        var cx = load64(&r);
        while (cx <= load64(&r + 8)) {
            var cy = load64(&r + 16);
            while (cy <= load64(&r + 24)) {
                var cz = load64(&r + 32);
                while (cz <= load64(&r + 40)) {
                    if (self.recs.push(cx) == 0) { return 0; }
                    if (self.recs.push((cy << 32) | (cz & 4294967295)) == 0) { return 0; }
                    if (self.recs.push(key) == 0) { return 0; }
                    cz = cz + 1;
                }
                cy = cy + 1;
            }
            cx = cx + 1;
        }
        return 1;
    }

    # Inserts `key` for a 2D box (z = 0): 1, or 0 when there is no memory. Mirrors `insert_2d`.
    fn insert_2d(self, key, min: ImVec2, max: ImVec2): i64 {
        var x0: f64 = min.x;
        var y0: f64 = min.y;
        var x1: f64 = max.x;
        var y1: f64 = max.y;
        return self._insert(key, x0, y0, 0.0, x1, y1, 0.0);
    }

    # Inserts `key` for a 3D box: 1, or 0 when there is no memory. Mirrors `insert_3d`.
    fn insert_3d(self, key, min: ImVec3, max: ImVec3): i64 {
        var x0: f64 = min.x;
        var y0: f64 = min.y;
        var z0: f64 = min.z;
        var x1: f64 = max.x;
        var y1: f64 = max.y;
        var z1: f64 = max.z;
        return self._insert(key, x0, y0, z0, x1, y1, z1);
    }

    # Every pair of distinct keys that share a cell, and every pair with an oversized entry, into
    # `out` (cleared first): each ordered (smaller first, unsigned), the list sorted and unique as
    # Rust's BTreeSet. 1, or 0 when there is no memory. Mirrors `query_pairs`.
    fn query_pairs(self, out: *ImPairList): i64 {
        out.clear();
        var n = self.recs.len / 3;
        if (n > 1) {
            if (self.tmp.reserve(n * 3) == 0) { return 0; }
            _im_sort_rec3(self.recs.data, n, self.tmp.data);
        }
        var start = 0;
        while (start < n) {
            var end = start + 1;
            var c0 = self.recs.at(start * 3);
            var c1 = self.recs.at(start * 3 + 1);
            while (end < n && self.recs.at(end * 3) == c0 && self.recs.at(end * 3 + 1) == c1) {
                end = end + 1;
            }
            for (var i = start; i < end; i = i + 1) {
                var ki = self.recs.at(i * 3 + 2);
                for (var j = i + 1; j < end; j = j + 1) {
                    var kj = self.recs.at(j * 3 + 2);
                    if (ki != kj) {
                        var lo, hi = _im_pair_key(ki, kj);
                        if (out.push(lo, hi) == 0) { return 0; }
                    }
                }
            }
            start = end;
        }
        for (var o = 0; o < self.over.len; o = o + 1) {
            var ko = self.over.at(o);
            for (var a = 0; a < self.all.len; a = a + 1) {
                var ka = self.all.at(a);
                if (ka != ko) {
                    var lo2, hi2 = _im_pair_key(ko, ka);
                    if (out.push(lo2, hi2) == 0) { return 0; }
                }
            }
        }
        if (out.is_sorted() == 0) {
            if (self.ptmp.reserve(out.len) == 0) { return 0; }
            _im_pairs_sort(out.data, out.len, self.ptmp.data);
        }
        out.dedup();
        return 1;
    }

    # The number of distinct cells in use (Rust's `cells.len()`, which its tests read). Sorts the
    # records, as query_pairs does.
    fn cell_count(self): i64 {
        var n = self.recs.len / 3;
        if (n == 0) { return 0; }
        if (n > 1) {
            if (self.tmp.reserve(n * 3) == 0) { return 0 - 1; }
            _im_sort_rec3(self.recs.data, n, self.tmp.data);
        }
        var cells = 1;
        for (var i = 1; i < n; i = i + 1) {
            if (self.recs.at(i * 3) != self.recs.at(i * 3 - 3) || self.recs.at(i * 3 + 1) != self.recs.at(i * 3 - 2)) {
                cells = cells + 1;
            }
        }
        return cells;
    }

    # Empties the grid and sets a new cell size, keeping its storage, for the next step's rebuild.
    fn reset(self, cell_size: f64) {
        var fresh: ImSpatialHashGrid = ImSpatialHashGrid_new(cell_size);
        var inv: f64 = fresh.inv_cell_size;
        self.inv_cell_size = inv;
        self.recs.len = 0;
        self.over.len = 0;
        self.all.len = 0;
        return 0;
    }

    # Releases the grid's storage.
    fn free(self) {
        self.recs.free();
        self.over.free();
        self.all.free();
        self.tmp.free();
        self.ptmp.free();
        return 0;
    }
}

# --- b2_types.cyr ---

# b2_types.cyr — the 2D backend's internal types (port of rust-old/src/backend_2d/types.rs): rigid
# bodies and their integration, colliders with their world AABBs and mass properties, joints,
# contacts, manifolds and the island union-find.
#
# Every expression keeps Rust's operation order, so the mass properties (+ − × ÷ √ only) are class B
# and the world AABB is class C through sin_cos alone, which is correctly rounded (ADR 0011). f64
# min / max are Rust's (src/mathx.cyr). The constants are generated (src/constants_private.cyr,
# `_IM_B2_*`). [f64; 2] fields are ImVec2.

# ── rigid bodies ────────────────────────────────────────────────────────────────────

struct ImRigidBody2d {
    handle;
    body_type;
    position: ImVec2;
    rotation: f64;
    linear_velocity: ImVec2;
    angular_velocity: f64;
    linear_damping: f64;
    angular_damping: f64;
    fixed_rotation;
    gravity_scale: f64;
    force_accumulator: ImVec2;
    torque_accumulator: f64;
    mass: f64;
    inv_mass: f64;
    inertia: f64;
    inv_inertia: f64;
    pseudo_velocity: ImVec2;
    pseudo_angular_velocity: f64;
    prev_position: ImVec2;
    prev_rotation: f64;
    is_sleeping;
    sleep_timer: f64;
    island_id;
}

# A body from its descriptor: no mass until colliders are added, gravity scale 1 unless given.
# Mirrors `RigidBody2d::from_desc`.
#must_use
fn ImRigidBody2d_from_desc(handle, desc: ImBodyDesc): ImRigidBody2d {
    var b: ImRigidBody2d;
    var px: f64 = desc.position.x;
    var py: f64 = desc.position.y;
    var vx: f64 = desc.linear_velocity.x;
    var vy: f64 = desc.linear_velocity.y;
    var rot: f64 = desc.rotation;
    var av: f64 = desc.angular_velocity;
    var ld: f64 = desc.linear_damping;
    var ad: f64 = desc.angular_damping;
    var gs: f64 = 1.0;
    if (desc.has_gravity_scale == 1) { gs = desc.gravity_scale; }
    b.handle = handle;
    b.body_type = desc.body_type;
    b.position = ImVec2_new(px, py);
    b.rotation = rot;
    b.linear_velocity = ImVec2_new(vx, vy);
    b.angular_velocity = av;
    b.linear_damping = ld;
    b.angular_damping = ad;
    b.fixed_rotation = desc.fixed_rotation;
    b.gravity_scale = gs;
    b.force_accumulator = ImVec2_new(0.0, 0.0);
    b.torque_accumulator = 0.0;
    b.mass = 0.0;
    b.inv_mass = 0.0;
    b.inertia = 0.0;
    b.inv_inertia = 0.0;
    b.pseudo_velocity = ImVec2_new(0.0, 0.0);
    b.pseudo_angular_velocity = 0.0;
    b.prev_position = ImVec2_new(px, py);
    b.prev_rotation = rot;
    b.is_sleeping = 0;
    b.sleep_timer = 0.0;
    b.island_id = 0;
    return b;
}

impl ImRigidBody2d {
    # 1 for a dynamic body.
    #must_use
    fn is_dynamic(self): i64 {
        if (self.body_type == IM_BODY_DYNAMIC) { return 1; }
        return 0;
    }

    # 1 for a static body.
    #must_use
    fn is_static(self): i64 {
        if (self.body_type == IM_BODY_STATIC) { return 1; }
        return 0;
    }

    # inv_mass and inv_inertia from mass and inertia: non-zero only for a dynamic body of finite
    # positive mass, and inv_inertia only when rotation is free and the inertia finite positive.
    # Mirrors `refresh_inverse_mass`.
    fn refresh_inverse_mass(self) {
        var m: f64 = self.mass;
        if (self.is_dynamic() == 1 && m > 0.0 && _im_is_finite(m) == 1) {
            var im: f64 = 1.0 / m;
            self.inv_mass = im;
            var i: f64 = self.inertia;
            if (self.fixed_rotation == 1 || _im_is_nan(i) == 1 || i <= 0.0 || _im_is_finite(i) == 0) {
                self.inv_inertia = 0.0;
            } else {
                var ii: f64 = 1.0 / i;
                self.inv_inertia = ii;
            }
        } else {
            self.inv_mass = 0.0;
            self.inv_inertia = 0.0;
        }
        return 0;
    }

    # (inv_mass, inv_inertia) as the solver sees them: zero for static, kinematic and sleeping
    # bodies. Mirrors `solver_inv_mass`.
    #must_use
    fn solver_inv_mass(self) {
        if (self.is_dynamic() == 1 && self.is_sleeping == 0) {
            var a: f64 = self.inv_mass;
            var b: f64 = self.inv_inertia;
            return (a, b);
        }
        var z: f64 = 0.0;
        return (z, z);
    }

    # One velocity step: gravity, the accumulated force and torque, damping, then the speed cap.
    # Static, kinematic, massless and sleeping bodies are left alone. Mirrors
    # `integrate_velocities`.
    fn integrate_velocities(self, gravity: ImVec2, dt: f64, max_velocity: f64) {
        var im: f64 = self.inv_mass;
        if (self.is_dynamic() == 0 || im == 0.0) { return 0; }
        if (self.is_sleeping == 1) { return 0; }
        var gs: f64 = self.gravity_scale;
        var gx: f64 = gravity.x;
        var gy: f64 = gravity.y;
        var vx: f64 = self.linear_velocity.x;
        var vy: f64 = self.linear_velocity.y;
        vx = vx + gx * gs * dt;
        vy = vy + gy * gs * dt;
        var fx: f64 = self.force_accumulator.x;
        var fy: f64 = self.force_accumulator.y;
        vx = vx + fx * im * dt;
        vy = vy + fy * im * dt;
        var w: f64 = self.angular_velocity;
        if (self.fixed_rotation == 0) {
            var t: f64 = self.torque_accumulator;
            var ii: f64 = self.inv_inertia;
            w = w + t * ii * dt;
        }
        var ld: f64 = self.linear_damping;
        var ad: f64 = self.angular_damping;
        var lf: f64 = 1.0 / (1.0 + dt * ld);
        vx = vx * lf;
        vy = vy * (1.0 / (1.0 + dt * ld));
        w = w * (1.0 / (1.0 + dt * ad));
        var sq: f64 = _im_powi2(vx) + _im_powi2(vy);
        if (sq > max_velocity * max_velocity) {
            var root: f64 = f64_sqrt(sq);
            var scale: f64 = max_velocity / root;
            vx = vx * scale;
            vy = vy * scale;
        }
        self.linear_velocity = ImVec2_new(vx, vy);
        self.angular_velocity = w;
        return 0;
    }

    # One position step from the velocity and the split-impulse pseudo-velocity, which is then
    # cleared. Static bodies never move; massless or sleeping dynamic ones only clear it. Mirrors
    # `integrate_positions`.
    fn integrate_positions(self, dt: f64) {
        if (self.is_static() == 1) { return 0; }
        var im: f64 = self.inv_mass;
        if (self.is_dynamic() == 1 && (im == 0.0 || self.is_sleeping == 1)) {
            self.pseudo_velocity = ImVec2_new(0.0, 0.0);
            self.pseudo_angular_velocity = 0.0;
            return 0;
        }
        var px: f64 = self.position.x;
        var py: f64 = self.position.y;
        var vx: f64 = self.linear_velocity.x;
        var vy: f64 = self.linear_velocity.y;
        var qx: f64 = self.pseudo_velocity.x;
        var qy: f64 = self.pseudo_velocity.y;
        px = px + vx * dt;
        py = py + vy * dt;
        px = px + qx * dt;
        py = py + qy * dt;
        self.position = ImVec2_new(px, py);
        if (self.fixed_rotation == 0) {
            var r: f64 = self.rotation;
            var w: f64 = self.angular_velocity;
            var q: f64 = self.pseudo_angular_velocity;
            r = r + w * dt;
            r = r + q * dt;
            self.rotation = r;
        }
        self.pseudo_velocity = ImVec2_new(0.0, 0.0);
        self.pseudo_angular_velocity = 0.0;
        return 0;
    }

    # Clears the accumulated force and torque. Mirrors `clear_forces`.
    fn clear_forces(self) {
        self.force_accumulator = ImVec2_new(0.0, 0.0);
        self.torque_accumulator = 0.0;
        return 0;
    }
}

# ── AABBs ───────────────────────────────────────────────────────────────────────────

struct ImAabb2d { min: ImVec2; max: ImVec2; }

# The box [min, max].
#must_use
fn ImAabb2d_new(x0: f64, y0: f64, x1: f64, y1: f64): ImAabb2d {
    var a: ImAabb2d;
    a.min = ImVec2_new(x0, y0);
    a.max = ImVec2_new(x1, y1);
    return a;
}

impl ImAabb2d {
    # 1 when the boxes overlap (closed intervals). Mirrors `Aabb2d::overlaps`.
    #must_use
    fn overlaps(self, o: *ImAabb2d): i64 {
        var ax0: f64 = self.min.x;
        var ay0: f64 = self.min.y;
        var ax1: f64 = self.max.x;
        var ay1: f64 = self.max.y;
        var bx0: f64 = o.min.x;
        var by0: f64 = o.min.y;
        var bx1: f64 = o.max.x;
        var by1: f64 = o.max.y;
        if (ax0 <= bx1 && ax1 >= bx0 && ay0 <= by1 && ay1 >= by0) { return 1; }
        return 0;
    }
}

# ── colliders ───────────────────────────────────────────────────────────────────────

struct ImCollider2d {
    handle;
    body;
    shape: ImColliderShape;
    offset: ImVec2;
    material: ImPhysicsMaterial;
    is_sensor;
    has_mass;
    mass: f64;
    collision_layer;
    collision_mask;
}

# A collider of `body` from its descriptor, with a copy of its shape (freed by `free`). Mirrors
# `Collider2d::from_desc`.
#must_use
fn ImCollider2d_from_desc(handle, body, desc: ImColliderDesc): ImCollider2d {
    var c: ImCollider2d;
    var ox: f64 = desc.offset.x;
    var oy: f64 = desc.offset.y;
    var m: f64 = desc.mass;
    c.handle = handle;
    c.body = body;
    c.shape = desc.shape.clone();
    c.offset = ImVec2_new(ox, oy);
    c.material = desc.material;
    c.is_sensor = desc.is_sensor;
    c.has_mass = desc.has_mass;
    c.mass = m;
    c.collision_layer = desc.collision_layer;
    c.collision_mask = desc.collision_mask;
    return c;
}

# Area, centroid and polar moment of inertia per unit mass about the centroid of the simple polygon
# of `n` points at `pts` (x, y word pairs), either winding (Box2D's b2ComputePolygonMass), into `out`
# (area, cx, cy, i): 1, or 0 for fewer than three points or zero or non-finite area. Mirrors
# `polygon_mass_props`.
fn _im_b2_polygon_mass(pts, n, out): i64 {
    if (n < 3) { return 0; }
    var ox: f64 = load64(pts);
    var oy: f64 = load64(pts + 8);
    var area: f64 = 0.0;
    var cx: f64 = 0.0;
    var cy: f64 = 0.0;
    var io: f64 = 0.0;
    for (var w = 1; w < n - 1; w = w + 1) {
        var ax: f64 = load64(pts + w * 16);
        var ay: f64 = load64(pts + w * 16 + 8);
        var bx: f64 = load64(pts + w * 16 + 16);
        var by: f64 = load64(pts + w * 16 + 24);
        var e1x: f64 = ax - ox;
        var e1y: f64 = ay - oy;
        var e2x: f64 = bx - ox;
        var e2y: f64 = by - oy;
        var d: f64 = e1x * e2y - e1y * e2x;
        var tri: f64 = 0.5 * d;
        area = area + tri;
        cx = cx + tri * (e1x + e2x) / 3.0;
        cy = cy + tri * (e1y + e2y) / 3.0;
        var ix2: f64 = e1x * e1x + e2x * e1x + e2x * e2x;
        var iy2: f64 = e1y * e1y + e2y * e1y + e2y * e2y;
        var k: f64 = 0.25 / 3.0 * d;
        io = io + k * (ix2 + iy2);
    }
    var aa: f64 = f64_abs(area);
    if (aa < _IM_B2_EPSILON_SQ || _im_is_finite(area) == 0) { return 0; }
    var ccx: f64 = cx / area;
    var ccy: f64 = cy / area;
    var ic: f64 = io / area - (ccx * ccx + ccy * ccy);
    var icm: f64 = _im_max(ic, 0.0);
    var rx: f64 = ox + ccx;
    var ry: f64 = oy + ccy;
    store64(out, _im_bits(aa));
    store64(out + 8, _im_bits(rx));
    store64(out + 16, _im_bits(ry));
    store64(out + 24, _im_bits(icm));
    return 1;
}

# Writes (area, cx, cy, i) into out.
fn _im_b2_props(out, area: f64, cx: f64, cy: f64, i: f64) {
    store64(out, _im_bits(area));
    store64(out + 8, _im_bits(cx));
    store64(out + 16, _im_bits(cy));
    store64(out + 24, _im_bits(i));
    return 0;
}

impl ImCollider2d {
    # The world AABB at body position `p`, rotation `rot`. Mirrors `Collider2d::world_aabb`.
    #must_use
    fn world_aabb(self, p: ImVec2, rot: f64): ImAabb2d {
        var sn, cs = _im_sin_cos(rot);
        var s: f64 = sn;
        var c: f64 = cs;
        var px: f64 = p.x;
        var py: f64 = p.y;
        var ox: f64 = self.offset.x;
        var oy: f64 = self.offset.y;
        var wx: f64 = px + c * ox - s * oy;
        var wy: f64 = py + s * ox + c * oy;
        var k = self.shape.kind;
        if (k == IM_SHAPE_BALL) {
            var r: f64 = self.shape.radius;
            return ImAabb2d_new(wx - r, wy - r, wx + r, wy + r);
        }
        if (k == IM_SHAPE_BOX) {
            var hx: f64 = self.shape.half_extents.x;
            var hy: f64 = self.shape.half_extents.y;
            var a1: f64 = c * hx;
            var a2: f64 = s * hy;
            var a3: f64 = s * hx;
            var a4: f64 = c * hy;
            var ex: f64 = f64_abs(a1) + f64_abs(a2);
            var ey: f64 = f64_abs(a3) + f64_abs(a4);
            return ImAabb2d_new(wx - ex, wy - ey, wx + ex, wy + ey);
        }
        if (k == IM_SHAPE_CAPSULE) {
            var hh: f64 = self.shape.half_height;
            var cr: f64 = self.shape.radius;
            var b1: f64 = s * hh;
            var b2: f64 = c * hh;
            var cex: f64 = f64_abs(b1) + cr;
            var cey: f64 = f64_abs(b2) + cr;
            return ImAabb2d_new(wx - cex, wy - cey, wx + cex, wy + cey);
        }
        if (k == IM_SHAPE_SEGMENT) {
            var sax: f64 = self.shape.a.x;
            var say: f64 = self.shape.a.y;
            var sbx: f64 = self.shape.b.x;
            var sby: f64 = self.shape.b.y;
            var ax: f64 = c * sax - s * say + wx;
            var ay: f64 = s * sax + c * say + wy;
            var bx: f64 = c * sbx - s * sby + wx;
            var by: f64 = s * sbx + c * sby + wy;
            var mnx: f64 = _im_min(ax, bx);
            var mny: f64 = _im_min(ay, by);
            var mxx: f64 = _im_max(ax, bx);
            var mxy: f64 = _im_max(ay, by);
            return ImAabb2d_new(mnx, mny, mxx, mxy);
        }
        if (k == IM_SHAPE_HEIGHTFIELD) {
            var n = self.shape.height_count;
            var cells = n;
            if (cells < 1) { cells = 1; }
            var sx: f64 = self.shape.scale.x;
            var sy: f64 = self.shape.scale.y;
            var cf: f64 = f64_from(cells - 1);
            var w: f64 = sx * cf;
            var zero: f64 = 0.0;
            var hmin: f64 = 1.0 / zero;
            var hmax: f64 = -hmin;
            for (var i = 0; i < n; i = i + 1) {
                var h: f64 = load64(self.shape.heights + i * 8);
                hmin = _im_min(hmin, h);
                hmax = _im_max(hmax, h);
            }
            return ImAabb2d_new(wx, wy + hmin * sy, wx + w, wy + hmax * sy);
        }
        # ConvexHull points or TriMesh vertices: the rotated, translated extremes.
        var pts = self.shape.points;
        var np = self.shape.point_count;
        if (k == IM_SHAPE_TRI_MESH) {
            pts = self.shape.vertices;
            np = self.shape.vertex_count;
        }
        var z0: f64 = 0.0;
        var inf: f64 = 1.0 / z0;
        var lx: f64 = inf;
        var ly: f64 = inf;
        var hx2: f64 = -inf;
        var hy2: f64 = -inf;
        for (var j = 0; j < np; j = j + 1) {
            var qx: f64 = load64(pts + j * 24);
            var qy: f64 = load64(pts + j * 24 + 8);
            var tx: f64 = c * qx - s * qy + wx;
            var ty: f64 = s * qx + c * qy + wy;
            lx = _im_min(lx, tx);
            ly = _im_min(ly, ty);
            hx2 = _im_max(hx2, tx);
            hy2 = _im_max(hy2, ty);
        }
        return ImAabb2d_new(lx, ly, hx2, hy2);
    }

    # (area, centroid x, y, inertia per unit mass about the centroid) into out. Shapes with no
    # area of their own (a degenerate hull or mesh, a heightfield) fall back to (1, 0, 0, 1).
    # Mirrors `shape_props`.
    fn _shape_props(self, out) {
        var k = self.shape.kind;
        if (k == IM_SHAPE_BALL) {
            var r: f64 = self.shape.radius;
            var pa: f64 = _IM_PI * r * r;
            var pi: f64 = 0.5 * r * r;
            return _im_b2_props(out, pa, 0.0, 0.0, pi);
        }
        if (k == IM_SHAPE_BOX) {
            var hx: f64 = self.shape.half_extents.x;
            var hy: f64 = self.shape.half_extents.y;
            var w: f64 = 2.0 * hx;
            var h: f64 = 2.0 * hy;
            var wh: f64 = w * h;
            var ba: f64 = f64_abs(wh);
            var bi: f64 = (w * w + h * h) / 12.0;
            return _im_b2_props(out, ba, 0.0, 0.0, bi);
        }
        if (k == IM_SHAPE_CAPSULE) {
            # A rectangle plus two half-discs (Box2D's b2ComputeCapsuleMass).
            var hh: f64 = self.shape.half_height;
            var rr: f64 = self.shape.radius;
            var ch: f64 = f64_abs(hh);
            var cr: f64 = f64_abs(rr);
            var rect: f64 = 4.0 * ch * cr;
            var circ: f64 = _IM_PI * cr * cr;
            var area: f64 = rect + circ;
            if (area <= 0.0) { return _im_b2_props(out, 1.0, 0.0, 0.0, 1.0); }
            var lc: f64 = 4.0 * cr / (3.0 * _IM_PI);
            var ri: f64 = rect * (4.0 * cr * cr + 4.0 * ch * ch) / 12.0;
            var ci: f64 = circ * (0.5 * cr * cr + ch * ch + 2.0 * ch * lc);
            var cap: f64 = (ri + ci) / area;
            return _im_b2_props(out, area, 0.0, 0.0, cap);
        }
        if (k == IM_SHAPE_SEGMENT) {
            # A thin rod, 1 cm thick.
            var sax: f64 = self.shape.a.x;
            var say: f64 = self.shape.a.y;
            var sbx: f64 = self.shape.b.x;
            var sby: f64 = self.shape.b.y;
            var dx: f64 = sbx - sax;
            var dy: f64 = sby - say;
            var sq: f64 = dx * dx + dy * dy;
            var len: f64 = f64_sqrt(sq);
            var sa: f64 = len * 0.01;
            var mx: f64 = (sax + sbx) * 0.5;
            var my: f64 = (say + sby) * 0.5;
            var si: f64 = len * len / 12.0;
            return _im_b2_props(out, sa, mx, my, si);
        }
        if (k == IM_SHAPE_CONVEX_HULL) {
            var np = self.shape.point_count;
            var pts = 0;
            if (np > 0) { pts = fl_alloc(np * 16); }
            for (var i = 0; i < np; i = i + 1) {
                store64(pts + i * 16, load64(self.shape.points + i * 24));
                store64(pts + i * 16 + 8, load64(self.shape.points + i * 24 + 8));
            }
            var ok = _im_b2_polygon_mass(pts, np, out);
            if (pts != 0) { fl_free(pts); }
            if (ok == 0) { _im_b2_props(out, 1.0, 0.0, 0.0, 1.0); }
            return 0;
        }
        if (k == IM_SHAPE_TRI_MESH) {
            var ta: f64 = 0.0;
            var tcx: f64 = 0.0;
            var tcy: f64 = 0.0;
            var second: f64 = 0.0;
            var tri[48];
            var tp[32];
            var nv = self.shape.vertex_count;
            for (var t = 0; t < self.shape.index_count; t = t + 1) {
                var valid = 1;
                for (var q = 0; q < 3; q = q + 1) {
                    var vi = load64(self.shape.indices + (t * 3 + q) * 8);
                    if (vi < 0 || vi >= nv) {
                        valid = 0;
                    } else {
                        store64(&tri + q * 16, load64(self.shape.vertices + vi * 24));
                        store64(&tri + q * 16 + 8, load64(self.shape.vertices + vi * 24 + 8));
                    }
                }
                if (valid == 1 && _im_b2_polygon_mass(&tri, 3, &tp) == 1) {
                    var ai: f64 = load64(&tp);
                    var cix: f64 = load64(&tp + 8);
                    var ciy: f64 = load64(&tp + 16);
                    var ii: f64 = load64(&tp + 24);
                    ta = ta + ai;
                    tcx = tcx + ai * cix;
                    tcy = tcy + ai * ciy;
                    second = second + ai * (ii + cix * cix + ciy * ciy);
                }
            }
            if (ta <= 0.0) { return _im_b2_props(out, 1.0, 0.0, 0.0, 1.0); }
            var mcx: f64 = tcx / ta;
            var mcy: f64 = tcy / ta;
            var mi: f64 = second / ta - mcx * mcx - mcy * mcy;
            var mim: f64 = _im_max(mi, 0.0);
            return _im_b2_props(out, ta, mcx, mcy, mim);
        }
        # A heightfield has no area of its own.
        return _im_b2_props(out, 1.0, 0.0, 0.0, 1.0);
    }

    # The collider's centroid in its local frame. Mirrors `local_centroid` (test-only in Rust).
    #must_use
    fn local_centroid(self): ImVec2 {
        var o[32];
        self._shape_props(&o);
        var x: f64 = load64(&o + 8);
        var y: f64 = load64(&o + 16);
        return ImVec2_new(x, y);
    }

    # (mass, inertia about the centroid, centroid x, y) into out: the explicit mass, or area ·
    # density, at least MIN_MASS; the inertia at least MIN_INERTIA. Mirrors `mass_properties`.
    fn mass_properties(self, out) {
        var o[32];
        self._shape_props(&o);
        var area: f64 = load64(&o);
        var ipm: f64 = load64(&o + 24);
        var m: f64 = 0.0;
        if (self.has_mass == 1) {
            var em: f64 = self.mass;
            m = _im_max(em, _IM_B2_MIN_MASS);
        } else {
            var den: f64 = self.material.density;
            var am: f64 = area * den;
            m = _im_max(am, _IM_B2_MIN_MASS);
        }
        var mi: f64 = m * ipm;
        var inertia: f64 = _im_max(mi, _IM_B2_MIN_INERTIA);
        store64(out, _im_bits(m));
        store64(out + 8, _im_bits(inertia));
        store64(out + 16, load64(&o + 8));
        store64(out + 24, load64(&o + 16));
        return 0;
    }

    # The mass alone. Mirrors `compute_mass` (test-only in Rust).
    #must_use
    fn compute_mass(self): f64 {
        var o[32];
        self.mass_properties(&o);
        var m: f64 = load64(&o);
        return m;
    }

    # The inertia about the centroid for `mass`. Mirrors `compute_inertia` (test-only in Rust).
    #must_use
    fn compute_inertia(self, mass: f64): f64 {
        var o[32];
        self._shape_props(&o);
        var ipm: f64 = load64(&o + 24);
        var mi: f64 = mass * ipm;
        var r: f64 = _im_max(mi, _IM_B2_MIN_INERTIA);
        return r;
    }

    # Releases the collider's shape arrays.
    fn free(self) {
        self.shape.free();
        return 0;
    }
}

# Adds collider c's mass and its inertia about the body origin (the parallel-axis shift of its
# centroid, offset included) to body b, then refreshes b's inverses: state.rs's `add_collider` and,
# summed over a body's colliders in attachment order, `recompute_mass`.
fn _im_b2_add_collider_mass(b: *ImRigidBody2d, c: *ImCollider2d) {
    var o[32];
    c.mass_properties(&o);
    var m: f64 = load64(&o);
    var ic: f64 = load64(&o + 8);
    var cx: f64 = load64(&o + 16);
    var cy: f64 = load64(&o + 24);
    var ox: f64 = c.offset.x;
    var oy: f64 = c.offset.y;
    var dx: f64 = ox + cx;
    var dy: f64 = oy + cy;
    var bm: f64 = b.mass;
    var bi: f64 = b.inertia;
    b.mass = bm + m;
    b.inertia = bi + (ic + m * (dx * dx + dy * dy));
    b.refresh_inverse_mass();
    return 0;
}

# ── joints, contacts, manifolds ─────────────────────────────────────────────────────

struct ImJoint2d {
    body_a;
    body_b;
    joint_type: ImJointType;
    local_anchor_a: ImVec2;
    local_anchor_b: ImVec2;
    has_motor;
    motor: ImJointMotor;
    damping: f64;
    has_break_force;
    break_force: f64;
    reference_angle: f64;
}

struct ImContact {
    collider_a;
    collider_b;
    body_a;
    body_b;
    normal: ImVec2;
    depth: f64;
    point: ImVec2;
}

struct ImManifoldPoint {
    local_a: ImVec2;
    local_b: ImVec2;
    normal_impulse: f64;
    tangent_impulse: f64;
    depth: f64;
}

# `points` is `point_count` (at most _IM_B2_MAX_MANIFOLD_POINTS) ImManifoldPoint records.
struct ImContactManifold {
    collider_a;
    collider_b;
    body_a;
    body_b;
    normal: ImVec2;
    points;
    point_count;
    rolling_impulse: f64;
}

# ── islands ─────────────────────────────────────────────────────────────────────────

# Union-find over body indices: path-compressed find, union by rank.
struct ImIslandManager { parent: ImWordList; rank: ImWordList; }

# A manager for `capacity` elements, each its own set. Mirrors `IslandManager::new`.
#must_use
fn ImIslandManager_new(capacity): ImIslandManager {
    var m: ImIslandManager;
    m.parent = ImWordList_new();
    m.rank = ImWordList_new();
    m.reset(capacity);
    return m;
}

impl ImIslandManager {
    # Starts over with `count` singleton sets: 1, or 0 when there is no memory. Mirrors `reset`.
    fn reset(self, count): i64 {
        self.parent.len = 0;
        self.rank.len = 0;
        if (self.parent.reserve(count) == 0 || self.rank.reserve(count) == 0) { return 0; }
        for (var i = 0; i < count; i = i + 1) {
            self.parent.push(i);
            self.rank.push(0);
        }
        return 1;
    }

    # x's set representative, halving the path on the way. Mirrors `find`.
    fn find(self, x0): i64 {
        var x = x0;
        while (self.parent.at(x) != x) {
            var gp = self.parent.at(self.parent.at(x));
            store64(self.parent.data + x * 8, gp);
            x = self.parent.at(x);
        }
        return x;
    }

    # Merges a's and b's sets, by rank. Mirrors `union` (a reserved word in Cyrius).
    fn unite(self, a, b) {
        var ra = self.find(a);
        var rb = self.find(b);
        if (ra == rb) { return 0; }
        var ka = self.rank.at(ra);
        var kb = self.rank.at(rb);
        if (ka < kb) {
            store64(self.parent.data + ra * 8, rb);
        } elif (ka > kb) {
            store64(self.parent.data + rb * 8, ra);
        } else {
            store64(self.parent.data + rb * 8, ra);
            store64(self.rank.data + ra * 8, ka + 1);
        }
        return 0;
    }

    # Releases the arrays.
    fn free(self) {
        self.parent.free();
        self.rank.free();
        return 0;
    }
}

# --- b2_narrowphase.cyr ---

# b2_narrowphase.cyr — 2D contact generation (port of rust-old/src/backend_2d/narrowphase.rs).
#
# A contact is five f64 words, _IM_B2_CONTACT bytes: the normal x, y (from A to B), the depth, and
# the world point x, y. Generators write their contacts into a caller's buffer of room for two
# (_IM_B2_MAX_CONTACTS; a one-shot 2D manifold never has more) and return how many they wrote, so
# an `Option<Contact2>` is a count of 0 or 1 and a `Vec<Contact2>` one of 0 to 2.
#
# Every expression keeps Rust's operation order and every rotation goes through `_im_sin_cos`, which
# is correctly rounded (ADR 0011), so the rows are class C at 0 ulp against the corrected oracle.
# Points travel as multi-return pairs (x, y). The polygon paths keep their vertices in a stack
# buffer, or on freelist past _IM_B2_POLY_STACK vertices, freed before they return.

const _IM_B2_CONTACT = 40;
const _IM_B2_MAX_CONTACTS = 2;

# ── transforms ──────────────────────────────────────────────────────────────────────

# The world position of `offset` on a body at (bx, by) rotated by rot. Mirrors `world_pos`.
#must_use
fn _im_b2_world_pos(bx: f64, by: f64, rot: f64, ox: f64, oy: f64) {
    var sn, cs = _im_sin_cos(rot);
    var s: f64 = sn;
    var c: f64 = cs;
    var x: f64 = bx + c * ox - s * oy;
    var y: f64 = by + s * ox + c * oy;
    return (x, y);
}

# A world point in the frame of a body at (bx, by) rotated by rot. Mirrors `world_to_local`.
#must_use
fn _im_b2_world_to_local(wx: f64, wy: f64, bx: f64, by: f64, rot: f64) {
    var dx: f64 = wx - bx;
    var dy: f64 = wy - by;
    var sn, cs = _im_sin_cos(rot);
    var s: f64 = sn;
    var c: f64 = cs;
    var x: f64 = c * dx + s * dy;
    var y: f64 = -s * dx + c * dy;
    return (x, y);
}

# A body-local point in world space. Mirrors `local_to_world`.
#must_use
fn _im_b2_local_to_world(lx: f64, ly: f64, bx: f64, by: f64, rot: f64) {
    var sn, cs = _im_sin_cos(rot);
    var s: f64 = sn;
    var c: f64 = cs;
    var x: f64 = bx + c * lx - s * ly;
    var y: f64 = by + s * lx + c * ly;
    return (x, y);
}

# The vector (vx, vy) rotated by rot. Mirrors `rotate`.
#must_use
fn _im_b2_rotate(vx: f64, vy: f64, rot: f64) {
    var sn, cs = _im_sin_cos(rot);
    var s: f64 = sn;
    var c: f64 = cs;
    var x: f64 = c * vx - s * vy;
    var y: f64 = s * vx + c * vy;
    return (x, y);
}

# The collider pair (a, b) with the smaller handle first, as unsigned words. Mirrors
# `ordered_manifold_key`.
#must_use
fn _im_b2_ordered_manifold_key(a, b) {
    if (_im_ult(b, a) == 1) { return (b, a); }
    return (a, b);
}

# ── contact records ─────────────────────────────────────────────────────────────────

# Writes the contact (normal (nx, ny), depth d, point (px, py)) at c.
fn _im_b2_put(c, nx: f64, ny: f64, d: f64, px: f64, py: f64) {
    store64(c, nx);
    store64(c + 8, ny);
    store64(c + 16, d);
    store64(c + 24, px);
    store64(c + 32, py);
    return 0;
}

# Negates the normal of the contact at c. Mirrors `flip_normal`.
fn _im_b2_flip(c) {
    var nx: f64 = load64(c);
    var ny: f64 = load64(c + 8);
    store64(c, -nx);
    store64(c + 8, -ny);
    return 0;
}

# Negates the normals of the n contacts at c.
fn _im_b2_flip_all(c, n) {
    for (var i = 0; i < n; i = i + 1) { _im_b2_flip(c + i * _IM_B2_CONTACT); }
    return 0;
}

# The dot product of (ax, ay) and (bx, by). Mirrors `dot2`.
#must_use
fn _im_b2_dot2(ax: f64, ay: f64, bx: f64, by: f64): f64 {
    var r: f64 = ax * bx + ay * by;
    return r;
}

# Maps the contact at c, computed in the frame of a box at (bx, by) rotated by rot, to world space.
# Mirrors `box_to_world`.
fn _im_b2_box_to_world(c, bx: f64, by: f64, rot: f64) {
    var nx: f64 = load64(c);
    var ny: f64 = load64(c + 8);
    var px: f64 = load64(c + 24);
    var py: f64 = load64(c + 32);
    # Rust's rotate and local_to_world, sharing one sin_cos (a pure function).
    var sn, cs = _im_sin_cos(rot);
    var s: f64 = sn;
    var k: f64 = cs;
    var wnx: f64 = k * nx - s * ny;
    var wny: f64 = s * nx + k * ny;
    var wpx: f64 = bx + k * px - s * py;
    var wpy: f64 = by + s * px + k * py;
    store64(c, wnx);
    store64(c + 8, wny);
    store64(c + 24, wpx);
    store64(c + 32, wpy);
    return 0;
}

# ── circles and boxes ───────────────────────────────────────────────────────────────

# Circle A (centre (ax, ay), radius ra) against circle B into out: 1, or 0 when they don't touch.
# Mirrors `circle_circle`.
fn _im_b2_circle_circle(ax: f64, ay: f64, ra: f64, bx: f64, by: f64, rb: f64, out): i64 {
    var dx: f64 = bx - ax;
    var dy: f64 = by - ay;
    var dist_sq: f64 = dx * dx + dy * dy;
    var sum_r: f64 = ra + rb;
    if (dist_sq >= sum_r * sum_r) { return 0; }
    var dist: f64 = f64_sqrt(dist_sq);
    var nx: f64 = 0.0;
    var ny: f64 = 1.0;
    var depth: f64 = sum_r;
    if (!(dist < _IM_B2_EPSILON)) {
        nx = dx / dist;
        ny = dy / dist;
        depth = sum_r - dist;
    }
    var px: f64 = ax + nx * ra;
    var py: f64 = ay + ny * ra;
    _im_b2_put(out, nx, ny, depth, px, py);
    return 1;
}

# A circle (centre (cx, cy), radius r) against the axis-aligned box of half extents (hx, hy) at
# (bx, by) into out: 1, or 0. The normal points from the box to the circle. Mirrors `circle_aabb`.
fn _im_b2_circle_aabb(cx: f64, cy: f64, r: f64, bx: f64, by: f64, hx: f64, hy: f64, out): i64 {
    var dx: f64 = cx - bx;
    var dy: f64 = cy - by;
    var closest_x: f64 = _im_clamp(dx, -hx, hx);
    var closest_y: f64 = _im_clamp(dy, -hy, hy);
    var diff_x: f64 = dx - closest_x;
    var diff_y: f64 = dy - closest_y;
    var dist_sq: f64 = diff_x * diff_x + diff_y * diff_y;
    if (dist_sq >= r * r) { return 0; }
    var dist: f64 = f64_sqrt(dist_sq);
    var nx: f64 = 0.0;
    var ny: f64 = 0.0;
    var depth: f64 = 0.0;
    if (dist < _IM_B2_EPSILON) {
        var adx: f64 = f64_abs(dx);
        var ady: f64 = f64_abs(dy);
        var f0: f64 = hx - adx;
        var f1: f64 = hy - ady;
        if (f0 < f1) {
            nx = 1.0;
            if (!(dx >= 0.0)) { nx = -1.0; }
            depth = f0 + r;
        } else {
            ny = 1.0;
            if (!(dy >= 0.0)) { ny = -1.0; }
            depth = f1 + r;
        }
    } else {
        nx = diff_x / dist;
        ny = diff_y / dist;
        depth = r - dist;
    }
    var px: f64 = bx + closest_x;
    var py: f64 = by + closest_y;
    _im_b2_put(out, nx, ny, depth, px, py);
    return 1;
}

# A circle against an oriented box (at (bx, by), rotated by brot) into out: 1, or 0. The normal
# points from the box to the circle. Mirrors `circle_obb`.
fn _im_b2_circle_obb(cx: f64, cy: f64, r: f64, bx: f64, by: f64, brot: f64, hx: f64, hy: f64, out): i64 {
    var lx, ly = _im_b2_world_to_local(cx, cy, bx, by, brot);
    if (_im_b2_circle_aabb(lx, ly, r, 0.0, 0.0, hx, hy, out) == 0) { return 0; }
    _im_b2_box_to_world(out, bx, by, brot);
    return 1;
}

# ── segments and capsules ───────────────────────────────────────────────────────────

# A capsule's axis end points in world space into out (x0, y0, x1, y1): the axis is the body's
# local y. Mirrors `capsule_endpoints`.
fn _im_b2_capsule_endpoints(px: f64, py: f64, rot: f64, hh: f64, out) {
    var sn, cs = _im_sin_cos(rot);
    var s: f64 = sn;
    var c: f64 = cs;
    var dx: f64 = -s * hh;
    var dy: f64 = c * hh;
    var x0: f64 = px - dx;
    var y0: f64 = py - dy;
    var x1: f64 = px + dx;
    var y1: f64 = py + dy;
    store64(out, x0);
    store64(out + 8, y0);
    store64(out + 16, x1);
    store64(out + 24, y1);
    return 0;
}

# The point of segment (a, b) closest to p, and its parameter t in [0, 1]: (x, y, t). A segment
# shorter than EPSILON gives a. Mirrors `closest_point_on_segment`.
#must_use
fn _im_b2_closest_point_on_segment(ax: f64, ay: f64, bx: f64, by: f64, px: f64, py: f64): i64 {
    var abx: f64 = bx - ax;
    var aby: f64 = by - ay;
    var len_sq: f64 = abx * abx + aby * aby;
    if (len_sq < _IM_B2_EPSILON_SQ) {
        var z: f64 = 0.0;
        return (ax, ay, z);
    }
    var t0: f64 = ((px - ax) * abx + (py - ay) * aby) / len_sq;
    var t: f64 = _im_clamp(t0, 0.0, 1.0);
    var x: f64 = ax + abx * t;
    var y: f64 = ay + aby * t;
    return (x, y, t);
}

# The squared distance from (px, py) to (qx, qy), as `powi(2)`: two products.
#must_use
fn _im_b2_dist_sq(px: f64, py: f64, qx: f64, qy: f64): f64 {
    var x: f64 = px - qx;
    var y: f64 = py - qy;
    var r: f64 = x * x + y * y;
    return r;
}

# The closest points of segments (a, b) and (c, d) into out (on ab x, y, on cd x, y). Mirrors
# `closest_points_segments`: the four end-point projections, then the clamped analytic pair.
fn _im_b2_closest_points_segments(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64, dx: f64, dy: f64, out) {
    var abx: f64 = bx - ax;
    var aby: f64 = by - ay;
    var cdx: f64 = dx - cx;
    var cdy: f64 = dy - cy;
    var d1: f64 = abx * abx + aby * aby;
    var d2: f64 = cdx * cdx + cdy * cdy;
    var pax, pay, ta = _im_b2_closest_point_on_segment(cx, cy, dx, dy, ax, ay);
    var pbx, pby, tb = _im_b2_closest_point_on_segment(cx, cy, dx, dy, bx, by);
    var pcx, pcy, tc = _im_b2_closest_point_on_segment(ax, ay, bx, by, cx, cy);
    var pdx, pdy, td = _im_b2_closest_point_on_segment(ax, ay, bx, by, dx, dy);
    var b1x: f64 = ax;
    var b1y: f64 = ay;
    var b2x: f64 = pax;
    var b2y: f64 = pay;
    var best: f64 = _im_b2_dist_sq(ax, ay, pax, pay);
    var dd: f64 = _im_b2_dist_sq(bx, by, pbx, pby);
    if (dd < best) {
        b1x = bx; b1y = by; b2x = pbx; b2y = pby; best = dd;
    }
    dd = _im_b2_dist_sq(pcx, pcy, cx, cy);
    if (dd < best) {
        b1x = pcx; b1y = pcy; b2x = cx; b2y = cy; best = dd;
    }
    dd = _im_b2_dist_sq(pdx, pdy, dx, dy);
    if (dd < best) {
        b1x = pdx; b1y = pdy; b2x = dx; b2y = dy; best = dd;
    }
    if (d1 > _IM_B2_EPSILON_SQ && d2 > _IM_B2_EPSILON_SQ) {
        var rx: f64 = ax - cx;
        var ry: f64 = ay - cy;
        var d3: f64 = abx * cdx + aby * cdy;
        var d4: f64 = abx * rx + aby * ry;
        var d5: f64 = cdx * rx + cdy * ry;
        var denom: f64 = d1 * d2 - d3 * d3;
        var adenom: f64 = f64_abs(denom);
        if (adenom > _IM_B2_EPSILON_SQ) {
            var s0: f64 = (d3 * d5 - d4 * d2) / denom;
            var s: f64 = _im_clamp(s0, 0.0, 1.0);
            var t0: f64 = (d3 * s + d5) / d2;
            var t: f64 = _im_clamp(t0, 0.0, 1.0);
            var s1: f64 = (t * d3 - d4) / d1;
            s = _im_clamp(s1, 0.0, 1.0);
            var t1: f64 = (d3 * s + d5) / d2;
            t = _im_clamp(t1, 0.0, 1.0);
            var p1x: f64 = ax + abx * s;
            var p1y: f64 = ay + aby * s;
            var p2x: f64 = cx + cdx * t;
            var p2y: f64 = cy + cdy * t;
            dd = _im_b2_dist_sq(p1x, p1y, p2x, p2y);
            if (dd < best) {
                b1x = p1x; b1y = p1y; b2x = p2x; b2y = p2y;
            }
        }
    }
    store64(out, b1x);
    store64(out + 8, b1y);
    store64(out + 16, b2x);
    store64(out + 24, b2y);
    return 0;
}

# A capsule (at (cx, cy), rotated by crot, half height hh, radius cr) against a ball (at (bx, by),
# radius br) into out: 1, or 0. Mirrors `capsule_circle`.
fn _im_b2_capsule_circle(cx: f64, cy: f64, crot: f64, hh: f64, cr: f64, bx: f64, by: f64, br: f64, out): i64 {
    var e[32];
    _im_b2_capsule_endpoints(cx, cy, crot, hh, &e);
    var e0x: f64 = load64(&e);
    var e0y: f64 = load64(&e + 8);
    var e1x: f64 = load64(&e + 16);
    var e1y: f64 = load64(&e + 24);
    var qx, qy, t = _im_b2_closest_point_on_segment(e0x, e0y, e1x, e1y, bx, by);
    return _im_b2_circle_circle(qx, qy, cr, bx, by, br, out);
}

# Capsule A against capsule B into out: 1, or 0. Mirrors `capsule_capsule`.
fn _im_b2_capsule_capsule(ax: f64, ay: f64, ra: f64, hha: f64, cra: f64, bx: f64, by: f64, rb: f64, hhb: f64,
  crb: f64, out): i64 {
    var ea[32];
    var eb[32];
    var cp[32];
    _im_b2_capsule_endpoints(ax, ay, ra, hha, &ea);
    _im_b2_capsule_endpoints(bx, by, rb, hhb, &eb);
    var a1x: f64 = load64(&ea);
    var a1y: f64 = load64(&ea + 8);
    var a2x: f64 = load64(&ea + 16);
    var a2y: f64 = load64(&ea + 24);
    var b1x: f64 = load64(&eb);
    var b1y: f64 = load64(&eb + 8);
    var b2x: f64 = load64(&eb + 16);
    var b2y: f64 = load64(&eb + 24);
    _im_b2_closest_points_segments(a1x, a1y, a2x, a2y, b1x, b1y, b2x, b2y, &cp);
    var pax: f64 = load64(&cp);
    var pay: f64 = load64(&cp + 8);
    var pbx: f64 = load64(&cp + 16);
    var pby: f64 = load64(&cp + 24);
    return _im_b2_circle_circle(pax, pay, cra, pbx, pby, crb, out);
}

# A segment (end points (ax, ay), (bx, by) local to a body at (sx, sy) rotated by srot) against a
# ball into out: 1, or 0. The point is on the segment. Mirrors `segment_circle`.
fn _im_b2_segment_circle(sx: f64, sy: f64, srot: f64, ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64, cr: f64,
  out): i64 {
    var sn, cs = _im_sin_cos(srot);
    var s: f64 = sn;
    var c: f64 = cs;
    var wax: f64 = sx + c * ax - s * ay;
    var way: f64 = sy + s * ax + c * ay;
    var wbx: f64 = sx + c * bx - s * by;
    var wby: f64 = sy + s * bx + c * by;
    var qx, qy, t = _im_b2_closest_point_on_segment(wax, way, wbx, wby, cx, cy);
    var clx: f64 = qx;
    var cly: f64 = qy;
    var dx: f64 = cx - clx;
    var dy: f64 = cy - cly;
    var dist_sq: f64 = dx * dx + dy * dy;
    if (dist_sq >= cr * cr) { return 0; }
    var dist: f64 = f64_sqrt(dist_sq);
    if (dist < _IM_B2_EPSILON) {
        _im_b2_put(out, 0.0, 1.0, cr, clx, cly);
        return 1;
    }
    var nx: f64 = dx / dist;
    var ny: f64 = dy / dist;
    var depth: f64 = cr - dist;
    _im_b2_put(out, nx, ny, depth, clx, cly);
    return 1;
}

# ── polygons: area and edge normals ─────────────────────────────────────────────────

# Twice the signed area of the n points at pts, stride bytes apart (x, y first): positive for
# counter-clockwise. A left fold from -0.0, as Rust's f64 `sum`. Mirrors `signed_area_2x`.
#must_use
fn _im_b2_signed_area_2x(pts, n, stride): f64 {
    var acc: f64 = -0.0;
    for (var i = 0; i < n; i = i + 1) {
        var j = i + 1;
        if (j == n) { j = 0; }
        var ax: f64 = load64(pts + i * stride);
        var ay: f64 = load64(pts + i * stride + 8);
        var bx: f64 = load64(pts + j * stride);
        var by: f64 = load64(pts + j * stride + 8);
        var term: f64 = ax * by - bx * ay;
        acc = acc + term;
    }
    return acc;
}

# The outward unit normal of edge a → b for the winding (+1 counter-clockwise, -1 clockwise):
# (1, x, y), or (0, 0, 0) for an edge shorter than EPSILON. Mirrors `edge_normal`.
#must_use
fn _im_b2_edge_normal(ax: f64, ay: f64, bx: f64, by: f64, winding: f64): i64 {
    var ex: f64 = bx - ax;
    var ey: f64 = by - ay;
    var len: f64 = f64_sqrt(ex * ex + ey * ey);
    var z: f64 = 0.0;
    if (len < _IM_B2_EPSILON) { return (0, z, z); }
    var nx: f64 = winding * ey / len;
    var ny: f64 = -winding * ex / len;
    return (1, nx, ny);
}

# ── convex hull against a circle ────────────────────────────────────────────────────

# The convex hull of the n points at pts (3-word records, local to a body at (hx, hy) rotated by
# hrot, either winding) against a circle into out: 1, or 0. A centre inside the hull is pushed out
# through the least-penetrated face. The normal points from the hull to the circle. Mirrors
# `convex_hull_circle`.
fn _im_b2_hull_circle(pts, n, hx: f64, hy: f64, hrot: f64, cx: f64, cy: f64, radius: f64, out): i64 {
    if (n < 2) { return 0; }
    var area: f64 = _im_b2_signed_area_2x(pts, n, 24);
    var winding: f64 = 1.0;
    if (area < 0.0) { winding = -1.0; }
    var lcx, lcy = _im_b2_world_to_local(cx, cy, hx, hy, hrot);
    var c0: f64 = lcx;
    var c1: f64 = lcy;
    var zero: f64 = 0.0;
    var inf: f64 = 1.0 / zero;
    var best_d2: f64 = inf;
    var bcx: f64 = load64(pts);
    var bcy: f64 = load64(pts + 8);
    var max_sep: f64 = -inf;
    var snx: f64 = 0.0;
    var sny: f64 = 1.0;
    for (var i = 0; i < n; i = i + 1) {
        var j = i + 1;
        if (j == n) { j = 0; }
        var ax: f64 = load64(pts + i * 24);
        var ay: f64 = load64(pts + i * 24 + 8);
        var bx: f64 = load64(pts + j * 24);
        var by: f64 = load64(pts + j * 24 + 8);
        var qx, qy, t = _im_b2_closest_point_on_segment(ax, ay, bx, by, c0, c1);
        var d2: f64 = _im_b2_dist_sq(c0, c1, qx, qy);
        if (d2 < best_d2) {
            best_d2 = d2;
            bcx = qx;
            bcy = qy;
        }
        var ok, nx, ny = _im_b2_edge_normal(ax, ay, bx, by, winding);
        if (ok == 1) {
            var ex: f64 = c0 - ax;
            var ey: f64 = c1 - ay;
            var sep: f64 = _im_b2_dot2(nx, ny, ex, ey);
            if (sep > max_sep) {
                max_sep = sep;
                snx = nx;
                sny = ny;
            }
        }
    }
    var onx: f64 = 0.0;
    var ony: f64 = 0.0;
    var depth: f64 = 0.0;
    var ptx: f64 = 0.0;
    var pty: f64 = 0.0;
    if (n >= 3 && max_sep <= 0.0) {
        onx = snx;
        ony = sny;
        depth = radius - max_sep;
        ptx = c0 - snx * max_sep;
        pty = c1 - sny * max_sep;
    } else {
        if (best_d2 >= radius * radius) { return 0; }
        var dist: f64 = f64_sqrt(best_d2);
        if (dist < _IM_B2_EPSILON) {
            onx = snx;
            ony = sny;
            depth = radius;
        } else {
            onx = (c0 - bcx) / dist;
            ony = (c1 - bcy) / dist;
            depth = radius - dist;
        }
        ptx = bcx;
        pty = bcy;
    }
    var wnx, wny = _im_b2_rotate(onx, ony, hrot);
    var wpx, wpy = _im_b2_local_to_world(ptx, pty, hx, hy, hrot);
    _im_b2_put(out, wnx, wny, depth, wpx, wpy);
    return 1;
}

# ── pairs with a round shape ────────────────────────────────────────────────────────

# The single contact of a pair with a round shape (Ball, or Capsule against Ball or Capsule) into
# out: 1, or 0 when they don't touch or the pair has no round test. Mirrors `round_contact`.
fn _im_b2_round_contact(a: *ImColliderShape, ax: f64, ay: f64, ra: f64, b: *ImColliderShape, bx: f64, by: f64,
  rb: f64, out): i64 {
    var ka = a.kind;
    var kb = b.kind;
    if (ka == IM_SHAPE_BALL && kb == IM_SHAPE_BALL) {
        var r1: f64 = a.radius;
        var r2: f64 = b.radius;
        return _im_b2_circle_circle(ax, ay, r1, bx, by, r2, out);
    }
    if (ka == IM_SHAPE_BALL && kb == IM_SHAPE_BOX) {
        var r3: f64 = a.radius;
        var h1x: f64 = b.half_extents.x;
        var h1y: f64 = b.half_extents.y;
        if (_im_b2_circle_obb(ax, ay, r3, bx, by, rb, h1x, h1y, out) == 0) { return 0; }
        _im_b2_flip(out);
        return 1;
    }
    if (ka == IM_SHAPE_BOX && kb == IM_SHAPE_BALL) {
        var r4: f64 = b.radius;
        var h2x: f64 = a.half_extents.x;
        var h2y: f64 = a.half_extents.y;
        return _im_b2_circle_obb(bx, by, r4, ax, ay, ra, h2x, h2y, out);
    }
    if (ka == IM_SHAPE_CAPSULE && kb == IM_SHAPE_BALL) {
        var hh1: f64 = a.half_height;
        var cr1: f64 = a.radius;
        var br1: f64 = b.radius;
        return _im_b2_capsule_circle(ax, ay, ra, hh1, cr1, bx, by, br1, out);
    }
    if (ka == IM_SHAPE_BALL && kb == IM_SHAPE_CAPSULE) {
        var hh2: f64 = b.half_height;
        var cr2: f64 = b.radius;
        var br2: f64 = a.radius;
        if (_im_b2_capsule_circle(bx, by, rb, hh2, cr2, ax, ay, br2, out) == 0) { return 0; }
        _im_b2_flip(out);
        return 1;
    }
    if (ka == IM_SHAPE_CAPSULE && kb == IM_SHAPE_CAPSULE) {
        var hha: f64 = a.half_height;
        var cra: f64 = a.radius;
        var hhb: f64 = b.half_height;
        var crb: f64 = b.radius;
        return _im_b2_capsule_capsule(ax, ay, ra, hha, cra, bx, by, rb, hhb, crb, out);
    }
    if (ka == IM_SHAPE_CONVEX_HULL && kb == IM_SHAPE_BALL) {
        var r5: f64 = b.radius;
        return _im_b2_hull_circle(a.points, a.point_count, ax, ay, ra, bx, by, r5, out);
    }
    if (ka == IM_SHAPE_BALL && kb == IM_SHAPE_CONVEX_HULL) {
        var r6: f64 = a.radius;
        if (_im_b2_hull_circle(b.points, b.point_count, bx, by, rb, ax, ay, r6, out) == 0) { return 0; }
        _im_b2_flip(out);
        return 1;
    }
    if (ka == IM_SHAPE_SEGMENT && kb == IM_SHAPE_BALL) {
        var s1ax: f64 = a.a.x;
        var s1ay: f64 = a.a.y;
        var s1bx: f64 = a.b.x;
        var s1by: f64 = a.b.y;
        var r7: f64 = b.radius;
        return _im_b2_segment_circle(ax, ay, ra, s1ax, s1ay, s1bx, s1by, bx, by, r7, out);
    }
    if (ka == IM_SHAPE_BALL && kb == IM_SHAPE_SEGMENT) {
        var s2ax: f64 = b.a.x;
        var s2ay: f64 = b.a.y;
        var s2bx: f64 = b.b.x;
        var s2by: f64 = b.b.y;
        var r8: f64 = a.radius;
        if (_im_b2_segment_circle(bx, by, rb, s2ax, s2ay, s2bx, s2by, ax, ay, r8, out) == 0) { return 0; }
        _im_b2_flip(out);
        return 1;
    }
    return 0;
}

# ── polygons: Box, ConvexHull, Segment (reference/incident face clipping) ───────────

# Vertices a polygon keeps on the stack before the polygon paths take freelist storage.
const _IM_B2_POLY_STACK = 16;

# The number of vertices shape s has as a polygon: 4 for a box, 2 for a segment, its points for a
# hull; 0 for any other shape.
#must_use
fn _im_b2_poly_room(s: *ImColliderShape): i64 {
    if (s.kind == IM_SHAPE_BOX) { return 4; }
    if (s.kind == IM_SHAPE_SEGMENT) { return 2; }
    if (s.kind == IM_SHAPE_CONVEX_HULL) { return s.point_count; }
    return 0;
}

# The world vertices of polygon-like shape s at (px, py) rotated by rot into out ((x, y) pairs),
# counter-clockwise: the count, or -1 when s is no polygon (or a hull of fewer than 2 points).
# Mirrors `polygon_vertices` (and `transform_hull`): one rotation for all the vertices.
fn _im_b2_polygon_vertices(s: *ImColliderShape, px: f64, py: f64, rot: f64, out): i64 {
    var k = s.kind;
    if (k == IM_SHAPE_BOX) {
        var hx: f64 = s.half_extents.x;
        var hy: f64 = s.half_extents.y;
        store64(out, -hx); store64(out + 8, -hy);
        store64(out + 16, hx); store64(out + 24, -hy);
        store64(out + 32, hx); store64(out + 40, hy);
        store64(out + 48, -hx); store64(out + 56, hy);
        # Rust's local_to_world per vertex, with the rotation's sin_cos (a pure function) taken once.
        var bs, bc = _im_sin_cos(rot);
        var s4: f64 = bs;
        var c4: f64 = bc;
        for (var i = 0; i < 4; i = i + 1) {
            var lx: f64 = load64(out + i * 16);
            var ly: f64 = load64(out + i * 16 + 8);
            var wx: f64 = px + c4 * lx - s4 * ly;
            var wy: f64 = py + s4 * lx + c4 * ly;
            store64(out + i * 16, wx);
            store64(out + i * 16 + 8, wy);
        }
        return 4;
    }
    if (k == IM_SHAPE_CONVEX_HULL && s.point_count >= 2) {
        var n = s.point_count;
        var sn, cs = _im_sin_cos(rot);
        var sv: f64 = sn;
        var cv: f64 = cs;
        for (var j = 0; j < n; j = j + 1) {
            var qx: f64 = load64(s.points + j * 24);
            var qy: f64 = load64(s.points + j * 24 + 8);
            var tx: f64 = px + cv * qx - sv * qy;
            var ty: f64 = py + sv * qx + cv * qy;
            store64(out + j * 16, tx);
            store64(out + j * 16 + 8, ty);
        }
        var area: f64 = _im_b2_signed_area_2x(out, n, 16);
        if (area < 0.0) {
            var lo = 0;
            var hi = n - 1;
            while (lo < hi) {
                var x0 = load64(out + lo * 16);
                var y0 = load64(out + lo * 16 + 8);
                store64(out + lo * 16, load64(out + hi * 16));
                store64(out + lo * 16 + 8, load64(out + hi * 16 + 8));
                store64(out + hi * 16, x0);
                store64(out + hi * 16 + 8, y0);
                lo = lo + 1;
                hi = hi - 1;
            }
        }
        return n;
    }
    if (k == IM_SHAPE_SEGMENT) {
        var ax: f64 = s.a.x;
        var ay: f64 = s.a.y;
        var bx: f64 = s.b.x;
        var by: f64 = s.b.y;
        var wax, way = _im_b2_world_pos(px, py, rot, ax, ay);
        var wbx, wby = _im_b2_world_pos(px, py, rot, bx, by);
        store64(out, wax);
        store64(out + 8, way);
        store64(out + 16, wbx);
        store64(out + 24, wby);
        return 2;
    }
    return 0 - 1;
}

# The largest separation of polygon 2 from an edge of polygon 1 (both counter-clockwise, (x, y)
# pairs): (1, edge index, separation), or (0, 0, 0) when polygon 1 has no edge of length. A
# positive separation is a separating axis. Mirrors `max_separation`.
#must_use
fn _im_b2_max_separation(p1, n1, p2, n2): i64 {
    var found = 0;
    var edge = 0;
    var best: f64 = 0.0;
    for (var i = 0; i < n1; i = i + 1) {
        var j = i + 1;
        if (j == n1) { j = 0; }
        var v1x: f64 = load64(p1 + i * 16);
        var v1y: f64 = load64(p1 + i * 16 + 8);
        var wx: f64 = load64(p1 + j * 16);
        var wy: f64 = load64(p1 + j * 16 + 8);
        var ok, nx, ny = _im_b2_edge_normal(v1x, v1y, wx, wy, 1.0);
        if (ok == 1) {
            var zero: f64 = 0.0;
            var sep: f64 = 1.0 / zero;
            for (var q = 0; q < n2; q = q + 1) {
                var vx: f64 = load64(p2 + q * 16);
                var vy: f64 = load64(p2 + q * 16 + 8);
                var ex: f64 = vx - v1x;
                var ey: f64 = vy - v1y;
                var d: f64 = _im_b2_dot2(nx, ny, ex, ey);
                sep = _im_min(sep, d);
            }
            if (found == 0 || sep > best) {
                found = 1;
                edge = i;
                best = sep;
            }
        }
    }
    return (found, edge, best);
}

# Clips segment v (x0, y0, x1, y1) against the half-plane normal·p <= offset into out: 1 when two
# points remain, else 0. Mirrors `clip_segment`.
fn _im_b2_clip_segment(v, nx: f64, ny: f64, offset: f64, out): i64 {
    var v0x: f64 = load64(v);
    var v0y: f64 = load64(v + 8);
    var v1x: f64 = load64(v + 16);
    var v1y: f64 = load64(v + 24);
    var e0: f64 = _im_b2_dot2(nx, ny, v0x, v0y);
    var e1: f64 = _im_b2_dot2(nx, ny, v1x, v1y);
    var d0: f64 = e0 - offset;
    var d1: f64 = e1 - offset;
    var count = 0;
    if (d0 <= 0.0) {
        store64(out, v0x);
        store64(out + 8, v0y);
        count = 1;
    }
    if (d1 <= 0.0) {
        store64(out + count * 16, v1x);
        store64(out + count * 16 + 8, v1y);
        count = count + 1;
    }
    if (d0 * d1 < 0.0 && count < 2) {
        var t: f64 = d0 / (d0 - d1);
        var x: f64 = v0x + t * (v1x - v0x);
        var y: f64 = v0y + t * (v1y - v0y);
        store64(out + count * 16, x);
        store64(out + count * 16 + 8, y);
        count = count + 1;
    }
    if (count == 2) { return 1; }
    return 0;
}

# The manifold of two counter-clockwise polygons (at least 2 vertices each) into out (Box2D's
# b2CollidePolygons): -1 when a separating axis exists (or the reference edge has no length), else
# the 0 to 2 contacts the clipping leaves. Normals point from A to B. Mirrors `collide_polygons`.
fn _im_b2_collide_polygons(pa, na, pb, nb, out): i64 {
    var fa, edge_a, sa = _im_b2_max_separation(pa, na, pb, nb);
    if (fa == 0) { return 0 - 1; }
    var sep_a: f64 = sa;
    if (sep_a > 0.0) { return 0 - 1; }
    var fb, edge_b, sb = _im_b2_max_separation(pb, nb, pa, na);
    if (fb == 0) { return 0 - 1; }
    var sep_b: f64 = sb;
    if (sep_b > 0.0) { return 0 - 1; }
    var ref = pa;
    var nref = na;
    var inc = pb;
    var ninc = nb;
    var edge = edge_a;
    var flip = 0;
    if (sep_b > sep_a + 0.0005) {
        ref = pb;
        nref = nb;
        inc = pa;
        ninc = na;
        edge = edge_b;
        flip = 1;
    }
    var e2 = edge + 1;
    if (e2 == nref) { e2 = 0; }
    var v11x: f64 = load64(ref + edge * 16);
    var v11y: f64 = load64(ref + edge * 16 + 8);
    var v12x: f64 = load64(ref + e2 * 16);
    var v12y: f64 = load64(ref + e2 * 16 + 8);
    var rok, rnx0, rny0 = _im_b2_edge_normal(v11x, v11y, v12x, v12y, 1.0);
    if (rok == 0) { return 0 - 1; }
    var rnx: f64 = rnx0;
    var rny: f64 = rny0;
    var tx: f64 = -rny;
    var ty: f64 = rnx;
    var ie = 0;
    var zero: f64 = 0.0;
    var min_dot: f64 = 1.0 / zero;
    for (var i = 0; i < ninc; i = i + 1) {
        var j = i + 1;
        if (j == ninc) { j = 0; }
        var ax: f64 = load64(inc + i * 16);
        var ay: f64 = load64(inc + i * 16 + 8);
        var bx: f64 = load64(inc + j * 16);
        var by: f64 = load64(inc + j * 16 + 8);
        var ok, nx, ny = _im_b2_edge_normal(ax, ay, bx, by, 1.0);
        if (ok == 1) {
            var d: f64 = _im_b2_dot2(nx, ny, rnx, rny);
            if (d < min_dot) {
                min_dot = d;
                ie = i;
            }
        }
    }
    var ie2 = ie + 1;
    if (ie2 == ninc) { ie2 = 0; }
    var incident[32];
    store64(&incident, load64(inc + ie * 16));
    store64(&incident + 8, load64(inc + ie * 16 + 8));
    store64(&incident + 16, load64(inc + ie2 * 16));
    store64(&incident + 24, load64(inc + ie2 * 16 + 8));
    var c1[32];
    var c2[32];
    var t11: f64 = _im_b2_dot2(tx, ty, v11x, v11y);
    if (_im_b2_clip_segment(&incident, -tx, -ty, -t11, &c1) == 0) { return 0; }
    var t12: f64 = _im_b2_dot2(tx, ty, v12x, v12y);
    if (_im_b2_clip_segment(&c1, tx, ty, t12, &c2) == 0) { return 0; }
    var front: f64 = _im_b2_dot2(rnx, rny, v11x, v11y);
    var onx: f64 = rnx;
    var ony: f64 = rny;
    if (flip == 1) {
        onx = -rnx;
        ony = -rny;
    }
    var n = 0;
    for (var q = 0; q < 2; q = q + 1) {
        var vx: f64 = load64(&c2 + q * 16);
        var vy: f64 = load64(&c2 + q * 16 + 8);
        var dv: f64 = _im_b2_dot2(rnx, rny, vx, vy);
        var sep: f64 = dv - front;
        if (sep <= 0.0) {
            var px: f64 = vx - rnx * sep * 0.5;
            var py: f64 = vy - rny * sep * 0.5;
            _im_b2_put(out + n * _IM_B2_CONTACT, onx, ony, -sep, px, py);
            n = n + 1;
        }
    }
    return n;
}

# The extent (min, max) of the n polygon vertices along (ax, ay). Mirrors `project_hull`.
#must_use
fn _im_b2_project_hull(pts, n, ax: f64, ay: f64) {
    var zero: f64 = 0.0;
    var mx: f64 = -1.0 / zero;
    var mn: f64 = -mx;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = load64(pts + i * 16);
        var y: f64 = load64(pts + i * 16 + 8);
        var proj: f64 = x * ax + y * ay;
        mn = _im_min(mn, proj);
        mx = _im_max(mx, proj);
    }
    return (mn, mx);
}

# The vertex furthest along (dx, dy), the first of equals. Mirrors `support_point_poly`.
#must_use
fn _im_b2_support_point_poly(pts, n, dx: f64, dy: f64) {
    var bx: f64 = load64(pts);
    var by: f64 = load64(pts + 8);
    var best: f64 = bx * dx + by * dy;
    for (var i = 1; i < n; i = i + 1) {
        var x: f64 = load64(pts + i * 16);
        var y: f64 = load64(pts + i * 16 + 8);
        var d: f64 = x * dx + y * dy;
        if (d > best) {
            best = d;
            bx = x;
            by = y;
        }
    }
    return (bx, by);
}

# The single SAT contact of two world polygons, when clipping leaves none, into out: 1, or 0 when
# an axis separates them. The normal points from A (centre (cax, cay)) to B. Mirrors
# `sat_polygon_contact`.
fn _im_b2_sat_polygon_contact(wa, na, wb, nb, cax: f64, cay: f64, cbx: f64, cby: f64, out): i64 {
    var cdx: f64 = cbx - cax;
    var cdy: f64 = cby - cay;
    var zero: f64 = 0.0;
    var min_ov: f64 = 1.0 / zero;
    var bax: f64 = 0.0;
    var bay: f64 = 0.0;
    for (var h = 0; h < 2; h = h + 1) {
        var pts = wa;
        var n = na;
        if (h == 1) {
            pts = wb;
            n = nb;
        }
        for (var i = 0; i < n; i = i + 1) {
            var j = i + 1;
            if (j == n) { j = 0; }
            var x0: f64 = load64(pts + i * 16);
            var y0: f64 = load64(pts + i * 16 + 8);
            var x1: f64 = load64(pts + j * 16);
            var y1: f64 = load64(pts + j * 16 + 8);
            var ok, axw, ayw = _im_b2_edge_normal(x0, y0, x1, y1, 1.0);
            if (ok == 1) {
                # Multi-return values are untyped words: bind them before negating.
                var ax: f64 = axw;
                var ay: f64 = ayw;
                var mna, mxa = _im_b2_project_hull(wa, na, ax, ay);
                var mnb, mxb = _im_b2_project_hull(wb, nb, ax, ay);
                var hi: f64 = _im_min(mxa, mxb);
                var lo: f64 = _im_max(mna, mnb);
                var ov: f64 = hi - lo;
                if (ov <= 0.0) { return 0; }
                if (ov < min_ov) {
                    min_ov = ov;
                    var side: f64 = _im_b2_dot2(cdx, cdy, ax, ay);
                    bax = ax;
                    bay = ay;
                    if (!(side >= 0.0)) {
                        bax = -ax;
                        bay = -ay;
                    }
                }
            }
        }
    }
    if (_im_is_finite(min_ov) == 0) { return 0; }
    var pax, pay = _im_b2_support_point_poly(wa, na, bax, bay);
    var pbx, pby = _im_b2_support_point_poly(wb, nb, -bax, -bay);
    var qax: f64 = pax;
    var qay: f64 = pay;
    var qbx: f64 = pbx;
    var qby: f64 = pby;
    var px: f64 = (qax + qbx) * 0.5;
    var py: f64 = (qay + qby) * 0.5;
    _im_b2_put(out, bax, bay, min_ov, px, py);
    return 1;
}

# The contacts of two polygon-like shapes (Box, ConvexHull, Segment) into out: 0 to 2. Mirrors
# `polygon_contacts`. The vertices live on the stack up to _IM_B2_POLY_STACK each, else on freelist
# (no contacts when that storage can't be had).
fn _im_b2_polygon_contacts(a: *ImColliderShape, ax: f64, ay: f64, ra: f64, b: *ImColliderShape, bx: f64, by: f64,
  rb: f64, out): i64 {
    var room_a = _im_b2_poly_room(a);
    var room_b = _im_b2_poly_room(b);
    var local[512];
    var mem = &local;
    var heap = 0;
    if (room_a > _IM_B2_POLY_STACK || room_b > _IM_B2_POLY_STACK) {
        heap = fl_alloc((room_a + room_b) * 16 + 16);
        if (heap == 0) { return 0; }
        mem = heap;
    }
    var va = mem;
    var vb = mem + 256;
    if (heap != 0) { vb = mem + room_a * 16 + 8; }
    var n = 0;
    var na = _im_b2_polygon_vertices(a, ax, ay, ra, va);
    var nb = _im_b2_polygon_vertices(b, bx, by, rb, vb);
    if (na >= 0 && nb >= 0) {
        n = _im_b2_collide_polygons(va, na, vb, nb, out);
        if (n < 0) {
            n = 0;
        } elif (n == 0) {
            n = _im_b2_sat_polygon_contact(va, na, vb, nb, ax, ay, bx, by, out);
        }
    }
    if (heap != 0) { fl_free(heap); }
    return n;
}

# ── capsules against polygons ───────────────────────────────────────────────────────

# Copies the contact at src to dst (five words; memcpy moves bytes one at a time).
fn _im_b2_copy_contact(dst, src) {
    for (var w = 0; w < 5; w = w + 1) { store64(dst + w * 8, load64(src + w * 8)); }
    return 0;
}

# A capsule-radius circle at (px, py) against s in s's own frame into out: the box test when s is
# a Box, the hull test when it is a ConvexHull (Rust's `circle_test` closures).
fn _im_b2_cap_test(s: *ImColliderShape, cr: f64, px: f64, py: f64, out): i64 {
    if (s.kind == IM_SHAPE_BOX) {
        var hx: f64 = s.half_extents.x;
        var hy: f64 = s.half_extents.y;
        return _im_b2_circle_aabb(px, py, cr, 0.0, 0.0, hx, hy, out);
    }
    return _im_b2_hull_circle(s.points, s.point_count, 0.0, 0.0, 0.0, px, py, cr, out);
}

# Of two contacts at out, keeps only the deeper one (the first of equals) when their normals differ
# (dot < 0.999): a manifold shares one normal. Returns the count left.
fn _im_b2_keep_one_normal(out): i64 {
    var n0x: f64 = load64(out);
    var n0y: f64 = load64(out + 8);
    var n1x: f64 = load64(out + _IM_B2_CONTACT);
    var n1y: f64 = load64(out + _IM_B2_CONTACT + 8);
    var dot: f64 = _im_b2_dot2(n0x, n0y, n1x, n1y);
    if (!(dot < 0.999)) { return 2; }
    var d0: f64 = load64(out + 16);
    var d1: f64 = load64(out + _IM_B2_CONTACT + 16);
    if (!(d0 >= d1)) { _im_b2_copy_contact(out, out + _IM_B2_CONTACT); }
    return 1;
}

# The contacts of a capsule (axis end points e: x0, y0, x1, y1, in s's frame, radius cr) against s
# into out: both end caps; when neither touches, the deeper of the axis midpoint and the axis point
# nearest the frame's origin. Mirrors `capsule_end_contacts`.
fn _im_b2_capsule_end_contacts(e, s: *ImColliderShape, cr: f64, out): i64 {
    var e0x: f64 = load64(e);
    var e0y: f64 = load64(e + 8);
    var e1x: f64 = load64(e + 16);
    var e1y: f64 = load64(e + 24);
    var n = _im_b2_cap_test(s, cr, e0x, e0y, out);
    n = n + _im_b2_cap_test(s, cr, e1x, e1y, out + n * _IM_B2_CONTACT);
    if (n == 2) { n = _im_b2_keep_one_normal(out); }
    if (n > 0) { return n; }
    var mx: f64 = (e0x + e1x) * 0.5;
    var my: f64 = (e0y + e1y) * 0.5;
    var qx, qy, t = _im_b2_closest_point_on_segment(e0x, e0y, e1x, e1y, 0.0, 0.0);
    var c1[40];
    var c2[40];
    var h1 = _im_b2_cap_test(s, cr, mx, my, &c1);
    var h2 = _im_b2_cap_test(s, cr, qx, qy, &c2);
    if (h1 == 1 && h2 == 1) {
        var d1: f64 = load64(&c1 + 16);
        var d2: f64 = load64(&c2 + 16);
        if (d1 >= d2) { h2 = 0; } else { h1 = 0; }
    }
    if (h1 == 1) {
        _im_b2_copy_contact(out, &c1);
        return 1;
    }
    if (h2 == 1) {
        _im_b2_copy_contact(out, &c2);
        return 1;
    }
    return 0;
}

# A capsule (at (cx, cy), rotated by crot, half height hh, radius cr) against polygon s (a Box or a
# ConvexHull at (sx, sy), rotated by srot), worked in s's frame, into out: 0 to 2 contacts with
# normals from s to the capsule. Mirrors `capsule_obb` and `capsule_hull`.
fn _im_b2_capsule_in_frame(cx: f64, cy: f64, crot: f64, hh: f64, cr: f64, s: *ImColliderShape, sx: f64, sy: f64,
  srot: f64, out): i64 {
    var lx, ly = _im_b2_world_to_local(cx, cy, sx, sy, srot);
    var lrot: f64 = crot - srot;
    var e[32];
    _im_b2_capsule_endpoints(lx, ly, lrot, hh, &e);
    var n = _im_b2_capsule_end_contacts(&e, s, cr, out);
    for (var i = 0; i < n; i = i + 1) { _im_b2_box_to_world(out + i * _IM_B2_CONTACT, sx, sy, srot); }
    return n;
}

# A capsule against a segment (end points local to a body at (sx, sy) rotated by srot) into out: 0
# to 2 contacts with normals from the segment to the capsule. Mirrors `capsule_segment`.
fn _im_b2_capsule_segment(cx: f64, cy: f64, crot: f64, hh: f64, cr: f64, sx: f64, sy: f64, srot: f64, ax: f64,
  ay: f64, bx: f64, by: f64, out): i64 {
    var e[32];
    _im_b2_capsule_endpoints(cx, cy, crot, hh, &e);
    var e0x: f64 = load64(&e);
    var e0y: f64 = load64(&e + 8);
    var e1x: f64 = load64(&e + 16);
    var e1y: f64 = load64(&e + 24);
    var n = _im_b2_segment_circle(sx, sy, srot, ax, ay, bx, by, e0x, e0y, cr, out);
    n = n + _im_b2_segment_circle(sx, sy, srot, ax, ay, bx, by, e1x, e1y, cr, out + n * _IM_B2_CONTACT);
    if (n == 2) { n = _im_b2_keep_one_normal(out); }
    if (n > 0) { return n; }
    var wax, way = _im_b2_world_pos(sx, sy, srot, ax, ay);
    var wbx, wby = _im_b2_world_pos(sx, sy, srot, bx, by);
    var cp[32];
    _im_b2_closest_points_segments(wax, way, wbx, wby, e0x, e0y, e1x, e1y, &cp);
    var psx: f64 = load64(&cp);
    var psy: f64 = load64(&cp + 8);
    var pcx: f64 = load64(&cp + 16);
    var pcy: f64 = load64(&cp + 24);
    return _im_b2_circle_circle(psx, psy, 0.0, pcx, pcy, cr, out);
}

# ── the manifold ────────────────────────────────────────────────────────────────────

# 1 for a Box, ConvexHull or Segment. Mirrors `is_polygon`.
#must_use
fn _im_b2_is_polygon(s: *ImColliderShape): i64 {
    var k = s.kind;
    if (k == IM_SHAPE_BOX || k == IM_SHAPE_CONVEX_HULL || k == IM_SHAPE_SEGMENT) { return 1; }
    return 0;
}

# Every contact between shape A (at (ax, ay), rotated by ra) and shape B into out (room for
# _IM_B2_MAX_CONTACTS): a one-shot manifold of up to two points sharing one normal, from A to B.
# Returns the count. Heightfields and triangle meshes get none. Mirrors `generate_contacts_multi`.
fn _im_b2_generate_contacts_multi(a: *ImColliderShape, ax: f64, ay: f64, ra: f64, b: *ImColliderShape, bx: f64,
  by: f64, rb: f64, out): i64 {
    var ka = a.kind;
    var kb = b.kind;
    if (_im_b2_is_polygon(a) == 1 && _im_b2_is_polygon(b) == 1) {
        return _im_b2_polygon_contacts(a, ax, ay, ra, b, bx, by, rb, out);
    }
    var n = 0;
    if (ka == IM_SHAPE_CAPSULE && (kb == IM_SHAPE_BOX || kb == IM_SHAPE_CONVEX_HULL)) {
        var hh1: f64 = a.half_height;
        var cr1: f64 = a.radius;
        n = _im_b2_capsule_in_frame(ax, ay, ra, hh1, cr1, b, bx, by, rb, out);
        _im_b2_flip_all(out, n);
        return n;
    }
    if (kb == IM_SHAPE_CAPSULE && (ka == IM_SHAPE_BOX || ka == IM_SHAPE_CONVEX_HULL)) {
        var hh2: f64 = b.half_height;
        var cr2: f64 = b.radius;
        return _im_b2_capsule_in_frame(bx, by, rb, hh2, cr2, a, ax, ay, ra, out);
    }
    if (ka == IM_SHAPE_CAPSULE && kb == IM_SHAPE_SEGMENT) {
        var hh3: f64 = a.half_height;
        var cr3: f64 = a.radius;
        var s1ax: f64 = b.a.x;
        var s1ay: f64 = b.a.y;
        var s1bx: f64 = b.b.x;
        var s1by: f64 = b.b.y;
        n = _im_b2_capsule_segment(ax, ay, ra, hh3, cr3, bx, by, rb, s1ax, s1ay, s1bx, s1by, out);
        _im_b2_flip_all(out, n);
        return n;
    }
    if (kb == IM_SHAPE_CAPSULE && ka == IM_SHAPE_SEGMENT) {
        var hh4: f64 = b.half_height;
        var cr4: f64 = b.radius;
        var s2ax: f64 = a.a.x;
        var s2ay: f64 = a.a.y;
        var s2bx: f64 = a.b.x;
        var s2by: f64 = a.b.y;
        return _im_b2_capsule_segment(bx, by, rb, hh4, cr4, ax, ay, ra, s2ax, s2ay, s2bx, s2by, out);
    }
    return _im_b2_round_contact(a, ax, ay, ra, b, bx, by, rb, out);
}

# The deepest contact of the manifold into out (room for two): 1, or 0. Mirrors `generate_contact`
# (test-only in Rust; `deepest` keeps the first of equals).
fn _im_b2_generate_contact(a: *ImColliderShape, ax: f64, ay: f64, ra: f64, b: *ImColliderShape, bx: f64, by: f64,
  rb: f64, out): i64 {
    var n = _im_b2_generate_contacts_multi(a, ax, ay, ra, b, bx, by, rb, out);
    if (n == 2) {
        var d0: f64 = load64(out + 16);
        var d1: f64 = load64(out + _IM_B2_CONTACT + 16);
        if (!(d0 >= d1)) { _im_b2_copy_contact(out, out + _IM_B2_CONTACT); }
        return 1;
    }
    return n;
}

# 1 when the shapes touch: the round test alone when either is a Ball, else a non-empty manifold.
# Mirrors `shapes_touch`.
#must_use
fn _im_b2_shapes_touch(a: *ImColliderShape, ax: f64, ay: f64, ra: f64, b: *ImColliderShape, bx: f64, by: f64,
  rb: f64): i64 {
    var out[80];
    var n = 0;
    if (a.kind == IM_SHAPE_BALL || b.kind == IM_SHAPE_BALL) {
        n = _im_b2_round_contact(a, ax, ay, ra, b, bx, by, rb, &out);
    } else {
        n = _im_b2_generate_contacts_multi(a, ax, ay, ra, b, bx, by, rb, &out);
    }
    if (n > 0) { return 1; }
    return 0;
}

# --- b2_raycast.cyr ---

# b2_raycast.cyr — 2D ray and overlap queries (port of rust-old/src/backend_2d/raycast.rs).
#
# The ray tests per shape (circle, oriented box, capsule, segment, convex hull), the entry/exit interval
# a ray makes with a convex shape, and the per-collider parts of the world's queries: a ray against one
# collider, and one collider against an overlap probe. ImPhysicsState2d (M3) loops them over its
# colliders as `raycast_filtered`, `overlap_sphere` and `overlap_aabb` do.
#
# Every expression keeps Rust's operation order. Rotations go through `_im_sin_cos` and lengths through
# `_im_hypot`, both correctly rounded (ADR 0011 and its hypot amendment), so the rows are class C at
# 0 ulp against the corrected oracle. A rotation's sin_cos is taken once where Rust takes it per vertex
# (a pure function: the same bits). A hit is (t, normal x, y) in a caller's three-word buffer.

# ── the interval a ray makes with a convex shape ────────────────────────────────────

# Where a ray enters and leaves a convex shape (t along a unit direction), with the outward normal at
# each. Mirrors `RayInterval`.
struct ImRayInterval {
    t_in: f64;
    nx_in: f64;
    ny_in: f64;
    t_out: f64;
    nx_out: f64;
    ny_out: f64;
}

# Copies interval src to dst, field by field.
fn _im_b2_ray_copy(dst: *ImRayInterval, src: *ImRayInterval) {
    var a: f64 = src.t_in;
    var b: f64 = src.nx_in;
    var c: f64 = src.ny_in;
    var d: f64 = src.t_out;
    var e: f64 = src.nx_out;
    var f: f64 = src.ny_out;
    dst.t_in = a;
    dst.nx_in = b;
    dst.ny_in = c;
    dst.t_out = d;
    dst.nx_out = e;
    dst.ny_out = f;
    return 0;
}

# Writes the hit (t, nx, ny) at out.
fn _im_b2_put_hit(out, t: f64, nx: f64, ny: f64) {
    store64(out, t);
    store64(out + 8, nx);
    store64(out + 16, ny);
    return 0;
}

impl ImRayInterval {
    # The first hit at t ≥ 0 into out (t, nx, ny): the entry, or the exit for a ray that starts
    # inside. 1, or 0 when the shape is behind the ray. Mirrors `RayInterval::first`.
    fn first(self, out): i64 {
        var ti: f64 = self.t_in;
        if (ti >= 0.0) {
            var a: f64 = self.nx_in;
            var b: f64 = self.ny_in;
            _im_b2_put_hit(out, ti, a, b);
            return 1;
        }
        var to: f64 = self.t_out;
        if (to >= 0.0) {
            var c: f64 = self.nx_out;
            var d: f64 = self.ny_out;
            _im_b2_put_hit(out, to, c, d);
            return 1;
        }
        return 0;
    }

    # This interval unioned with o, two overlapping intervals of one convex shape: the earlier entry
    # and the later exit (o's only when strictly so). Mirrors `RayInterval::union`.
    fn merge(self, o: *ImRayInterval) {
        var si: f64 = self.t_in;
        var oi: f64 = o.t_in;
        if (oi < si) {
            var a: f64 = o.nx_in;
            var b: f64 = o.ny_in;
            self.t_in = oi;
            self.nx_in = a;
            self.ny_in = b;
        }
        var so: f64 = self.t_out;
        var oo: f64 = o.t_out;
        if (oo > so) {
            var c: f64 = o.nx_out;
            var d: f64 = o.ny_out;
            self.t_out = oo;
            self.nx_out = c;
            self.ny_out = d;
        }
        return 0;
    }
}

# ── circles ─────────────────────────────────────────────────────────────────────────

# A circle's outward normal at offset (px, py) from its centre: the unit offset, or the reversed ray
# direction when the offset is shorter than EPSILON.
#must_use
fn _im_b2_ray_circle_normal(px: f64, py: f64, dx: f64, dy: f64) {
    var len: f64 = _im_hypot(px, py);
    if (len > _IM_B2_EPSILON) {
        var nx: f64 = px / len;
        var ny: f64 = py / len;
        return (nx, ny);
    }
    var rx: f64 = -dx;
    var ry: f64 = -dy;
    return (rx, ry);
}

# The first hit (t ≥ 0) of the ray o + t·d (d unit) on the circle at (cx, cy) of radius r into out:
# the exit point when o is inside. 1, or 0. Mirrors `ray_circle_first`.
fn _im_b2_ray_circle_first(ox: f64, oy: f64, dx: f64, dy: f64, cx: f64, cy: f64, r: f64, out): i64 {
    var ocx: f64 = ox - cx;
    var ocy: f64 = oy - cy;
    var half_b: f64 = ocx * dx + ocy * dy;
    var c: f64 = ocx * ocx + ocy * ocy - r * r;
    var disc: f64 = half_b * half_b - c;
    if (disc != disc || disc < 0.0) { return 0; }
    var sq: f64 = f64_sqrt(disc);
    var t: f64 = -half_b - sq;
    if (!(t >= 0.0)) {
        t = -half_b + sq;
        if (!(t >= 0.0)) { return 0; }
    }
    var px: f64 = ocx + dx * t;
    var py: f64 = ocy + dy * t;
    var nx, ny = _im_b2_ray_circle_normal(px, py, dx, dy);
    _im_b2_put_hit(out, t, nx, ny);
    return 1;
}

# The interval of the ray on the circle into iv: 1, or 0 when the ray's line misses it. Mirrors
# `ray_circle_interval`.
fn _im_b2_ray_circle_interval(ox: f64, oy: f64, dx: f64, dy: f64, cx: f64, cy: f64, r: f64, iv: *ImRayInterval): i64 {
    var ocx: f64 = ox - cx;
    var ocy: f64 = oy - cy;
    var half_b: f64 = ocx * dx + ocy * dy;
    var c: f64 = ocx * ocx + ocy * ocy - r * r;
    var disc: f64 = half_b * half_b - c;
    if (disc != disc || disc < 0.0) { return 0; }
    var sq: f64 = f64_sqrt(disc);
    var t_in: f64 = -half_b - sq;
    var t_out: f64 = -half_b + sq;
    var pix: f64 = ox + dx * t_in - cx;
    var piy: f64 = oy + dy * t_in - cy;
    var nix, niy = _im_b2_ray_circle_normal(pix, piy, dx, dy);
    var pox: f64 = ox + dx * t_out - cx;
    var poy: f64 = oy + dy * t_out - cy;
    var nox, noy = _im_b2_ray_circle_normal(pox, poy, dx, dy);
    iv.t_in = t_in;
    iv.nx_in = nix;
    iv.ny_in = niy;
    iv.t_out = t_out;
    iv.nx_out = nox;
    iv.ny_out = noy;
    return 1;
}

# ── boxes and polygons ──────────────────────────────────────────────────────────────

# One slab of `ray_aabb_interval`: the ray's coordinate o and direction d on axis `axis` (0 x, 1 y)
# against [mn, mx], narrowing iv. 0 when the ray misses.
fn _im_b2_ray_slab(iv: *ImRayInterval, o: f64, d: f64, mn: f64, mx: f64, axis): i64 {
    var ad: f64 = f64_abs(d);
    if (ad < _IM_B2_EPSILON) {
        if (o < mn || o > mx) { return 0; }
        return 1;
    }
    var inv: f64 = 1.0 / d;
    var t1: f64 = (mn - o) * inv;
    var t2: f64 = (mx - o) * inv;
    var s1: f64 = -1.0;
    var s2: f64 = 1.0;
    if (t1 > t2) {
        var tt: f64 = t1;
        t1 = t2;
        t2 = tt;
        s1 = 1.0;
        s2 = -1.0;
    }
    var ti: f64 = iv.t_in;
    if (t1 > ti) {
        iv.t_in = t1;
        if (axis == 0) {
            iv.nx_in = s1;
            iv.ny_in = 0.0;
        } else {
            iv.nx_in = 0.0;
            iv.ny_in = s1;
        }
    }
    var to: f64 = iv.t_out;
    if (t2 < to) {
        iv.t_out = t2;
        if (axis == 0) {
            iv.nx_out = s2;
            iv.ny_out = 0.0;
        } else {
            iv.nx_out = 0.0;
            iv.ny_out = s2;
        }
    }
    var ni: f64 = iv.t_in;
    var no: f64 = iv.t_out;
    if (ni > no) { return 0; }
    return 1;
}

# The interval of the ray on the axis-aligned box [min, max] into iv (slabs): 1, or 0. Mirrors
# `ray_aabb_interval`.
fn _im_b2_ray_aabb_interval(ox: f64, oy: f64, dx: f64, dy: f64, mnx: f64, mny: f64, mxx: f64, mxy: f64,
  iv: *ImRayInterval): i64 {
    var zero: f64 = 0.0;
    var inf: f64 = 1.0 / zero;
    iv.t_in = -inf;
    iv.nx_in = -dx;
    iv.ny_in = -dy;
    iv.t_out = inf;
    iv.nx_out = dx;
    iv.ny_out = dy;
    if (_im_b2_ray_slab(iv, ox, dx, mnx, mxx, 0) == 0) { return 0; }
    return _im_b2_ray_slab(iv, oy, dy, mny, mxy, 1);
}

# The interval of the ray on the counter-clockwise convex polygon of n vertices at verts ((x, y)
# pairs) into iv, by Cyrus–Beck clipping: 1, or 0. Mirrors `ray_polygon_interval`.
fn _im_b2_ray_polygon_interval(ox: f64, oy: f64, dx: f64, dy: f64, verts, n, iv: *ImRayInterval): i64 {
    var zero: f64 = 0.0;
    var inf: f64 = 1.0 / zero;
    iv.t_in = -inf;
    iv.nx_in = -dx;
    iv.ny_in = -dy;
    iv.t_out = inf;
    iv.nx_out = dx;
    iv.ny_out = dy;
    for (var i = 0; i < n; i = i + 1) {
        var j = i + 1;
        if (j == n) { j = 0; }
        var ax: f64 = load64(verts + i * 16);
        var ay: f64 = load64(verts + i * 16 + 8);
        var bx: f64 = load64(verts + j * 16);
        var by: f64 = load64(verts + j * 16 + 8);
        var ex: f64 = bx - ax;
        var ey: f64 = by - ay;
        var len: f64 = _im_hypot(ex, ey);
        if (!(len < _IM_B2_EPSILON)) {
            var nx: f64 = ey / len;
            var ny: f64 = -ex / len;
            var dist: f64 = (ox - ax) * nx + (oy - ay) * ny;
            var rate: f64 = dx * nx + dy * ny;
            var ar: f64 = f64_abs(rate);
            if (ar < _IM_B2_EPSILON) {
                if (dist > 0.0) { return 0; }
            } else {
                var t: f64 = -dist / rate;
                if (rate < 0.0) {
                    var ti: f64 = iv.t_in;
                    if (t > ti) {
                        iv.t_in = t;
                        iv.nx_in = nx;
                        iv.ny_in = ny;
                    }
                } else {
                    var to: f64 = iv.t_out;
                    if (t < to) {
                        iv.t_out = t;
                        iv.nx_out = nx;
                        iv.ny_out = ny;
                    }
                }
                var ni: f64 = iv.t_in;
                var no: f64 = iv.t_out;
                if (ni > no) { return 0; }
            }
        }
    }
    return 1;
}

# The hit of the ray on segment (a, b) into out (t, normal facing the ray): 1, or 0 when parallel,
# outside the segment or behind the ray. Mirrors `ray_segment`.
fn _im_b2_ray_segment(ox: f64, oy: f64, dx: f64, dy: f64, ax: f64, ay: f64, bx: f64, by: f64, out): i64 {
    var ex: f64 = bx - ax;
    var ey: f64 = by - ay;
    var denom: f64 = dx * ey - dy * ex;
    var ad: f64 = f64_abs(denom);
    if (ad < _IM_B2_EPSILON) { return 0; }
    var aox: f64 = ax - ox;
    var aoy: f64 = ay - oy;
    var t: f64 = (aox * ey - aoy * ex) / denom;
    var u: f64 = (aox * dy - aoy * dx) / denom;
    if (!(u >= 0.0 && u <= 1.0) || t < 0.0) { return 0; }
    var len: f64 = _im_hypot(ex, ey);
    var nx: f64 = ey / len;
    var ny: f64 = -ex / len;
    var facing: f64 = nx * dx + ny * dy;
    if (facing > 0.0) {
        nx = -nx;
        ny = -ny;
    }
    _im_b2_put_hit(out, t, nx, ny);
    return 1;
}

# ── capsules ────────────────────────────────────────────────────────────────────────

# The interval of the ray on a capsule (at (cx, cy), rotated by crot, half height hh, radius r) into
# iv: the union of its two end discs and its shaft rectangle, in that order. 1, or 0. Mirrors
# `ray_capsule_interval`.
fn _im_b2_ray_capsule_interval(ox: f64, oy: f64, dx: f64, dy: f64, cx: f64, cy: f64, crot: f64, hh: f64, r: f64,
  iv: *ImRayInterval): i64 {
    var e[32];
    _im_b2_capsule_endpoints(cx, cy, crot, hh, &e);
    var eax: f64 = load64(&e);
    var eay: f64 = load64(&e + 8);
    var ebx: f64 = load64(&e + 16);
    var eby: f64 = load64(&e + 24);
    var part: ImRayInterval;
    var have = _im_b2_ray_circle_interval(ox, oy, dx, dy, eax, eay, r, iv);
    if (_im_b2_ray_circle_interval(ox, oy, dx, dy, ebx, eby, r, &part) == 1) {
        if (have == 1) {
            iv.merge(&part);
        } else {
            _im_b2_ray_copy(iv, &part);
            have = 1;
        }
    }
    var axx: f64 = ebx - eax;
    var axy: f64 = eby - eay;
    var axis_len: f64 = _im_hypot(axx, axy);
    if (axis_len > _IM_B2_EPSILON) {
        var ux: f64 = axx / axis_len;
        var uy: f64 = axy / axis_len;
        var px: f64 = -uy;
        var py: f64 = ux;
        var rx: f64 = ox - cx;
        var ry: f64 = oy - cy;
        var lox: f64 = rx * ux + ry * uy;
        var loy: f64 = rx * px + ry * py;
        var ldx: f64 = dx * ux + dy * uy;
        var ldy: f64 = dx * px + dy * py;
        if (_im_b2_ray_aabb_interval(lox, loy, ldx, ldy, -hh, -r, hh, r, &part) == 1) {
            # Back to world: n.x along the axis, n.y along its perpendicular.
            var a0: f64 = part.nx_in;
            var a1: f64 = part.ny_in;
            var b0: f64 = part.nx_out;
            var b1: f64 = part.ny_out;
            var wix: f64 = a0 * ux + a1 * px;
            var wiy: f64 = a0 * uy + a1 * py;
            var wox: f64 = b0 * ux + b1 * px;
            var woy: f64 = b0 * uy + b1 * py;
            part.nx_in = wix;
            part.ny_in = wiy;
            part.nx_out = wox;
            part.ny_out = woy;
            if (have == 1) {
                iv.merge(&part);
            } else {
                _im_b2_ray_copy(iv, &part);
                have = 1;
            }
        }
    }
    return have;
}

# ── any shape ───────────────────────────────────────────────────────────────────────

# The interval of the ray (d unit) on shape s at (px, py) rotated by rot into iv: 1, or 0 when it
# misses or the shape takes no ray (a heightfield, a mesh, a hull of fewer than 3 points). Mirrors
# `ray_shape`.
fn _im_b2_ray_shape(s: *ImColliderShape, px: f64, py: f64, rot: f64, ox: f64, oy: f64, dx: f64, dy: f64,
  iv: *ImRayInterval): i64 {
    var k = s.kind;
    if (k == IM_SHAPE_BALL) {
        var br: f64 = s.radius;
        return _im_b2_ray_circle_interval(ox, oy, dx, dy, px, py, br, iv);
    }
    if (k == IM_SHAPE_BOX) {
        # In the box's frame, then the normals rotated back (one sin_cos for all three).
        var sn, cs = _im_sin_cos(rot);
        var sv: f64 = sn;
        var cv: f64 = cs;
        var rx: f64 = ox - px;
        var ry: f64 = oy - py;
        var lox: f64 = cv * rx + sv * ry;
        var loy: f64 = -sv * rx + cv * ry;
        var ldx: f64 = cv * dx + sv * dy;
        var ldy: f64 = -sv * dx + cv * dy;
        var hx0: f64 = s.half_extents.x;
        var hy0: f64 = s.half_extents.y;
        var hx: f64 = f64_abs(hx0);
        var hy: f64 = f64_abs(hy0);
        if (_im_b2_ray_aabb_interval(lox, loy, ldx, ldy, -hx, -hy, hx, hy, iv) == 0) { return 0; }
        var a0: f64 = iv.nx_in;
        var a1: f64 = iv.ny_in;
        var b0: f64 = iv.nx_out;
        var b1: f64 = iv.ny_out;
        var wix: f64 = cv * a0 - sv * a1;
        var wiy: f64 = sv * a0 + cv * a1;
        var wox: f64 = cv * b0 - sv * b1;
        var woy: f64 = sv * b0 + cv * b1;
        iv.nx_in = wix;
        iv.ny_in = wiy;
        iv.nx_out = wox;
        iv.ny_out = woy;
        return 1;
    }
    if (k == IM_SHAPE_CAPSULE) {
        var hh: f64 = s.half_height;
        var cr: f64 = s.radius;
        return _im_b2_ray_capsule_interval(ox, oy, dx, dy, px, py, rot, hh, cr, iv);
    }
    if (k == IM_SHAPE_SEGMENT) {
        var sax: f64 = s.a.x;
        var say: f64 = s.a.y;
        var sbx: f64 = s.b.x;
        var sby: f64 = s.b.y;
        var wax, way = _im_b2_world_pos(px, py, rot, sax, say);
        var wbx, wby = _im_b2_world_pos(px, py, rot, sbx, sby);
        var hit[24];
        if (_im_b2_ray_segment(ox, oy, dx, dy, wax, way, wbx, wby, &hit) == 0) { return 0; }
        var t: f64 = load64(&hit);
        var nx: f64 = load64(&hit + 8);
        var ny: f64 = load64(&hit + 16);
        iv.t_in = t;
        iv.nx_in = nx;
        iv.ny_in = ny;
        iv.t_out = t;
        iv.nx_out = nx;
        iv.ny_out = ny;
        return 1;
    }
    if (k == IM_SHAPE_CONVEX_HULL && s.point_count >= 3) {
        var n = s.point_count;
        var local[256];
        var verts = &local;
        var heap = 0;
        if (n > _IM_B2_POLY_STACK) {
            heap = fl_alloc(n * 16);
            if (heap == 0) { return 0; }
            verts = heap;
        }
        var hs, hc = _im_sin_cos(rot);
        var hsv: f64 = hs;
        var hcv: f64 = hc;
        for (var j = 0; j < n; j = j + 1) {
            var qx: f64 = load64(s.points + j * 24);
            var qy: f64 = load64(s.points + j * 24 + 8);
            var tx: f64 = px + hcv * qx - hsv * qy;
            var ty: f64 = py + hsv * qx + hcv * qy;
            store64(verts + j * 16, tx);
            store64(verts + j * 16 + 8, ty);
        }
        var area: f64 = _im_b2_signed_area_2x(verts, n, 16);
        if (area < 0.0) {
            var lo = 0;
            var hi = n - 1;
            while (lo < hi) {
                var x0 = load64(verts + lo * 16);
                var y0 = load64(verts + lo * 16 + 8);
                store64(verts + lo * 16, load64(verts + hi * 16));
                store64(verts + lo * 16 + 8, load64(verts + hi * 16 + 8));
                store64(verts + hi * 16, x0);
                store64(verts + hi * 16 + 8, y0);
                lo = lo + 1;
                hi = hi - 1;
            }
        }
        var got = _im_b2_ray_polygon_interval(ox, oy, dx, dy, verts, n, iv);
        if (heap != 0) { fl_free(heap); }
        return got;
    }
    return 0;
}

# The first hit of the ray on circle (cx, cy, r) into out: `ray_circle_first`, which Rust's tests
# check against the interval's. Mirrors `ray_circle` (test-only in Rust).
fn _im_b2_ray_circle(ox: f64, oy: f64, dx: f64, dy: f64, cx: f64, cy: f64, r: f64, out): i64 {
    return _im_b2_ray_circle_first(ox, oy, dx, dy, cx, cy, r, out);
}

# The first hit of the ray on the box [min, max] into out. Mirrors `ray_aabb_2d` (test-only in Rust).
fn _im_b2_ray_aabb_2d(ox: f64, oy: f64, dx: f64, dy: f64, mnx: f64, mny: f64, mxx: f64, mxy: f64, out): i64 {
    var iv: ImRayInterval;
    if (_im_b2_ray_aabb_interval(ox, oy, dx, dy, mnx, mny, mxx, mxy, &iv) == 0) { return 0; }
    return iv.first(out);
}

# ── the world's queries, per collider ───────────────────────────────────────────────

# The unit direction of (dx, dy): (1, x, y), or (0, 0, 0) when its length is NaN, infinite or below
# EPSILON (no ray). The first step of `raycast_filtered`.
#must_use
fn _im_b2_ray_direction(dx: f64, dy: f64): i64 {
    var len: f64 = _im_hypot(dx, dy);
    var z: f64 = 0.0;
    if (len != len || len < _IM_B2_EPSILON || _im_is_finite(len) == 0) { return (0, z, z); }
    var ux: f64 = dx / len;
    var uy: f64 = dy / len;
    return (1, ux, uy);
}

# The first hit of the ray o + t·d (d unit, from `_im_b2_ray_direction`) on collider c of body b into
# out (t, nx, ny): 1, or 0. The loop body of `raycast_filtered`, before its layer filter and
# max-distance and nearest-hit choice.
fn _im_b2_raycast_collider(b: *ImRigidBody2d, c: *ImCollider2d, ox: f64, oy: f64, dx: f64, dy: f64, out): i64 {
    var bx: f64 = b.position.x;
    var by: f64 = b.position.y;
    var rot: f64 = b.rotation;
    var offx: f64 = c.offset.x;
    var offy: f64 = c.offset.y;
    var wx, wy = _im_b2_world_pos(bx, by, rot, offx, offy);
    if (c.shape.kind == IM_SHAPE_BALL) {
        var r: f64 = c.shape.radius;
        return _im_b2_ray_circle_first(ox, oy, dx, dy, wx, wy, r, out);
    }
    var iv: ImRayInterval;
    if (_im_b2_ray_shape(c.shape, wx, wy, rot, ox, oy, dx, dy, &iv) == 0) { return 0; }
    return iv.first(out);
}

# 1 when collider c of body b overlaps the probe shape at (px, py) whose box is probe_box: its world
# AABB must meet the box, then the contact test decides (a heightfield or a mesh on its box alone).
# The loop body of `overlap_shape`.
fn _im_b2_overlap_collider(b: *ImRigidBody2d, c: *ImCollider2d, probe: *ImColliderShape, px: f64, py: f64,
  probe_box: *ImAabb2d): i64 {
    var bx: f64 = b.position.x;
    var by: f64 = b.position.y;
    var rot: f64 = b.rotation;
    var wb: ImAabb2d = c.world_aabb(ImVec2_new(bx, by), rot);
    if (probe_box.overlaps(&wb) == 0) { return 0; }
    var k = c.shape.kind;
    if (k == IM_SHAPE_HEIGHTFIELD || k == IM_SHAPE_TRI_MESH) { return 1; }
    var offx: f64 = c.offset.x;
    var offy: f64 = c.offset.y;
    var wx, wy = _im_b2_world_pos(bx, by, rot, offx, offy);
    return _im_b2_shapes_touch(probe, px, py, 0.0, c.shape, wx, wy, rot);
}

# --- json.cyr ---

# json.cyr — serde-compatible JSON (ADR 0010): the same documents the Rust crate's serde_json writes
# and reads.
#
# Writers append to a `str_builder`, fields in Rust declaration order, f64 through src/fmtf.cyr's
# serde_json form, handles as unsigned decimals. Readers parse with bayan's value tree (never the
# derive scanner, whose open defects malformed input could reach) into one decode arena reset per
# call, so decoding never grows the heap, and apply serde's derive semantics, as serde_json 1.0.154
# was probed to (port-parity.md §7):
# - a struct reads from an object (by field name) or from an array (by position, serde's sequence
#   form). In an array, trailing `#[serde(default)]` fields may be left off; an `Option` field
#   without a default may not, nor may there be extra elements;
# - a required field missing, a value of the wrong JSON type, an array of the wrong length, or an enum
#   name that is no variant is Err(IM_ERR_DESERIALIZE);
# - a `#[serde(default)]` field may be absent (its default), and so may an `Option` field (None);
# - unknown fields are ignored; a duplicate key refuses the document (bayan; see S4 below);
# - an enum is externally tagged: a unit variant is `"Name"` or `{"Name":null}`, a struct variant
#   `{"Name":{..}}` or `{"Name":[..]}`, one key only;
# - an f64 takes a JSON integer or float, never `null` (serde_json writes NaN and ±∞ as `null` and
#   can't read them back, nor can the port);
# - a u32 takes a JSON integer in 0..=4294967295 only (`4.0` and `-1` are refused), a handle (u64) a
#   non-negative integer.
# Two bayan policies are stricter than serde_json (port plan §8): an integer above i64::MAX refuses
# the document (S3: a handle at generation ≥ 2^31, which serde_json writes), and so does any
# duplicate key, even one serde would ignore (S4). Not thread-safe: the decode arena is module state.

include "lib/bayan.cyr"
include "lib/str.cyr"

# ── writer ──────────────────────────────────────────────────────────────────────────

# Appends `"name":`, preceded by a comma unless `first` is 1.
fn _im_jw_key(sb, name, first) {
    if (first == 0) { str_builder_putc(sb, 44); }
    str_builder_putc(sb, 34);
    str_builder_add_cstr(sb, name);
    str_builder_putc(sb, 34);
    str_builder_putc(sb, 58);
    return 0;
}

# Appends `true` or `false`.
fn _im_jw_bool(sb, b) {
    if (b == 1) { str_builder_add_cstr(sb, "true"); } else { str_builder_add_cstr(sb, "false"); }
    return 0;
}

# Appends the quoted string `s` (a C string with no characters that need escaping: variant names).
fn _im_jw_name(sb, s) {
    str_builder_putc(sb, 34);
    str_builder_add_cstr(sb, s);
    str_builder_putc(sb, 34);
    return 0;
}

# Appends the word x as an unsigned decimal (a u64: handles, `step`).
fn _im_jw_u64(sb, x) {
    if (x >= 0) {
        str_builder_add_int(sb, x);
        return 0;
    }
    # x ≥ 2^63 unsigned: x = 10·q + r with q = (x >>> 1) / 5 (logical shift).
    var q = (x >> 1) / 5;
    var r = x - q * 10;
    str_builder_add_int(sb, q);
    str_builder_putc(sb, 48 + r);
    return 0;
}

# Appends `[x,y]`.
fn _im_jw_vec2(sb, v: ImVec2) {
    var x: f64 = v.x;
    var y: f64 = v.y;
    str_builder_putc(sb, 91);
    im_fmt_f64_json(sb, x);
    str_builder_putc(sb, 44);
    im_fmt_f64_json(sb, y);
    str_builder_putc(sb, 93);
    return 0;
}

# Appends `[x,y,z]`.
fn _im_jw_vec3(sb, v: ImVec3) {
    var x: f64 = v.x;
    var y: f64 = v.y;
    var z: f64 = v.z;
    str_builder_putc(sb, 91);
    im_fmt_f64_json(sb, x);
    str_builder_putc(sb, 44);
    im_fmt_f64_json(sb, y);
    str_builder_putc(sb, 44);
    im_fmt_f64_json(sb, z);
    str_builder_putc(sb, 93);
    return 0;
}

# Appends the `n` f64 words at p as `[a,b,..]`.
fn _im_jw_f64_list(sb, p, n) {
    str_builder_putc(sb, 91);
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { str_builder_putc(sb, 44); }
        var x: f64 = load64(p + i * 8);
        im_fmt_f64_json(sb, x);
    }
    str_builder_putc(sb, 93);
    return 0;
}

# Appends the `n` triples of words at p as `[[a,b,c],..]`: f64 when `is_f64` is 1, else integers.
fn _im_jw_triples(sb, p, n, is_f64) {
    str_builder_putc(sb, 91);
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { str_builder_putc(sb, 44); }
        str_builder_putc(sb, 91);
        for (var j = 0; j < 3; j = j + 1) {
            if (j > 0) { str_builder_putc(sb, 44); }
            var w = load64(p + (i * 3 + j) * 8);
            if (is_f64 == 1) {
                var x: f64 = w;
                im_fmt_f64_json(sb, x);
            } else {
                str_builder_add_int(sb, w);
            }
        }
        str_builder_putc(sb, 93);
    }
    str_builder_putc(sb, 93);
    return 0;
}

# Appends an `Option<f64>`: the number, or `null` without one.
fn _im_jw_opt_f64(sb, has, x: f64) {
    if (has == 1) { im_fmt_f64_json(sb, x); } else { str_builder_add_cstr(sb, "null"); }
    return 0;
}

# Appends `{"Name":` for a struct variant (closed by the caller's two `}`).
fn _im_jw_variant(sb, name) {
    str_builder_putc(sb, 123);
    _im_jw_name(sb, name);
    str_builder_putc(sb, 58);
    return 0;
}

# ── reader ──────────────────────────────────────────────────────────────────────────

var _im_json_arena = 0;

# The parsed tree of [buf, buf + len), on the decode arena (reset first), or 0 when the text is not
# one JSON value.
#must_use
fn _im_jr_parse(buf, len): i64 {
    if (_im_json_arena == 0) { _im_json_arena = arena_allocator_growable(4096); }
    if (_im_json_arena == 0) { return 0; }
    reset_via(_im_json_arena);
    return bayan_json_v_parse_buf_a(_im_json_arena, buf, len);
}

# The form of struct node v with `n` fields: 1 an object, 2 an array of at most n elements (serde's
# sequence form), 0 anything else.
#must_use
fn _im_jr_form(v, n): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_OBJ) { return 1; }
    if (tag == JTAG_ARR && bayan_json_v_arr_len(v) <= n) { return 2; }
    return 0;
}

# Field i, named `name`, of struct node v in `form`: its value, or 0 when absent.
#must_use
fn _im_jr_at(v, form, i, name): i64 {
    if (form == 1) { return bayan_json_v_obj_get_by_cstr(v, name); }
    if (i < bayan_json_v_arr_len(v)) { return bayan_json_v_arr_get(v, i); }
    return 0;
}

# 1 when v is JSON null.
#must_use
fn _im_jr_is_null(v): i64 {
    if (v != 0 && bayan_json_v_tag(v) == JTAG_NULL) { return 1; }
    return 0;
}

# A JSON number as an f64 into *out: 1, or 0 for any other value (null included).
fn _im_jr_f64(v, out): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    if (tag != JTAG_INT && tag != JTAG_FLOAT) { return 0; }
    store64(out, bayan_json_v_float(v));
    return 1;
}

# A JSON integer in [lo, hi] into *out: 1, or 0.
fn _im_jr_int(v, lo, hi, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_INT) { return 0; }
    var n = bayan_json_v_int(v);
    if (n < lo || n > hi) { return 0; }
    store64(out, n);
    return 1;
}

# A handle (u64) into *out: 1, or 0. bayan has no integer above i64::MAX (S3).
fn _im_jr_u64(v, out): i64 {
    return _im_jr_int(v, 0, 0x7FFFFFFFFFFFFFFF, out);
}

# A u32 into *out: 1, or 0.
fn _im_jr_u32(v, out): i64 {
    return _im_jr_int(v, 0, 4294967295, out);
}

# A JSON boolean into *out (0 / 1): 1, or 0.
fn _im_jr_bool(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_BOOL) { return 0; }
    store64(out, bayan_json_v_bool(v));
    return 1;
}

# A JSON array of exactly n numbers into the n words at out: 1, or 0.
fn _im_jr_f64s(v, n, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_ARR || bayan_json_v_arr_len(v) != n) { return 0; }
    for (var i = 0; i < n; i = i + 1) {
        if (_im_jr_f64(bayan_json_v_arr_get(v, i), out + i * 8) == 0) { return 0; }
    }
    return 1;
}

# A JSON array of exactly 2 numbers into *out (an ImVec2): 1, or 0.
fn _im_jr_vec2(v, out: *ImVec2): i64 {
    var w[16];
    if (_im_jr_f64s(v, 2, &w) == 0) { return 0; }
    var x: f64 = load64(&w);
    var y: f64 = load64(&w + 8);
    out.x = x;
    out.y = y;
    return 1;
}

# A JSON array of exactly 3 numbers into *out (an ImVec3): 1, or 0.
fn _im_jr_vec3(v, out: *ImVec3): i64 {
    var w[24];
    if (_im_jr_f64s(v, 3, &w) == 0) { return 0; }
    var x: f64 = load64(&w);
    var y: f64 = load64(&w + 8);
    var z: f64 = load64(&w + 16);
    out.x = x;
    out.y = y;
    out.z = z;
    return 1;
}

# A unit variant into *out: the JSON string naming one of the `count` variants (`name_fn(k)`), or the
# one-key object `{"Name":null}`. 1, or 0 for any other value.
fn _im_jr_enum(v, name_fn, count, out): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    var s = 0;
    if (tag == JTAG_STR) {
        s = bayan_json_v_str(v);
    } elif (tag == JTAG_OBJ && bayan_json_v_obj_len(v) == 1) {
        if (_im_jr_is_null(bayan_json_v_obj_val(v, 0)) == 0) { return 0; }
        s = bayan_json_v_obj_key(v, 0);
    } else {
        return 0;
    }
    for (var k = 0; k < count; k = k + 1) {
        if (str_eq_cstr(s, fncall1(name_fn, k)) == 1) {
            store64(out, k);
            return 1;
        }
    }
    return 0;
}

# An externally tagged payload enum: the variant (one of `count`, named by `name_fn`) into *kind and
# its payload node into *payload, 0 for the bare-string form. 1, or 0 when v is neither a string nor
# a one-key object, or names no variant.
fn _im_jr_tagged(v, name_fn, count, kind, payload): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    var s = 0;
    store64(payload, 0);
    if (tag == JTAG_STR) {
        s = bayan_json_v_str(v);
    } elif (tag == JTAG_OBJ && bayan_json_v_obj_len(v) == 1) {
        s = bayan_json_v_obj_key(v, 0);
        store64(payload, bayan_json_v_obj_val(v, 0));
    } else {
        return 0;
    }
    for (var k = 0; k < count; k = k + 1) {
        if (str_eq_cstr(s, fncall1(name_fn, k)) == 1) {
            store64(kind, k);
            return 1;
        }
    }
    return 0;
}

# A unit variant's payload: the bare-string form (0) or `null`. 1 when valid.
#must_use
fn _im_jr_unit_ok(p): i64 {
    if (p == 0 || _im_jr_is_null(p) == 1) { return 1; }
    return 0;
}

# A field with a serde default, read by `fn_read(v, out)`: 1 read, 2 absent (keep the default), 0
# malformed.
fn _im_jr_def(v, fn_read, out): i64 {
    if (v == 0) { return 2; }
    return fncall2(fn_read, v, out);
}

# An `Option` field with a serde default: 1 read, 2 absent or null (None), 0 malformed.
fn _im_jr_opt_def(v, fn_read, out): i64 {
    if (v == 0 || _im_jr_is_null(v) == 1) { return 2; }
    return fncall2(fn_read, v, out);
}

# An `Option` field without a default, in `form`: as `_im_jr_opt_def`, except that a sequence-form
# struct must carry it (an absent element is too short an array).
fn _im_jr_opt(v, form, fn_read, out): i64 {
    if (v == 0 && form == 2) { return 0; }
    return _im_jr_opt_def(v, fn_read, out);
}

# A JSON array of f64 into a freelist buffer: *words and *count. 1, or 0 (nothing allocated).
fn _im_jr_f64_list(v, words, count): i64 {
    store64(words, 0);
    store64(count, 0);
    if (v == 0 || bayan_json_v_tag(v) != JTAG_ARR) { return 0; }
    var n = bayan_json_v_arr_len(v);
    if (n == 0) { return 1; }
    var p = fl_alloc(n * 8);
    if (p == 0) { return 0; }
    for (var i = 0; i < n; i = i + 1) {
        if (_im_jr_f64(bayan_json_v_arr_get(v, i), p + i * 8) == 0) {
            fl_free(p);
            return 0;
        }
    }
    store64(words, p);
    store64(count, n);
    return 1;
}

# A JSON array of triples into a freelist buffer of 3·n words: f64 triples when `is_f64` is 1, else
# u32 triples. *words and *count. 1, or 0 (nothing allocated).
fn _im_jr_triples(v, is_f64, words, count): i64 {
    store64(words, 0);
    store64(count, 0);
    if (v == 0 || bayan_json_v_tag(v) != JTAG_ARR) { return 0; }
    var n = bayan_json_v_arr_len(v);
    if (n == 0) { return 1; }
    var p = fl_alloc(n * 24);
    if (p == 0) { return 0; }
    for (var i = 0; i < n; i = i + 1) {
        var e = bayan_json_v_arr_get(v, i);
        var ok = 0;
        if (is_f64 == 1) {
            ok = _im_jr_f64s(e, 3, p + i * 24);
        } elif (e != 0 && bayan_json_v_tag(e) == JTAG_ARR && bayan_json_v_arr_len(e) == 3) {
            ok = 1;
            for (var j = 0; j < 3; j = j + 1) {
                if (_im_jr_u32(bayan_json_v_arr_get(e, j), p + i * 24 + j * 8) == 0) { ok = 0; }
            }
        }
        if (ok == 0) {
            fl_free(p);
            return 0;
        }
    }
    store64(words, p);
    store64(count, n);
    return 1;
}

# The enum readers `_im_jr_def` can call (one word out).
fn _im_jr_broadphase(v, out): i64 { return _im_jr_enum(v, &broadphase_kind_name, 2, out); }
fn _im_jr_solver(v, out): i64 { return _im_jr_enum(v, &solver_kind_name, 2, out); }
fn _im_jr_combine(v, out): i64 { return _im_jr_enum(v, &combine_rule_name, 4, out); }
fn _im_jr_body_type(v, out): i64 { return _im_jr_enum(v, &body_type_name, 3, out); }
fn _im_jr_unit(v, out): i64 { return _im_jr_enum(v, &physics_unit_name, 14, out); }

# Ok(0) when ok is 1, else Err(IM_ERR_DESERIALIZE).
#must_use
fn _im_jr_result(ok): Result {
    if (ok == 1) { return Ok(0); }
    return Err(IM_ERR_DESERIALIZE);
}

# ── WorldConfig ─────────────────────────────────────────────────────────────────────

impl ImWorldConfig {
    # Appends the config as serde_json writes a `WorldConfig`.
    fn to_json(self, sb) {
        var ts: f64 = self.timestep;
        var slop: f64 = self.position_slop;
        var corr: f64 = self.position_correction;
        var mv: f64 = self.max_velocity;
        var fq: f64 = self.constraint_frequency;
        var dr: f64 = self.constraint_damping_ratio;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "timestep", 1);
        im_fmt_f64_json(sb, ts);
        _im_jw_key(sb, "gravity", 0);
        _im_jw_vec3(sb, self.gravity);
        _im_jw_key(sb, "velocity_iterations", 0);
        str_builder_add_int(sb, self.velocity_iterations);
        _im_jw_key(sb, "position_iterations", 0);
        str_builder_add_int(sb, self.position_iterations);
        _im_jw_key(sb, "deterministic", 0);
        _im_jw_bool(sb, self.deterministic);
        _im_jw_key(sb, "step", 0);
        _im_jw_u64(sb, self.step);
        _im_jw_key(sb, "position_slop", 0);
        im_fmt_f64_json(sb, slop);
        _im_jw_key(sb, "position_correction", 0);
        im_fmt_f64_json(sb, corr);
        _im_jw_key(sb, "max_velocity", 0);
        im_fmt_f64_json(sb, mv);
        _im_jw_key(sb, "sub_steps", 0);
        str_builder_add_int(sb, self.sub_steps);
        _im_jw_key(sb, "constraint_frequency", 0);
        im_fmt_f64_json(sb, fq);
        _im_jw_key(sb, "constraint_damping_ratio", 0);
        im_fmt_f64_json(sb, dr);
        _im_jw_key(sb, "broadphase", 0);
        _im_jw_name(sb, broadphase_kind_name(self.broadphase));
        _im_jw_key(sb, "solver", 0);
        _im_jw_name(sb, solver_kind_name(self.solver));
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads the `WorldConfig` node o into *out: 1, or 0 when malformed. timestep, gravity, the iteration
# counts, deterministic and step are required; the rest default as `WorldConfig::default`.
fn _im_jr_config(o, out: *ImWorldConfig): i64 {
    var f = _im_jr_form(o, 14);
    if (f == 0) { return 0; }
    var c: ImWorldConfig = ImWorldConfig_default();
    var w[8];
    if (_im_jr_f64(_im_jr_at(o, f, 0, "timestep"), &w) == 0) { return 0; }
    var ts: f64 = load64(&w);
    c.timestep = ts;
    var g: ImVec3 = ImVec3_zero();
    if (_im_jr_vec3(_im_jr_at(o, f, 1, "gravity"), &g) == 0) { return 0; }
    c.gravity = g;
    if (_im_jr_u32(_im_jr_at(o, f, 2, "velocity_iterations"), &w) == 0) { return 0; }
    c.velocity_iterations = load64(&w);
    if (_im_jr_u32(_im_jr_at(o, f, 3, "position_iterations"), &w) == 0) { return 0; }
    c.position_iterations = load64(&w);
    if (_im_jr_bool(_im_jr_at(o, f, 4, "deterministic"), &w) == 0) { return 0; }
    c.deterministic = load64(&w);
    if (_im_jr_u64(_im_jr_at(o, f, 5, "step"), &w) == 0) { return 0; }
    c.step = load64(&w);
    var r = _im_jr_def(_im_jr_at(o, f, 6, "position_slop"), &_im_jr_f64, &w);
    if (r == 0) { return 0; }
    if (r == 1) {
        var a: f64 = load64(&w);
        c.position_slop = a;
    }
    r = _im_jr_def(_im_jr_at(o, f, 7, "position_correction"), &_im_jr_f64, &w);
    if (r == 0) { return 0; }
    if (r == 1) {
        var b: f64 = load64(&w);
        c.position_correction = b;
    }
    r = _im_jr_def(_im_jr_at(o, f, 8, "max_velocity"), &_im_jr_f64, &w);
    if (r == 0) { return 0; }
    if (r == 1) {
        var mv: f64 = load64(&w);
        c.max_velocity = mv;
    }
    r = _im_jr_def(_im_jr_at(o, f, 9, "sub_steps"), &_im_jr_u32, &w);
    if (r == 0) { return 0; }
    if (r == 1) { c.sub_steps = load64(&w); }
    r = _im_jr_def(_im_jr_at(o, f, 10, "constraint_frequency"), &_im_jr_f64, &w);
    if (r == 0) { return 0; }
    if (r == 1) {
        var fq: f64 = load64(&w);
        c.constraint_frequency = fq;
    }
    r = _im_jr_def(_im_jr_at(o, f, 11, "constraint_damping_ratio"), &_im_jr_f64, &w);
    if (r == 0) { return 0; }
    if (r == 1) {
        var dr: f64 = load64(&w);
        c.constraint_damping_ratio = dr;
    }
    r = _im_jr_def(_im_jr_at(o, f, 12, "broadphase"), &_im_jr_broadphase, &w);
    if (r == 0) { return 0; }
    if (r == 1) { c.broadphase = load64(&w); }
    r = _im_jr_def(_im_jr_at(o, f, 13, "solver"), &_im_jr_solver, &w);
    if (r == 0) { return 0; }
    if (r == 1) { c.solver = load64(&w); }
    memcpy(out, &c, sizeof(ImWorldConfig));
    return 1;
}

# Reads a `WorldConfig` document from [buf, buf + len) into *out: Ok(0), or Err(IM_ERR_DESERIALIZE).
# Mirrors `serde_json::from_str::<WorldConfig>`.
#must_use
fn ImWorldConfig_from_json(buf, len, out: *ImWorldConfig): Result {
    return _im_jr_result(_im_jr_config(_im_jr_parse(buf, len), out));
}

# ── PhysicsMaterial ─────────────────────────────────────────────────────────────────

impl ImPhysicsMaterial {
    # Appends the material as serde_json writes a `PhysicsMaterial`.
    fn to_json(self, sb) {
        var fr: f64 = self.friction;
        var re: f64 = self.restitution;
        var de: f64 = self.density;
        var sf: f64 = self.static_friction;
        var ro: f64 = self.rolling_friction;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "friction", 1);
        im_fmt_f64_json(sb, fr);
        _im_jw_key(sb, "restitution", 0);
        im_fmt_f64_json(sb, re);
        _im_jw_key(sb, "density", 0);
        im_fmt_f64_json(sb, de);
        _im_jw_key(sb, "static_friction", 0);
        _im_jw_opt_f64(sb, self.has_static_friction, sf);
        _im_jw_key(sb, "rolling_friction", 0);
        im_fmt_f64_json(sb, ro);
        _im_jw_key(sb, "friction_combine", 0);
        _im_jw_name(sb, combine_rule_name(self.friction_combine));
        _im_jw_key(sb, "restitution_combine", 0);
        _im_jw_name(sb, combine_rule_name(self.restitution_combine));
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads the `PhysicsMaterial` node o into *out: 1, or 0 when malformed. friction, restitution and
# density are required; static_friction may be absent or null (None); rolling_friction defaults to
# 0, friction_combine to Average, restitution_combine to Min.
fn _im_jr_material(o, out: *ImPhysicsMaterial): i64 {
    var f = _im_jr_form(o, 7);
    if (f == 0) { return 0; }
    var m: ImPhysicsMaterial = ImPhysicsMaterial_default();
    var w[8];
    if (_im_jr_f64(_im_jr_at(o, f, 0, "friction"), &w) == 0) { return 0; }
    var fr: f64 = load64(&w);
    m.friction = fr;
    if (_im_jr_f64(_im_jr_at(o, f, 1, "restitution"), &w) == 0) { return 0; }
    var re: f64 = load64(&w);
    m.restitution = re;
    if (_im_jr_f64(_im_jr_at(o, f, 2, "density"), &w) == 0) { return 0; }
    var de: f64 = load64(&w);
    m.density = de;
    var r = _im_jr_opt_def(_im_jr_at(o, f, 3, "static_friction"), &_im_jr_f64, &w);
    if (r == 0) { return 0; }
    if (r == 1) {
        var sf: f64 = load64(&w);
        m.has_static_friction = 1;
        m.static_friction = sf;
    }
    r = _im_jr_def(_im_jr_at(o, f, 4, "rolling_friction"), &_im_jr_f64, &w);
    if (r == 0) { return 0; }
    if (r == 1) {
        var ro: f64 = load64(&w);
        m.rolling_friction = ro;
    }
    r = _im_jr_def(_im_jr_at(o, f, 5, "friction_combine"), &_im_jr_combine, &w);
    if (r == 0) { return 0; }
    if (r == 1) { m.friction_combine = load64(&w); }
    r = _im_jr_def(_im_jr_at(o, f, 6, "restitution_combine"), &_im_jr_combine, &w);
    if (r == 0) { return 0; }
    if (r == 1) { m.restitution_combine = load64(&w); }
    memcpy(out, &m, sizeof(ImPhysicsMaterial));
    return 1;
}

# Reads a `PhysicsMaterial` document into *out: Ok(0), or Err(IM_ERR_DESERIALIZE).
# Mirrors `serde_json::from_str::<PhysicsMaterial>`.
#must_use
fn ImPhysicsMaterial_from_json(buf, len, out: *ImPhysicsMaterial): Result {
    return _im_jr_result(_im_jr_material(_im_jr_parse(buf, len), out));
}

# ── Quantity ────────────────────────────────────────────────────────────────────────

impl ImQuantity {
    # Appends the quantity as serde_json writes a `Quantity`.
    fn to_json(self, sb) {
        var v: f64 = self.value;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "value", 1);
        im_fmt_f64_json(sb, v);
        _im_jw_key(sb, "unit", 0);
        _im_jw_name(sb, physics_unit_name(self.unit));
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads a `Quantity` document (value and unit both required) into *out: Ok(0), or
# Err(IM_ERR_DESERIALIZE). Mirrors `serde_json::from_str::<Quantity>`.
#must_use
fn ImQuantity_from_json(buf, len, out: *ImQuantity): Result {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 2);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var w[8];
    if (_im_jr_f64(_im_jr_at(o, f, 0, "value"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var v: f64 = load64(&w);
    if (_im_jr_unit(_im_jr_at(o, f, 1, "unit"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var q: ImQuantity = ImQuantity_new(v, load64(&w));
    memcpy(out, &q, sizeof(ImQuantity));
    return Ok(0);
}

# ── Force, Impulse, Torque ──────────────────────────────────────────────────────────

# Appends `{"vector":[..],"point":[..] or null}`.
fn _im_jw_vector_point(sb, v: ImVec3, has, p: ImVec3) {
    str_builder_putc(sb, 123);
    _im_jw_key(sb, "vector", 1);
    _im_jw_vec3(sb, v);
    _im_jw_key(sb, "point", 0);
    if (has == 1) { _im_jw_vec3(sb, p); } else { str_builder_add_cstr(sb, "null"); }
    str_builder_putc(sb, 125);
    return 0;
}

# Reads `{"vector":[..], "point":[..] / null / absent}` (or `[vector, point]`) from [buf, buf + len)
# into *v, *has, *p: 1, or 0 when malformed. `point` has no serde default.
fn _im_jr_vector_point(buf, len, v: *ImVec3, has, p: *ImVec3): i64 {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 2);
    if (f == 0) { return 0; }
    if (_im_jr_vec3(_im_jr_at(o, f, 0, "vector"), v) == 0) { return 0; }
    var r = _im_jr_opt(_im_jr_at(o, f, 1, "point"), f, &_im_jr_vec3, p);
    if (r == 0) { return 0; }
    store64(has, 0);
    if (r == 1) { store64(has, 1); }
    return 1;
}

impl ImForce {
    # Appends the force as serde_json writes a `Force`.
    fn to_json(self, sb) {
        return _im_jw_vector_point(sb, self.vector, self.has_point, self.point);
    }
}

impl ImImpulse {
    # Appends the impulse as serde_json writes an `Impulse`.
    fn to_json(self, sb) {
        return _im_jw_vector_point(sb, self.vector, self.has_point, self.point);
    }
}

impl ImTorque {
    # Appends the torque as serde_json writes a `Torque`.
    fn to_json(self, sb) {
        var v: f64 = self.value;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "value", 1);
        im_fmt_f64_json(sb, v);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads a `Force` document into *out: Ok(0), or Err(IM_ERR_DESERIALIZE).
# Mirrors `serde_json::from_str::<Force>`.
#must_use
fn ImForce_from_json(buf, len, out: *ImForce): Result {
    var f: ImForce = ImForce_new(0.0, 0.0, 0.0);
    var has[8];
    var v: ImVec3 = ImVec3_zero();
    var p: ImVec3 = ImVec3_zero();
    if (_im_jr_vector_point(buf, len, &v, &has, &p) == 0) { return Err(IM_ERR_DESERIALIZE); }
    f.vector = v;
    f.has_point = load64(&has);
    f.point = p;
    memcpy(out, &f, sizeof(ImForce));
    return Ok(0);
}

# Reads an `Impulse` document into *out: Ok(0), or Err(IM_ERR_DESERIALIZE).
# Mirrors `serde_json::from_str::<Impulse>`.
#must_use
fn ImImpulse_from_json(buf, len, out: *ImImpulse): Result {
    var i: ImImpulse = ImImpulse_new(0.0, 0.0, 0.0);
    var has[8];
    var v: ImVec3 = ImVec3_zero();
    var p: ImVec3 = ImVec3_zero();
    if (_im_jr_vector_point(buf, len, &v, &has, &p) == 0) { return Err(IM_ERR_DESERIALIZE); }
    i.vector = v;
    i.has_point = load64(&has);
    i.point = p;
    memcpy(out, &i, sizeof(ImImpulse));
    return Ok(0);
}

# Reads a `Torque` document (`{"value":..}` or `[..]`) into *out: Ok(0), or Err(IM_ERR_DESERIALIZE).
# Mirrors `serde_json::from_str::<Torque>`.
#must_use
fn ImTorque_from_json(buf, len, out: *ImTorque): Result {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 1);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var w[8];
    if (_im_jr_f64(_im_jr_at(o, f, 0, "value"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var v: f64 = load64(&w);
    var t: ImTorque = ImTorque_new(v);
    memcpy(out, &t, sizeof(ImTorque));
    return Ok(0);
}

# ── BodyDesc, BodyState ─────────────────────────────────────────────────────────────

impl ImBodyDesc {
    # Appends the descriptor as serde_json writes a `BodyDesc`.
    fn to_json(self, sb) {
        var rot: f64 = self.rotation;
        var av: f64 = self.angular_velocity;
        var ld: f64 = self.linear_damping;
        var ad: f64 = self.angular_damping;
        var gs: f64 = self.gravity_scale;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "body_type", 1);
        _im_jw_name(sb, body_type_name(self.body_type));
        _im_jw_key(sb, "position", 0);
        _im_jw_vec3(sb, self.position);
        _im_jw_key(sb, "rotation", 0);
        im_fmt_f64_json(sb, rot);
        _im_jw_key(sb, "linear_velocity", 0);
        _im_jw_vec3(sb, self.linear_velocity);
        _im_jw_key(sb, "angular_velocity", 0);
        im_fmt_f64_json(sb, av);
        _im_jw_key(sb, "linear_damping", 0);
        im_fmt_f64_json(sb, ld);
        _im_jw_key(sb, "angular_damping", 0);
        im_fmt_f64_json(sb, ad);
        _im_jw_key(sb, "fixed_rotation", 0);
        _im_jw_bool(sb, self.fixed_rotation);
        _im_jw_key(sb, "gravity_scale", 0);
        _im_jw_opt_f64(sb, self.has_gravity_scale, gs);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads a `BodyDesc` document into *out: Ok(0), or Err(IM_ERR_DESERIALIZE). body_type, position and
# rotation are required; the rest default as `BodyDesc::default`. Mirrors
# `serde_json::from_str::<BodyDesc>`.
#must_use
fn ImBodyDesc_from_json(buf, len, out: *ImBodyDesc): Result {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 9);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var d: ImBodyDesc = ImBodyDesc_default();
    var w[8];
    if (_im_jr_body_type(_im_jr_at(o, f, 0, "body_type"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    d.body_type = load64(&w);
    var pos: ImVec3 = ImVec3_zero();
    if (_im_jr_vec3(_im_jr_at(o, f, 1, "position"), &pos) == 0) { return Err(IM_ERR_DESERIALIZE); }
    d.position = pos;
    if (_im_jr_f64(_im_jr_at(o, f, 2, "rotation"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var rot: f64 = load64(&w);
    d.rotation = rot;
    var lv: ImVec3 = ImVec3_zero();
    var r = _im_jr_def(_im_jr_at(o, f, 3, "linear_velocity"), &_im_jr_vec3, &lv);
    if (r == 0) { return Err(IM_ERR_DESERIALIZE); }
    d.linear_velocity = lv;
    r = _im_jr_def(_im_jr_at(o, f, 4, "angular_velocity"), &_im_jr_f64, &w);
    if (r == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (r == 1) {
        var av: f64 = load64(&w);
        d.angular_velocity = av;
    }
    r = _im_jr_def(_im_jr_at(o, f, 5, "linear_damping"), &_im_jr_f64, &w);
    if (r == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (r == 1) {
        var ld: f64 = load64(&w);
        d.linear_damping = ld;
    }
    r = _im_jr_def(_im_jr_at(o, f, 6, "angular_damping"), &_im_jr_f64, &w);
    if (r == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (r == 1) {
        var ad: f64 = load64(&w);
        d.angular_damping = ad;
    }
    r = _im_jr_def(_im_jr_at(o, f, 7, "fixed_rotation"), &_im_jr_bool, &w);
    if (r == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (r == 1) { d.fixed_rotation = load64(&w); }
    r = _im_jr_opt_def(_im_jr_at(o, f, 8, "gravity_scale"), &_im_jr_f64, &w);
    if (r == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (r == 1) {
        var gs: f64 = load64(&w);
        d.has_gravity_scale = 1;
        d.gravity_scale = gs;
    }
    memcpy(out, &d, sizeof(ImBodyDesc));
    return Ok(0);
}

impl ImBodyState {
    # Appends the state as serde_json writes a `BodyState`.
    fn to_json(self, sb) {
        var rot: f64 = self.rotation;
        var av: f64 = self.angular_velocity;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "handle", 1);
        _im_jw_u64(sb, self.handle);
        _im_jw_key(sb, "body_type", 0);
        _im_jw_name(sb, body_type_name(self.body_type));
        _im_jw_key(sb, "position", 0);
        _im_jw_vec3(sb, self.position);
        _im_jw_key(sb, "rotation", 0);
        im_fmt_f64_json(sb, rot);
        _im_jw_key(sb, "linear_velocity", 0);
        _im_jw_vec3(sb, self.linear_velocity);
        _im_jw_key(sb, "angular_velocity", 0);
        im_fmt_f64_json(sb, av);
        _im_jw_key(sb, "is_sleeping", 0);
        _im_jw_bool(sb, self.is_sleeping);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads a `BodyState` document (every field required) into *out: Ok(0), or Err(IM_ERR_DESERIALIZE).
# Mirrors `serde_json::from_str::<BodyState>`.
#must_use
fn ImBodyState_from_json(buf, len, out: *ImBodyState): Result {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 7);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var s: ImBodyState;
    var w[8];
    if (_im_jr_u64(_im_jr_at(o, f, 0, "handle"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    s.handle = load64(&w);
    if (_im_jr_body_type(_im_jr_at(o, f, 1, "body_type"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    s.body_type = load64(&w);
    var pos: ImVec3 = ImVec3_zero();
    if (_im_jr_vec3(_im_jr_at(o, f, 2, "position"), &pos) == 0) { return Err(IM_ERR_DESERIALIZE); }
    s.position = pos;
    if (_im_jr_f64(_im_jr_at(o, f, 3, "rotation"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var rot: f64 = load64(&w);
    s.rotation = rot;
    var lv: ImVec3 = ImVec3_zero();
    if (_im_jr_vec3(_im_jr_at(o, f, 4, "linear_velocity"), &lv) == 0) { return Err(IM_ERR_DESERIALIZE); }
    s.linear_velocity = lv;
    if (_im_jr_f64(_im_jr_at(o, f, 5, "angular_velocity"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var av: f64 = load64(&w);
    s.angular_velocity = av;
    if (_im_jr_bool(_im_jr_at(o, f, 6, "is_sleeping"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    s.is_sleeping = load64(&w);
    memcpy(out, &s, sizeof(ImBodyState));
    return Ok(0);
}

# ── ColliderShape, ColliderDesc ─────────────────────────────────────────────────────

impl ImColliderShape {
    # Appends the shape as serde_json writes a `ColliderShape` (externally tagged).
    fn to_json(self, sb) {
        var k = self.kind;
        _im_jw_variant(sb, shape_kind_name(k));
        str_builder_putc(sb, 123);
        if (k == IM_SHAPE_BOX) {
            _im_jw_key(sb, "half_extents", 1);
            _im_jw_vec3(sb, self.half_extents);
        } elif (k == IM_SHAPE_BALL) {
            var r: f64 = self.radius;
            _im_jw_key(sb, "radius", 1);
            im_fmt_f64_json(sb, r);
        } elif (k == IM_SHAPE_CAPSULE) {
            var hh: f64 = self.half_height;
            var cr: f64 = self.radius;
            _im_jw_key(sb, "half_height", 1);
            im_fmt_f64_json(sb, hh);
            _im_jw_key(sb, "radius", 0);
            im_fmt_f64_json(sb, cr);
        } elif (k == IM_SHAPE_CONVEX_HULL) {
            _im_jw_key(sb, "points", 1);
            _im_jw_triples(sb, self.points, self.point_count, 1);
        } elif (k == IM_SHAPE_TRI_MESH) {
            _im_jw_key(sb, "vertices", 1);
            _im_jw_triples(sb, self.vertices, self.vertex_count, 1);
            _im_jw_key(sb, "indices", 0);
            _im_jw_triples(sb, self.indices, self.index_count, 0);
        } elif (k == IM_SHAPE_HEIGHTFIELD) {
            _im_jw_key(sb, "heights", 1);
            _im_jw_f64_list(sb, self.heights, self.height_count);
            _im_jw_key(sb, "scale", 0);
            _im_jw_vec3(sb, self.scale);
        } elif (k == IM_SHAPE_SEGMENT) {
            _im_jw_key(sb, "a", 1);
            _im_jw_vec3(sb, self.a);
            _im_jw_key(sb, "b", 0);
            _im_jw_vec3(sb, self.b);
        }
        str_builder_putc(sb, 125);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads the `ColliderShape` node v into *out (its arrays on freelist): 1, or 0 when malformed (nothing
# left allocated).
fn _im_jr_shape(v, out: *ImColliderShape): i64 {
    var kw[8];
    var pw[8];
    if (_im_jr_tagged(v, &shape_kind_name, 7, &kw, &pw) == 0) { return 0; }
    var k = load64(&kw);
    var p = load64(&pw);
    var s: ImColliderShape = _im_shape(k);
    var n = 1;
    if (k == IM_SHAPE_CAPSULE || k == IM_SHAPE_TRI_MESH || k == IM_SHAPE_HEIGHTFIELD || k == IM_SHAPE_SEGMENT) {
        n = 2;
    }
    var f = _im_jr_form(p, n);
    if (f == 0) { return 0; }
    var w[8];
    var a[8];
    var c[8];
    var ok = 1;
    if (k == IM_SHAPE_BOX) {
        var he: ImVec3 = ImVec3_zero();
        ok = _im_jr_vec3(_im_jr_at(p, f, 0, "half_extents"), &he);
        s.half_extents = he;
    } elif (k == IM_SHAPE_BALL) {
        ok = _im_jr_f64(_im_jr_at(p, f, 0, "radius"), &w);
        var r: f64 = load64(&w);
        s.radius = r;
    } elif (k == IM_SHAPE_CAPSULE) {
        ok = _im_jr_f64(_im_jr_at(p, f, 0, "half_height"), &w);
        var hh: f64 = load64(&w);
        s.half_height = hh;
        if (ok == 1) { ok = _im_jr_f64(_im_jr_at(p, f, 1, "radius"), &w); }
        var cr: f64 = load64(&w);
        s.radius = cr;
    } elif (k == IM_SHAPE_CONVEX_HULL) {
        ok = _im_jr_triples(_im_jr_at(p, f, 0, "points"), 1, &a, &c);
        s.points = load64(&a);
        s.point_count = load64(&c);
    } elif (k == IM_SHAPE_TRI_MESH) {
        ok = _im_jr_triples(_im_jr_at(p, f, 0, "vertices"), 1, &a, &c);
        s.vertices = load64(&a);
        s.vertex_count = load64(&c);
        if (ok == 1) {
            ok = _im_jr_triples(_im_jr_at(p, f, 1, "indices"), 0, &a, &c);
            s.indices = load64(&a);
            s.index_count = load64(&c);
        }
    } elif (k == IM_SHAPE_HEIGHTFIELD) {
        ok = _im_jr_f64_list(_im_jr_at(p, f, 0, "heights"), &a, &c);
        s.heights = load64(&a);
        s.height_count = load64(&c);
        var sc: ImVec3 = ImVec3_zero();
        if (ok == 1) { ok = _im_jr_vec3(_im_jr_at(p, f, 1, "scale"), &sc); }
        s.scale = sc;
    } elif (k == IM_SHAPE_SEGMENT) {
        var sa: ImVec3 = ImVec3_zero();
        var sbv: ImVec3 = ImVec3_zero();
        ok = _im_jr_vec3(_im_jr_at(p, f, 0, "a"), &sa);
        if (ok == 1) { ok = _im_jr_vec3(_im_jr_at(p, f, 1, "b"), &sbv); }
        s.a = sa;
        s.b = sbv;
    }
    if (ok == 0) {
        s.free();
        return 0;
    }
    memcpy(out, &s, sizeof(ImColliderShape));
    return 1;
}

# Reads a `ColliderShape` document into *out (its arrays on freelist; release with `free`): Ok(0), or
# Err(IM_ERR_DESERIALIZE). Mirrors `serde_json::from_str::<ColliderShape>`.
#must_use
fn ImColliderShape_from_json(buf, len, out: *ImColliderShape): Result {
    return _im_jr_result(_im_jr_shape(_im_jr_parse(buf, len), out));
}

impl ImColliderDesc {
    # Appends the descriptor as serde_json writes a `ColliderDesc`.
    fn to_json(self, sb) {
        var mass: f64 = self.mass;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "shape", 1);
        self.shape.to_json(sb);
        _im_jw_key(sb, "offset", 0);
        _im_jw_vec3(sb, self.offset);
        _im_jw_key(sb, "material", 0);
        self.material.to_json(sb);
        _im_jw_key(sb, "is_sensor", 0);
        _im_jw_bool(sb, self.is_sensor);
        _im_jw_key(sb, "mass", 0);
        _im_jw_opt_f64(sb, self.has_mass, mass);
        _im_jw_key(sb, "collision_layer", 0);
        str_builder_add_int(sb, self.collision_layer);
        _im_jw_key(sb, "collision_mask", 0);
        str_builder_add_int(sb, self.collision_mask);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads a `ColliderDesc` document into *out (the shape's arrays on freelist): Ok(0), or
# Err(IM_ERR_DESERIALIZE). shape is required; the rest default as `ImColliderDesc_new`. Mirrors
# `serde_json::from_str::<ColliderDesc>`.
#must_use
fn ImColliderDesc_from_json(buf, len, out: *ImColliderDesc): Result {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 7);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var sh: ImColliderShape = _im_shape(IM_SHAPE_BALL);
    if (_im_jr_shape(_im_jr_at(o, f, 0, "shape"), &sh) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var d: ImColliderDesc = ImColliderDesc_new(sh);
    var w[8];
    var ok = 1;
    var off: ImVec3 = ImVec3_zero();
    if (_im_jr_def(_im_jr_at(o, f, 1, "offset"), &_im_jr_vec3, &off) == 0) { ok = 0; }
    d.offset = off;
    var m: ImPhysicsMaterial = ImPhysicsMaterial_default();
    if (ok == 1 && _im_jr_def(_im_jr_at(o, f, 2, "material"), &_im_jr_material, &m) == 0) { ok = 0; }
    d.material = m;
    var r = 2;
    if (ok == 1) { r = _im_jr_def(_im_jr_at(o, f, 3, "is_sensor"), &_im_jr_bool, &w); }
    if (r == 0) { ok = 0; }
    if (r == 1) { d.is_sensor = load64(&w); }
    r = 2;
    if (ok == 1) { r = _im_jr_opt_def(_im_jr_at(o, f, 4, "mass"), &_im_jr_f64, &w); }
    if (r == 0) { ok = 0; }
    if (r == 1) {
        var mass: f64 = load64(&w);
        d.has_mass = 1;
        d.mass = mass;
    }
    r = 2;
    if (ok == 1) { r = _im_jr_def(_im_jr_at(o, f, 5, "collision_layer"), &_im_jr_u32, &w); }
    if (r == 0) { ok = 0; }
    if (r == 1) { d.collision_layer = load64(&w); }
    r = 2;
    if (ok == 1) { r = _im_jr_def(_im_jr_at(o, f, 6, "collision_mask"), &_im_jr_u32, &w); }
    if (r == 0) { ok = 0; }
    if (r == 1) { d.collision_mask = load64(&w); }
    if (ok == 0) {
        sh.free();
        return Err(IM_ERR_DESERIALIZE);
    }
    memcpy(out, &d, sizeof(ImColliderDesc));
    return Ok(0);
}

# ── JointType, JointMotor, JointDesc ────────────────────────────────────────────────

# Appends `"limits":[lo,hi]` or `"limits":null`.
fn _im_jw_limits(sb, has, l: ImVec2) {
    _im_jw_key(sb, "limits", 0);
    if (has == 1) { _im_jw_vec2(sb, l); } else { str_builder_add_cstr(sb, "null"); }
    return 0;
}

impl ImJointType {
    # Appends the joint type as serde_json writes a `JointType`: `"Fixed"`, or externally tagged.
    fn to_json(self, sb) {
        var k = self.kind;
        if (k == IM_JOINT_FIXED) {
            _im_jw_name(sb, "Fixed");
            return 0;
        }
        var st: f64 = self.stiffness;
        var dm: f64 = self.damping;
        _im_jw_variant(sb, joint_kind_name(k));
        str_builder_putc(sb, 123);
        if (k == IM_JOINT_REVOLUTE) {
            _im_jw_key(sb, "anchor", 1);
            _im_jw_vec2(sb, self.anchor);
            _im_jw_limits(sb, self.has_limits, self.limits);
        } elif (k == IM_JOINT_PRISMATIC) {
            _im_jw_key(sb, "axis", 1);
            _im_jw_vec2(sb, self.axis);
            _im_jw_limits(sb, self.has_limits, self.limits);
        } elif (k == IM_JOINT_SPRING) {
            var rl: f64 = self.rest_length;
            _im_jw_key(sb, "rest_length", 1);
            im_fmt_f64_json(sb, rl);
            _im_jw_key(sb, "stiffness", 0);
            im_fmt_f64_json(sb, st);
            _im_jw_key(sb, "damping", 0);
            im_fmt_f64_json(sb, dm);
        } elif (k == IM_JOINT_DISTANCE) {
            var ln: f64 = self.length;
            _im_jw_key(sb, "length", 1);
            im_fmt_f64_json(sb, ln);
        } elif (k == IM_JOINT_WHEEL) {
            _im_jw_key(sb, "axis", 1);
            _im_jw_vec2(sb, self.axis);
            _im_jw_key(sb, "stiffness", 0);
            im_fmt_f64_json(sb, st);
            _im_jw_key(sb, "damping", 0);
            im_fmt_f64_json(sb, dm);
        } elif (k == IM_JOINT_ROPE) {
            var ml: f64 = self.max_length;
            _im_jw_key(sb, "max_length", 1);
            im_fmt_f64_json(sb, ml);
        } elif (k == IM_JOINT_MOUSE) {
            var mf: f64 = self.max_force;
            _im_jw_key(sb, "target", 1);
            _im_jw_vec3(sb, self.target);
            _im_jw_key(sb, "stiffness", 0);
            im_fmt_f64_json(sb, st);
            _im_jw_key(sb, "damping", 0);
            im_fmt_f64_json(sb, dm);
            _im_jw_key(sb, "max_force", 0);
            im_fmt_f64_json(sb, mf);
        }
        str_builder_putc(sb, 125);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads `count` required f64 fields named by `names` (a C-string array) of struct node p in form f
# into the words at out: 1, or 0.
fn _im_jr_f64_fields(p, f, names, count, out): i64 {
    for (var i = 0; i < count; i = i + 1) {
        if (_im_jr_f64(_im_jr_at(p, f, i, load64(names + i * 8)), out + i * 8) == 0) { return 0; }
    }
    return 1;
}

# Reads the `JointType` node v into *out: 1, or 0 when malformed.
fn _im_jr_joint_type(v, out: *ImJointType): i64 {
    var kw[8];
    var pw[8];
    if (_im_jr_tagged(v, &joint_kind_name, 8, &kw, &pw) == 0) { return 0; }
    var k = load64(&kw);
    var p = load64(&pw);
    var j: ImJointType = _im_joint(k);
    if (k == IM_JOINT_FIXED) {
        if (_im_jr_unit_ok(p) == 0) { return 0; }
        memcpy(out, &j, sizeof(ImJointType));
        return 1;
    }
    var n = 1;
    if (k == IM_JOINT_REVOLUTE || k == IM_JOINT_PRISMATIC) { n = 2; }
    if (k == IM_JOINT_SPRING || k == IM_JOINT_WHEEL) { n = 3; }
    if (k == IM_JOINT_MOUSE) { n = 4; }
    var f = _im_jr_form(p, n);
    if (f == 0) { return 0; }
    var w[32];
    var names[32];
    if (k == IM_JOINT_REVOLUTE || k == IM_JOINT_PRISMATIC) {
        var first = "axis";
        if (k == IM_JOINT_REVOLUTE) { first = "anchor"; }
        var av: ImVec2 = ImVec2_new(0.0, 0.0);
        if (_im_jr_vec2(_im_jr_at(p, f, 0, first), &av) == 0) { return 0; }
        if (k == IM_JOINT_REVOLUTE) { j.anchor = av; } else { j.axis = av; }
        var lim: ImVec2 = ImVec2_new(0.0, 0.0);
        var r = _im_jr_opt(_im_jr_at(p, f, 1, "limits"), f, &_im_jr_vec2, &lim);
        if (r == 0) { return 0; }
        if (r == 1) {
            j.has_limits = 1;
            j.limits = lim;
        }
    } elif (k == IM_JOINT_SPRING) {
        store64(&names, "rest_length");
        store64(&names + 8, "stiffness");
        store64(&names + 16, "damping");
        if (_im_jr_f64_fields(p, f, &names, 3, &w) == 0) { return 0; }
        var rl: f64 = load64(&w);
        var st: f64 = load64(&w + 8);
        var dm: f64 = load64(&w + 16);
        j.rest_length = rl;
        j.stiffness = st;
        j.damping = dm;
    } elif (k == IM_JOINT_DISTANCE) {
        if (_im_jr_f64(_im_jr_at(p, f, 0, "length"), &w) == 0) { return 0; }
        var ln: f64 = load64(&w);
        j.length = ln;
    } elif (k == IM_JOINT_WHEEL) {
        var ax: ImVec2 = ImVec2_new(0.0, 0.0);
        if (_im_jr_vec2(_im_jr_at(p, f, 0, "axis"), &ax) == 0) { return 0; }
        j.axis = ax;
        if (_im_jr_f64(_im_jr_at(p, f, 1, "stiffness"), &w) == 0) { return 0; }
        if (_im_jr_f64(_im_jr_at(p, f, 2, "damping"), &w + 8) == 0) { return 0; }
        var ws: f64 = load64(&w);
        var wd: f64 = load64(&w + 8);
        j.stiffness = ws;
        j.damping = wd;
    } elif (k == IM_JOINT_ROPE) {
        if (_im_jr_f64(_im_jr_at(p, f, 0, "max_length"), &w) == 0) { return 0; }
        var ml: f64 = load64(&w);
        j.max_length = ml;
    } elif (k == IM_JOINT_MOUSE) {
        var tg: ImVec3 = ImVec3_zero();
        if (_im_jr_vec3(_im_jr_at(p, f, 0, "target"), &tg) == 0) { return 0; }
        j.target = tg;
        if (_im_jr_f64(_im_jr_at(p, f, 1, "stiffness"), &w) == 0) { return 0; }
        if (_im_jr_f64(_im_jr_at(p, f, 2, "damping"), &w + 8) == 0) { return 0; }
        if (_im_jr_f64(_im_jr_at(p, f, 3, "max_force"), &w + 16) == 0) { return 0; }
        var ms: f64 = load64(&w);
        var md: f64 = load64(&w + 8);
        var mf: f64 = load64(&w + 16);
        j.stiffness = ms;
        j.damping = md;
        j.max_force = mf;
    }
    memcpy(out, &j, sizeof(ImJointType));
    return 1;
}

# Reads a `JointType` document into *out: Ok(0), or Err(IM_ERR_DESERIALIZE). Mirrors
# `serde_json::from_str::<JointType>`.
#must_use
fn ImJointType_from_json(buf, len, out: *ImJointType): Result {
    return _im_jr_result(_im_jr_joint_type(_im_jr_parse(buf, len), out));
}

impl ImJointMotor {
    # Appends the motor as serde_json writes a `JointMotor`.
    fn to_json(self, sb) {
        var tv: f64 = self.target_velocity;
        var mf: f64 = self.max_force;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "target_velocity", 1);
        im_fmt_f64_json(sb, tv);
        _im_jw_key(sb, "max_force", 0);
        im_fmt_f64_json(sb, mf);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads the `JointMotor` node v (both fields required) into *out: 1, or 0.
fn _im_jr_motor(v, out: *ImJointMotor): i64 {
    var f = _im_jr_form(v, 2);
    if (f == 0) { return 0; }
    var w[16];
    if (_im_jr_f64(_im_jr_at(v, f, 0, "target_velocity"), &w) == 0) { return 0; }
    if (_im_jr_f64(_im_jr_at(v, f, 1, "max_force"), &w + 8) == 0) { return 0; }
    var tv: f64 = load64(&w);
    var mf: f64 = load64(&w + 8);
    out.target_velocity = tv;
    out.max_force = mf;
    return 1;
}

# Reads a `JointMotor` document into *out: Ok(0), or Err(IM_ERR_DESERIALIZE). Mirrors
# `serde_json::from_str::<JointMotor>`.
#must_use
fn ImJointMotor_from_json(buf, len, out: *ImJointMotor): Result {
    return _im_jr_result(_im_jr_motor(_im_jr_parse(buf, len), out));
}

impl ImJointDesc {
    # Appends the descriptor as serde_json writes a `JointDesc`.
    fn to_json(self, sb) {
        var dm: f64 = self.damping;
        var bf: f64 = self.break_force;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "body_a", 1);
        _im_jw_u64(sb, self.body_a);
        _im_jw_key(sb, "body_b", 0);
        _im_jw_u64(sb, self.body_b);
        _im_jw_key(sb, "joint_type", 0);
        self.joint_type.to_json(sb);
        _im_jw_key(sb, "local_anchor_a", 0);
        _im_jw_vec2(sb, self.local_anchor_a);
        _im_jw_key(sb, "local_anchor_b", 0);
        _im_jw_vec2(sb, self.local_anchor_b);
        _im_jw_key(sb, "motor", 0);
        if (self.has_motor == 1) { self.motor.to_json(sb); } else { str_builder_add_cstr(sb, "null"); }
        _im_jw_key(sb, "damping", 0);
        im_fmt_f64_json(sb, dm);
        _im_jw_key(sb, "break_force", 0);
        _im_jw_opt_f64(sb, self.has_break_force, bf);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads a `JointDesc` document into *out: Ok(0), or Err(IM_ERR_DESERIALIZE). The bodies, joint type
# and anchors are required; motor and break_force may be absent or null, damping defaults to 0.
# Mirrors `serde_json::from_str::<JointDesc>`.
#must_use
fn ImJointDesc_from_json(buf, len, out: *ImJointDesc): Result {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 8);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var w[16];
    if (_im_jr_u64(_im_jr_at(o, f, 0, "body_a"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (_im_jr_u64(_im_jr_at(o, f, 1, "body_b"), &w + 8) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var jt: ImJointType = ImJointType_fixed();
    if (_im_jr_joint_type(_im_jr_at(o, f, 2, "joint_type"), &jt) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var aa: ImVec2 = ImVec2_new(0.0, 0.0);
    var ab: ImVec2 = ImVec2_new(0.0, 0.0);
    if (_im_jr_vec2(_im_jr_at(o, f, 3, "local_anchor_a"), &aa) == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (_im_jr_vec2(_im_jr_at(o, f, 4, "local_anchor_b"), &ab) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var d: ImJointDesc = ImJointDesc_new(load64(&w), load64(&w + 8), jt, aa, ab);
    var mo: ImJointMotor = ImJointMotor_new(0.0, 0.0);
    var r = _im_jr_opt_def(_im_jr_at(o, f, 5, "motor"), &_im_jr_motor, &mo);
    if (r == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (r == 1) {
        d.has_motor = 1;
        d.motor = mo;
    }
    r = _im_jr_def(_im_jr_at(o, f, 6, "damping"), &_im_jr_f64, &w);
    if (r == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (r == 1) {
        var dm: f64 = load64(&w);
        d.damping = dm;
    }
    r = _im_jr_opt_def(_im_jr_at(o, f, 7, "break_force"), &_im_jr_f64, &w);
    if (r == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (r == 1) {
        var bf: f64 = load64(&w);
        d.has_break_force = 1;
        d.break_force = bf;
    }
    memcpy(out, &d, sizeof(ImJointDesc));
    return Ok(0);
}

# ── CollisionEvent, ContactPoint, ContactData ───────────────────────────────────────

# A typed view of a word.
#must_use
fn _im_as_contact_point(p): *ImContactPoint {
    return p;
}

impl ImCollisionEvent {
    # Appends the event as serde_json writes a `CollisionEvent` (externally tagged).
    fn to_json(self, sb) {
        _im_jw_variant(sb, event_kind_name(self.kind));
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "collider_a", 1);
        _im_jw_u64(sb, self.collider_a);
        _im_jw_key(sb, "collider_b", 0);
        _im_jw_u64(sb, self.collider_b);
        str_builder_putc(sb, 125);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads a `CollisionEvent` document into *out: Ok(0), or Err(IM_ERR_DESERIALIZE). Mirrors
# `serde_json::from_str::<CollisionEvent>`.
#must_use
fn ImCollisionEvent_from_json(buf, len, out: *ImCollisionEvent): Result {
    var o = _im_jr_parse(buf, len);
    var kw[8];
    var pw[8];
    if (_im_jr_tagged(o, &event_kind_name, 3, &kw, &pw) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var p = load64(&pw);
    var f = _im_jr_form(p, 2);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var w[16];
    if (_im_jr_u64(_im_jr_at(p, f, 0, "collider_a"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (_im_jr_u64(_im_jr_at(p, f, 1, "collider_b"), &w + 8) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var e: ImCollisionEvent = ImCollisionEvent_new(load64(&kw), load64(&w), load64(&w + 8));
    memcpy(out, &e, sizeof(ImCollisionEvent));
    return Ok(0);
}

impl ImContactPoint {
    # Appends the point as serde_json writes a `ContactPoint`.
    fn to_json(self, sb) {
        var im: f64 = self.impulse;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "local_a", 1);
        _im_jw_vec3(sb, self.local_a);
        _im_jw_key(sb, "local_b", 0);
        _im_jw_vec3(sb, self.local_b);
        _im_jw_key(sb, "impulse", 0);
        im_fmt_f64_json(sb, im);
        str_builder_putc(sb, 125);
        return 0;
    }
}

# Reads the `ContactPoint` node v (every field required) into *out: 1, or 0.
fn _im_jr_contact_point(v, out: *ImContactPoint): i64 {
    var f = _im_jr_form(v, 3);
    if (f == 0) { return 0; }
    var la: ImVec3 = ImVec3_zero();
    var lb: ImVec3 = ImVec3_zero();
    var w[8];
    if (_im_jr_vec3(_im_jr_at(v, f, 0, "local_a"), &la) == 0) { return 0; }
    if (_im_jr_vec3(_im_jr_at(v, f, 1, "local_b"), &lb) == 0) { return 0; }
    if (_im_jr_f64(_im_jr_at(v, f, 2, "impulse"), &w) == 0) { return 0; }
    var im: f64 = load64(&w);
    out.local_a = la;
    out.local_b = lb;
    out.impulse = im;
    return 1;
}

# Reads a `ContactPoint` document into *out: Ok(0), or Err(IM_ERR_DESERIALIZE). Mirrors
# `serde_json::from_str::<ContactPoint>`.
#must_use
fn ImContactPoint_from_json(buf, len, out: *ImContactPoint): Result {
    return _im_jr_result(_im_jr_contact_point(_im_jr_parse(buf, len), out));
}

impl ImContactData {
    # Appends the contact as serde_json writes a `ContactData`.
    fn to_json(self, sb) {
        var dp: f64 = self.depth;
        str_builder_putc(sb, 123);
        _im_jw_key(sb, "collider_a", 1);
        _im_jw_u64(sb, self.collider_a);
        _im_jw_key(sb, "collider_b", 0);
        _im_jw_u64(sb, self.collider_b);
        _im_jw_key(sb, "normal", 0);
        _im_jw_vec3(sb, self.normal);
        _im_jw_key(sb, "depth", 0);
        im_fmt_f64_json(sb, dp);
        _im_jw_key(sb, "points", 0);
        str_builder_putc(sb, 91);
        for (var i = 0; i < self.point_count; i = i + 1) {
            if (i > 0) { str_builder_putc(sb, 44); }
            var cp: *ImContactPoint = _im_as_contact_point(self.points + i * sizeof(ImContactPoint));
            cp.to_json(sb);
        }
        str_builder_putc(sb, 93);
        str_builder_putc(sb, 125);
        return 0;
    }

    # Releases the points.
    fn free(self) {
        if (self.points != 0) { fl_free(self.points); }
        self.points = 0;
        self.point_count = 0;
        return 0;
    }
}

# Reads a `ContactData` document (every field required) into *out, its points on freelist (release
# with `free`): Ok(0), or Err(IM_ERR_DESERIALIZE). Mirrors `serde_json::from_str::<ContactData>`.
#must_use
fn ImContactData_from_json(buf, len, out: *ImContactData): Result {
    var o = _im_jr_parse(buf, len);
    var f = _im_jr_form(o, 5);
    if (f == 0) { return Err(IM_ERR_DESERIALIZE); }
    var w[16];
    if (_im_jr_u64(_im_jr_at(o, f, 0, "collider_a"), &w) == 0) { return Err(IM_ERR_DESERIALIZE); }
    if (_im_jr_u64(_im_jr_at(o, f, 1, "collider_b"), &w + 8) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var nrm: ImVec3 = ImVec3_zero();
    if (_im_jr_vec3(_im_jr_at(o, f, 2, "normal"), &nrm) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var dw[8];
    if (_im_jr_f64(_im_jr_at(o, f, 3, "depth"), &dw) == 0) { return Err(IM_ERR_DESERIALIZE); }
    var pv = _im_jr_at(o, f, 4, "points");
    if (pv == 0 || bayan_json_v_tag(pv) != JTAG_ARR) { return Err(IM_ERR_DESERIALIZE); }
    var n = bayan_json_v_arr_len(pv);
    var pts = 0;
    if (n > 0) {
        pts = fl_alloc(n * sizeof(ImContactPoint));
        if (pts == 0) { return Err(IM_ERR_DESERIALIZE); }
        for (var i = 0; i < n; i = i + 1) {
            if (_im_jr_contact_point(bayan_json_v_arr_get(pv, i), pts + i * sizeof(ImContactPoint)) == 0) {
                fl_free(pts);
                return Err(IM_ERR_DESERIALIZE);
            }
        }
    }
    var dp: f64 = load64(&dw);
    var c: ImContactData;
    c.collider_a = load64(&w);
    c.collider_b = load64(&w + 8);
    c.normal = nrm;
    c.depth = dp;
    c.points = pts;
    c.point_count = n;
    memcpy(out, &c, sizeof(ImContactData));
    return Ok(0);
}

